module

public import Mathlib.Analysis.SpecialFunctions.Integrals.Basic
public import Mathlib.MeasureTheory.Integral.DominatedConvergence
public import Mathlib.Analysis.Normed.Group.Tannery
public import Feec.Ch4.BoxThesis

/-!
# Forward propagation on the box: `t ≥ 0` already forces stationarity

`Feec.Ch4.Box` identifies the largest invariant subspace `K*` of `K = {0} × L²(TSD) × L²(TSD)`
on the box `Q = (0, ½)³` with the thesis' boundary conditions (parity model): it consists of the
stationary data. `K*` asks the orbit to stay in `K` for all `t ∈ ℝ`. Thesis Prop 4.17
([QuennevilleBelair2015, §4.10]) is a statement about `t ≥ 0`, and forward propagation is in
general weaker (correction in `Feec.Ch4.BoundedSalvageMax`). This file shows that on the box the
two coincide: **a datum whose forward orbit stays in `K` is stationary**, so it is
`(0, 0, B₀)` with `B₀ ∈ L²(TSD)` curl-free.

## Method

The orbits are almost periodic. On the mode `k` the group acts by `exp(t W_k)` with
`W_k³ = -|ξ_k|² W_k` (`waveSymK_cube`), so
`⟪exp(t W_k) u, v⟫ = a + b cos(|ξ_k| t) + c sin(|ξ_k| t)` (`exp_smul_apply_eq`,
`inner_exp_waveSymK`). For `z ⊥ K`, `t ↦ ⟪S(t) x, z⟫` vanishes on `[0, ∞)` and is an absolutely
convergent sum of such terms. Its Cesàro means against `cos(ωt)` extract the frequency `ω`
(`tendsto_cesaro_trig`, then `sum_eq_zero_of_forward_trig`: dominated convergence for the
interval integrals and Tannery's theorem for the series). Hence the `N_ω`-component of `x`, a
trigonometric polynomial, is orthogonal to `Kᗮ`, so it lies in `K ∩ N_ω = 0`
(`Feec.Box.eq_zero_of_mem_Kc_Nω`), and `W_k x̂(k) = 0` for every `k`.

## Main results

* `exp_smul_apply_eq`: `exp(tA) u = u₀ + cos(ωt) u₁ + (sin(ωt)/ω) A u` if `A³ = -ω² A`;
  `norm_exp_smul_apply_of_skew`: `exp(tA)` is an isometry for skew `A`.
* `tendsto_cesaro_trig`: `T⁻¹ ∫₀ᵀ cos(ωt)(a + b cos(νt) + c sin(νt)) dt → [ν = ω] b/2`.
* **`waveSym_eq_zero_of_forward`**: forward invariance of `K = {0} × S1 × S2` (`S1`, `S2` as in
  `Feec.Box.mem_Kmax_iff`) forces `W_k x̂(k) = 0` for all `k`.
* **`forward_iff_mem_Kmax`**: forward invariance iff `x ∈ K*`; **`forward_boxTSD_iff`**: for the
  thesis' `K`, iff `x = (0, 0, B₀)` with `B₀ ∈ L²(TSD)` curl-free.
* **`thesisBox_forward_iff`**: the same for every orthogonal group generated by the Hodge wave
  operator of the box complex `Feec.Box.thesisBoxComplex`.

As in `Feec.Ch4.Box`, everything is in the parity model; the identification of the parity
spaces with the Sobolev spaces of `Q` (traces) is not proved.

## References

* [QuennevilleBelair2015], §4.10 (Prop 4.17)
* [Pazy1983], §1.10 (groups and generators)
-/

@[expose] public noncomputable section

open scoped RealInnerProductSpace
open MeasureTheory Set Filter Topology NormedSpace

namespace Feec.Box

/-! ## Exponentials of skew operators with `A³ = -ω² A` -/

section Skew

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- `exp(tA)` is an isometry for skew `A`. -/
theorem norm_exp_smul_apply_of_skew (A : E →L[ℝ] E) (hA : ∀ x y, ⟪A x, y⟫ = -⟪x, A y⟫)
    (t : ℝ) (u : E) : ‖exp (t • A) u‖ = ‖u‖ := by
  have hd : ∀ s : ℝ, HasDerivAt (fun s : ℝ => ⟪exp (s • A) u, exp (s • A) u⟫) 0 s := by
    intro s
    have h := (hasDerivAt_exp_smul_apply A u s).inner ℝ (hasDerivAt_exp_smul_apply A u s)
    convert h using 1
    linarith [hA (exp (s • A) u) (exp (s • A) u),
      real_inner_comm (A (exp (s • A) u)) (exp (s • A) u)]
  have := is_const_of_deriv_eq_zero (fun s => (hd s).differentiableAt) (fun s => (hd s).deriv) t 0
  simp only [zero_smul, exp_zero, ] at this
  rw [real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq] at this
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).1 this

omit [CompleteSpace E] in
/-- A skew `A` with `A⁴ = -ω² A²` satisfies `A³ = -ω² A`. -/
theorem cube_of_four_of_skew (A : E →L[ℝ] E) (hA : ∀ x y, ⟪A x, y⟫ = -⟪x, A y⟫) {ω : ℝ}
    (h4 : ∀ x, A (A (A (A x))) = -(ω ^ 2) • A (A x)) (x : E) :
    A (A (A x)) = -(ω ^ 2) • A x := by
  set y := A (A (A x)) + (ω ^ 2) • A x
  have hy : y = A (A (A x) + (ω ^ 2) • x) := by simp [y]
  have hAy : A y = 0 := by
    simp only [y, _root_.map_add, _root_.map_smul, h4, neg_smul, neg_add_cancel]
  have h0 : ⟪y, y⟫ = 0 := by
    have e : ⟪y, y⟫ = ⟪A (A (A x) + (ω ^ 2) • x), y⟫ := by rw [← hy]
    rw [e, hA, hAy, inner_zero_right, neg_zero]
  rw [real_inner_self_eq_norm_sq, sq_eq_zero_iff, norm_eq_zero] at h0
  rw [neg_smul, ← sub_eq_zero, sub_neg_eq_add]
  exact h0

/-- **The flow of `A` with `A³ = -ω² A`, `ω ≠ 0`**:
`exp(tA) u = u₀ + cos(ωt) u₁ + (sin(ωt)/ω) A u` with `u₁ = -ω⁻² A² u`, `u₀ = u - u₁`. -/
theorem exp_smul_apply_eq (A : E →L[ℝ] E) {ω : ℝ} (hω : ω ≠ 0)
    (h3 : ∀ x, A (A (A x)) = -(ω ^ 2) • A x) (t : ℝ) (u : E) :
    exp (t • A) u = (u + (ω ^ 2)⁻¹ • A (A u)) + Real.cos (ω * t) • (-(ω ^ 2)⁻¹ • A (A u)) +
      (Real.sin (ω * t) / ω) • A u := by
  set φ : ℝ → E := fun s => (u + (ω ^ 2)⁻¹ • A (A u)) +
    Real.cos (ω * s) • (-(ω ^ 2)⁻¹ • A (A u)) + (Real.sin (ω * s) / ω) • A u with hφ
  have hφd : ∀ s, HasDerivAt φ (A (φ s)) s := by
    intro s
    have hc : HasDerivAt (fun s => Real.cos (ω * s)) (-Real.sin (ω * s) * ω) s := by
      have := ((hasDerivAt_id' s).const_mul ω).cos
      convert this using 1; ring
    have hs : HasDerivAt (fun s => Real.sin (ω * s) / ω) (Real.cos (ω * s) * ω / ω) s := by
      have := (((hasDerivAt_id' s).const_mul ω).sin).div_const ω
      convert this using 1; ring
    have h := ((hasDerivAt_const s (u + (ω ^ 2)⁻¹ • A (A u))).add
      (hc.smul_const (-(ω ^ 2)⁻¹ • A (A u)))).add (hs.smul_const (A u))
    convert h using 1
    simp only [hφ, _root_.map_add, _root_.map_smul, h3, zero_add]
    have hω2 : ω ^ 2 ≠ 0 := pow_ne_zero 2 hω
    match_scalars <;> field_simp
    ring
  set ψ : ℝ → E := fun s => exp ((-s) • A) (φ s) with hψ
  have hψd : ∀ s, HasDerivAt ψ 0 s := by
    intro s
    have he : (fun s : ℝ => exp ((-s) • A)) = fun s => exp (s • (-A)) := by
      funext s; rw [neg_smul, smul_neg]
    have h1 : HasDerivAt (fun s : ℝ => exp ((-s) • A)) ((-A) * exp (s • (-A))) s := by
      rw [he]; exact hasDerivAt_exp_smul_const' (-A) s
    have h := h1.clm_apply (hφd s)
    convert h using 1
    have hc : Commute A (exp (s • (-A))) := ((Commute.refl A).neg_right.smul_right s).exp_right
    have hc' : exp (s • (-A)) (A (φ s)) = A (exp (s • (-A)) (φ s)) := by
      have := congrArg (fun T : E →L[ℝ] E => T (φ s)) hc.eq
      simpa using this.symm
    rw [show (-s) • A = s • (-A) by rw [neg_smul, smul_neg]]
    change (0 : E) = -(A (exp (s • (-A)) (φ s))) + exp (s • (-A)) (A (φ s))
    rw [hc', neg_add_cancel]
  have hψc := is_const_of_deriv_eq_zero (fun s => (hψd s).differentiableAt)
    (fun s => (hψd s).deriv) t 0
  have h0 : ψ 0 = u := by
    simp only [hψ, hφ, neg_zero, zero_smul, exp_zero, mul_zero,
      Real.cos_zero, Real.sin_zero, zero_div, one_smul]
    simp
  rw [h0] at hψc
  have := congrArg (fun v => (exp (t • A) : E →L[ℝ] E) v) hψc
  rw [← this]
  change (exp (t • A) * exp ((-t) • A)) (φ t) = φ t
  rw [exp_smul_mul_exp_neg_smul]
  rfl

end Skew

/-! ## Cesàro means of trigonometric functions -/

section Cesaro

theorem tendsto_inv_mul_of_bdd {F : ℝ → ℝ} {C : ℝ} (h : ∀ T, |F T| ≤ C) :
    Tendsto (fun T => T⁻¹ * F T) atTop (𝓝 0) := by
  refine tendsto_inv_atTop_zero.zero_mul_isBoundedUnder_le ⟨C, ?_⟩
  simp only [eventually_map]
  exact Eventually.of_forall fun T => by simpa [Real.norm_eq_abs] using h T

theorem integral_cos_mul {c : ℝ} (hc : c ≠ 0) (T : ℝ) :
    ∫ t in (0 : ℝ)..T, Real.cos (c * t) = c⁻¹ * (Real.sin (c * T) - Real.sin 0) := by
  rw [intervalIntegral.integral_comp_mul_left (fun t => Real.cos t) hc, integral_cos, mul_zero,
    smul_eq_mul]

theorem integral_sin_mul {c : ℝ} (hc : c ≠ 0) (T : ℝ) :
    ∫ t in (0 : ℝ)..T, Real.sin (c * t) = c⁻¹ * (Real.cos 0 - Real.cos (c * T)) := by
  rw [intervalIntegral.integral_comp_mul_left (fun t => Real.sin t) hc, integral_sin, mul_zero,
    smul_eq_mul]

/-- `T⁻¹ ∫₀ᵀ cos(ct) dt → [c = 0]`. -/
theorem tendsto_cesaro_cos (c : ℝ) :
    Tendsto (fun T => T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (c * t)) atTop
      (𝓝 (if c = 0 then 1 else 0)) := by
  by_cases hc : c = 0
  · subst hc
    simp only [zero_mul, Real.cos_zero, intervalIntegral.integral_const, sub_zero, smul_eq_mul,
      mul_one, ↓reduceIte]
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with T hT
    rw [inv_mul_cancel₀ hT.ne']
  · simp only [hc, ↓reduceIte]
    refine tendsto_inv_mul_of_bdd (C := |c⁻¹| * 2) fun T => ?_
    rw [integral_cos_mul hc, abs_mul]
    gcongr
    refine (abs_sub _ _).trans ?_
    linarith [Real.abs_sin_le_one (c * T), Real.abs_sin_le_one 0]

/-- `T⁻¹ ∫₀ᵀ sin(ct) dt → 0`. -/
theorem tendsto_cesaro_sin (c : ℝ) :
    Tendsto (fun T => T⁻¹ * ∫ t in (0 : ℝ)..T, Real.sin (c * t)) atTop (𝓝 0) := by
  by_cases hc : c = 0
  · subst hc
    simp
  · refine tendsto_inv_mul_of_bdd (C := |c⁻¹| * 2) fun T => ?_
    rw [integral_sin_mul hc, abs_mul]
    gcongr
    refine (abs_sub _ _).trans ?_
    linarith [Real.abs_cos_le_one (c * T), Real.abs_cos_le_one 0]

theorem cos_mul_cos' (a b t : ℝ) :
    Real.cos (a * t) * Real.cos (b * t) =
      (Real.cos ((a - b) * t) + Real.cos ((a + b) * t)) / 2 := by
  rw [sub_mul, add_mul, Real.cos_sub, Real.cos_add]; ring

theorem cos_mul_sin' (a b t : ℝ) :
    Real.cos (a * t) * Real.sin (b * t) =
      (Real.sin ((b + a) * t) + Real.sin ((b - a) * t)) / 2 := by
  rw [sub_mul, add_mul, Real.sin_sub, Real.sin_add]; ring

/-- `T⁻¹ ∫₀ᵀ cos(ωt) cos(νt) dt → [ν = ω]/2` for `ω > 0`, `ν ≥ 0`. -/
theorem tendsto_cesaro_cos_cos {ω ν : ℝ} (hω : 0 < ω) (hν : 0 ≤ ν) :
    Tendsto (fun T => T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t) * Real.cos (ν * t)) atTop
      (𝓝 (if ν = ω then 1 / 2 else 0)) := by
  have e : ∀ T, T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t) * Real.cos (ν * t) =
      ((T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos ((ω - ν) * t)) +
        (T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos ((ω + ν) * t))) / 2 := by
    intro T
    simp_rw [cos_mul_cos']
    rw [intervalIntegral.integral_div, intervalIntegral.integral_add
      (by apply Continuous.intervalIntegrable; fun_prop)
      (by apply Continuous.intervalIntegrable; fun_prop)]
    ring
  simp_rw [e]
  have h := ((tendsto_cesaro_cos (ω - ν)).add (tendsto_cesaro_cos (ω + ν))).div_const 2
  convert h using 2
  have hpos : ω + ν ≠ 0 := by linarith
  by_cases h' : ν = ω
  · subst h'
    have : ν + ν ≠ 0 := by linarith
    simp [this]
  · have : ω - ν ≠ 0 := sub_ne_zero.2 (Ne.symm h')
    simp only [h', this, hpos, ↓reduceIte]; norm_num

/-- `T⁻¹ ∫₀ᵀ cos(ωt) sin(νt) dt → 0`. -/
theorem tendsto_cesaro_cos_sin (ω ν : ℝ) :
    Tendsto (fun T => T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t) * Real.sin (ν * t)) atTop
      (𝓝 0) := by
  have e : ∀ T, T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t) * Real.sin (ν * t) =
      ((T⁻¹ * ∫ t in (0 : ℝ)..T, Real.sin ((ν + ω) * t)) +
        (T⁻¹ * ∫ t in (0 : ℝ)..T, Real.sin ((ν - ω) * t))) / 2 := by
    intro T
    simp_rw [cos_mul_sin']
    rw [intervalIntegral.integral_div, intervalIntegral.integral_add
      (by apply Continuous.intervalIntegrable; fun_prop)
      (by apply Continuous.intervalIntegrable; fun_prop)]
    ring
  simp_rw [e]
  simpa using ((tendsto_cesaro_sin (ν + ω)).add (tendsto_cesaro_sin (ν - ω))).div_const 2

/-- **The Cesàro mean of `cos(ωt) (a + b cos(νt) + c sin(νt))`** tends to `[ν = ω] b/2`. -/
theorem tendsto_cesaro_trig {ω ν : ℝ} (hω : 0 < ω) (hν : 0 ≤ ν) (a b c : ℝ) :
    Tendsto (fun T => T⁻¹ * ∫ t in (0 : ℝ)..T,
        Real.cos (ω * t) * (a + Real.cos (ν * t) * b + Real.sin (ν * t) * c)) atTop
      (𝓝 (if ν = ω then b / 2 else 0)) := by
  have e : ∀ T, T⁻¹ * ∫ t in (0 : ℝ)..T,
        Real.cos (ω * t) * (a + Real.cos (ν * t) * b + Real.sin (ν * t) * c) =
      a * (T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t)) +
        b * (T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t) * Real.cos (ν * t)) +
        c * (T⁻¹ * ∫ t in (0 : ℝ)..T, Real.cos (ω * t) * Real.sin (ν * t)) := by
    intro T
    have : (fun t => Real.cos (ω * t) * (a + Real.cos (ν * t) * b + Real.sin (ν * t) * c)) =
        fun t => (a * Real.cos (ω * t) + b * (Real.cos (ω * t) * Real.cos (ν * t))) +
          c * (Real.cos (ω * t) * Real.sin (ν * t)) := by funext t; ring
    rw [this, intervalIntegral.integral_add (by apply Continuous.intervalIntegrable; fun_prop)
      (by apply Continuous.intervalIntegrable; fun_prop),
      intervalIntegral.integral_add (by apply Continuous.intervalIntegrable; fun_prop)
      (by apply Continuous.intervalIntegrable; fun_prop),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul]
    ring
  simp_rw [e]
  have h0 := tendsto_cesaro_cos ω
  simp only [hω.ne', ↓reduceIte] at h0
  have h := ((h0.const_mul a).add ((tendsto_cesaro_cos_cos hω hν).const_mul b)).add
    ((tendsto_cesaro_cos_sin ω ν).const_mul c)
  convert h using 2
  split_ifs <;> ring

/-- **Cesàro extraction for absolutely convergent trigonometric series**: if
`f(t) = Σ_j (a_j + b_j cos(ν_j t) + c_j sin(ν_j t))`, dominated by a summable `B`, vanishes for
`t ≥ 0`, then `Σ_{ν_j = ω} b_j = 0` for every `ω > 0`. (Average `cos(ωt) f(t)` over `[0, T]`:
the integral commutes with the sum by dominated convergence, and as `T → ∞` the means tend to
`½ Σ_{ν_j = ω} b_j` by Tannery's theorem and `tendsto_cesaro_trig`.) -/
theorem sum_eq_zero_of_forward_trig {ι : Type*} [Countable ι] {ω : ℝ} (hω : 0 < ω)
    (ν a b c : ι → ℝ) (hν : ∀ j, 0 ≤ ν j) (B : ι → ℝ) (hB : Summable B)
    (hbd : ∀ j t, ‖a j + Real.cos (ν j * t) * b j + Real.sin (ν j * t) * c j‖ ≤ B j)
    (h0 : ∀ t, 0 ≤ t →
      HasSum (fun j => a j + Real.cos (ν j * t) * b j + Real.sin (ν j * t) * c j) 0) :
    ∑' j, (if ν j = ω then b j / 2 else 0) = 0 := by
  set g : ι → ℝ → ℝ := fun j t =>
    Real.cos (ω * t) * (a j + Real.cos (ν j * t) * b j + Real.sin (ν j * t) * c j) with hg
  have hgb : ∀ j t, ‖g j t‖ ≤ B j := by
    intro j t
    rw [hg, norm_mul]
    calc ‖Real.cos (ω * t)‖ * ‖a j + Real.cos (ν j * t) * b j + Real.sin (ν j * t) * c j‖
        ≤ 1 * B j := mul_le_mul (by simpa using Real.abs_cos_le_one (ω * t)) (hbd j t)
          (norm_nonneg _) zero_le_one
      _ = B j := one_mul _
  have hgc : ∀ j, Continuous (g j) := fun j => by rw [hg]; fun_prop
  set F : ℝ → ι → ℝ := fun T j => T⁻¹ * ∫ t in (0 : ℝ)..T, g j t with hF
  have hsum : ∀ T, 0 < T → HasSum (F T) 0 := by
    intro T hT
    have h := intervalIntegral.hasSum_integral_of_dominated_convergence (μ := volume)
      (a := 0) (b := T) (f := fun _ => (0 : ℝ)) (F := g) (fun j _ => B j)
      (fun j => (hgc j).aestronglyMeasurable) (fun j => ae_of_all _ fun t _ => hgb j t)
      (ae_of_all _ fun _ _ => hB) intervalIntegrable_const
      (ae_of_all _ fun t ht => by
        rw [Set.uIoc_of_le hT.le] at ht
        simpa [hg] using (h0 t ht.1.le).mul_left (Real.cos (ω * t)))
    simpa [hF] using h.mul_left T⁻¹
  have hlim : ∀ j, Tendsto (fun T => F T j) atTop (𝓝 (if ν j = ω then b j / 2 else 0)) :=
    fun j => tendsto_cesaro_trig hω (hν j) (a j) (b j) (c j)
  have hbdF : ∀ᶠ T in atTop, ∀ j, ‖F T j‖ ≤ B j := by
    filter_upwards [eventually_gt_atTop 0] with T hT j
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := T)
      (fun t _ => hgb j t)
    rw [sub_zero, abs_of_pos hT] at h
    rw [hF, norm_mul, norm_inv, Real.norm_of_nonneg hT.le]
    calc T⁻¹ * ‖∫ t in (0 : ℝ)..T, g j t‖ ≤ T⁻¹ * (B j * T) := by gcongr
      _ = B j := by field_simp
  have hT := tendsto_tsum_of_dominated_convergence hB hlim hbdF
  have h0' : (fun T => ∑' j, F T j) =ᶠ[atTop] fun _ => (0 : ℝ) := by
    filter_upwards [eventually_gt_atTop 0] with T hT
    exact (hsum T hT).tsum_eq
  exact tendsto_nhds_unique (hT.congr' h0') tendsto_const_nhds

end Cesaro

/-! ## Forward invariance on the box -/

section Forward

open Feec.Torus Feec.Constraints HilbertComplex2

/-- `W_k³ = -|ξ_k|² W_k`. -/
theorem waveSymK_cube (k : Z3) (x : Fib) :
    waveSymK k (waveSymK k (waveSymK k x)) = -(‖freq k‖ ^ 2) • waveSymK k x :=
  cube_of_four_of_skew (waveSymK k) (waveSym_skew (freq k)) (waveSym_four (freq k)) x

/-- `exp(t W_k)` is an isometry. -/
theorem norm_exp_waveSymK (k : Z3) (t : ℝ) (u : Fib) : ‖exp (t • waveSymK k) u‖ = ‖u‖ :=
  norm_exp_smul_apply_of_skew (waveSymK k) (waveSym_skew (freq k)) t u

/-- Coefficients of `⟪exp(t W_k) u, v⟫` (`ν = |ξ_k|`): constant part. -/
def coefA (k : Z3) (u v : Fib) : ℝ := ⟪u + (‖freq k‖ ^ 2)⁻¹ • waveSymK k (waveSymK k u), v⟫
/-- Coefficient of `cos(νt)`. -/
def coefB (k : Z3) (u v : Fib) : ℝ := ⟪-(‖freq k‖ ^ 2)⁻¹ • waveSymK k (waveSymK k u), v⟫
/-- Coefficient of `sin(νt)`. -/
def coefC (k : Z3) (u v : Fib) : ℝ := ⟪waveSymK k u, v⟫ / ‖freq k‖

/-- **The fibre flow is trigonometric**: `⟪exp(t W_k) u, v⟫ = a + b cos(νt) + c sin(νt)`,
`ν = |ξ_k|`. -/
theorem inner_exp_waveSymK (k : Z3) (t : ℝ) (u v : Fib) :
    ⟪exp (t • waveSymK k) u, v⟫ = coefA k u v + Real.cos (‖freq k‖ * t) * coefB k u v +
      Real.sin (‖freq k‖ * t) * coefC k u v := by
  by_cases h : ‖freq k‖ = 0
  · have hW : waveSymK k = 0 := ContinuousLinearMap.ext fun x => by
      rw [waveSymK, norm_eq_zero.1 h, waveSym_zero]; rfl
    simp [coefA, coefB, coefC, h, hW]
  · rw [exp_smul_apply_eq _ h (waveSymK_cube k) t u]
    simp only [coefA, coefB, coefC, inner_add_left, real_inner_smul_left]
    ring

/-- `Σ_k ‖u_k‖ ‖v_k‖ < ∞` for `u, v ∈ ℓ²`. -/
theorem summable_norm_mul_L2 {ι F : Type*} [NormedAddCommGroup F] (u v : L2 ι F) :
    Summable fun i => ‖u i‖ * ‖v i‖ := by
  refine Summable.of_nonneg_of_le (fun i => by positivity) (fun i => ?_)
    (((summable_norm_sq_L2 u).add (summable_norm_sq_L2 v)).div_const 2)
  nlinarith [sq_nonneg (‖u i‖ - ‖v i‖)]

/-- **Forward invariance forces stationarity**: if the forward orbit of `x` under the periodic
group stays in `K = {0} × S1 × S2` (`S1`, `S2` as in `mem_Kmax_iff`), then `W_k x̂(k) = 0` for
every mode.

Proof. Fix `k` with `ω = |ξ_k| > 0` and `z ⊥ K`. The function `t ↦ ⟪S(t) x, z⟫` vanishes on
`[0, ∞)` and is the sum over modes of `a_j + b_j cos(ν_j t) + c_j sin(ν_j t)`
(`inner_exp_waveSymK`), with `Σ |terms| ≤ Σ ‖x̂_j‖ ‖ẑ_j‖ < ∞`. Its Cesàro means against
`cos(ωt)` over `[0, T]` vanish, and as `T → ∞` they tend to `½ Σ_{ν_j = ω} b_j`
(`tendsto_cesaro_trig`, dominated convergence for interval integrals and for series). Hence the
trigonometric polynomial `p` with `p̂_j = -ω⁻² W_j² x̂_j` for `ν_j = ω` (the `N_ω`-component of
`x`) is orthogonal to `Kᗮ`, so `p ∈ K ∩ N_ω = 0` (`eq_zero_of_mem_Kc_Nω`), and
`‖W_k x̂_k‖² = -⟪x̂_k, W_k² x̂_k⟫ = 0`. -/
theorem waveSym_eq_zero_of_forward {S1 S2 : Submodule ℝ L2M} [S1.HasOrthogonalProjection]
    [S2.HasOrthogonalProjection] (hS1 : S1 ≤ ParRow 1 ⊓ boxSym ⊓ boxTr)
    (hS2 : S2 ≤ ParRow (-1) ⊓ boxSym ⊓ boxTr) {x : X}
    (hx : ∀ t, 0 ≤ t → periodicGroup.S t x ∈ Kc L2V S1 S2) (k : Z3) :
    waveSymK k (fib x k) = 0 := by
  by_cases h0 : ‖freq k‖ = 0
  · rw [waveSymK, norm_eq_zero.1 h0, waveSym_zero]
  have hω : 0 < ‖freq k‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm h0)
  set ω := ‖freq k‖ with hωdef
  set K := Kc L2V S1 S2 with hKdef
  set S := (finite_freq ω).toFinset with hSdef
  have hmemS : ∀ j, j ∈ S ↔ ‖freq j‖ = ω := fun j => (finite_freq ω).mem_toFinset
  set w : Z3 → Fib := fun j => -(ω ^ 2)⁻¹ • waveSymK j (waveSymK j (fib x j)) with hw
  set p : X := fibIso (∑ j ∈ S, lp.single 2 j (w j)) with hp
  have hpf : ∀ j, fib p j = if j ∈ S then w j else 0 := by
    intro j
    simp only [hp, fib, LinearIsometryEquiv.symm_apply_apply, lp.coeFn_single, lp.coeFn_sum,
      Finset.sum_apply, Finset.sum_pi_single]
  have hω2 : ω ^ 2 ≠ 0 := pow_ne_zero 2 hω.ne'
  -- `p ∈ N_ω`
  have hpN : p ∈ Nω ω := by
    intro j
    rw [hpf]
    split_ifs with hj
    · have hjω := (hmemS j).1 hj
      simp only [hw, _root_.map_smul]
      rw [waveSymK, waveSym_four, ← waveSymK, hjω, smul_smul, smul_smul, mul_comm]
    · simp
  -- `p ⊥ Kᗮ`
  have hpK : p ∈ K := by
    rw [← K.orthogonal_orthogonal, Submodule.mem_orthogonal]
    intro z hz
    set u : Z3 → Fib := fun j => fib x j with hu
    set v : Z3 → Fib := fun j => fib z j with hv
    have hzero := sum_eq_zero_of_forward_trig hω (fun j => ‖freq j‖)
      (fun j => coefA j (u j) (v j)) (fun j => coefB j (u j) (v j)) (fun j => coefC j (u j) (v j))
      (fun j => norm_nonneg _) (fun j => ‖u j‖ * ‖v j‖)
      (summable_norm_mul_L2 (fibIso.symm x) (fibIso.symm z))
      (fun j t => by
        rw [← inner_exp_waveSymK]
        refine (norm_inner_le_norm _ _).trans ?_
        rw [norm_exp_waveSymK])
      (fun t ht => by
        have h := lp.hasSum_inner (𝕜 := ℝ) (fibIso.symm (periodicGroup.S t x)) (fibIso.symm z)
        rw [LinearIsometryEquiv.inner_map_map,
          Submodule.inner_right_of_mem_orthogonal (hx t ht) hz] at h
        refine h.congr_fun fun j => ?_
        change _ = ⟪fibIso.symm (periodicGroup.S t x) j, v j⟫
        rw [periodicGroup_apply, inner_exp_waveSymK])
    rw [tsum_eq_sum (s := S) fun j hj => by
      exact ite_eq_right_of_eq_false _ _ (eq_false fun h => hj ((hmemS j).2 h))] at hzero
    have hfin : ∑ j ∈ S, ⟪w j, v j⟫ = 0 := by
      have e : ∑ j ∈ S, (if ‖freq j‖ = ω then coefB j (u j) (v j) / 2 else 0) =
          (∑ j ∈ S, ⟪w j, v j⟫) / 2 := by
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl fun j hj => ?_
        have hjω := (hmemS j).1 hj
        rw [ite_eq_left_of_eq_true _ _ (eq_true hjω), coefB, hjω]
      rw [e] at hzero
      linarith
    rw [real_inner_comm, ← LinearIsometryEquiv.inner_map_map fibIso.symm, lp.inner_eq_tsum]
    change ∑' j, ⟪fib p j, v j⟫ = 0
    rw [tsum_eq_sum (s := S) fun j hj => by
      rw [hpf, ite_eq_right_of_eq_false _ _ (eq_false hj), inner_zero_left]]
    rw [← hfin]
    refine Finset.sum_congr rfl fun j hj => ?_
    rw [hpf, ite_eq_left_of_eq_true _ _ (eq_true hj)]
  have hp0 := eq_zero_of_mem_Kc_Nω hS1 hS2 hω hpK hpN
  have hwk : w k = 0 := by
    have := hpf k
    rw [hp0, fib_zero, ite_eq_left_of_eq_true _ _ (eq_true ((hmemS k).2 rfl))] at this
    exact this.symm
  have hWW : waveSymK k (waveSymK k (fib x k)) = 0 := by
    have hc : -(ω ^ 2)⁻¹ ≠ 0 := neg_ne_zero.2 (inv_ne_zero hω2)
    exact (smul_eq_zero.1 hwk).resolve_left hc
  have h2 : ⟪waveSymK k (fib x k), waveSymK k (fib x k)⟫ = 0 := by
    rw [waveSymK, waveSym_skew, ← waveSymK, hWW, inner_zero_right, neg_zero]
  rwa [real_inner_self_eq_norm_sq, sq_eq_zero_iff, norm_eq_zero] at h2

/-- **On the box, forward invariance of `K` is full invariance**: for `S1`, `S2` as in
`mem_Kmax_iff`, the forward orbit of `x` stays in `K = {0} × S1 × S2` iff `x ∈ K*` iff `x ∈ K` is
stationary.

Correction: `Feec.Ch4.BoundedSalvageMax` notes that in general forward propagation is weaker
than membership in `K*`; on the box with the thesis' boundary conditions the two coincide,
because the spectrum is discrete and orbits are almost periodic. -/
theorem forward_iff_mem_Kmax {S1 S2 : Submodule ℝ L2M} [S1.HasOrthogonalProjection]
    [S2.HasOrthogonalProjection] (hS1 : S1 ≤ ParRow 1 ⊓ boxSym ⊓ boxTr)
    (hS2 : S2 ≤ ParRow (-1) ⊓ boxSym ⊓ boxTr) (x : X) :
    (∀ t, 0 ≤ t → periodicGroup.S t x ∈ Kc L2V S1 S2) ↔
      x ∈ Kmax periodicGroup (Kc L2V S1 S2) := by
  refine ⟨fun hx => ?_, fun hx t _ => hx t⟩
  rw [mem_Kmax_iff hS1 hS2]
  have hs := stationary_of_waveSym_eq_zero (waveSym_eq_zero_of_forward hS1 hS2 hx)
  refine ⟨?_, hs⟩
  have := hx 0 le_rfl
  rwa [hs 0] at this

/-- **The thesis' `K` on the box, forward in time**: the forward orbit of `x` stays in
`K = {0} × L²(TSD) × L²(TSD)` iff `x = (0, 0, B₀)` with `B₀ ∈ L²(TSD)` curl-free. So no
non-stationary datum propagates TSD even for `t ≥ 0`.

See [QuennevilleBelair2015, §4.10, Prop 4.17]. -/
theorem forward_boxTSD_iff (x : X) :
    (∀ t, 0 ≤ t → periodicGroup.S t x ∈ Kc L2V (boxTSD 1) (boxTSD (-1))) ↔
      ∃ B ∈ boxTSD (-1), (∀ k, curlSym (freq k) (B k) = 0) ∧ x = ini L2V 0 B := by
  rw [forward_iff_mem_Kmax (boxTSD_le 1) (boxTSD_le (-1)), mem_Kmax_boxTSD_iff]

/-- **Forward invariance on the box complex, for any group**: for every orthogonal group `G`
generated by `-L` of `thesisBoxComplex`, the forward orbit of `x` stays in
`K = {0} × L²(TSD) × L²(TSD)` iff `x ∈ K*`, i.e. iff `x ∈ K` is stationary
(`thesisBox_mem_Kmax_iff`). -/
theorem thesisBox_forward_iff (G : UnitaryGroupGenerator (-thesisBoxComplex.waveOp))
    (x : Tot rowV.fix rowE.fix rowB.fix) :
    (∀ t, 0 ≤ t → G.S t x ∈ Kc rowV.fix boxTSD1 boxTSD2) ↔
      x ∈ Kmax G (Kc rowV.fix boxTSD1 boxTSD2) := by
  have hG : ∀ t y, incl rowV rowE rowB (G.S t y) = periodicGroup.S t (incl rowV rowE rowB y) :=
    fun t y => incl_group G periodicGroup t y
  refine ⟨fun hx => ?_, fun hx t _ => hx t⟩
  have hfw : ∀ t, 0 ≤ t → periodicGroup.S t (incl rowV rowE rowB x) ∈
      Kc L2V (boxTSD 1) (boxTSD (-1)) := fun t ht => by
    rw [← hG]; exact (mem_Kc_box_iff _).1 (hx t ht)
  rw [forward_iff_mem_Kmax (boxTSD_le 1) (boxTSD_le (-1)), mem_Kmax_iff (boxTSD_le 1)
    (boxTSD_le (-1))] at hfw
  rw [thesisBox_mem_Kmax_iff]
  refine ⟨by simpa [G.map_zero] using hx 0 le_rfl, fun t => incl_injective ?_⟩
  rw [hG, hfw.2]

end Forward

end Feec.Box
