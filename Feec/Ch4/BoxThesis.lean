module

public import Feec.Ch4.BoxMirror
public import Feec.Ch4.BoxStatic

/-!
# The box complex with the thesis' boundary conditions, and its `K*`

`Feec.Ch4.Box` computes the largest invariant subspace `K*` of
`K = {0} × L²(TSD) × L²(TSD)` on the box `Q = (0, ½)³` for the periodic group restricted to the
row-wise parity space. This file builds the box model as a Hilbert complex in its own right and
states the result for *every* orthogonal group generated by its Hodge wave operator (in
particular Stone's, `Feec.HilbertComplex2.waveGroup`).

## Contents

* `rowV`, `rowE`, `rowB`: the row-wise reflection actions (`σ` odd; `E_{ab}` even in `x_b` and
  odd otherwise; `B_{ab}` odd in `x_b` and even otherwise), with fixed spaces `ParV`, `ParRow 1`,
  `ParRow (-1)` (`mem_rowE_fix`, `mem_rowB_fix`, `mem_rowV_fix`).
* `thesisBoxComplex`: the complex `H̊¹(V) → H̊(curl; M) → L²(M)` on the box, i.e. the periodic
  complex restricted to the parity subspaces (`Feec.Box.resComplex`); the boundary conditions
  `σ = 0`, `E_a × n = 0` are encoded by the parities.
* **`thesisBox_mem_Kmax_iff`**: for every group `G` generated by `-L` of `thesisBoxComplex`, a
  datum lies in `K*` iff it lies in `K` and is stationary; **`thesisBox_mem_Kmax_iff'`**: iff it
  is `(0, 0, B₀)` with `B₀ ∈ L²(TSD)` curl-free. **`thesisBox_Kmax_ne_bot`**: `K* ≠ 0` (it contains
  `diag(1, -1, 0)`).

The identification of the parity spaces with the Sobolev spaces of the box (traces) is not
proved; see `Feec.Ch4.Box`.

## References

* [QuennevilleBelair2015], §4.10 (Prop 4.17)
* [Pazy1983], §1.10 (groups and generators)
-/

@[expose] public noncomputable section

open scoped RealInnerProductSpace
open LinearPMap Set

namespace Feec.Box

open Feec.Torus Feec.Constraints HilbertComplex2

/-! ## The row-wise reflection actions -/

/-- The real sign `colSign`. -/
def colSignR (i b : Fin 3) : ℝ := if i = b then 1 else -1

theorem colSign_eq (i b : Fin 3) : colSign i b = (colSignR i b : ℂ) := by
  unfold colSign colSignR; split_ifs <;> simp

theorem colSignR_mul_self (i b : Fin 3) : colSignR i b * colSignR i b = 1 := by
  unfold colSignR; split_ifs <;> norm_num

/-- `σ ↦ -σ` (Dirichlet: every component odd). -/
def rowVf : Refl3 Vec3 where
  R _ := -ContinuousLinearMap.id ℝ Vec3
  invol _ _ := by simp
  inner_map _ _ _ := by simp
  comm _ _ _ := by simp

/-- `M ↦ ε colSign ⊙ M` (row-wise parities). -/
def rowMf (ε : ℝ) (hε : ε * ε = 1) : Refl3 Mat3 where
  R i := rowSgn (ε : ℂ) i
  invol i M := by
    ext ⟨a, b⟩
    simp only [rowSgn_apply, colSign_eq, ← mul_assoc]
    have : (ε : ℂ) * colSignR i b * ε * colSignR i b = 1 := by
      have h := colSignR_mul_self i b
      rw [show (ε : ℂ) * colSignR i b * ε * colSignR i b =
        ((ε * ε * (colSignR i b * colSignR i b) : ℝ) : ℂ) by push_cast; ring, hε, h]
      simp
    rw [this, one_mul]
  inner_map i M N := by
    simp only [inner_mat, rowSgn_apply, colSign_eq]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    have h := colSignR_mul_self i b
    have e : ∀ z : ℂ, (ε : ℂ) * (colSignR i b : ℂ) * z = ((ε * colSignR i b : ℝ) : ℂ) * z :=
      fun z => by push_cast; ring
    rw [e, e]
    simp only [Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
      sub_zero, add_zero]
    have h2 : (ε * colSignR i b) * (ε * colSignR i b) = 1 := by
      linear_combination (colSignR i b * colSignR i b) * hε + h
    linear_combination ((M (a, b)).re * (N (a, b)).re + (M (a, b)).im * (N (a, b)).im) * h2
  comm i j M := by ext ⟨a, b⟩; simp only [rowSgn_apply]; ring

theorem one_mul_one' : (1 : ℝ) * 1 = 1 := one_mul 1
theorem neg_one_mul_neg_one' : (-1 : ℝ) * -1 = 1 := by norm_num

/-- The Dirichlet action on `L²(V)`. -/
def rowV : Refl3 L2V := rowVf.lift
/-- The electric (row-wise) action on `L²(M)`. -/
def rowE : Refl3 L2M := (rowMf 1 one_mul_one').lift
/-- The magnetic (row-wise) action on `L²(M)`. -/
def rowB : Refl3 L2M := (rowMf (-1) neg_one_mul_neg_one').lift

theorem rowMf_R_eq (ε : ℝ) (hε : ε * ε = 1) (i : Fin 3) (M N : Mat3) :
    (rowMf ε hε).R i M = N ↔ M = (rowMf ε hε).R i N := by
  constructor
  · rintro rfl; rw [(rowMf ε hε).invol]
  · rintro rfl; rw [(rowMf ε hε).invol]

/-- The fixed space of `rowE` is `ParRow 1`. -/
theorem mem_rowE_fix {A : L2M} : A ∈ rowE.fix ↔ A ∈ ParRow 1 := by
  constructor
  · intro h i k a b
    have h1 := congrArg (fun B : L2M => B k (a, b)) (h i)
    change rowSgn ((1 : ℝ) : ℂ) i (A (refl i k)) (a, b) = A k (a, b) at h1
    have h2 := congrArg (fun B : L2M => B (refl i k) (a, b)) (h i)
    change rowSgn ((1 : ℝ) : ℂ) i (A (refl i (refl i k))) (a, b) = A (refl i k) (a, b) at h2
    rw [refl_refl, rowSgn_apply] at h2
    rw [← h2]; push_cast; ring
  · intro h i
    refine lp.ext (funext fun k => ?_)
    ext ⟨a, b⟩
    change rowSgn ((1 : ℝ) : ℂ) i (A (refl i k)) (a, b) = A k (a, b)
    rw [rowSgn_apply, h i k a b, colSign_eq]
    have := colSignR_mul_self i b
    rw [show ((1 : ℝ) : ℂ) * (colSignR i b : ℂ) * (1 * (colSignR i b : ℂ) * A k (a, b)) =
      ((colSignR i b * colSignR i b : ℝ) : ℂ) * A k (a, b) by push_cast; ring, this]
    simp

/-- The fixed space of `rowB` is `ParRow (-1)`. -/
theorem mem_rowB_fix {A : L2M} : A ∈ rowB.fix ↔ A ∈ ParRow (-1) := by
  constructor
  · intro h i k a b
    have h2 := congrArg (fun B : L2M => B (refl i k) (a, b)) (h i)
    change rowSgn ((-1 : ℝ) : ℂ) i (A (refl i (refl i k))) (a, b) = A (refl i k) (a, b) at h2
    rw [refl_refl, rowSgn_apply] at h2
    rw [← h2]; push_cast; ring
  · intro h i
    refine lp.ext (funext fun k => ?_)
    ext ⟨a, b⟩
    change rowSgn ((-1 : ℝ) : ℂ) i (A (refl i k)) (a, b) = A k (a, b)
    rw [rowSgn_apply, h i k a b, colSign_eq]
    have := colSignR_mul_self i b
    rw [show ((-1 : ℝ) : ℂ) * (colSignR i b : ℂ) * (-1 * (colSignR i b : ℂ) * A k (a, b)) =
      ((colSignR i b * colSignR i b : ℝ) : ℂ) * A k (a, b) by push_cast; ring, this]
    simp

/-- The fixed space of `rowV` is `ParV`. -/
theorem mem_rowV_fix {σ : L2V} : σ ∈ rowV.fix ↔ σ ∈ ParV := by
  constructor
  · intro h i k a
    have h2 := congrArg (fun B : L2V => B (refl i k) a) (h i)
    change (-ContinuousLinearMap.id ℝ Vec3) (σ (refl i (refl i k))) a = σ (refl i k) a at h2
    rw [refl_refl] at h2
    rw [← h2]; simp
  · intro h i
    refine lp.ext (funext fun k => ?_)
    ext a
    change (-ContinuousLinearMap.id ℝ Vec3) (σ (refl i k)) a = σ k a
    simp [h i k a]

/-- `grad` intertwines the row-wise actions. -/
theorem gradSym_row (i : Fin 3) (k : Z3) (u : Vec3) :
    gradSym (freq (refl i k)) (rowVf.R i u) = (rowMf 1 one_mul_one').R i (gradSym (freq k) u) := by
  ext ⟨a, b⟩
  change gradSym _ (-u) (a, b) = rowSgn _ i _ (a, b)
  simp only [gradSym_apply, rowSgn_apply, freq_refl_apply, PiLp.neg_apply, colSign]
  by_cases h : b = i
  · subst h; simp only [↓reduceIte]; push_cast; ring
  · have h' : ¬ i = b := fun e => h e.symm
    simp only [h, h', ↓reduceIte]; push_cast; ring

/-- `curl` intertwines the row-wise actions (electric to magnetic). -/
theorem curlSym_row (i : Fin 3) (k : Z3) (M : Mat3) :
    curlSym (freq (refl i k)) ((rowMf 1 one_mul_one').R i M) =
      (rowMf (-1) neg_one_mul_neg_one').R i (curlSym (freq k) M) := by
  ext ⟨a, b⟩
  change curlSym _ (rowSgn _ i M) (a, b) = rowSgn _ i _ (a, b)
  simp only [curlSym_apply, jM_apply, curlR_apply, cross, rowSgn_apply, freq_refl_apply]
  fin_cases i <;> fin_cases b <;> simp [colSign] <;> ring

theorem intertwines_grad_row : Intertwines rowV rowE periodicComplex.d0 :=
  intertwines_mulOp rowVf (rowMf 1 one_mul_one') (fun k => gradSym (freq k))
    fun i k u => gradSym_row i k u

theorem intertwines_curl_row : Intertwines rowE rowB periodicComplex.d1 :=
  intertwines_mulOp (rowMf 1 one_mul_one') (rowMf (-1) neg_one_mul_neg_one')
    (fun k => curlSym (freq k)) fun i k M => curlSym_row i k M

/-- **The box complex with the thesis' boundary conditions**: `H̊¹(V) → H̊(curl; M) → L²(M)` on
`Q`, as the periodic complex restricted to the row-wise parity subspaces. -/
def thesisBoxComplex : HilbertComplex2 rowV.fix rowE.fix rowB.fix :=
  resComplex periodicComplex rowV rowE rowB intertwines_grad_row intertwines_curl_row

/-- `L²(TSD)` on the box, electric slot. -/
abbrev boxTSD1 : Submodule ℝ rowE.fix := (boxTSD 1).comap rowE.fix.subtype
/-- `L²(TSD)` on the box, magnetic slot. -/
abbrev boxTSD2 : Submodule ℝ rowB.fix := (boxTSD (-1)).comap rowB.fix.subtype

instance : boxTSD1.HasOrthogonalProjection := by
  have hc : _root_.IsClosed (boxTSD1 : Set rowE.fix) :=
    (isClosed_boxTSD 1).preimage continuous_subtype_val
  have : CompleteSpace boxTSD1 := hc.completeSpace_coe
  infer_instance

instance : boxTSD2.HasOrthogonalProjection := by
  have hc : _root_.IsClosed (boxTSD2 : Set rowB.fix) :=
    (isClosed_boxTSD (-1)).preimage continuous_subtype_val
  have : CompleteSpace boxTSD2 := hc.completeSpace_coe
  infer_instance

theorem mem_Kc_box_iff (y : Tot rowV.fix rowE.fix rowB.fix) :
    y ∈ Kc rowV.fix boxTSD1 boxTSD2 ↔
      incl rowV rowE rowB y ∈ Kc L2V (boxTSD 1) (boxTSD (-1)) := by
  have e := tot_incl (G0 := rowV) (G1 := rowE) (G2 := rowB) y
  rw [mem_Kc (W0 := rowV.fix) (W1 := rowE.fix) (W2 := rowB.fix),
    mem_Kc (W0 := L2V) (W1 := L2M) (W2 := L2M)]
  simp only [e, ZeroMemClass.coe_eq_zero]
  exact Iff.rfl

/-- **`K*` on the box with the thesis' boundary conditions, for any group**: for every
orthogonal group `G` generated by `-L` of `thesisBoxComplex` (e.g. Stone's,
`thesisBoxComplex.waveGroup`), a datum lies in the largest `G`-invariant subspace of
`K = {0} × L²(TSD) × L²(TSD)` iff it lies in `K` and is stationary.

See [QuennevilleBelair2015, §4.10, Prop 4.17]. -/
theorem thesisBox_mem_Kmax_iff (G : UnitaryGroupGenerator (-thesisBoxComplex.waveOp))
    (x : Tot rowV.fix rowE.fix rowB.fix) :
    x ∈ Kmax G (Kc rowV.fix boxTSD1 boxTSD2) ↔
      x ∈ Kc rowV.fix boxTSD1 boxTSD2 ∧ ∀ t, G.S t x = x := by
  have hG : ∀ t y, incl rowV rowE rowB (G.S t y) = periodicGroup.S t (incl rowV rowE rowB y) :=
    fun t y => incl_group G periodicGroup t y
  constructor
  · intro hx
    have hK : incl rowV rowE rowB x ∈ Kmax periodicGroup (Kc L2V (boxTSD 1) (boxTSD (-1))) :=
      fun t => by rw [← hG]; exact (mem_Kc_box_iff _).1 (hx t)
    obtain ⟨-, hs⟩ := (mem_Kmax_iff (boxTSD_le 1) (boxTSD_le (-1)) _).1 hK
    exact ⟨Kmax_le hx, fun t => incl_injective (by rw [hG, hs])⟩
  · rintro ⟨hK, hs⟩ t
    rw [hs t]; exact hK

/-- **`K*` on the box, explicitly**: `x ∈ K*` iff `x = (0, 0, B₀)` with `B₀ ∈ L²(TSD)` curl-free
(on the Fourier side, `curl_ξ B̂₀(k) = 0`). -/
theorem thesisBox_mem_Kmax_iff' (G : UnitaryGroupGenerator (-thesisBoxComplex.waveOp))
    (x : Tot rowV.fix rowE.fix rowB.fix) :
    x ∈ Kmax G (Kc rowV.fix boxTSD1 boxTSD2) ↔
      ∃ B ∈ boxTSD (-1), (∀ k, curlSym (freq k) (B k) = 0) ∧
        incl rowV rowE rowB x = ini L2V 0 B := by
  have hG : ∀ t y, incl rowV rowE rowB (G.S t y) = periodicGroup.S t (incl rowV rowE rowB y) :=
    fun t y => incl_group G periodicGroup t y
  have e : x ∈ Kmax G (Kc rowV.fix boxTSD1 boxTSD2) ↔
      incl rowV rowE rowB x ∈ Kmax periodicGroup (Kc L2V (boxTSD 1) (boxTSD (-1))) := by
    refine forall_congr' fun t => ?_
    rw [mem_Kc_box_iff, hG]
  rw [e, mem_Kmax_boxTSD_iff]

/-- **`K*` is not zero**: it contains `(0, 0, diag(1, -1, 0))`. -/
theorem thesisBox_Kmax_ne_bot (G : UnitaryGroupGenerator (-thesisBoxComplex.waveOp)) :
    Kmax G (Kc rowV.fix boxTSD1 boxTSD2) ≠ ⊥ := by
  intro hbot
  have hBm : staticB ∈ rowB.fix := mem_rowB_fix.2 staticB_mem_ParRow
  have hx : ini rowV.fix (0 : rowE.fix) ⟨staticB, hBm⟩ ∈ Kmax G (Kc rowV.fix boxTSD1 boxTSD2) := by
    rw [thesisBox_mem_Kmax_iff']
    refine ⟨staticB, staticB_mem_boxTSD, curlSym_staticB, ?_⟩
    apply (tot L2V L2M L2M).injective
    have e := tot_incl (G0 := rowV) (G1 := rowE) (G2 := rowB)
      (ini rowV.fix (0 : rowE.fix) ⟨staticB, hBm⟩)
    simp only [e, tot_ini]
    rfl
  rw [hbot, Submodule.mem_bot] at hx
  have := congrArg (fun y => ((tot rowV.fix rowE.fix rowB.fix y).2.2 : L2M)) hx
  simp only [tot_ini, _root_.map_zero, Prod.snd_zero, ZeroMemClass.coe_zero] at this
  exact staticB_ne_zero this

end Feec.Box
