module

public import Mathlib.Analysis.Calculus.ParametricIntervalIntegral
public import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus
public import Feec.Ch4.Restriction
public import Feec.Evolution.Forcing

/-!
# Duhamel's formula for a unitary group (Thesis Thm 4.3, inhomogeneous case)

For a strongly continuous orthogonal group `S` generated by `A` (`Feec.UnitaryGroupGenerator A`)
and a forcing `F ∈ C(ℝ; D(A))`, the Duhamel formula
`U(t) = S(t) U₀ + S(t) ∫₀ᵗ S(-s) F(s) ds` is a classical solution of `U' = A U + F`.
Nothing here depends on a particular operator: the periodic Hodge wave group
(`Feec.Torus.periodicGroup`) and the Stone groups of `Feec.Ch4.Stone` both use it.

## Main results

* `UnitaryGroupGenerator.continuous_uncurry`: `(t, x) ↦ S t x` is jointly continuous;
* `UnitaryGroupGenerator.hasDerivAt_apply_comp`: product rule for `τ ↦ S τ (y τ)`;
* `UnitaryGroupGenerator.integral_mem_domain`: `∫₀ᵗ S(-s) F(s) ds ∈ D(A)`, and `A` commutes
  with the integral (differentiation under the integral sign);
* **`UnitaryGroupGenerator.duhamel`**: Duhamel's formula solves `U' = A U + F` everywhere;
* `WellPosedClassical.mono`: classical well-posedness is antitone in the forcing class;
* **`UnitaryGroupGenerator.wellPosedClassical_forcing`**: Thm 4.3 with forcing in
  `ForcingDL A T`, i.e. `WellPosedClassical A T (ForcingDL A T)`.

Correction: the thesis' forcing class is `C([0,T]; X) ∩ (W^{1,1}(0,T; X) ∪ L¹(0,T; D(A)))`
(`ForcingClass.admissible`, `Feec.Evolution.Forcing`); `ForcingDL = ForcingClass.contDomain` is
its subclass `C([0,T]; D(A))`. The full class is treated in `Feec.Ch4.StoneForcing`.

## References

* [QuennevilleBelair2015], §4.3 (Thm 4.3)
* [Pazy1983], §1.10 (unitary groups), §4.2 (Duhamel's formula)
* [CazenaveHaraux1998], Prop 4.1.6 (the result cited by the thesis for Thm 4.3)
-/

@[expose] public noncomputable section

open scoped RealInnerProductSpace Topology
open Set Filter

namespace Feec

section Duhamel

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  {A : E →ₗ.[ℝ] E} (G : UnitaryGroupGenerator A)

omit [CompleteSpace E] in
/-- A strongly continuous isometric group is jointly continuous: `(t, x) ↦ S t x`. -/
theorem UnitaryGroupGenerator.continuous_uncurry :
    Continuous fun p : ℝ × E => G.S p.1 p.2 := by
  rw [continuous_iff_continuousAt]
  rintro ⟨t₀, x₀⟩
  have h1 : Tendsto (fun p : ℝ × E => G.S p.1 x₀) (𝓝 (t₀, x₀)) (𝓝 (G.S t₀ x₀)) :=
    ((G.continuous_apply x₀).comp continuous_fst).continuousAt
  have h2 : Tendsto (fun p : ℝ × E => G.S p.1 (p.2 - x₀)) (𝓝 (t₀, x₀)) (𝓝 0) := by
    refine squeeze_zero_norm (fun p => (G.norm_map _ _).le) ?_
    have : Tendsto (fun p : ℝ × E => p.2 - x₀) (𝓝 (t₀, x₀)) (𝓝 (x₀ - x₀)) :=
      (continuous_snd.sub continuous_const).continuousAt
    simpa using this.norm
  have := h2.add h1
  rw [zero_add] at this
  exact this.congr fun p => by rw [← _root_.map_add, sub_add_cancel]

omit [CompleteSpace E] in
/-- Product rule for an orbit along a differentiable curve: if `y' (t)` exists and
`τ ↦ S τ (y t)` has derivative `D` at `t`, then `τ ↦ S τ (y τ)` has derivative `S t y' + D`. -/
theorem UnitaryGroupGenerator.hasDerivAt_apply_comp {y : ℝ → E} {y' D : E} {t : ℝ}
    (hy : HasDerivAt y y' t) (hD : HasDerivAt (fun τ => G.S τ (y t)) D t) :
    HasDerivAt (fun τ => G.S τ (y τ)) (G.S t y' + D) t := by
  have hf : HasDerivAt (fun τ => G.S τ (y τ - y t)) (G.S t y') t := by
    rw [hasDerivAt_iff_tendsto_slope]
    have hp : Tendsto (fun τ => (τ, slope y t τ)) (𝓝[≠] t) (𝓝 (t, y')) :=
      (tendsto_nhdsWithin_of_tendsto_nhds tendsto_id).prodMk_nhds
        (hasDerivAt_iff_tendsto_slope.1 hy)
    refine ((G.continuous_uncurry.tendsto (t, y')).comp hp).congr fun τ => ?_
    simp only [Function.comp_apply, slope_def_module, sub_self, _root_.map_zero, sub_zero,
      _root_.map_smul]
  exact (hf.add hD).congr_of_eventuallyEq
    (Eventually.of_forall fun τ => by simp only [Pi.add_apply]; rw [← _root_.map_add, sub_add_cancel])

/-- `∫₀ᵗ S(-s) F(s) ds ∈ D(A)` with `A ∫₀ᵗ S(-s) F(s) ds = ∫₀ᵗ S(-s) A F(s) ds`, for
`F ∈ C(ℝ; D(A))` (differentiation under the integral sign). -/
theorem UnitaryGroupGenerator.integral_mem_domain {F : ℝ → E}
    (hFD : ∀ s, F s ∈ A.domain) (hF : Continuous F) (hAF : Continuous fun s => A ⟨F s, hFD s⟩)
    (t : ℝ) : ∃ h : (∫ s in (0 : ℝ)..t, G.S (-s) (F s)) ∈ A.domain,
      A ⟨_, h⟩ = ∫ s in (0 : ℝ)..t, G.S (-s) (A ⟨F s, hFD s⟩) := by
  have hc : ∀ h : ℝ, Continuous fun s => G.S (h + -s) (F s) := fun h =>
    G.continuous_uncurry.comp ((continuous_const.add continuous_neg).prodMk hF)
  have hc' : Continuous fun s => G.S (0 + -s) (A ⟨F s, hFD s⟩) :=
    G.continuous_uncurry.comp ((continuous_const.add continuous_neg).prodMk hAF)
  have key := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := MeasureTheory.volume) (a := 0) (b := t) (x₀ := (0 : ℝ))
    (F := fun h s => G.S (h + -s) (F s))
    (F' := fun h s => G.S (h + -s) (A ⟨F s, hFD s⟩))
    (bound := fun s => ‖A ⟨F s, hFD s⟩‖) (s := univ) univ_mem
    (Eventually.of_forall fun h => (hc h).aestronglyMeasurable)
    ((hc 0).intervalIntegrable _ _) hc'.aestronglyMeasurable
    (Eventually.of_forall fun s _ h _ => (G.norm_map _ _).le)
    (hAF.norm.intervalIntegrable _ _)
    (Eventually.of_forall fun s _ h _ =>
      (G.hasDerivAt_apply ⟨F s, hFD s⟩ (h + -s)).comp_add_const h (-s))
  have hS : ∀ h : ℝ, G.S h (∫ s in (0 : ℝ)..t, G.S (-s) (F s)) =
      ∫ s in (0 : ℝ)..t, G.S (h + -s) (F s) := fun h => by
    rw [← (G.S h).intervalIntegral_comp_comm]
    · simp only [G.map_add, mul_apply_eq_comp]
    · simpa using (hc 0).intervalIntegrable 0 t
  have hd : HasDerivAt (fun h => G.S h (∫ s in (0 : ℝ)..t, G.S (-s) (F s)))
      (∫ s in (0 : ℝ)..t, G.S (-s) (A ⟨F s, hFD s⟩)) 0 := by
    have := key.2
    simp only [zero_add] at this
    exact this.congr_of_eventuallyEq (Eventually.of_forall hS)
  have hmem := (G.mem_domain_iff _).2 hd.differentiableAt
  exact ⟨hmem, (G.hasDerivAt_zero ⟨_, hmem⟩).unique hd⟩

/-- **Duhamel's formula** (Thesis Thm 4.3, inhomogeneous case, for `F ∈ C(ℝ; D(A))`):
`U(t) = S(t) U₀ + S(t) ∫₀ᵗ S(-s) F(s) ds` lies in `D(A)`, `t ↦ A U(t)` is continuous, and
`U' = A U + F` everywhere. -/
theorem UnitaryGroupGenerator.duhamel {F : ℝ → E} (hFD : ∀ s, F s ∈ A.domain)
    (hF : Continuous F) (hAF : Continuous fun s => A ⟨F s, hFD s⟩) (U₀ : A.domain) :
    ∃ hU : ∀ t, G.S t U₀ + G.S t (∫ s in (0 : ℝ)..t, G.S (-s) (F s)) ∈ A.domain,
      Continuous (fun t => A ⟨_, hU t⟩) ∧
      ∀ t, HasDerivAt (fun τ => G.S τ U₀ + G.S τ (∫ s in (0 : ℝ)..τ, G.S (-s) (F s)))
        (A ⟨_, hU t⟩ + F t) t := by
  set w : ℝ → E := fun t => ∫ s in (0 : ℝ)..t, G.S (-s) (F s) with hw_def
  have hg : Continuous fun s => G.S (-s) (F s) :=
    G.continuous_uncurry.comp (continuous_neg.prodMk hF)
  have hg' : Continuous fun s => G.S (-s) (A ⟨F s, hFD s⟩) :=
    G.continuous_uncurry.comp (continuous_neg.prodMk hAF)
  have hw : ∀ t, HasDerivAt w (G.S (-t) (F t)) t := fun t =>
    (hg.integral_hasStrictDerivAt 0 t).hasDerivAt
  have hz : Continuous fun t => ∫ s in (0 : ℝ)..t, G.S (-s) (A ⟨F s, hFD s⟩) :=
    continuous_iff_continuousAt.2 fun t => (hg'.integral_hasStrictDerivAt 0 t).hasDerivAt.continuousAt
  choose mem hA using G.integral_mem_domain hFD hF hAF
  have hU : ∀ t, G.S t U₀ + G.S t (w t) ∈ A.domain := fun t =>
    A.domain.add_mem (G.mem_domain_apply U₀ t) (G.mem_domain_apply ⟨w t, mem t⟩ t)
  have hval : ∀ t, A ⟨_, hU t⟩ = G.S t (A U₀) +
      G.S t (∫ s in (0 : ℝ)..t, G.S (-s) (A ⟨F s, hFD s⟩)) := fun t => by
    have e : (⟨_, hU t⟩ : A.domain) = ⟨_, G.mem_domain_apply U₀ t⟩ +
        ⟨_, G.mem_domain_apply ⟨w t, mem t⟩ t⟩ := rfl
    rw [e, LinearPMap.map_add, G.apply_comm, G.apply_comm, hA t]
  refine ⟨hU, ?_, fun t => ?_⟩
  · rw [show (fun t => A ⟨_, hU t⟩) = _ from funext hval]
    exact (G.continuous_apply _).add (G.continuous_uncurry.comp (continuous_id.prodMk hz))
  · have h1 := G.hasDerivAt_apply U₀ t
    have h2 := G.hasDerivAt_apply_comp (hw t) (G.hasDerivAt_apply ⟨w t, mem t⟩ t)
    have hinv : G.S t (G.S (-t) (F t)) = F t := by
      have := congrArg (fun B : E →L[ℝ] E => B (F t)) (G.map_add t (-t))
      simp only [add_neg_cancel, G.map_zero, one_apply_eq_self,
        mul_apply_eq_comp] at this
      exact this.symm
    convert h1.add h2 using 1
    rw [hval, hinv, hA t]
    abel

omit [CompleteSpace E] in
/-- `WellPosedClassical` is antitone in the forcing class. -/
theorem WellPosedClassical.mono {T : ℝ} {Adm Adm' : (ℝ → E) → Prop}
    (h : WellPosedClassical A T Adm) (hle : ∀ F, Adm' F → Adm F) : WellPosedClassical A T Adm' :=
  fun U₀ hU₀ F hF => h U₀ hU₀ F (hle F hF)

include G in
/-- **Thesis Thm 4.3 (existence) from a unitary group, inhomogeneous case**: for
`U₀ ∈ D(A)` and `F ∈ C([0,T]; D(A))` there is a classical solution
`U ∈ C⁰([0,T]; D(A)) ∩ C¹([0,T]; X)` of `U' = A U + F`, `U(0) = U₀` (Duhamel's formula).

Correction: the thesis' forcing class is `C([0,T]; X) ∩ (W^{1,1}(0,T; X) ∪ L¹(0,T; D(A)))`;
this covers its subclass `C([0,T]; D(A))`.
See [QuennevilleBelair2015, Thm 4.3]; cf. [Pazy1983, §4.2], [CazenaveHaraux1998, Prop 4.1.6]. -/
theorem UnitaryGroupGenerator.wellPosedClassical_forcing (T : ℝ) :
    WellPosedClassical A T (ForcingDL A T) := by
  rintro U₀ hU₀ F ⟨hFD, hFc, H, hHc, hH⟩
  by_cases hT : 0 ≤ T
  · set P := projIcc 0 T hT
    have hFD' : ∀ s, F (P s) ∈ A.domain := fun s => hFD _ (P s).2
    have hF' : Continuous fun s => F (P s) :=
      hFc.comp_continuous (continuous_subtype_val.comp continuous_projIcc) fun s => (P s).2
    have hAF' : Continuous fun s => A ⟨F (P s), hFD' s⟩ :=
      (hHc.comp_continuous (continuous_subtype_val.comp continuous_projIcc) fun s => (P s).2).congr
        fun s => (hH _ (P s).2).symm
    obtain ⟨hU, hc, hd⟩ := G.duhamel hFD' hF' hAF' ⟨U₀, hU₀⟩
    have hP : ∀ t ∈ Icc 0 T, F (P t) = F t := fun t ht => by
      simp only [P, projIcc_of_mem hT ht]
    refine ⟨_, ⟨fun t _ => hU t, fun t ht => ?_, ?_⟩, ⟨_, hc.continuousOn, fun _ _ => rfl⟩,
      ⟨_, hc.continuousOn.add hFc, fun _ _ => rfl⟩⟩
    · rw [← hP t ht]; exact (hd t).hasDerivWithinAt
    · simp [G.map_zero]
  · have hE : Icc (0 : ℝ) T = ∅ := Icc_eq_empty (by linarith)
    refine ⟨fun _ => U₀, ⟨fun t ht => ?_, fun t ht => ?_, rfl⟩, ⟨0, ?_, fun t ht => ?_⟩,
      ⟨0, ?_, fun t ht => ?_⟩⟩ <;>
      first | (rw [hE] at ht; exact absurd ht (Set.notMem_empty t)) |
        (rw [hE]; exact continuousOn_empty _)

end Duhamel

end Feec
