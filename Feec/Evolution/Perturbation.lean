module

public import Feec.Semigroup.Perturbation
public import Feec.Evolution.Duhamel

/-!
# Uniqueness in the bounded perturbation theorem

For a strongly continuous semigroup `G` with generator `A` and a bounded operator `B`,
`G.perturb B` (`Feec.Semigroup.Perturbation`) is generated by `B +ᵥ A`. Here, by Duhamel's
formula, it is the only such semigroup:

* **`C0Semigroup.eqOn_perturb`**: every strongly continuous semigroup generated by `B +ᵥ A`
  agrees with `G.perturb B` for `t ≥ 0`;
* **`C0Semigroup.existsUnique_generator_eq_vadd`**: the bounded perturbation theorem, existence
  and uniqueness;
* `C0Semigroup.eqOn_of_generator_eq`: the case `B = 0`, a semigroup is determined by its
  generator.

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §3.1 (Thm 3.1.1)
* [K.-J. Engel, R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*][EngelNagel2000],
  §III.1 (Thm III.1.3)

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology MeasureTheory LinearPMap

@[expose] public noncomputable section

namespace Feec

namespace C0Semigroup

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E] [CompleteSpace E]
  [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] (G : C0Semigroup 𝕜 E) (B : E →L[𝕜] E)

/-- **Uniqueness**: every strongly continuous semigroup generated by `A + B` agrees with
`G.perturb B` for `t ≥ 0`. -/
theorem eqOn_perturb {G' : C0Semigroup 𝕜 E}
    (h : G'.generator = (B : E →ₗ[𝕜] E) +ᵥ G.generator) :
    EqOn G'.S (G.perturb B).S (Ici 0) := by
  have hdom : ∀ y, y ∈ G'.generator.domain ↔ y ∈ G.generator.domain := fun y => by
    rw [h, vadd_domain]
  have happ : ∀ y (hy : y ∈ G'.generator.domain),
      G'.generator ⟨y, hy⟩ = B y + G.generator ⟨y, (hdom y).1 hy⟩ := by
    have : ∀ (T : E →ₗ.[𝕜] E) (e : T = (B : E →ₗ[𝕜] E) +ᵥ G.generator) y (hy : y ∈ T.domain),
        T ⟨y, hy⟩ = B y + G.generator ⟨y, by rw [e] at hy; exact hy⟩ := by
      rintro T rfl y hy; rfl
    exact fun y hy => this _ h y hy
  -- agreement on `D(A)`
  have hD : ∀ x : G.generator.domain, ∀ T, ∀ t ∈ Icc 0 T, G'.S t x = (G.perturb B).S t x := by
    intro x T
    have hx' : (x : E) ∈ G'.generator.domain := (hdom x).2 x.2
    set u : ℝ → E := fun s => G'.S s x
    set F : ℝ → E := fun s => B (u s)
    have huc : ContinuousOn u (Icc 0 T) := (G'.strongCont x).mono Icc_subset_Ici_self
    have hsol : Evolution.IsStrongSolution G.generator (Icc 0 T) F u := by
      refine Evolution.IsStrongSolution.of_deriv fun t ht => ?_
      have hm' : u t ∈ G'.generator.domain := G'.mapsTo_domain ⟨x, hx'⟩ ht.1
      have hm : u t ∈ G.generator.domain := (hdom _).1 hm'
      refine ⟨G.generator ⟨u t, hm⟩, G.generator.mem_graph ⟨u t, hm⟩, ?_⟩
      have hd := (G'.hasDerivWithinAt_apply ⟨x, hx'⟩ ht.1).mono
        (Icc_subset_Ici_self : Icc (0 : ℝ) T ⊆ Ici 0)
      have e : G'.S t (G'.generator ⟨x, hx'⟩) = G.generator ⟨u t, hm⟩ + F t := by
        rw [← G'.generator_apply_S ⟨x, hx'⟩ ht.1, happ, add_comm]
      rw [← e]
      exact hd
    have hFc : ContinuousOn F (Icc 0 T) := B.continuous.comp_continuousOn huc
    have hmild := Evolution.IsStrongSolution.eq_mild hsol hFc
    set V : ℝ → E := fun s => u s - (G.perturb B).S s x
    have hVc : ContinuousOn V (Icc 0 T) :=
      huc.sub (G.continuous_perturbS_apply B x).continuousOn
    have hV : ∀ t ∈ Icc 0 T, V t = ∫ r in (0 : ℝ)..t, G.extS (t - r) (B (V r)) := by
      intro t ht
      have hsub : uIcc 0 t ⊆ Icc 0 T := by
        rw [uIcc_of_le ht.1]; exact Icc_subset_Icc_right ht.2
      have h1 : IntervalIntegrable (fun r => G.extS (t - r) (B (u r))) volume 0 t :=
        (G.continuous_extS_uncurry.comp_continuousOn ((continuousOn_const.sub continuousOn_id).prodMk
          (B.continuous.comp_continuousOn (huc.mono hsub)))).intervalIntegrable
      have h2 : IntervalIntegrable (fun r => G.extS (t - r) (B ((G.perturb B).S r x))) volume 0 t :=
        (G.continuous_extS_comp (B.continuous.comp (G.continuous_perturbS_apply B x)) t
          ).intervalIntegrable _ _
      have hu0 : u 0 = x := G'.S_zero_apply x
      change u t - (G.perturb B).S t x = _
      rw [hmild t ht, Evolution.mild, sub_zero, hu0, G.integral_S_sub_eq_extS ht.1,
        G.perturb_S_apply_eq B ht.1, add_sub_add_left_eq_sub, ← intervalIntegral.integral_sub h1 h2]
      refine intervalIntegral.integral_congr fun r _ => ?_
      change G.extS (t - r) (B (u r)) - G.extS (t - r) (B ((G.perturb B).S r x)) =
        G.extS (t - r) (B (u r - (G.perturb B).S r x))
      rw [_root_.map_sub, _root_.map_sub]
    intro t ht
    exact sub_eq_zero.1 (G.eqOn_zero_of_volterra B hVc hV t ht)
  intro t (ht : 0 ≤ t)
  exact DFunLike.coe_injective (Continuous.ext_on G.dense_domain_generator (G'.S t).continuous
    ((G.perturb B).S t).continuous fun x hx => hD ⟨x, hx⟩ t t ⟨ht, le_rfl⟩)

/-- **Bounded perturbation theorem**: `A + B` generates a strongly continuous semigroup, unique on
`t ≥ 0`. -/
theorem existsUnique_generator_eq_vadd :
    ∃ G' : C0Semigroup 𝕜 E, G'.generator = (B : E →ₗ[𝕜] E) +ᵥ G.generator ∧
      ∀ G'' : C0Semigroup 𝕜 E, G''.generator = (B : E →ₗ[𝕜] E) +ᵥ G.generator →
        EqOn G''.S G'.S (Ici 0) :=
  ⟨G.perturb B, G.generator_perturb B, fun _ h => G.eqOn_perturb B h⟩

variable {G} in
/-- **A semigroup is determined by its generator** (on `t ≥ 0`). -/
theorem eqOn_of_generator_eq {G' : C0Semigroup 𝕜 E} (h : G'.generator = G.generator) :
    EqOn G'.S G.S (Ici 0) := by
  have h0 : G'.generator = ((0 : E →L[𝕜] E) : E →ₗ[𝕜] E) +ᵥ G.generator := by
    rw [h]
    refine LinearPMap.ext rfl fun x hx hx' => ?_
    rw [vadd_apply]
    simp
  intro t ht
  rw [G.eqOn_perturb 0 h0 ht]
  ext x
  rw [perturb_S, ← (G.hasSum_perturbS 0 ht x).tsum_eq, tsum_eq_single 0 fun n hn => ?_,
    dysonPhillips_zero, G.extS_of_nonneg ht]
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
  simp [dysonPhillips_succ]

end C0Semigroup

end Feec
