/-!
# Non-vacuity of the existence hypotheses (Thesis Thm 4.3, Hille–Yosida / Stone)

**Status.** Part of `Feec.Legacy`, the real-scalar short-complex development (built on
`Feec.Legacy.HilbertComplex2`) that the cube models and some counterexamples still use.
Most of the original module was re-derived in the general layers (see
`docs/migration/map.tsv`); what remains is listed below.

## Contents

* `bddOp`: An everywhere-defined bounded operator, viewed as a (trivially densely defined) unbounded operator with domain `⊤`.
* `bddOp_domain`: `D(bddOp A) = E`.
* `bddOp_apply`: `bddOp A` acts as `A`.
* `hasDerivAt_exp_smul_apply`: `(d/dt) exp(tA) x = A exp(tA) x`.
* `continuous_exp_smul`: `t ↦ exp(tA)` is norm-continuous.
* `exp_smul_mul_exp_neg_smul`: `exp(tA) exp(-tA) = 1`.
* `duhamel`: Duhamel's formula `U t = exp(tA) (U₀ + ∫₀ᵗ exp(-sA) G s ds)` for a forcing `G` on `ℝ`.
* `duhamel_zero`
* `UnitaryGroupGenerator`: `L` generates a strongly continuous orthogonal ("unitary") group `S`.
* `UnitaryGroupGenerator.S`
* `UnitaryGroupGenerator.map_zero`
* `UnitaryGroupGenerator.map_add`
* `UnitaryGroupGenerator.norm_map`
* `UnitaryGroupGenerator.continuous_apply`
* `UnitaryGroupGenerator.mem_domain_iff`
* `UnitaryGroupGenerator.hasDerivAt_zero`
* `UnitaryGroupGenerator.comm`: The group is commutative.
* `UnitaryGroupGenerator.hasDerivAt_apply`: Orbits of domain points are differentiable everywhere: `(d/dt) S t x = S t (L x)`.
* `UnitaryGroupGenerator.mem_domain_apply`: `S t` preserves `D(L)`.
* `UnitaryGroupGenerator.apply_comm`: `L (S t x) = S t (L x)` on `D(L)`.
* `UnitaryGroupGenerator.wellPosedHom`: **`WellPosedHom` from the Stone stand-in.** If `L` generates an orthogonal group `S`, then `U t = S t U₀` is a strong solution of `U' = L U`, `U 0 = U₀`, for every `U₀ ∈ D(L)`.
* `UnitaryGroupGenerator.isSkewSymm`: The generator of an orthogonal group is skew-symmetric (easy half of Stone's theorem): differentiate `⟪S t x, S t y⟫ = ⟪x, y⟫` at `t = 0`.
* `UnitaryGroupGenerator.toC0Group`: The underlying strongly continuous group.
* `UnitaryGroupGenerator.toC0Group_S`
* `UnitaryGroupGenerator.isIsometric_toC0Group`
* `UnitaryGroupGenerator.generator_toC0Group`: The generator of the underlying group is `L`.
* `Feec.C0Group.toUnitaryGroupGenerator`: An isometric `C0Group` with generator `L`, as a `UnitaryGroupGenerator L`.
* `C0Group.toUnitaryGroupGenerator_S`
* `UnitaryGroupGenerator.transport`: **Transport of a Stone group along a linear isometric equivalence.** If `Φ : E ≃ₗᵢ F` conjugates `A` to `B` (`D(B) = Φ D(A)`, `B Φ = Φ A`), a unitary group generated by `A` yields one generated by `B`, namely `Φ S(t) Φ⁻¹`.
* `exp_smul_add`: Group law `exp((s+t)A) = exp(sA) exp(tA)`.
* `norm_exp_smul_apply`: For skew `A`, `exp(tA)` is an isometry (it is unitary since `tA` is skew-adjoint).
* `hasDerivAt_exp_smul_apply_zero`: `(d/dt) exp(tA) x |_{t=0} = A x`.
* `norm_exp_smul_sub_le`: For skew `A`, `‖exp(tA) x - x‖ ≤ |t| ‖A x‖` (mean value theorem; `exp(sA)` is an isometry commuting with `A`).
* `expGroup`: **The Stone stand-in is inhabited:** a bounded skew-symmetric `A` generates the orthogonal group `t ↦ exp(tA)` (`NormedSpace.exp` in the C*-algebra `E →L[ℝ] E`; `tA` is skew-adjoint, so `exp(tA)` is unitary).

## References

* [QuennevilleBelair2015], §4.1 (unbounded operators), §4.3 (Thm 4.3, Thm 4.4, Cor 4.5),
  §4.4 (Thm 4.6, the abstract Hodge wave equation)
* [CazenaveHaraux1998], Prop 4.1.6 and Cor 2.4.9 (the results the thesis cites for Thm 4.3)
* [Pazy1983], Ch. 1 (uniformly continuous semigroups, Hille–Yosida, Stone's theorem) and
  Ch. 4 (the inhomogeneous initial value problem, Duhamel's formula)
* [Arnold2018] (Hilbert-complex setting of the Hodge wave operator, the unbounded case)
-/

open scoped RealInnerProductSpace
open Set NormedSpace

@[expose] public noncomputable section

namespace Feec.Legacy

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- `ℚ`-algebra structure on operators, needed by `NormedSpace.exp_add_of_commute` and
`NormedSpace.exp_mem_unitary_of_mem_skewAdjoint`. (`exp` itself does not depend on it.) -/
local instance instNormedAlgebraRatOp : NormedAlgebra ℚ (E →L[ℝ] E) :=
  NormedAlgebra.restrictScalars ℚ ℝ _

/-! ### Bounded operators as everywhere-defined `LinearPMap`s -/

/-- An everywhere-defined bounded operator, viewed as a (trivially densely defined) unbounded
operator with domain `⊤`. -/
def bddOp (A : E →L[ℝ] E) : E →ₗ.[ℝ] E := (A : E →ₗ[ℝ] E).toPMap ⊤

/-- `D(bddOp A) = E`. -/
@[simp] theorem bddOp_domain (A : E →L[ℝ] E) : (bddOp A).domain = ⊤ := rfl

/-- `bddOp A` acts as `A`. -/
@[simp] theorem bddOp_apply (A : E →L[ℝ] E) (x : (bddOp A).domain) : bddOp A x = A x := rfl

/-! ### The exponential flow -/

section Exp

variable [CompleteSpace E]

/-- `(d/dt) exp(tA) x = A exp(tA) x`. -/
theorem hasDerivAt_exp_smul_apply (A : E →L[ℝ] E) (x : E) (t : ℝ) :
    HasDerivAt (fun s : ℝ => exp (s • A) x) (A (exp (t • A) x)) t := by
  have h := (hasDerivAt_exp_smul_const' (𝕂 := ℝ) A t)
  have := (ContinuousLinearMap.apply ℝ E x).hasFDerivAt.comp_hasDerivAt t h
  simpa [Function.comp_def] using this

/-- `t ↦ exp(tA)` is norm-continuous. -/
theorem continuous_exp_smul (A : E →L[ℝ] E) : Continuous fun s : ℝ => exp (s • A) :=
  exp_continuous.comp (continuous_id.smul continuous_const)

/-- `exp(tA) exp(-tA) = 1`. -/
theorem exp_smul_mul_exp_neg_smul (A : E →L[ℝ] E) (t : ℝ) :
    exp (t • A) * exp ((-t) • A) = 1 := by
  rw [← exp_add_of_commute ((Commute.refl A).smul_left t |>.smul_right (-t)), neg_smul,
    add_neg_cancel, exp_zero]

/-- Duhamel's formula `U t = exp(tA) (U₀ + ∫₀ᵗ exp(-sA) G s ds)` for a forcing `G` on `ℝ`.
Classical variation-of-constants formula; cf. [Pazy1983], Ch. 4. -/
def duhamel (A : E →L[ℝ] E) (U₀ : E) (G : ℝ → E) (t : ℝ) : E :=
  exp (t • A) (U₀ + ∫ s in (0:ℝ)..t, exp ((-s) • A) (G s))

omit [CompleteSpace E] in
@[simp] theorem duhamel_zero (A : E →L[ℝ] E) (U₀ : E) (G : ℝ → E) : duhamel A U₀ G 0 = U₀ := by
  simp [duhamel]

end Exp

/-! ### A Stone-theorem stand-in -/

/-- `L` generates a strongly continuous orthogonal ("unitary") group `S`.
This is the conclusion of Stone's theorem for a skew-adjoint `L` (Thesis Thm 4.3 cites
Hille–Yosida/Stone; Mathlib has neither), packaged as a structure; Stone's theorem
(`Feec.Legacy.stoneGroup`, `LinearPMap.isSkewAdjoint_iff_existsUnique_isometricGroup` in
`Feec.Legacy.Stone`) shows it is inhabited exactly when `L` is skew-adjoint:
`S` is a group of isometries, strongly continuous, and `L` is its generator, i.e.
`D(L) = {x | t ↦ S t x differentiable at 0}` with `L x = (d/dt) S t x |_{t=0}`.

See [QuennevilleBelair2015, Thm 4.3]; Stone's theorem: cf. [Pazy1983], Ch. 1, and
[CazenaveHaraux1998] (cited by the thesis for Thm 4.3). -/
structure UnitaryGroupGenerator (L : E →ₗ.[ℝ] E) where
  /-- the group `t ↦ S t = e^{tL}` -/
  S : ℝ → E →L[ℝ] E
  map_zero : S 0 = 1
  map_add : ∀ s t, S (s + t) = S s * S t
  norm_map : ∀ t x, ‖S t x‖ = ‖x‖
  continuous_apply : ∀ x, Continuous fun t => S t x
  mem_domain_iff : ∀ x, x ∈ L.domain ↔ DifferentiableAt ℝ (fun t => S t x) 0
  hasDerivAt_zero : ∀ x : L.domain, HasDerivAt (fun t => S t x) (L x) 0

namespace UnitaryGroupGenerator

variable {L : E →ₗ.[ℝ] E} (G : UnitaryGroupGenerator L)

/-- The group is commutative. -/
theorem comm (s t : ℝ) : G.S s * G.S t = G.S t * G.S s := by
  rw [← G.map_add, ← G.map_add, add_comm]

/-- Orbits of domain points are differentiable everywhere: `(d/dt) S t x = S t (L x)`. -/
theorem hasDerivAt_apply (x : L.domain) (t : ℝ) :
    HasDerivAt (fun s => G.S s x) (G.S t (L x)) t := by
  have h0 := (G.S t).hasFDerivAt.comp_hasDerivAt (0 : ℝ) (G.hasDerivAt_zero x)
  rw [show (0 : ℝ) = t - t from (sub_self t).symm] at h0
  have h1 := h0.comp_sub_const t t
  convert h1 using 1
  funext s
  simp only [Function.comp_apply, ← mul_apply_eq_comp, ← G.map_add]
  congr 2; ring

/-- `S t` preserves `D(L)`. -/
theorem mem_domain_apply (x : L.domain) (t : ℝ) : G.S t x ∈ L.domain := by
  rw [G.mem_domain_iff]
  have h := ((G.S t).hasFDerivAt.comp_hasDerivAt (0 : ℝ) (G.hasDerivAt_zero x))
  refine h.differentiableAt.congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
  simp only [Function.comp_apply, ← mul_apply_eq_comp, G.comm]

/-- `L (S t x) = S t (L x)` on `D(L)`. -/
theorem apply_comm (x : L.domain) (t : ℝ) :
    L ⟨G.S t x, G.mem_domain_apply x t⟩ = G.S t (L x) := by
  have h := ((G.S t).hasFDerivAt.comp_hasDerivAt (0 : ℝ) (G.hasDerivAt_zero x))
  refine (G.hasDerivAt_zero ⟨_, G.mem_domain_apply x t⟩).unique (h.congr_of_eventuallyEq
    (Filter.Eventually.of_forall fun s => ?_))
  simp only [Function.comp_apply, ← mul_apply_eq_comp, G.comm]

/-- **`WellPosedHom` from the Stone stand-in.** If `L` generates an orthogonal group `S`, then
`U t = S t U₀` is a strong solution of `U' = L U`, `U 0 = U₀`, for every `U₀ ∈ D(L)`.
Thesis Thm 4.3/4.6: this is the existence half of Thm 4.3 (homogeneous case) derived from
the conclusion of Stone's theorem, so the existence conclusions of Ch. 4 rest on that.
See [QuennevilleBelair2015, Thm 4.3, Thm 4.6]; cf. [Pazy1983], Ch. 1. -/
theorem wellPosedHom (G : UnitaryGroupGenerator L) (T : ℝ) : WellPosedHom L T := by
  intro U₀ hU₀
  refine ⟨fun t => G.S t U₀, fun t _ => G.mem_domain_apply ⟨U₀, hU₀⟩ t, fun t _ => ?_, ?_⟩
  · simp only [Pi.zero_apply, add_zero]
    rw [G.apply_comm ⟨U₀, hU₀⟩ t]
    exact (G.hasDerivAt_apply ⟨U₀, hU₀⟩ t).hasDerivWithinAt
  · simp [G.map_zero]

/-- The generator of an orthogonal group is skew-symmetric (easy half of Stone's theorem):
differentiate `⟪S t x, S t y⟫ = ⟪x, y⟫` at `t = 0`. Sanity check that the structure
`UnitaryGroupGenerator` is consistent with the skew-adjointness hypotheses of Ch. 4.
Cf. Stone's theorem in [Pazy1983], Ch. 1; [QuennevilleBelair2015, Thm 4.3]. -/
theorem isSkewSymm (G : UnitaryGroupGenerator L) : IsSkewSymm L := by
  intro x y
  have hconst : (fun t => ⟪G.S t x, G.S t y⟫) = fun _ => ⟪(x : E), (y : E)⟫ := by
    funext t
    exact (LinearMap.norm_map_iff_inner_map_map (G.S t)).mp (G.norm_map t) x y
  have hd := (G.hasDerivAt_zero x).inner ℝ (G.hasDerivAt_zero y)
  rw [hconst] at hd
  have h0 := hd.unique (hasDerivAt_const (0 : ℝ) _)
  simp only [G.map_zero, one_apply_eq_self] at h0
  linarith

end UnitaryGroupGenerator

/-! ### Bridge to `Feec.C0Group` (`Feec.Semigroup.Basic`)

`UnitaryGroupGenerator L` is an isometric `C0Group ℝ E` together with the identification of its
generator with `L`. -/

namespace UnitaryGroupGenerator

variable {L : E →ₗ.[ℝ] E}

/-- The underlying strongly continuous group. -/
def toC0Group (G : UnitaryGroupGenerator L) : C0Group ℝ E :=
  ⟨G.S, G.map_zero, G.map_add, G.continuous_apply⟩

@[simp] theorem toC0Group_S (G : UnitaryGroupGenerator L) : G.toC0Group.S = G.S := rfl

theorem isIsometric_toC0Group (G : UnitaryGroupGenerator L) : G.toC0Group.IsIsometric :=
  G.norm_map

/-- The generator of the underlying group is `L`. -/
theorem generator_toC0Group [CompleteSpace E] (G : UnitaryGroupGenerator L) :
    G.toC0Group.generator = L := by
  have hdom : G.toC0Group.generator.domain = L.domain := by
    ext x
    rw [G.toC0Group.mem_domain_generator_iff, G.mem_domain_iff]
    rfl
  refine LinearPMap.ext hdom fun x hx hx' => ?_
  exact G.toC0Group.generator_apply_eq (x := ⟨x, hx⟩) (G.hasDerivAt_zero ⟨x, hx'⟩)

end UnitaryGroupGenerator

/-- An isometric `C0Group` with generator `L`, as a `UnitaryGroupGenerator L`. -/
def _root_.Feec.C0Group.toUnitaryGroupGenerator [CompleteSpace E] (G : C0Group ℝ E) (hG : G.IsIsometric)
    {L : E →ₗ.[ℝ] E} (hL : G.generator = L) : UnitaryGroupGenerator L where
  S := G.S
  map_zero := G.map_zero
  map_add := G.map_add
  norm_map := hG
  continuous_apply := G.strongCont
  mem_domain_iff x := by rw [← G.mem_domain_generator_iff, hL]
  hasDerivAt_zero x := by
    subst hL
    exact G.hasDerivAt_generator x

@[simp] theorem C0Group.toUnitaryGroupGenerator_S [CompleteSpace E] (G : C0Group ℝ E)
    (hG : G.IsIsometric) {L : E →ₗ.[ℝ] E} (hL : G.generator = L) :
    (G.toUnitaryGroupGenerator hG hL).S = G.S := rfl

section Transport

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]

/-- **Transport of a Stone group along a linear isometric equivalence.** If `Φ : E ≃ₗᵢ F`
conjugates `A` to `B` (`D(B) = Φ D(A)`, `B Φ = Φ A`), a unitary group generated by `A` yields
one generated by `B`, namely `Φ S(t) Φ⁻¹`. -/
def UnitaryGroupGenerator.transport {A : E →ₗ.[ℝ] E} (G : UnitaryGroupGenerator A)
    (Φ : E ≃ₗᵢ[ℝ] F) {B : F →ₗ.[ℝ] F} (hdom : ∀ y, y ∈ B.domain ↔ Φ.symm y ∈ A.domain)
    (happ : ∀ y : B.domain, B y = Φ (A ⟨Φ.symm y, (hdom y).1 y.2⟩)) :
    UnitaryGroupGenerator B where
  S t := (Φ.toContinuousLinearEquiv : E →L[ℝ] F) ∘L G.S t ∘L
    (Φ.symm.toContinuousLinearEquiv : F →L[ℝ] E)
  map_zero := by ext y; simp [G.map_zero]
  map_add s t := by ext y; simp [G.map_add, mul_apply_eq_comp]
  norm_map t y := by simp [G.norm_map]
  continuous_apply y := Φ.continuous.comp (G.continuous_apply _)
  mem_domain_iff y := by
    rw [hdom, G.mem_domain_iff]
    constructor
    · intro h
      exact (Φ.toContinuousLinearEquiv : E →L[ℝ] F).differentiableAt.comp (0 : ℝ) h
    · intro h
      have := (Φ.symm.toContinuousLinearEquiv : F →L[ℝ] E).differentiableAt.comp (0 : ℝ) h
      refine this.congr_of_eventuallyEq (Filter.Eventually.of_forall fun t => ?_)
      simp
  hasDerivAt_zero y := by
    have := (Φ.toContinuousLinearEquiv : E →L[ℝ] F).hasFDerivAt.comp_hasDerivAt (0 : ℝ)
      (G.hasDerivAt_zero ⟨Φ.symm y, (hdom y).1 y.2⟩)
    rw [happ]
    exact this

end Transport

/-- Group law `exp((s+t)A) = exp(sA) exp(tA)`. -/
theorem exp_smul_add [CompleteSpace E] (A : E →L[ℝ] E) (s t : ℝ) :
    exp ((s + t) • A) = exp (s • A) * exp (t • A) := by
  rw [add_smul, exp_add_of_commute ((Commute.refl A).smul_left s |>.smul_right t)]

/-- For skew `A`, `exp(tA)` is an isometry (it is unitary since `tA` is skew-adjoint). -/
theorem norm_exp_smul_apply [CompleteSpace E] {A : E →L[ℝ] E}
    (hA : ∀ x y, ⟪A x, y⟫ = -⟪x, A y⟫) (t : ℝ) (x : E) : ‖exp (t • A) x‖ = ‖x‖ :=
  C0Group.norm_exp_ofReal_smul_apply hA t x

/-- `(d/dt) exp(tA) x |_{t=0} = A x`. -/
theorem hasDerivAt_exp_smul_apply_zero [CompleteSpace E] (A : E →L[ℝ] E) (x : E) :
    HasDerivAt (fun s : ℝ => exp (s • A) x) (A x) 0 := by
  have := hasDerivAt_exp_smul_apply A x 0
  rwa [zero_smul, exp_zero, one_apply_eq_self] at this

/-- For skew `A`, `‖exp(tA) x - x‖ ≤ |t| ‖A x‖` (mean value theorem; `exp(sA)` is an isometry
commuting with `A`). -/
theorem norm_exp_smul_sub_le [CompleteSpace E] {A : E →L[ℝ] E}
    (hA : ∀ x y, ⟪A x, y⟫ = -⟪x, A y⟫) (t : ℝ) (x : E) : ‖exp (t • A) x - x‖ ≤ |t| * ‖A x‖ :=
  C0Group.norm_exp_ofReal_smul_sub_le hA t x

/-- **The Stone stand-in is inhabited:** a bounded skew-symmetric `A` generates the orthogonal
group `t ↦ exp(tA)` (`NormedSpace.exp` in the C*-algebra `E →L[ℝ] E`; `tA` is skew-adjoint,
so `exp(tA)` is unitary). Cf. uniformly continuous groups in [Pazy1983], Ch. 1. -/
def expGroup [CompleteSpace E] (A : E →L[ℝ] E) (hA : ∀ x y, ⟪A x, y⟫ = -⟪x, A y⟫) :
    UnitaryGroupGenerator (bddOp A) where
  S t := exp (t • A)
  map_zero := by rw [zero_smul, exp_zero]
  map_add := exp_smul_add A
  norm_map := norm_exp_smul_apply hA
  continuous_apply x := (continuous_exp_smul A).clm_apply continuous_const
  mem_domain_iff x := iff_of_true trivial (hasDerivAt_exp_smul_apply_zero A x).differentiableAt
  hasDerivAt_zero x := hasDerivAt_exp_smul_apply_zero A (x : E)

end Feec.Legacy
