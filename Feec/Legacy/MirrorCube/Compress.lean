module

public import Feec.Legacy.Box.Reduce
public import Feec.Legacy.BoundedDomain.SalvageMax

/-!
# Compressing a Hilbert complex onto the range of a projection

**Status.** Part of `Feec.Legacy`, the real-scalar short-complex development (built on
`Feec.Legacy.HilbertComplex2`) that the cube models and some counterexamples still use. It
keeps only what those modules need and the results that have no home in the general layers
yet; everything else moved there (see `docs/migration/map.tsv`).

Abstract tool for the repair of thesis Prop 4.17 on the box (`Feec.Legacy.MirrorCube.Cube`). A Hilbert
complex `H` on `W0 → W1 → W2` is given, together with, on each space, a scaled isometric embedding
`J : W' → W` (`⟪J x, J y⟫ = c ⟪x, y⟫`, `c > 0`) of another Hilbert space, a left inverse `R` of
`J`, and a self-adjoint `P` with `P J = J` whose values lie in the range of `J` (so `P` is the
orthogonal projection onto `range J`), such that `P` commutes with the differentials of `H`
(`Compr`, `ComprComm`). Then:

* `compr`: `d' = R ∘ d ∘ J` on `{x | J x ∈ D(d)}` is closed and densely defined, and
  `J (d' x) = d (J x)` (`J_compr`); its adjoint is the compression of the adjoint
  (`mem_adjoint_compr_iff`, `J_adjoint_compr`).
* `comprComplex`: the compressed operators form a Hilbert complex on `W0' → W1' → W2'`;
  `J = (J0, J1, J2)` maps `D(L')` into `D(L)` (in fact `x ∈ D(L') ↔ J x ∈ D(L)`,
  `mem_domL_compr_iff`) and intertwines the Hodge wave operators (`totJ_waveOp`) and every pair
  of orthogonal groups generated by `-L'`, `-L` (`Feec.HilbertComplex.ReducingSubcomplex.waveGroup_toHilbertComplex`).
* `reducing_hyps_compr`: if `S1`, `S2` satisfy the hypotheses of the abstract Prop 4.17
  (`Feec.Legacy.Constraints.Kc_propagates`) for `H` and their projections commute with `P`, then the
  preimages `S1' = J⁻¹ S1`, `S2' = J⁻¹ S2` satisfy them for the compressed complex.
* `Feec.HilbertComplex.ReducingSubcomplex.existsUnique_mem`, `Kmax_compr_eq`: hence Prop 4.17 with existence and uniqueness, and
  `K* = K` for every group, for the compressed complex.

## References

* [QuennevilleBelair2015], §4.2 (Hilbert complexes), §4.10 (Prop 4.17)
* [AFW2010], [BruningLesch1992] (Hilbert complexes)
-/

@[expose] public noncomputable section

open scoped RealInnerProductSpace
open LinearPMap Set Filter Topology

namespace Feec.Legacy.MirrorCube

open Feec.Legacy.Constraints Feec.Legacy.HilbertComplex2 Feec.Legacy.Box

/-! ## Scaled embeddings onto the range of a projection -/

/-- A scaled isometric embedding `J : W' → W` (`⟪J x, J y⟫ = c ⟪x, y⟫`) with left inverse `R`,
and a self-adjoint `P` with `P J = J` and values in `range J` (the orthogonal projection onto
`range J`). -/
structure Compr (c : ℝ) (W' W : Type*) [NormedAddCommGroup W'] [InnerProductSpace ℝ W']
    [NormedAddCommGroup W] [InnerProductSpace ℝ W] where
  /-- the embedding -/
  J : W' →L[ℝ] W
  /-- a left inverse -/
  R : W →L[ℝ] W'
  /-- the projection onto the range -/
  P : W →L[ℝ] W
  inner_J : ∀ x y, ⟪J x, J y⟫ = c * ⟪x, y⟫
  RJ : ∀ x, R (J x) = x
  JRP : ∀ z, J (R (P z)) = P z
  PJ : ∀ x, P (J x) = J x
  P_sa : ∀ z w, ⟪P z, w⟫ = ⟪z, P w⟫

namespace Compr

variable {c : ℝ} {W' W : Type*} [NormedAddCommGroup W'] [InnerProductSpace ℝ W']
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] (A : Compr c W' W)

theorem J_injective : Function.Injective A.J := fun x y h => by
  rw [← A.RJ x, ← A.RJ y, h]

theorem PP (z : W) : A.P (A.P z) = A.P z := by
  rw [← A.JRP z, A.PJ]

theorem inner_P_J (z : W) (x : W') : ⟪A.P z, A.J x⟫ = ⟪z, A.J x⟫ := by
  rw [A.P_sa, A.PJ]

/-- Values of `P` are in the range of `J`. -/
theorem P_mem_range (z : W) : ∃ x, A.J x = A.P z := ⟨_, A.JRP z⟩

/-- A vector fixed by `P` is `J` of its `R`. -/
theorem J_R_of_P {z : W} (h : A.P z = z) : A.J (A.R z) = z := by
  conv_lhs => rw [← h]
  rw [A.JRP, h]

end Compr

/-! ## Compressed operators -/

section Op

variable {c : ℝ} {W V W' V' : Type*}
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [NormedAddCommGroup W'] [InnerProductSpace ℝ W'] [NormedAddCommGroup V']
  [InnerProductSpace ℝ V']

/-- `P` commutes with the operator `T`: `P D(T) ⊆ D(T)` and `T P = P T`. -/
def ComprComm (T : W →ₗ.[ℝ] V) (A : Compr c W' W) (B : Compr c V' V) : Prop :=
  ∀ z : T.domain, ∃ h : A.P z ∈ T.domain, T ⟨_, h⟩ = B.P (T z)

variable {T : W →ₗ.[ℝ] V} {A : Compr c W' W} {B : Compr c V' V}

theorem lpmap_congr' {E F : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
    (f : E →ₗ.[ℝ] F) {x y : E} (hx : x ∈ f.domain) (hy : y ∈ f.domain) (h : x = y) :
    f ⟨x, hx⟩ = f ⟨y, hy⟩ := by subst h; rfl

/-- `T (J x) = P (T (J x))`: the values of `T` on `range J` lie in `range J'`. -/
theorem P_T_J (hT : ComprComm T A B) (x : W') (hx : A.J x ∈ T.domain) :
    B.P (T ⟨A.J x, hx⟩) = T ⟨A.J x, hx⟩ := by
  obtain ⟨h, e⟩ := hT ⟨_, hx⟩
  rw [← e]
  exact lpmap_congr' T _ _ (A.PJ x)

variable (T A B) in
/-- **The compressed operator** `R' ∘ T ∘ J` on `{x | J x ∈ D(T)}`. -/
def compr : W' →ₗ.[ℝ] V' where
  domain := T.domain.comap (A.J : W' →ₗ[ℝ] W)
  toFun :=
    { toFun := fun x => B.R (T ⟨A.J x, x.2⟩)
      map_add' := fun x y => by
        rw [← _root_.map_add]
        congr 1
        rw [← T.map_add]
        exact lpmap_congr' T _ _ (_root_.map_add A.J _ _)
      map_smul' := fun r x => by
        rw [RingHom.id_apply, ← _root_.map_smul]
        congr 1
        rw [← T.map_smul]
        exact lpmap_congr' T _ _ (_root_.map_smul A.J _ _) }

theorem mem_compr_domain {x : W'} : x ∈ (compr T A B).domain ↔ A.J x ∈ T.domain := Iff.rfl

@[simp] theorem compr_apply (x : (compr T A B).domain) :
    compr T A B x = B.R (T ⟨A.J x, mem_compr_domain.1 x.2⟩) := rfl

/-- **`J' (d' x) = d (J x)`.** -/
theorem J_compr (hT : ComprComm T A B) (x : (compr T A B).domain) :
    B.J (compr T A B x) = T ⟨A.J x, mem_compr_domain.1 x.2⟩ := by
  have e := P_T_J hT (x : W') (mem_compr_domain.1 x.2)
  rw [compr_apply]
  conv_lhs => rw [← e]
  rw [B.JRP, e]

/-- The graph of the compression is the preimage of the graph. -/
theorem mem_graph_compr_iff (hT : ComprComm T A B) (p : W' × V') :
    p ∈ (compr T A B).graph ↔ (A.J p.1, B.J p.2) ∈ T.graph := by
  obtain ⟨x, y⟩ := p
  simp only [LinearPMap.mem_graph_iff]
  constructor
  · rintro ⟨x', rfl, rfl⟩
    exact ⟨⟨_, x'.2⟩, rfl, (J_compr hT x').symm⟩
  · rintro ⟨z, hz, hy⟩
    have hx : x ∈ (compr T A B).domain := by
      rw [mem_compr_domain, ← hz]; exact z.2
    refine ⟨⟨x, hx⟩, rfl, B.J_injective ?_⟩
    rw [J_compr hT, ← hy]
    exact lpmap_congr' T _ _ hz.symm

/-- **Compressions of closed operators are closed.** -/
theorem isClosed_compr (hT : ComprComm T A B) (hc : T.IsClosed) : (compr T A B).IsClosed := by
  change IsClosed ((compr T A B).graph : Set (W' × V'))
  have e : ((compr T A B).graph : Set (W' × V')) =
      (Prod.map A.J B.J) ⁻¹' (T.graph : Set (W × V)) := by
    ext p; exact mem_graph_compr_iff hT p
  rw [e]
  exact hc.preimage (A.J.continuous.prodMap B.J.continuous)

/-- **Compressions of densely defined operators are densely defined.** -/
theorem dense_compr (hT : ComprComm T A B) (hd : Dense (T.domain : Set W)) :
    Dense ((compr T A B).domain : Set W') := by
  intro x
  have h := map_mem_closure ((A.R.comp A.P).continuous) (hd (A.J x))
    (t := ((compr T A B).domain : Set W')) fun z hz => by
      obtain ⟨h, -⟩ := hT ⟨z, hz⟩
      change A.J (A.R (A.P z)) ∈ T.domain
      rw [A.JRP]; exact h
  simpa [A.PJ, A.RJ] using h

variable [CompleteSpace W] [CompleteSpace W']

/-- The adjoint of the compression, forward: `J' y ∈ D(T*)` and `T* (J' y) = J (d'* y)`. -/
theorem adjoint_compr_forward (hT : ComprComm T A B) (hd : Dense (T.domain : Set W))
    (y : (compr T A B)†.domain) :
    ∃ h : B.J y ∈ T†.domain, T† ⟨_, h⟩ = A.J ((compr T A B)† y) := by
  have hfa := adjoint_isFormalAdjoint (dense_compr hT hd)
  have key : ∀ z : T.domain, ⟪A.J ((compr T A B)† y), (z : W)⟫ = ⟪B.J y, T z⟫ := by
    intro z
    obtain ⟨hz, e⟩ := hT z
    have hx : A.R (A.P z) ∈ (compr T A B).domain := by
      rw [mem_compr_domain, A.JRP]; exact hz
    have e1 : T ⟨_, hz⟩ = B.J (compr T A B ⟨_, hx⟩) := by
      rw [J_compr hT]; exact lpmap_congr' T _ _ (A.JRP z).symm
    have h2 := hfa y ⟨_, hx⟩
    calc ⟪A.J ((compr T A B)† y), (z : W)⟫
        = ⟪A.J ((compr T A B)† y), A.P z⟫ := by
          rw [← A.P_sa, A.PJ]
      _ = c * ⟪(compr T A B)† y, A.R (A.P z)⟫ := by rw [← A.JRP z, A.inner_J, A.JRP]
      _ = c * ⟪(y : V'), compr T A B ⟨_, hx⟩⟫ := by rw [h2]
      _ = ⟪B.J y, B.J (compr T A B ⟨_, hx⟩)⟫ := by rw [B.inner_J]
      _ = ⟪B.J y, B.P (T z)⟫ := by rw [← e1, e]
      _ = ⟪B.J y, T z⟫ := by rw [← B.P_sa, B.PJ]
  have hm := mem_adjoint_domain_of_exists _ ⟨_, key⟩
  exact ⟨hm, adjoint_apply_eq hd ⟨_, hm⟩ key⟩

/-- The adjoint of the compression, backward: if `J' y ∈ D(T*)`, then `y ∈ D(d'*)`. -/
theorem adjoint_compr_backward (hT : ComprComm T A B) (hd : Dense (T.domain : Set W))
    (hc : 0 < c) {y : V'} (hy : B.J y ∈ T†.domain) : y ∈ (compr T A B)†.domain := by
  refine mem_adjoint_domain_of_exists _ ⟨A.R (A.P (T† ⟨_, hy⟩)), fun x => ?_⟩
  have h1 : ⟪T† ⟨B.J y, hy⟩, A.J x⟫ = ⟪B.J y, T ⟨A.J x, mem_compr_domain.1 x.2⟩⟫ :=
    adjoint_isFormalAdjoint hd ⟨_, hy⟩ ⟨_, mem_compr_domain.1 x.2⟩
  have hJ : ⟪A.J (A.R (A.P (T† ⟨_, hy⟩))), A.J x⟫ = ⟪B.J y, B.J (compr T A B x)⟫ := by
    rw [A.JRP, A.inner_P_J, h1, J_compr hT]
  rw [A.inner_J, B.inner_J] at hJ
  exact mul_left_cancel₀ hc.ne' hJ

theorem mem_adjoint_compr_iff (hT : ComprComm T A B) (hd : Dense (T.domain : Set W))
    (hc : 0 < c) {y : V'} : y ∈ (compr T A B)†.domain ↔ B.J y ∈ T†.domain :=
  ⟨fun h => (adjoint_compr_forward hT hd ⟨y, h⟩).1, adjoint_compr_backward hT hd hc⟩

/-- **`J (d'* y) = d* (J' y)`.** -/
theorem J_adjoint_compr (hT : ComprComm T A B) (hd : Dense (T.domain : Set W))
    (y : (compr T A B)†.domain) (h : B.J y ∈ T†.domain) :
    A.J ((compr T A B)† y) = T† ⟨_, h⟩ := by
  obtain ⟨h', e⟩ := adjoint_compr_forward hT hd y
  rw [← e]

end Op

/-! ## The compressed Hilbert complex -/

section Complex

variable {c : ℝ} {W0 W1 W2 W0' W1' W2' : Type*}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0] [CompleteSpace W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1] [CompleteSpace W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2] [CompleteSpace W2]
  [NormedAddCommGroup W0'] [InnerProductSpace ℝ W0'] [CompleteSpace W0']
  [NormedAddCommGroup W1'] [InnerProductSpace ℝ W1'] [CompleteSpace W1']
  [NormedAddCommGroup W2'] [InnerProductSpace ℝ W2'] [CompleteSpace W2']

variable (H : HilbertComplex2 W0 W1 W2) (A0 : Compr c W0' W0) (A1 : Compr c W1' W1)
  (A2 : Compr c W2' W2) (h0 : ComprComm H.d0 A0 A1) (h1 : ComprComm H.d1 A1 A2)

/-- **The compressed Hilbert complex** `d0' = R1 d0 J0`, `d1' = R2 d1 J1`. -/
def comprComplex : HilbertComplex2 W0' W1' W2' where
  d0 := compr H.d0 A0 A1
  d1 := compr H.d1 A1 A2
  dense0 := dense_compr h0 H.dense0
  dense1 := dense_compr h1 H.dense1
  closed0 := isClosed_compr h0 H.closed0
  closed1 := isClosed_compr h1 H.closed1
  map_mem x := by
    change A1.J _ ∈ H.d1.domain
    rw [J_compr h0]
    exact H.map_mem _
  comp_zero x := by
    apply A2.J_injective
    rw [J_compr h1, _root_.map_zero]
    have e : H.d1 ⟨A1.J (compr H.d0 A0 A1 x), by rw [J_compr h0]; exact H.map_mem _⟩ =
        H.d1 ⟨H.d0 ⟨A0.J x, x.2⟩, H.map_mem _⟩ := lpmap_congr' _ _ _ (J_compr h0 x)
    rw [e]
    exact H.comp_zero _

variable {H A0 A1 A2 h0 h1}

/-- The embedding of states `(σ, E, B) ↦ (J0 σ, J1 E, J2 B)`. -/
def totJ (A0 : Compr c W0' W0) (A1 : Compr c W1' W1) (A2 : Compr c W2' W2) :
    Tot W0' W1' W2' →L[ℝ] Tot W0 W1 W2 :=
  (Constraints.totL (W0 := W0) (W1 := W1) (W2 := W2)).symm.toContinuousLinearMap ∘L
    (A0.J.prodMap (A1.J.prodMap A2.J)) ∘L
    (Constraints.totL (W0 := W0') (W1 := W1') (W2 := W2')).toContinuousLinearMap

omit [CompleteSpace W0] [CompleteSpace W1] [CompleteSpace W2] [CompleteSpace W0']
  [CompleteSpace W1'] [CompleteSpace W2'] in
theorem tot_totJ (x : Tot W0' W1' W2') :
    tot W0 W1 W2 (totJ A0 A1 A2 x) =
      (A0.J (tot _ _ _ x).1, A1.J (tot _ _ _ x).2.1, A2.J (tot _ _ _ x).2.2) := by
  simp [totJ]; rfl

omit [CompleteSpace W0] [CompleteSpace W1] [CompleteSpace W2] [CompleteSpace W0']
  [CompleteSpace W1'] [CompleteSpace W2'] in
theorem totJ_injective : Function.Injective (totJ A0 A1 A2) := by
  intro x y h
  have := congrArg (tot W0 W1 W2) h
  rw [tot_totJ, tot_totJ] at this
  simp only [Prod.mk.injEq] at this
  apply (tot W0' W1' W2').injective
  exact Prod.ext (A0.J_injective this.1)
    (Prod.ext (A1.J_injective this.2.1) (A2.J_injective this.2.2))

variable (hc : 0 < c)
include hc

theorem mem_midDomain_compr_iff {u : W1'} :
    u ∈ (comprComplex H A0 A1 A2 h0 h1).midDomain ↔ A1.J u ∈ H.midDomain := by
  change u ∈ (compr H.d1 A1 A2).domain ⊓ (compr H.d0 A0 A1)†.domain ↔ _
  rw [Submodule.mem_inf, mem_compr_domain]
  exact ⟨fun h => ⟨h.1, (mem_adjoint_compr_iff h0 H.dense0 hc).1 h.2⟩,
    fun h => ⟨h.1, (mem_adjoint_compr_iff h0 H.dense0 hc).2 h.2⟩⟩

theorem mem_adj1_compr_iff {ρ : W2'} :
    ρ ∈ (comprComplex H A0 A1 A2 h0 h1).d1†.domain ↔ A2.J ρ ∈ H.d1†.domain :=
  mem_adjoint_compr_iff h1 H.dense1 hc

/-- **`D(L') = J⁻¹ D(L)`.** -/
theorem mem_domL_compr_iff (x : Tot W0' W1' W2') :
    x ∈ (comprComplex H A0 A1 A2 h0 h1).domL ↔ totJ A0 A1 A2 x ∈ H.domL := by
  rw [Constraints.mem_domL, Constraints.mem_domL, tot_totJ, mem_midDomain_compr_iff hc,
    mem_adj1_compr_iff hc]
  rfl

/-- **The embedding intertwines the Hodge wave operators**: `J L' = L J`. -/
theorem totJ_waveOp (x : Tot W0' W1' W2') (hx : x ∈ (comprComplex H A0 A1 A2 h0 h1).domL) :
    totJ A0 A1 A2 ((comprComplex H A0 A1 A2 h0 h1).waveOp ⟨x, hx⟩) =
      H.waveOp ⟨totJ A0 A1 A2 x, (mem_domL_compr_iff hc x).1 hx⟩ := by
  have hx' := (mem_domL_compr_iff (h0 := h0) (h1 := h1) hc x).1 hx
  rw [Constraints.mem_domL, tot_totJ] at hx'
  apply (tot W0 W1 W2).injective
  rw [tot_totJ, Constraints.tot_waveOp, Constraints.tot_waveOp]
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · dsimp only
    rw [_root_.map_neg, neg_inj]
    refine (J_adjoint_compr h0 H.dense0 _ hx'.2.1.2).trans ?_
    exact lpmap_congr' _ _ _ (by simp [tot_totJ])
  · dsimp only
    rw [_root_.map_add]
    refine congrArg₂ (· + ·) ?_ ?_
    · refine (J_compr h0 _).trans ?_
      exact lpmap_congr' _ _ _ (by simp [tot_totJ])
    · refine (J_adjoint_compr h1 H.dense1 _ hx'.2.2).trans ?_
      exact lpmap_congr' _ _ _ (by simp [tot_totJ])
  · dsimp only
    rw [_root_.map_neg, neg_inj]
    refine (J_compr h1 _).trans ?_
    exact lpmap_congr' _ _ _ (by simp [tot_totJ])

omit hc [CompleteSpace W0] [CompleteSpace W1] [CompleteSpace W2] [CompleteSpace W0']
  [CompleteSpace W1'] [CompleteSpace W2'] in
/-- `J⁻¹ Kc = Kc'`. -/
theorem mem_Kc_compr_iff (S1 : Submodule ℝ W1) (S2 : Submodule ℝ W2) (x : Tot W0' W1' W2') :
    x ∈ Kc W0' (S1.comap (A1.J : W1' →ₗ[ℝ] W1)) (S2.comap (A2.J : W2' →ₗ[ℝ] W2)) ↔
      totJ A0 A1 A2 x ∈ Kc W0 S1 S2 := by
  rw [mem_Kc, mem_Kc, tot_totJ]
  simp only [Submodule.mem_comap, ContinuousLinearMap.coe_coe]
  refine and_congr ⟨fun h => by rw [h, _root_.map_zero], fun h => A0.J_injective ?_⟩ Iff.rfl
  rw [h, _root_.map_zero]

end Complex

/-! ## Constraint spaces and their projections -/

section Proj

variable {c : ℝ} {W' W : Type*} [NormedAddCommGroup W'] [InnerProductSpace ℝ W'] [CompleteSpace W']
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]

/-- The preimage of a closed subspace is closed, so has an orthogonal projection. -/
instance comap_hasOrthogonalProjection (A : Compr c W' W) (S : Submodule ℝ W)
    [S.HasOrthogonalProjection] : (S.comap (A.J : W' →ₗ[ℝ] W)).HasOrthogonalProjection := by
  have hc : _root_.IsClosed (S.comap (A.J : W' →ₗ[ℝ] W) : Set W') :=
    (isClosed_of_hasOrthogonalProjection S).preimage A.J.continuous
  have : CompleteSpace (S.comap (A.J : W' →ₗ[ℝ] W)) := hc.completeSpace_coe
  infer_instance

omit [CompleteSpace W] in
/-- **The projection onto `J⁻¹ S`**: if `P_S` commutes with `P`, then `J P_{J⁻¹ S} = P_S J`. -/
theorem J_starProjection_comap (A : Compr c W' W) (hc : 0 < c) (S : Submodule ℝ W)
    [S.HasOrthogonalProjection] (hPS : ∀ z, S.starProjection (A.P z) = A.P (S.starProjection z))
    (x : W') :
    A.J ((S.comap (A.J : W' →ₗ[ℝ] W)).starProjection x) = S.starProjection (A.J x) := by
  have hfix : A.P (S.starProjection (A.J x)) = S.starProjection (A.J x) := by
    rw [← hPS, A.PJ]
  set v := A.R (S.starProjection (A.J x))
  have hv : A.J v = S.starProjection (A.J x) := A.J_R_of_P hfix
  have hvS : v ∈ S.comap (A.J : W' →ₗ[ℝ] W) := by
    change A.J v ∈ S; rw [hv]; exact S.starProjection_apply_mem _
  have e : (S.comap (A.J : W' →ₗ[ℝ] W)).starProjection x = v := by
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero hvS fun s hs => ?_
    have h0 := (Submodule.mem_orthogonal _ _).1 (S.sub_starProjection_mem_orthogonal (A.J x))
      (A.J s) hs
    have : c * ⟪x - v, s⟫ = 0 := by
      rw [← A.inner_J, _root_.map_sub, hv, real_inner_comm]; exact h0
    exact (mul_eq_zero.1 this).resolve_left hc.ne'
  rw [e, hv]

end Proj

section Propagation

variable {c : ℝ} {W0 W1 W2 W0' W1' W2' : Type*}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0] [CompleteSpace W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1] [CompleteSpace W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2] [CompleteSpace W2]
  [NormedAddCommGroup W0'] [InnerProductSpace ℝ W0'] [CompleteSpace W0']
  [NormedAddCommGroup W1'] [InnerProductSpace ℝ W1'] [CompleteSpace W1']
  [NormedAddCommGroup W2'] [InnerProductSpace ℝ W2'] [CompleteSpace W2']
  {H : HilbertComplex2 W0 W1 W2} {A0 : Compr c W0' W0} {A1 : Compr c W1' W1}
  {A2 : Compr c W2' W2} {h0 : ComprComm H.d0 A0 A1} {h1 : ComprComm H.d1 A1 A2}
  (S1 : Submodule ℝ W1) (S2 : Submodule ℝ W2) [S1.HasOrthogonalProjection]
  [S2.HasOrthogonalProjection]

/-- **The hypotheses of Prop 4.17 transfer to the compressed complex**, for the preimages
`J⁻¹ S1`, `J⁻¹ S2`, when the projections onto `S1`, `S2` commute with `P`. -/
theorem reducing_hyps_compr (hc : 0 < c) (hS1 : S1 ≤ H.d0†.ker)
    (hPD : ∀ x ∈ H.domL, projKc W0 S1 S2 x ∈ H.domL)
    (hd1 : ∀ u : H.d1.domain, (u : W1) ∈ S1 → H.d1 u ∈ S2)
    (hd1s : ∀ ρ : H.d1†.domain, (ρ : W2) ∈ S2 → H.d1† ρ ∈ S1)
    (hP1 : ∀ z, S1.starProjection (A1.P z) = A1.P (S1.starProjection z))
    (hP2 : ∀ z, S2.starProjection (A2.P z) = A2.P (S2.starProjection z)) :
    (S1.comap (A1.J : W1' →ₗ[ℝ] W1) ≤ (comprComplex H A0 A1 A2 h0 h1).d0†.ker) ∧
    (∀ x ∈ (comprComplex H A0 A1 A2 h0 h1).domL,
      projKc W0' (S1.comap (A1.J : W1' →ₗ[ℝ] W1)) (S2.comap (A2.J : W2' →ₗ[ℝ] W2)) x ∈
        (comprComplex H A0 A1 A2 h0 h1).domL) ∧
    (∀ u : (comprComplex H A0 A1 A2 h0 h1).d1.domain,
      (u : W1') ∈ S1.comap (A1.J : W1' →ₗ[ℝ] W1) →
        (comprComplex H A0 A1 A2 h0 h1).d1 u ∈ S2.comap (A2.J : W2' →ₗ[ℝ] W2)) ∧
    (∀ ρ : (comprComplex H A0 A1 A2 h0 h1).d1†.domain,
      (ρ : W2') ∈ S2.comap (A2.J : W2' →ₗ[ℝ] W2) →
        (comprComplex H A0 A1 A2 h0 h1).d1† ρ ∈ S1.comap (A1.J : W1' →ₗ[ℝ] W1)) := by
  refine ⟨fun u hu => ?_, fun x hx => ?_, fun u hu => ?_, fun ρ hρ => ?_⟩
  · obtain ⟨y, hy, hy0⟩ := LinearPMap.mem_ker_iff.1 (hS1 hu)
    have hJ : A1.J u ∈ H.d0†.domain := by
      change A1.J u = (y : W1) at hy; rw [hy]; exact y.2
    have hdom : u ∈ (compr H.d0 A0 A1)†.domain := adjoint_compr_backward h0 H.dense0 hc hJ
    refine LinearPMap.mem_ker_iff.2 ⟨⟨u, hdom⟩, rfl, A0.J_injective ?_⟩
    change A0.J ((compr H.d0 A0 A1)† ⟨u, hdom⟩) = A0.J 0
    rw [J_adjoint_compr h0 H.dense0 _ hJ, _root_.map_zero, ← hy0]
    exact lpmap_congr' _ _ _ hy
  · rw [mem_domL_compr_iff hc] at hx ⊢
    have h := hPD _ hx
    have e : totJ A0 A1 A2 (projKc W0' (S1.comap (A1.J : W1' →ₗ[ℝ] W1))
        (S2.comap (A2.J : W2' →ₗ[ℝ] W2)) x) = projKc W0 S1 S2 (totJ A0 A1 A2 x) := by
      apply (tot W0 W1 W2).injective
      rw [tot_totJ, tot_projKc, tot_projKc, tot_totJ, _root_.map_zero,
        J_starProjection_comap A1 hc S1 hP1, J_starProjection_comap A2 hc S2 hP2]
    rw [e]; exact h
  · have e : A2.J ((comprComplex H A0 A1 A2 h0 h1).d1 u) = H.d1 ⟨A1.J u, u.2⟩ := J_compr h1 u
    change A2.J ((comprComplex H A0 A1 A2 h0 h1).d1 u) ∈ S2
    rw [e]
    exact hd1 ⟨_, u.2⟩ hu
  · have hJ : A2.J ρ ∈ H.d1†.domain := (mem_adj1_compr_iff (h0 := h0) (h1 := h1) hc).1 ρ.2
    change A1.J ((compr H.d1 A1 A2)† ρ) ∈ S1
    rw [J_adjoint_compr h1 H.dense1 _ hJ]
    exact hd1s _ hρ

end Propagation

end Feec.Legacy.MirrorCube
