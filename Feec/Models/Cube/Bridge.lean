module

public import Feec.Legacy.Constraints
public import Feec.Legacy.HodgeWave
public import Feec.HilbertComplex.Equivariant
public import Feec.Semigroup.Spectral
public import Feec.Models.Cube.Basic

/-!
# From the product total space to the window total space

The cube models of `Feec.Models.Cube` are built from the length-two complexes of the
pre-refactor layer (`Feec.Legacy.HilbertComplex2`, whose Hodge wave operator `L` of Thesis (4.5) acts on
`Tot W0 W1 W2 = W0 × W1 × W2`), and their theorems are stated for the window complex
`H.toShort.toHilbertComplex` on `ComplexShape.fin3`, whose wave operator `d − d†` acts on
`PiLp 2 (W3 W0 W1 W2)`. This file is the dictionary between the two.

The coordinate change `totEquiv (σ, u, ρ) = (−σ, u, ρ)` is a unitary map that carries `−L` to the
wave operator of the window (`intertwines_neg_waveOp`): `−L (σ, u, ρ) = (d₀† u, −d₀ σ − d₁† ρ,
d₁ u)`. Hence every isometric group generated by `−L` is conjugate to the wave group
(`totEquiv_S`), its largest invariant subspaces correspond (`mem_Kmax_iff`), and the constraint
spaces `{0} × S₁ × S₂` correspond to the product subspaces `totalSub (sub3 ⊥ S₁ S₂)`
(`mem_Kc_iff`).

The families `sub3` of three subspaces and the compression lemmas shared by all cube models are
in `Feec.Models.Cube.Basic`.

## Main definitions

* `Feec.Models.Cube.totEquiv`: `Tot W0 W1 W2 ≃ₗᵢ[ℝ] PiLp 2 (W3 W0 W1 W2)`.

## Main results

* `intertwines_neg_waveOp`, `intertwines_symm_neg_waveOp`, `mem_domL_iff`.
* `totEquiv_S`: `e (S t x) = e^{tL} (e x)` for every group `S` generated by `−L`.
* `mem_Kmax_iff`, `mem_Kc_iff`, `mem_stationary_iff`.

## References

* [QuennevilleBelair2015], §4.4, (4.5)
-/

open Feec.Legacy

open scoped RealInnerProductSpace
open Set LinearPMap

@[expose] public noncomputable section

universe u

namespace Feec.Models.Cube

open Feec.Legacy.HilbertComplex2 Feec.ShortHilbertComplex Feec.Legacy.Constraints

/- Over `ℝ`, the real structure of `W3` is the one of its inner product space; the instance
`instNormedSpaceRealW3` (meant for `𝕜 = ℂ`) would be a second, non-reducibly-equal one. -/
attribute [-instance] ShortHilbertComplex.instNormedSpaceRealW3

/-! ### The coordinate change -/

variable {W0 W1 W2 : Type u}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2]

/-- The coordinates `(−σ, u, ρ)` of `x = (σ, u, ρ)` as a dependent function on `Fin 3`. -/
def totFun (x : Tot W0 W1 W2) : ∀ i : Fin 3, W3 W0 W1 W2 i
  | 0 => -(tot W0 W1 W2 x).1
  | 1 => (tot W0 W1 W2 x).2.1
  | 2 => (tot W0 W1 W2 x).2.2

/-- The inverse coordinates. -/
def totInv (y : PiLp 2 (W3 W0 W1 W2)) : Tot W0 W1 W2 :=
  (tot W0 W1 W2).symm (-(y 0 : W0), (y 1 : W1), (y 2 : W2))

theorem tot_totInv (y : PiLp 2 (W3 W0 W1 W2)) :
    tot W0 W1 W2 (totInv y) = (-(y 0 : W0), (y 1 : W1), (y 2 : W2)) :=
  LinearEquiv.apply_symm_apply _ _

/-- The coordinate change as a linear equivalence. -/
def totLinearEquiv : Tot W0 W1 W2 ≃ₗ[ℝ] PiLp 2 (W3 W0 W1 W2) where
  toFun x := WithLp.toLp 2 (totFun x)
  map_add' x y := by
    refine ext3 ?_ ?_ ?_
    · show -(tot W0 W1 W2 (x + y)).1 = -(tot W0 W1 W2 x).1 + -(tot W0 W1 W2 y).1
      rw [_root_.map_add, Prod.fst_add, neg_add]
    · show (tot W0 W1 W2 (x + y)).2.1 = (tot W0 W1 W2 x).2.1 + (tot W0 W1 W2 y).2.1
      rw [_root_.map_add]; rfl
    · show (tot W0 W1 W2 (x + y)).2.2 = (tot W0 W1 W2 x).2.2 + (tot W0 W1 W2 y).2.2
      rw [_root_.map_add]; rfl
  map_smul' c x := by
    rw [RingHom.id_apply]
    refine ext3 ?_ ?_ ?_
    · show -(tot W0 W1 W2 (c • x)).1 = c • -(tot W0 W1 W2 x).1
      rw [_root_.map_smul, Prod.smul_fst, smul_neg]
    · show (tot W0 W1 W2 (c • x)).2.1 = c • (tot W0 W1 W2 x).2.1
      rw [_root_.map_smul]; rfl
    · show (tot W0 W1 W2 (c • x)).2.2 = c • (tot W0 W1 W2 x).2.2
      rw [_root_.map_smul]; rfl
  invFun := totInv
  left_inv x := by
    apply (tot W0 W1 W2).injective
    rw [tot_totInv]
    show (-(-(tot W0 W1 W2 x).1), (tot W0 W1 W2 x).2.1, (tot W0 W1 W2 x).2.2) = _
    rw [neg_neg]
  right_inv y := by
    refine ext3 ?_ ?_ ?_
    · show -(tot W0 W1 W2 (totInv y)).1 = (y 0 : W0)
      rw [tot_totInv]
      exact neg_neg _
    · show (tot W0 W1 W2 (totInv y)).2.1 = (y 1 : W1)
      rw [tot_totInv]
    · show (tot W0 W1 W2 (totInv y)).2.2 = (y 2 : W2)
      rw [tot_totInv]

/-- **The coordinate change** `(σ, u, ρ) ↦ (−σ, u, ρ)` from `W0 × W1 × W2` to the window total
space, a unitary map. -/
def totEquiv : Tot W0 W1 W2 ≃ₗᵢ[ℝ] PiLp 2 (W3 W0 W1 W2) :=
  totLinearEquiv.isometryOfInner fun x y => by
    change ⟪WithLp.toLp 2 (totFun x), WithLp.toLp 2 (totFun y)⟫ = _
    rw [PiLp.inner_apply, Fin.sum_univ_three, tot_inner]
    change ⟪-(tot W0 W1 W2 x).1, -(tot W0 W1 W2 y).1⟫ + _ + _ = _
    rw [inner_neg_neg]
    rfl

@[simp] theorem totEquiv_apply_zero (x : Tot W0 W1 W2) :
    (totEquiv x 0 : W0) = -(tot W0 W1 W2 x).1 := rfl

@[simp] theorem totEquiv_apply_one (x : Tot W0 W1 W2) :
    (totEquiv x 1 : W1) = (tot W0 W1 W2 x).2.1 := rfl

@[simp] theorem totEquiv_apply_two (x : Tot W0 W1 W2) :
    (totEquiv x 2 : W2) = (tot W0 W1 W2 x).2.2 := rfl

theorem tot_totEquiv_symm (y : PiLp 2 (W3 W0 W1 W2)) :
    tot W0 W1 W2 (totEquiv.symm y) = (-(y 0 : W0), (y 1 : W1), (y 2 : W2)) :=
  tot_totInv y

/-- The constraint space `{0} × S₁ × S₂` in window coordinates. -/
theorem mem_Kc_iff (S1 : Submodule ℝ W1) (S2 : Submodule ℝ W2) (x : Tot W0 W1 W2) :
    x ∈ Kc W0 S1 S2 ↔ totEquiv x ∈ HilbertComplex.totalSub (sub3 (⊥ : Submodule ℝ W0) S1 S2) := by
  rw [mem_Kc, mem_totalSub_sub3, totEquiv_apply_one, totEquiv_apply_two]
  have h0 : (totEquiv x 0 : W0) ∈ (⊥ : Submodule ℝ W0) ↔ (tot W0 W1 W2 x).1 = 0 := by
    change -((tot W0 W1 W2 x).1) ∈ (⊥ : Submodule ℝ W0) ↔ _
    rw [Submodule.mem_bot, neg_eq_zero]
  rw [h0]
  exact Iff.rfl

theorem map_Kc (S1 : Submodule ℝ W1) (S2 : Submodule ℝ W2) :
    (Kc W0 S1 S2).map (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
      Tot W0 W1 W2 →ₗ[ℝ] PiLp 2 (W3 W0 W1 W2)) =
      HilbertComplex.totalSub (sub3 (⊥ : Submodule ℝ W0) S1 S2) := by
  ext y
  rw [Submodule.mem_map_equiv]
  change totEquiv.symm y ∈ _ ↔ _
  rw [mem_Kc_iff, LinearIsometryEquiv.apply_symm_apply]

/-! ### The wave operators -/

variable [CompleteSpace W0] [CompleteSpace W1] [CompleteSpace W2] (H : HilbertComplex2 W0 W1 W2)

/-- `x ∈ D(L)` iff its coordinates lie in `D(L)` of the window complex. -/
theorem mem_domL_iff {x : Tot W0 W1 W2} :
    x ∈ H.domL ↔ totEquiv x ∈ H.toShort.wave.domain := by
  rw [HilbertComplex2.mem_domL, ShortHilbertComplex.mem_wave_domain]
  have h0 : ((totEquiv x : PiLp 2 (W3 W0 W1 W2)) 0 : W0) ∈ H.d0.domain ↔
      (tot W0 W1 W2 x).1 ∈ H.d0.domain := by
    change -((tot W0 W1 W2 x).1) ∈ H.d0.domain ↔ _
    exact H.d0.domain.neg_mem_iff
  rw [toShort_d₀, h0]
  simp only [totEquiv_apply_one, totEquiv_apply_two, toShort_d₁, midDomain,
    Submodule.mem_inf]
  tauto

/-- **`−L` is the wave operator in the window coordinates**. -/
theorem intertwines_neg_waveOp :
    Intertwines (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
      Tot W0 W1 W2 →L[ℝ] PiLp 2 (W3 W0 W1 W2)) (-H.waveOp)
      H.toShort.wave := by
  refine ⟨fun x => (mem_domL_iff H).1 x.2, fun x => ?_⟩
  have hx : (x : Tot W0 W1 W2) ∈ H.domL := x.2
  set y : H.toShort.wave.domain := ⟨_, (mem_domL_iff H).1 hx⟩
  change H.toShort.wave y = totEquiv ((-H.waveOp) x)
  rw [LinearPMap.neg_apply]
  have hw := HilbertComplex2.tot_waveOp H x
  refine ext3 ?_ ?_ ?_
  · rw [wave_apply_zero, totEquiv_apply_zero, _root_.map_neg, Prod.fst_neg, hw, neg_neg]
    rfl
  · rw [wave_apply_one, totEquiv_apply_one, _root_.map_neg, Prod.snd_neg, Prod.fst_neg, hw]
    have e0 : H.toShort.d₀ ⟨(y : PiLp 2 (W3 W0 W1 W2)) 0, y.2.1 0 1⟩ =
        H.d0 (-(H.pr0 ⟨x.1, x.2⟩)) := rfl
    rw [e0, LinearPMap.map_neg, neg_add, sub_eq_add_neg]
    rfl
  · rw [wave_apply_two, totEquiv_apply_two, _root_.map_neg, Prod.snd_neg, Prod.snd_neg, hw,
      neg_neg]
    rfl

/-- The inverse coordinate change carries the wave operator to `−L`. -/
theorem intertwines_symm_neg_waveOp :
    Intertwines ((totEquiv (W0 := W0) (W1 := W1) (W2 := W2)).symm :
      PiLp 2 (W3 W0 W1 W2) →L[ℝ] Tot W0 W1 W2) H.toShort.wave
      (-H.waveOp) := by
  refine ⟨fun y => ?_, fun y => ?_⟩
  · change totEquiv.symm (y : PiLp 2 (W3 W0 W1 W2)) ∈ H.domL
    rw [mem_domL_iff, LinearIsometryEquiv.apply_symm_apply]; exact y.2
  · have hm : totEquiv.symm (y : PiLp 2 (W3 W0 W1 W2)) ∈ (-H.waveOp).domain := by
      change _ ∈ H.domL
      rw [mem_domL_iff, LinearIsometryEquiv.apply_symm_apply]; exact y.2
    apply totEquiv.injective
    have h := (intertwines_neg_waveOp H).comm ⟨_, hm⟩
    change H.toShort.wave ⟨totEquiv (totEquiv.symm (y : PiLp 2 (W3 W0 W1 W2))), _⟩ =
      totEquiv ((-H.waveOp) ⟨_, hm⟩) at h
    change totEquiv ((-H.waveOp) ⟨_, hm⟩) = totEquiv (totEquiv.symm (H.toShort.wave y))
    rw [LinearIsometryEquiv.apply_symm_apply, ← h]
    congr 1
    exact Subtype.ext (LinearIsometryEquiv.apply_symm_apply _ _)

/-! ### Groups and invariant subspaces -/

/-- **Every isometric group generated by `−L` is the wave group** in window coordinates. -/
theorem totEquiv_S (G : UnitaryGroupGenerator (-H.waveOp)) (t : ℝ) (x : Tot W0 W1 W2) :
    totEquiv (G.S t x) = H.toShort.toHilbertComplex.waveGroup.S t (totEquiv x) := by
  have hJ : Intertwines (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
      Tot W0 W1 W2 →L[ℝ] PiLp 2 (W3 W0 W1 W2))
      G.toC0Group.generator H.toShort.toHilbertComplex.waveGroup.generator := by
    rw [G.generator_toC0Group, HilbertComplex.generator_waveGroup]
    exact intertwines_neg_waveOp H
  exact H.toShort.toHilbertComplex.isIsometric_waveGroup.intertwines_S _ hJ t x

theorem totEquiv_symm_waveGroup (G : UnitaryGroupGenerator (-H.waveOp)) (t : ℝ)
    (y : PiLp 2 (W3 W0 W1 W2)) :
    totEquiv.symm (H.toShort.toHilbertComplex.waveGroup.S t y) = G.S t (totEquiv.symm y) := by
  apply totEquiv.injective
  rw [totEquiv_S H G, LinearIsometryEquiv.apply_symm_apply, LinearIsometryEquiv.apply_symm_apply]

/-- The largest invariant subspace `K* = {x | S t x ∈ K for all t}` of `K` is the invariant core
of the image of `K` under the wave group. -/
theorem mem_Kmax_iff (G : UnitaryGroupGenerator (-H.waveOp)) (K : Submodule ℝ (Tot W0 W1 W2))
    (x : Tot W0 W1 W2) :
    (∀ t, G.S t x ∈ K) ↔ totEquiv x ∈ H.toShort.toHilbertComplex.waveGroup.invariantCore
      (K.map (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
        Tot W0 W1 W2 →ₗ[ℝ] PiLp 2 (W3 W0 W1 W2))) := by
  rw [C0Group.mem_invariantCore]
  refine forall_congr' fun t => ?_
  rw [← totEquiv_S H G, Submodule.mem_map_equiv]
  change _ ↔ totEquiv.symm (totEquiv _) ∈ K
  rw [LinearIsometryEquiv.symm_apply_apply]

theorem mem_stationary_iff (G : UnitaryGroupGenerator (-H.waveOp)) (x : Tot W0 W1 W2) :
    (∀ t, G.S t x = x) ↔ totEquiv x ∈ H.toShort.toHilbertComplex.waveGroup.stationary := by
  rw [C0Group.mem_stationary]
  refine forall_congr' fun t => ?_
  rw [← totEquiv_S H G, totEquiv.injective.eq_iff]

section Stationary

variable {W0 W1 W2 : Type u}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0] [CompleteSpace W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1] [CompleteSpace W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2] [CompleteSpace W2]
  (H : HilbertComplex2 W0 W1 W2)

/-- A datum `x ∈ D(L)` with `L x ≠ 0` is not stationary for the wave group. -/
theorem totEquiv_not_mem_stationary {x : Tot W0 W1 W2} (hx : x ∈ H.domL)
    (hL : H.waveOp ⟨x, hx⟩ ≠ 0) :
    totEquiv x ∉ H.toShort.toHilbertComplex.waveGroup.stationary := by
  intro hs
  have hd : totEquiv x ∈ H.toShort.toHilbertComplex.waveGroup.generator.domain := by
    rw [HilbertComplex.generator_waveGroup]; exact (mem_domL_iff H).1 hx
  have h0 := generator_eq_zero_of_mem_stationary _ ⟨_, hd⟩ hs
  have hw := (intertwines_neg_waveOp H).comm ⟨x, hx⟩
  have e : H.toShort.wave ⟨_, (intertwines_neg_waveOp H).mapsTo ⟨x, hx⟩⟩ = 0 := by
    rw [← h0]
    exact apply_eq_of_eq (HilbertComplex.generator_waveGroup _).symm _ _ rfl
  rw [e, LinearPMap.neg_apply] at hw
  exact hL (neg_eq_zero.1 (totEquiv.map_eq_zero_iff.1 hw.symm))

end Stationary

end Feec.Models.Cube
