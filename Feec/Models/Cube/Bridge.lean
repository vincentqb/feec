module

public import Feec.Legacy.BoundedDomain.SalvageMax
public import Feec.HilbertComplex.Equivariant
public import Feec.Semigroup.Spectral

/-!
# From the product total space to the window total space

The cube models of `Feec.Models.Cube` are built from the length-two complexes of the
pre-refactor layer (`Feec.Legacy.HilbertComplex2`, whose Hodge wave operator `L` of Thesis (4.5) acts on
`Tot W0 W1 W2 = W0 × W1 × W2`), and their theorems are stated for the window complex
`H.toShort.toHilbertComplex` on `ComplexShape.fin3`, whose wave operator `d − d†` acts on
`PiLp 2 (W3 W0 W1 W2)`. This file is the dictionary between the two.

The coordinate change `totEquiv (σ, u, ρ) = (−σ, u, ρ)` is a unitary map that carries `−L` to the
wave operator of the window (`intertwines_neg_waveOp`): `−L (σ, u, ρ) = (d₀† u, −d₀ σ − d₁† ρ,
d₁ u)`. Hence every isometric group generated by `−L` is conjugate to the wave group
(`totEquiv_S`), its largest invariant subspaces correspond (`mem_Kmax_iff`), and the constraint
spaces `{0} × S₁ × S₂` correspond to the product subspaces `totalSub (sub3 ⊥ S₁ S₂)`
(`mem_Kc_iff`).

## Main definitions

* `Feec.Models.Cube.sub3`: a family of three subspaces as a family on `Fin 3`.
* `Feec.Models.Cube.totEquiv`: `Tot W0 W1 W2 ≃ₗᵢ[ℝ] PiLp 2 (W3 W0 W1 W2)`.

## Main results

* `intertwines_neg_waveOp`, `intertwines_symm_neg_waveOp`, `mem_domL_iff`.
* `totEquiv_S`: `e (S t x) = e^{tL} (e x)` for every group `S` generated by `−L`.
* `mem_Kmax_iff`, `mem_Kc_iff`, `mem_stationary_iff`.

## References

* [QuennevilleBelair2015], §4.4, (4.5)
-/

open Feec.Legacy

open scoped RealInnerProductSpace
open Set LinearPMap

@[expose] public noncomputable section

universe u

namespace Feec.Models.Cube

open Feec.Legacy.HilbertComplex2 Feec.ShortHilbertComplex Feec.Legacy.Constraints

/- Over `ℝ`, the real structure of `W3` is the one of its inner product space; the instance
`instNormedSpaceRealW3` (meant for `𝕜 = ℂ`) would be a second, non-reducibly-equal one. -/
attribute [-instance] ShortHilbertComplex.instNormedSpaceRealW3

/-! ### Families of three subspaces -/

section Sub3

variable {𝕜 : Type*} [RCLike 𝕜] {W0 W1 W2 : Type u}
  [NormedAddCommGroup W0] [InnerProductSpace 𝕜 W0] [CompleteSpace W0]
  [NormedAddCommGroup W1] [InnerProductSpace 𝕜 W1] [CompleteSpace W1]
  [NormedAddCommGroup W2] [InnerProductSpace 𝕜 W2] [CompleteSpace W2]

/-- Three subspaces `K₀ ⊆ W0`, `K₁ ⊆ W1`, `K₂ ⊆ W2` as a family on `Fin 3`. -/
def sub3 (K₀ : Submodule 𝕜 W0) (K₁ : Submodule 𝕜 W1) (K₂ : Submodule 𝕜 W2) :
    ∀ i : Fin 3, Submodule 𝕜 (W3 W0 W1 W2 i)
  | 0 => K₀
  | 1 => K₁
  | 2 => K₂

instance instHasOrthogonalProjectionSub3 (K₀ : Submodule 𝕜 W0) (K₁ : Submodule 𝕜 W1)
    (K₂ : Submodule 𝕜 W2) [K₀.HasOrthogonalProjection] [K₁.HasOrthogonalProjection]
    [K₂.HasOrthogonalProjection] : ∀ i, (sub3 K₀ K₁ K₂ i).HasOrthogonalProjection
  | 0 => inferInstanceAs K₀.HasOrthogonalProjection
  | 1 => inferInstanceAs K₁.HasOrthogonalProjection
  | 2 => inferInstanceAs K₂.HasOrthogonalProjection

omit [CompleteSpace W0] [CompleteSpace W1] [CompleteSpace W2] in
theorem mem_totalSub_sub3 {K₀ : Submodule 𝕜 W0} {K₁ : Submodule 𝕜 W1} {K₂ : Submodule 𝕜 W2}
    {x : PiLp 2 (W3 W0 W1 W2)} :
    x ∈ HilbertComplex.totalSub (sub3 K₀ K₁ K₂) ↔
      (x 0 : W0) ∈ K₀ ∧ (x 1 : W1) ∈ K₁ ∧ (x 2 : W2) ∈ K₂ := by
  constructor
  · intro h; exact ⟨h 0, h 1, h 2⟩
  · rintro ⟨h0, h1, h2⟩ i
    fin_cases i
    exacts [h0, h1, h2]

/-- A reducing subcomplex of a short complex from the two reducing pairs. -/
theorem reducingSubcomplex_sub3 (S : ShortHilbertComplex 𝕜 W0 W1 W2) {K₀ : Submodule 𝕜 W0}
    {K₁ : Submodule 𝕜 W1} {K₂ : Submodule 𝕜 W2} [K₀.HasOrthogonalProjection]
    [K₁.HasOrthogonalProjection] [K₂.HasOrthogonalProjection]
    (h₀ : S.d₀.IsReducingPair K₀ K₁) (h₁ : S.d₁.IsReducingPair K₁ K₂) :
    S.toHilbertComplex.ReducingSubcomplex (sub3 K₀ K₁ K₂) := by
  refine HilbertComplex.ReducingSubcomplex.of_rel fun i j hij => ?_
  fin_cases i <;> fin_cases j <;> simp at hij
  exacts [h₀, h₁]

end Sub3

/-! ### The coordinate change -/

variable {W0 W1 W2 : Type u}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2]

/-- Extensionality on the window total space of a short complex. -/
theorem ext3 {V0 V1 V2 : Type u} {x y : PiLp 2 (W3 V0 V1 V2)}
    (h0 : (x 0 : V0) = y 0) (h1 : (x 1 : V1) = y 1) (h2 : (x 2 : V2) = y 2) : x = y := by
  refine PiLp.ext fun i => ?_
  fin_cases i
  exacts [h0, h1, h2]

/-- The first slot of the window total space, with its own type. -/
abbrev slot0 (y : PiLp 2 (W3 W0 W1 W2)) : W0 := y 0

/-- The second slot of the window total space, with its own type. -/
abbrev slot1 (y : PiLp 2 (W3 W0 W1 W2)) : W1 := y 1

/-- The third slot of the window total space, with its own type. -/
abbrev slot2 (y : PiLp 2 (W3 W0 W1 W2)) : W2 := y 2

/-- The coordinates `(−σ, u, ρ)` of `x = (σ, u, ρ)` as a dependent function on `Fin 3`. -/
def totFun (x : Tot W0 W1 W2) : ∀ i : Fin 3, W3 W0 W1 W2 i
  | 0 => -(tot W0 W1 W2 x).1
  | 1 => (tot W0 W1 W2 x).2.1
  | 2 => (tot W0 W1 W2 x).2.2

/-- The inverse coordinates. -/
def totInv (y : PiLp 2 (W3 W0 W1 W2)) : Tot W0 W1 W2 :=
  (tot W0 W1 W2).symm (-(y 0 : W0), (y 1 : W1), (y 2 : W2))

theorem tot_totInv (y : PiLp 2 (W3 W0 W1 W2)) :
    tot W0 W1 W2 (totInv y) = (-(y 0 : W0), (y 1 : W1), (y 2 : W2)) :=
  LinearEquiv.apply_symm_apply _ _

/-- The coordinate change as a linear equivalence. -/
def totLinearEquiv : Tot W0 W1 W2 ≃ₗ[ℝ] PiLp 2 (W3 W0 W1 W2) where
  toFun x := WithLp.toLp 2 (totFun x)
  map_add' x y := by
    refine ext3 ?_ ?_ ?_
    · show -(tot W0 W1 W2 (x + y)).1 = -(tot W0 W1 W2 x).1 + -(tot W0 W1 W2 y).1
      rw [_root_.map_add, Prod.fst_add, neg_add]
    · show (tot W0 W1 W2 (x + y)).2.1 = (tot W0 W1 W2 x).2.1 + (tot W0 W1 W2 y).2.1
      rw [_root_.map_add]; rfl
    · show (tot W0 W1 W2 (x + y)).2.2 = (tot W0 W1 W2 x).2.2 + (tot W0 W1 W2 y).2.2
      rw [_root_.map_add]; rfl
  map_smul' c x := by
    rw [RingHom.id_apply]
    refine ext3 ?_ ?_ ?_
    · show -(tot W0 W1 W2 (c • x)).1 = c • -(tot W0 W1 W2 x).1
      rw [_root_.map_smul, Prod.smul_fst, smul_neg]
    · show (tot W0 W1 W2 (c • x)).2.1 = c • (tot W0 W1 W2 x).2.1
      rw [_root_.map_smul]; rfl
    · show (tot W0 W1 W2 (c • x)).2.2 = c • (tot W0 W1 W2 x).2.2
      rw [_root_.map_smul]; rfl
  invFun := totInv
  left_inv x := by
    apply (tot W0 W1 W2).injective
    rw [tot_totInv]
    show (-(-(tot W0 W1 W2 x).1), (tot W0 W1 W2 x).2.1, (tot W0 W1 W2 x).2.2) = _
    rw [neg_neg]
  right_inv y := by
    refine ext3 ?_ ?_ ?_
    · show -(tot W0 W1 W2 (totInv y)).1 = (y 0 : W0)
      rw [tot_totInv]
      exact neg_neg _
    · show (tot W0 W1 W2 (totInv y)).2.1 = (y 1 : W1)
      rw [tot_totInv]
    · show (tot W0 W1 W2 (totInv y)).2.2 = (y 2 : W2)
      rw [tot_totInv]

/-- **The coordinate change** `(σ, u, ρ) ↦ (−σ, u, ρ)` from `W0 × W1 × W2` to the window total
space, a unitary map. -/
def totEquiv : Tot W0 W1 W2 ≃ₗᵢ[ℝ] PiLp 2 (W3 W0 W1 W2) :=
  totLinearEquiv.isometryOfInner fun x y => by
    change ⟪WithLp.toLp 2 (totFun x), WithLp.toLp 2 (totFun y)⟫ = _
    rw [PiLp.inner_apply, Fin.sum_univ_three, tot_inner]
    change ⟪-(tot W0 W1 W2 x).1, -(tot W0 W1 W2 y).1⟫ + _ + _ = _
    rw [inner_neg_neg]
    rfl

@[simp] theorem totEquiv_apply_zero (x : Tot W0 W1 W2) :
    (totEquiv x 0 : W0) = -(tot W0 W1 W2 x).1 := rfl

@[simp] theorem totEquiv_apply_one (x : Tot W0 W1 W2) :
    (totEquiv x 1 : W1) = (tot W0 W1 W2 x).2.1 := rfl

@[simp] theorem totEquiv_apply_two (x : Tot W0 W1 W2) :
    (totEquiv x 2 : W2) = (tot W0 W1 W2 x).2.2 := rfl

theorem tot_totEquiv_symm (y : PiLp 2 (W3 W0 W1 W2)) :
    tot W0 W1 W2 (totEquiv.symm y) = (-(y 0 : W0), (y 1 : W1), (y 2 : W2)) :=
  tot_totInv y

/-- The constraint space `{0} × S₁ × S₂` in window coordinates. -/
theorem mem_Kc_iff (S1 : Submodule ℝ W1) (S2 : Submodule ℝ W2) (x : Tot W0 W1 W2) :
    x ∈ Kc W0 S1 S2 ↔ totEquiv x ∈ HilbertComplex.totalSub (sub3 (⊥ : Submodule ℝ W0) S1 S2) := by
  rw [mem_Kc, mem_totalSub_sub3, totEquiv_apply_one, totEquiv_apply_two]
  have h0 : (totEquiv x 0 : W0) ∈ (⊥ : Submodule ℝ W0) ↔ (tot W0 W1 W2 x).1 = 0 := by
    change -((tot W0 W1 W2 x).1) ∈ (⊥ : Submodule ℝ W0) ↔ _
    rw [Submodule.mem_bot, neg_eq_zero]
  rw [h0]
  exact Iff.rfl

theorem map_Kc (S1 : Submodule ℝ W1) (S2 : Submodule ℝ W2) :
    (Kc W0 S1 S2).map (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
      Tot W0 W1 W2 →ₗ[ℝ] PiLp 2 (W3 W0 W1 W2)) =
      HilbertComplex.totalSub (sub3 (⊥ : Submodule ℝ W0) S1 S2) := by
  ext y
  rw [Submodule.mem_map_equiv]
  change totEquiv.symm y ∈ _ ↔ _
  rw [mem_Kc_iff, LinearIsometryEquiv.apply_symm_apply]

/-! ### The wave operators -/

variable [CompleteSpace W0] [CompleteSpace W1] [CompleteSpace W2] (H : HilbertComplex2 W0 W1 W2)

/-- `x ∈ D(L)` iff its coordinates lie in `D(L)` of the window complex. -/
theorem mem_domL_iff {x : Tot W0 W1 W2} :
    x ∈ H.domL ↔ totEquiv x ∈ H.toShort.wave.domain := by
  rw [HilbertComplex2.mem_domL, ShortHilbertComplex.mem_wave_domain]
  have h0 : ((totEquiv x : PiLp 2 (W3 W0 W1 W2)) 0 : W0) ∈ H.d0.domain ↔
      (tot W0 W1 W2 x).1 ∈ H.d0.domain := by
    change -((tot W0 W1 W2 x).1) ∈ H.d0.domain ↔ _
    exact H.d0.domain.neg_mem_iff
  rw [toShort_d₀, h0]
  simp only [totEquiv_apply_one, totEquiv_apply_two, toShort_d₁, midDomain,
    Submodule.mem_inf]
  tauto

/-- **`−L` is the wave operator in the window coordinates**. -/
theorem intertwines_neg_waveOp :
    Intertwines (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
      Tot W0 W1 W2 →L[ℝ] PiLp 2 (W3 W0 W1 W2)) (-H.waveOp)
      H.toShort.wave := by
  refine ⟨fun x => (mem_domL_iff H).1 x.2, fun x => ?_⟩
  have hx : (x : Tot W0 W1 W2) ∈ H.domL := x.2
  set y : H.toShort.wave.domain := ⟨_, (mem_domL_iff H).1 hx⟩
  change H.toShort.wave y = totEquiv ((-H.waveOp) x)
  rw [LinearPMap.neg_apply]
  have hw := HilbertComplex2.tot_waveOp H x
  refine ext3 ?_ ?_ ?_
  · rw [wave_apply_zero, totEquiv_apply_zero, _root_.map_neg, Prod.fst_neg, hw, neg_neg]
    rfl
  · rw [wave_apply_one, totEquiv_apply_one, _root_.map_neg, Prod.snd_neg, Prod.fst_neg, hw]
    have e0 : H.toShort.d₀ ⟨(y : PiLp 2 (W3 W0 W1 W2)) 0, y.2.1 0 1⟩ =
        H.d0 (-(H.pr0 ⟨x.1, x.2⟩)) := rfl
    rw [e0, LinearPMap.map_neg, neg_add, sub_eq_add_neg]
    rfl
  · rw [wave_apply_two, totEquiv_apply_two, _root_.map_neg, Prod.snd_neg, Prod.snd_neg, hw,
      neg_neg]
    rfl

/-- The inverse coordinate change carries the wave operator to `−L`. -/
theorem intertwines_symm_neg_waveOp :
    Intertwines ((totEquiv (W0 := W0) (W1 := W1) (W2 := W2)).symm :
      PiLp 2 (W3 W0 W1 W2) →L[ℝ] Tot W0 W1 W2) H.toShort.wave
      (-H.waveOp) := by
  refine ⟨fun y => ?_, fun y => ?_⟩
  · change totEquiv.symm (y : PiLp 2 (W3 W0 W1 W2)) ∈ H.domL
    rw [mem_domL_iff, LinearIsometryEquiv.apply_symm_apply]; exact y.2
  · have hm : totEquiv.symm (y : PiLp 2 (W3 W0 W1 W2)) ∈ (-H.waveOp).domain := by
      change _ ∈ H.domL
      rw [mem_domL_iff, LinearIsometryEquiv.apply_symm_apply]; exact y.2
    apply totEquiv.injective
    have h := (intertwines_neg_waveOp H).comm ⟨_, hm⟩
    change H.toShort.wave ⟨totEquiv (totEquiv.symm (y : PiLp 2 (W3 W0 W1 W2))), _⟩ =
      totEquiv ((-H.waveOp) ⟨_, hm⟩) at h
    change totEquiv ((-H.waveOp) ⟨_, hm⟩) = totEquiv (totEquiv.symm (H.toShort.wave y))
    rw [LinearIsometryEquiv.apply_symm_apply, ← h]
    congr 1
    exact Subtype.ext (LinearIsometryEquiv.apply_symm_apply _ _)

/-! ### Groups and invariant subspaces -/

/-- **Every isometric group generated by `−L` is the wave group** in window coordinates. -/
theorem totEquiv_S (G : UnitaryGroupGenerator (-H.waveOp)) (t : ℝ) (x : Tot W0 W1 W2) :
    totEquiv (G.S t x) = H.toShort.toHilbertComplex.waveGroup.S t (totEquiv x) := by
  have hJ : Intertwines (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
      Tot W0 W1 W2 →L[ℝ] PiLp 2 (W3 W0 W1 W2))
      G.toC0Group.generator H.toShort.toHilbertComplex.waveGroup.generator := by
    rw [G.generator_toC0Group, HilbertComplex.generator_waveGroup]
    exact intertwines_neg_waveOp H
  exact H.toShort.toHilbertComplex.isIsometric_waveGroup.intertwines_S _ hJ t x

theorem totEquiv_symm_waveGroup (G : UnitaryGroupGenerator (-H.waveOp)) (t : ℝ)
    (y : PiLp 2 (W3 W0 W1 W2)) :
    totEquiv.symm (H.toShort.toHilbertComplex.waveGroup.S t y) = G.S t (totEquiv.symm y) := by
  apply totEquiv.injective
  rw [totEquiv_S H G, LinearIsometryEquiv.apply_symm_apply, LinearIsometryEquiv.apply_symm_apply]

/-- The largest invariant subspace `K*` of `K` is the invariant core of the image of `K` under
the wave group. -/
theorem mem_Kmax_iff (G : UnitaryGroupGenerator (-H.waveOp)) (K : Submodule ℝ (Tot W0 W1 W2))
    (x : Tot W0 W1 W2) :
    x ∈ Kmax G K ↔ totEquiv x ∈ H.toShort.toHilbertComplex.waveGroup.invariantCore
      (K.map (totEquiv (W0 := W0) (W1 := W1) (W2 := W2) :
        Tot W0 W1 W2 →ₗ[ℝ] PiLp 2 (W3 W0 W1 W2))) := by
  rw [mem_Kmax, C0Group.mem_invariantCore]
  refine forall_congr' fun t => ?_
  rw [← totEquiv_S H G, Submodule.mem_map_equiv]
  change _ ↔ totEquiv.symm (totEquiv _) ∈ K
  rw [LinearIsometryEquiv.symm_apply_apply]

theorem mem_stationary_iff (G : UnitaryGroupGenerator (-H.waveOp)) (x : Tot W0 W1 W2) :
    (∀ t, G.S t x = x) ↔ totEquiv x ∈ H.toShort.toHilbertComplex.waveGroup.stationary := by
  rw [C0Group.mem_stationary]
  refine forall_congr' fun t => ?_
  rw [← totEquiv_S H G, totEquiv.injective.eq_iff]

/-! ### Invariant cores of compressions -/

section Compression

variable {ι : Type*} [Fintype ι] {c : ComplexShape ι} {W : ι → Type*}
  [∀ i, NormedAddCommGroup (W i)] [∀ i, InnerProductSpace ℝ (W i)] [∀ i, CompleteSpace (W i)]
  {H : HilbertComplex ℝ c W} {S : ∀ i, Submodule ℝ (W i)} [∀ i, (S i).HasOrthogonalProjection]
  [∀ i, CompleteSpace (S i)]

omit [∀ i, CompleteSpace (W i)] in
theorem totalIncl_injective (S : ∀ i, Submodule ℝ (W i)) :
    Function.Injective (HilbertComplex.ReducingSubcomplex.totalIncl S) :=
  (HilbertComplex.ReducingSubcomplex.totalIncl S).injective

/-- The constraint family `K` seen inside the compressed spaces `S i`. -/
def compSub (S : ∀ i, Submodule ℝ (W i)) (K : ∀ i, Submodule ℝ (W i)) :
    ∀ i, Submodule ℝ (S i) := fun i => (K i).comap (S i).subtype

omit [∀ i, CompleteSpace (W i)] [∀ i, (S i).HasOrthogonalProjection] [∀ i, CompleteSpace (S i)] in
theorem mem_totalSub_compSub {K : ∀ i, Submodule ℝ (W i)} {y : PiLp 2 fun i => S i} :
    y ∈ HilbertComplex.totalSub (compSub S K) ↔
      HilbertComplex.ReducingSubcomplex.totalIncl S y ∈ HilbertComplex.totalSub K :=
  Iff.rfl

/-- **Invariant cores of a compression are invariant cores of the big complex**: for a reducing
subcomplex `S` of `H` and any family `K`, `y` lies in the invariant core of `∏ (K i ∩ S i)` for
the compressed wave group iff its inclusion lies in the invariant core of `∏ K i` for the wave
group of `H`. -/
theorem mem_invariantCore_compSub_iff (h : H.ReducingSubcomplex S) (K : ∀ i, Submodule ℝ (W i))
    (y : PiLp 2 fun i => S i) :
    y ∈ h.toHilbertComplex.waveGroup.invariantCore (HilbertComplex.totalSub (compSub S K)) ↔
      HilbertComplex.ReducingSubcomplex.totalIncl S y ∈
        H.waveGroup.invariantCore (HilbertComplex.totalSub K) := by
  simp only [C0Group.mem_invariantCore, mem_totalSub_compSub, h.waveGroup_toHilbertComplex]

/-- Stationary vectors of a compression are the stationary vectors of the big complex. -/
theorem mem_stationary_compSub_iff (h : H.ReducingSubcomplex S) (y : PiLp 2 fun i => S i) :
    y ∈ h.toHilbertComplex.waveGroup.stationary ↔
      HilbertComplex.ReducingSubcomplex.totalIncl S y ∈ H.waveGroup.stationary := by
  simp only [C0Group.mem_stationary]
  refine forall_congr' fun t => ?_
  rw [← h.waveGroup_toHilbertComplex, (totalIncl_injective S).eq_iff]

/-- Forward orbits of a compression are the forward orbits of the big complex. -/
theorem forward_compSub_iff (h : H.ReducingSubcomplex S) (K : ∀ i, Submodule ℝ (W i))
    (y : PiLp 2 fun i => S i) :
    (∀ t, 0 ≤ t → h.toHilbertComplex.waveGroup.S t y ∈ HilbertComplex.totalSub (compSub S K)) ↔
      ∀ t, 0 ≤ t → H.waveGroup.S t (HilbertComplex.ReducingSubcomplex.totalIncl S y) ∈
        HilbertComplex.totalSub K := by
  simp only [mem_totalSub_compSub, h.waveGroup_toHilbertComplex]

/-- The domain of the wave operator of a compression. -/
theorem mem_wave_domain_compress_iff (h : H.ReducingSubcomplex S) (y : PiLp 2 fun i => S i) :
    y ∈ h.toHilbertComplex.wave.domain ↔
      HilbertComplex.ReducingSubcomplex.totalIncl S y ∈ H.wave.domain := by
  rw [HilbertComplex.mem_wave_domain, HilbertComplex.mem_wave_domain]
  refine and_congr Iff.rfl (forall_congr' fun i => forall_congr' fun j => ?_)
  change y j ∈ (h.toHilbertComplex.dual.d j i).domain ↔ _
  rw [HilbertComplex.ReducingSubcomplex.dual_toHilbertComplex_d]
  exact Iff.rfl

end Compression

/-! ### Constraints invariant under a unitary action -/

section Action

variable {ι : Type*} [Fintype ι] {c : ComplexShape ι} {W : ι → Type*}
  [∀ i, NormedAddCommGroup (W i)] [∀ i, InnerProductSpace ℝ (W i)] [∀ i, CompleteSpace (W i)]
  {H : HilbertComplex ℝ c W} {Γ : Type*} [Group Γ] [Fintype Γ]

/-- A unitary preserving a closed subspace `K` and its inverse commutes with `P_K`. -/
theorem starProjection_comm_of_invariant {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (U : E ≃ₗᵢ[ℝ] E) (K : Submodule ℝ E) [K.HasOrthogonalProjection]
    (hU : ∀ x ∈ K, U x ∈ K) (hU' : ∀ x ∈ K, U.symm x ∈ K) (x : E) :
    K.starProjection (U x) = U (K.starProjection x) := by
  refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero (u := U x)
    (hU _ (K.starProjection_apply_mem x)) fun k hk => ?_
  rw [← _root_.map_sub, show k = U (U.symm k) from (U.apply_symm_apply k).symm,
    U.inner_map_map]
  exact K.starProjection_inner_eq_zero x _ (hU' k hk)

instance instHasOrthogonalProjectionCompSub (S : ∀ i, Submodule ℝ (W i))
    [∀ i, CompleteSpace (S i)] (K : ∀ i, Submodule ℝ (W i)) [∀ i, (K i).HasOrthogonalProjection]
    (i : ι) : (compSub S K i).HasOrthogonalProjection := by
  have hc : IsClosed (compSub S K i : Set (S i)) :=
    ((K i).isClosed_of_hasOrthogonalProjection).preimage continuous_subtype_val
  have : CompleteSpace (compSub S K i) := hc.completeSpace_coe
  infer_instance

omit [Fintype ι] in
/-- **Invariant constraints descend to the fixed complex**: if `K` is a reducing subcomplex of `H`
whose spaces are preserved by a finite unitary action, then `K ∩ Fix` is a reducing subcomplex
of the fixed (method-of-images) complex. -/
theorem reducingSubcomplex_compSub_fixed (A : H.Action Γ) {K : ∀ i, Submodule ℝ (W i)}
    [∀ i, (K i).HasOrthogonalProjection] (hK : H.ReducingSubcomplex K)
    (hA : ∀ g i, ∀ x ∈ K i, A.act g i x ∈ K i) :
    A.fixedComplex.ReducingSubcomplex (compSub A.fixed K) := by
  have hS : ∀ i (x : A.fixed i), ∃ y : A.fixed i,
      A.reducingSubcomplex_fixed.toScaledEmbedding.J i y = (K i).starProjection
        (A.reducingSubcomplex_fixed.toScaledEmbedding.J i x) := by
    intro i x
    refine ⟨⟨(K i).starProjection x, fun g => ?_⟩, rfl⟩
    have hinv : ∀ y ∈ K i, (A.act g i).symm y ∈ K i := fun y hy => by
      have e : (A.act g i).symm y = A.act g⁻¹ i y := by
        apply (A.act g i).injective
        rw [LinearIsometryEquiv.apply_symm_apply, A.act_act_inv]
      rw [e]; exact hA g⁻¹ i y hy
    rw [← starProjection_comm_of_invariant (A.act g i) (K i) (hA g i) hinv, x.2 g]
  exact A.reducingSubcomplex_fixed.toScaledEmbedding.reducingSubcomplex_comap hK hS

end Action

/-! ### Zero differentials -/

/-- Two zero differentials commute with any pair of maps. -/
theorem comm_of_eq_zero {E F E' F' : Type*} [AddCommGroup E] [Module ℝ E] [AddCommGroup F]
    [Module ℝ F] [AddCommGroup E'] [Module ℝ E'] [AddCommGroup F'] [Module ℝ F']
    {T : E →ₗ.[ℝ] F} {T' : E' →ₗ.[ℝ] F'} (hT : T = 0) (hT' : T' = 0) (J : E →ₗ[ℝ] E')
    (J' : F →ₗ[ℝ] F') (κ : ℝ) (x : T.domain) (h : J x ∈ T'.domain) :
    T' ⟨J x, h⟩ = κ • J' (T x) := by
  rw [LinearPMap.apply_eq_zero_of_eq_zero hT', LinearPMap.apply_eq_zero_of_eq_zero hT x,
    _root_.map_zero, smul_zero]

/-! ### Stationary vectors -/

/-- A stationary vector in the domain of the generator is killed by the generator. -/
theorem generator_eq_zero_of_mem_stationary {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [CompleteSpace E] (G : C0Group ℝ E) (x : G.generator.domain)
    (hx : (x : E) ∈ G.stationary) : G.generator x = 0 := by
  refine G.generator_apply_eq ?_
  have e : (fun t => G.S t x) = fun _ => (x : E) := funext (C0Group.mem_stationary.1 hx)
  rw [e]
  exact hasDerivAt_const _ _

section Stationary

variable {W0 W1 W2 : Type u}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0] [CompleteSpace W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1] [CompleteSpace W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2] [CompleteSpace W2]
  (H : HilbertComplex2 W0 W1 W2)

/-- A datum `x ∈ D(L)` with `L x ≠ 0` is not stationary for the wave group. -/
theorem totEquiv_not_mem_stationary {x : Tot W0 W1 W2} (hx : x ∈ H.domL)
    (hL : H.waveOp ⟨x, hx⟩ ≠ 0) :
    totEquiv x ∉ H.toShort.toHilbertComplex.waveGroup.stationary := by
  intro hs
  have hd : totEquiv x ∈ H.toShort.toHilbertComplex.waveGroup.generator.domain := by
    rw [HilbertComplex.generator_waveGroup]; exact (mem_domL_iff H).1 hx
  have h0 := generator_eq_zero_of_mem_stationary _ ⟨_, hd⟩ hs
  have hw := (intertwines_neg_waveOp H).comm ⟨x, hx⟩
  have e : H.toShort.wave ⟨_, (intertwines_neg_waveOp H).mapsTo ⟨x, hx⟩⟩ = 0 := by
    rw [← h0]
    exact apply_eq_of_eq (HilbertComplex.generator_waveGroup _).symm _ _ rfl
  rw [e, LinearPMap.neg_apply] at hw
  exact hL (neg_eq_zero.1 (totEquiv.map_eq_zero_iff.1 hw.symm))

end Stationary

