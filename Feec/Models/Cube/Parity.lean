module

public import Feec.Models.Cube.Bridge
public import Feec.Models.Cube.Reflection
public import Feec.Legacy.Box.RowWise

/-!
# The cube by the method of images: reflection actions and the thesis' boundary conditions

The cube `Q = (0, ½)³` is a fundamental domain of the group `(ℤ/2)³` generated by the
reflections `x_i ↦ -x_i` of the torus `𝕋³ = ℝ³/ℤ³`. A field on `Q` with homogeneous boundary
conditions on the faces is a field on `𝕋³` with prescribed parities in each variable (odd in
`x_i`: Dirichlet on the faces `x_i ∈ {0, ½}`). So a Hilbert complex on the cube is the subcomplex
of a torus complex fixed by a unitary action of `(ℤ/2)³` (**method of images**,
`Feec.HilbertComplex.Action.fixedComplex`).

The reflection actions (`reflAction`, `Feec.Models.Cube.Reflection`) are shared with the mirror
models; this file treats the boundary conditions of the thesis' complex
`H̊¹(V) → H̊(curl; M) → L²(M)` ([QuennevilleBelair2015, §4.10]): `σ` odd in every variable,
`E_{ab}` even in `x_b` and odd in the others, `B_{ab}` odd in `x_b` and even in the others
(`rowAction`, `Parity.complex`). For these boundary conditions the largest invariant subspace of
any constraint space `{0} × S₁ × S₂` with `S₁`, `S₂` symmetric and trace-free on the cube consists
of the stationary data (`Parity.mem_invariantCore_iff`); for the thesis' constraint
`K = {0} × L²(TSD) × L²(TSD)` these are the data `(0, 0, B₀)` with `B₀` TSD and curl-free
(`Parity.mem_invariantCore_tsd_iff`). The forward-in-time version and the nonzero stationary
data are in `Feec.Models.Cube.Static`.

## Main definitions

* `Feec.Models.Cube.rowAction`, `Feec.Models.Cube.Parity.complex`.

## Main results

* `Parity.mem_invariantCore_torus_iff`, **`Parity.mem_invariantCore_iff`**,
  **`Parity.mem_invariantCore_tsd_iff`**.

## References

* [QuennevilleBelair2015], §4.10 (Prop 4.17)
* [Brezis2011], §9.2 (extension by reflection)
-/

open Feec.Legacy

open scoped RealInnerProductSpace
open Set LinearPMap

@[expose] public noncomputable section

universe u

namespace Feec.Models.Cube

open Feec.Legacy.HilbertComplex2 Feec.ShortHilbertComplex Feec.Legacy.Constraints Feec.Legacy.Torus Feec.Legacy.Box

attribute [-instance] ShortHilbertComplex.instNormedSpaceRealW3


/-! ### The thesis' boundary conditions -/

/-- **The parities of the thesis' boundary conditions** (`σ = 0`, `E_a × n = 0`, no condition on
`B`): `σ` odd in every variable, `E_{ab}` even in `x_b` and odd in the others, `B_{ab}` odd in
`x_b` and even in the others. -/
def rowAction : torus.Action ReflGroup :=
  reflAction periodicComplex.toShort intertwines_grad_row intertwines_curl_row

namespace Parity

/-- **The cube complex with the thesis' boundary conditions**, `H̊¹(V) → H̊(curl; M) → L²(M)` on
`Q = (0, ½)³`, as the subcomplex of the torus complex fixed by `rowAction`.
Thesis: §4.10 -/
abbrev complex := rowAction.fixedComplex

/-- The constraint family `{0} × S₁ × S₂` of the torus. -/
abbrev constraint (S1 S2 : Submodule ℝ L2M) : ∀ i : Fin 3, Submodule ℝ (W3 L2V L2M L2M i) :=
  sub3 (⊥ : Submodule ℝ L2V) S1 S2

/-- **`K*` on the cube with the thesis' boundary conditions, on the torus side**: for closed
`S₁ ≤ ParRow 1`, `S₂ ≤ ParRow (-1)`, both symmetric and trace-free on the cube, a datum lies in
the largest invariant subspace of `K = {0} × S₁ × S₂` for the torus wave group iff it lies in
`K` and is stationary.
Thesis: Prop 4.17 (corrected) -/
theorem mem_invariantCore_torus_iff {S1 S2 : Submodule ℝ L2M} [S1.HasOrthogonalProjection]
    [S2.HasOrthogonalProjection] (hS1 : S1 ≤ ParRow 1 ⊓ boxSym ⊓ boxTr)
    (hS2 : S2 ≤ ParRow (-1) ⊓ boxSym ⊓ boxTr) (y : PiLp 2 (W3 L2V L2M L2M)) :
    y ∈ torus.waveGroup.invariantCore (HilbertComplex.totalSub (constraint S1 S2)) ↔
      y ∈ HilbertComplex.totalSub (constraint S1 S2) ∧ y ∈ torus.waveGroup.stationary := by
  obtain ⟨x, rfl⟩ := totEquiv.surjective y
  rw [← map_Kc, ← mem_Kmax_iff periodicComplex periodicGroup, ← Feec.Legacy.Constraints.mem_Kmax, Feec.Legacy.Box.mem_Kmax_iff hS1 hS2,
    mem_Kc_iff, mem_stationary_iff periodicComplex periodicGroup, map_Kc]

/-- **`K*` on the cube with the thesis' boundary conditions**: for the cube complex and closed
`S₁ ≤ ParRow 1`, `S₂ ≤ ParRow (-1)` symmetric and trace-free on the cube, the largest invariant
subspace of `K = {0} × S₁ × S₂` under the wave group consists of the stationary data in `K`.
Thesis: Prop 4.17 (corrected) -/
theorem mem_invariantCore_iff {S1 S2 : Submodule ℝ L2M} [S1.HasOrthogonalProjection]
    [S2.HasOrthogonalProjection] (hS1 : S1 ≤ ParRow 1 ⊓ boxSym ⊓ boxTr)
    (hS2 : S2 ≤ ParRow (-1) ⊓ boxSym ⊓ boxTr) (y : PiLp 2 fun i => rowAction.fixed i) :
    y ∈ complex.waveGroup.invariantCore
        (HilbertComplex.totalSub (compSub rowAction.fixed (constraint S1 S2))) ↔
      y ∈ HilbertComplex.totalSub (compSub rowAction.fixed (constraint S1 S2)) ∧
        y ∈ complex.waveGroup.stationary := by
  rw [mem_invariantCore_compSub_iff, mem_invariantCore_torus_iff hS1 hS2,
    mem_stationary_compSub_iff]
  rfl

/-- **`K*` on the cube for the thesis' constraint, explicitly**: on the torus side, a datum lies in
the largest invariant subspace of `K = {0} × L²(TSD) × L²(TSD)` iff it is `(0, 0, B₀)` with
`B₀ ∈ L²(TSD)` on the cube and curl-free (on the Fourier side, `curl_ξ B̂₀(k) = 0`).
Thesis: Prop 4.17 (corrected) -/
theorem mem_invariantCore_tsd_iff (y : PiLp 2 (W3 L2V L2M L2M)) :
    y ∈ torus.waveGroup.invariantCore
        (HilbertComplex.totalSub (constraint (boxTSD 1) (boxTSD (-1)))) ↔
      (y 0 : L2V) = 0 ∧ (y 1 : L2M) = 0 ∧ (y 2 : L2M) ∈ boxTSD (-1) ∧
        ∀ k, curlSym (freq k) (slot2 y k) = 0 := by
  obtain ⟨x, rfl⟩ := totEquiv.surjective y
  rw [← map_Kc, ← mem_Kmax_iff periodicComplex periodicGroup, ← Feec.Legacy.Constraints.mem_Kmax, Feec.Legacy.Box.mem_Kmax_boxTSD_iff,
    totEquiv_apply_one, totEquiv_apply_two]
  have h0 : ((totEquiv x : PiLp 2 (W3 L2V L2M L2M)) 0 : L2V) = 0 ↔ (tot L2V L2M L2M x).1 = 0 := by
    change -((tot L2V L2M L2M x).1) = 0 ↔ _
    exact neg_eq_zero
  rw [h0]
  constructor
  · rintro ⟨B, hB, hc, rfl⟩
    rw [tot_ini]
    exact ⟨rfl, rfl, hB, hc⟩
  · rintro ⟨e0, e1, hB, hc⟩
    refine ⟨_, hB, hc, (tot L2V L2M L2M).injective ?_⟩
    rw [tot_ini]
    exact Prod.ext e0 (Prod.ext e1 rfl)

end Parity

end Feec.Models.Cube
