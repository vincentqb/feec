module

public import Feec.Models.Cube.Reflection
public import Feec.Fourier.TorusSpectral
public import Feec.Domain.Operators

/-!
# The cube with the thesis' boundary conditions: the row-wise parity model

The cube `Q = (0, ½)³` is a fundamental domain of the group `(ℤ/2)³` generated by the reflections
`x_k ↦ -x_k` of the torus `𝕋³ = ℝ³/ℤ³`. A field on `Q` with homogeneous boundary conditions on
the faces is a field on `𝕋³` with prescribed parities in each variable (odd in `x_k`: Dirichlet
on the faces `x_k ∈ {0, ½}`), so a Hilbert complex on the cube is the subcomplex of a torus
complex fixed by a unitary action of `(ℤ/2)³` (**method of images**,
`Feec.HilbertComplex.Action.fixedComplex`).

This file treats the boundary conditions of the thesis' complex
`H̊¹(V) → H̊(curl; M) → L²(M)` ([QuennevilleBelair2015], §4.10): `σ` odd in every variable,
`E_{ab}` even in `x_b` and odd in the others (`E_a × n = 0`), `B_{ab}` odd in `x_b` and even in
the others (no condition). On the Fourier side of the real torus grad–curl complex
(`Feec.Models.Cube.RealTorus.gradCurl`) the reflection `x_k ↦ -x_k` acts by
`n ↦ flip_k n` on the frequencies and by `σ ↦ -σ`, `E ↦ -E D_k`, `B ↦ B D_k` on the fibres
(`D_k = diag(±1)`, `-1` in position `k`): these are the **row-wise reflections**
(`Parity.symmetries`, `rowAction`), and the cube complex is their fixed complex
(`Parity.complex`). The constraints are imposed on the cube: `boxSym`, `boxTr`, `boxDiv`
(symmetric, trace-free and weakly divergence-free after restriction to `Q`).

**Only stationary data propagate** (`Parity.mem_invariantCore_iff`): for closed `S₁`, `S₂` of
symmetric trace-free fields on the cube in the electric and magnetic parity classes, the largest
invariant subspace of `K = {0} × S₁ × S₂` under the wave group consists of the stationary data in
`K`. The proof is spectral: the torus wave group has an eigenbasis
(`Feec.Fourier.Torus.eigenDense_waveGroup`), the eigenvectors of `L²` with eigenvalue `-ω²`,
`ω > 0`, are trigonometric polynomials (`Parity.exists_finset_of_isEigenSq`: the only nonzero
eigenvalue of the fibre `-W_ξ²` is `|ξ|²`), and a trigonometric polynomial of a row-wise parity
class that is symmetric and trace-free on the cube vanishes
(`Parity.eq_zero_of_finite_of_parity`, by analytic continuation from the cube to the torus).
For the thesis' constraint `K = {0} × L²(TSD) × L²(TSD)` these are the data `(0, 0, B₀)` with
`B₀` TSD and curl-free (`Parity.mem_invariantCore_tsd_iff`).

## Main definitions

* `Parity.symmetries`, `Parity.refl`, `Parity.cnj`, `Parity.rowInvolutions`,
  `Parity.realInvolutions`; `rowAction` (an action of `ReflGroup = (ℤ/2)³` on the real torus
  complex) and `Parity.realAction` (with the real structure).
* `Parity.complex`: the cube complex `rowAction.fixedComplex`.
* `Parity.resM`, `Parity.boxSym`, `Parity.boxTr`, `Parity.boxDiv`; `Parity.tsdE`, `Parity.tsdB`
  (`L²(TSD)` on the cube in the electric and magnetic parity classes).

## Main results

* `Parity.symAlong`: the grad–curl symbol complex along a frequency map `ξ : ℤ³ → ℝ³`;
  `Parity.waveSym_symAlong_zero`, `Parity.waveSym_symAlong_one`, `Parity.waveSym_symAlong_two`,
  `Parity.eq_zero_of_waveSym_symAlong_sq`, `Parity.eigenDense_symAlong`,
  **`Parity.mem_invariantCore_symAlong_iff`**, `Parity.eq_zero_of_mem_stationary_symAlong`: the
  spectral facts along `ξ`, of which the torus (`ξ = freq`) and the anisotropic torus of
  `Feec.Models.Box` are instances.
* `Parity.eq_zero_of_waveSym_sq`: the eigenvalues of the square of the grad–curl wave symbol.
* `Parity.isPurePoint_torus`, `Parity.eigenDense_torus`.
* `Parity.eq_zero_of_finite_of_parity`, `Parity.exists_finset_of_isEigenSq`,
  `Parity.mem_stationary_iff`.
* **`Parity.mem_invariantCore_torus_iff`**, **`Parity.mem_invariantCore_iff`**,
  **`Parity.mem_invariantCore_tsd_iff`**.

## References

* [V. Quenneville-Bélair, *A New Approach to Finite Element Simulations of General Relativity*][QuennevilleBelair2015],
  §4.10 (Prop 4.17)
* [H. Brezis, *Functional Analysis, Sobolev Spaces and Partial Differential Equations*][Brezis2011],
  §9.2 (extension by reflection)

Bibliography: [references.bib](../../../docs/references.bib)
-/

open scoped InnerProductSpace ComplexConjugate
open MeasureTheory Set LinearPMap Feec.Fourier Feec.Fourier.GradCurl Feec.ShortHilbertComplex

@[expose] public noncomputable section

namespace Feec.Models.Cube

open Feec.Models.Torus.GradCurl (Space)
open MirrorTorus (sgn sgn_mul_self conj_sgn leviCivita3_sgn flip_flip flip_comm freq_flip)

/- Over `ℝ`, the real structure of `W3` is the one of its inner product space. -/
attribute [-instance] ShortHilbertComplex.instNormedSpaceRealW3

attribute [local instance] RealTorus.isScalarTower

namespace Parity

/-! ### The row-wise fibre reflections -/

/-- `M ↦ M D_k`: the column `k` of a matrix changes sign. -/
def colR (k : Fin 3) : Mat →L[ℂ] Mat :=
  LinearMap.toContinuousLinearMap
    { toFun := fun M => WithLp.toLp 2 fun p => sgn k p.2 * M p
      map_add' := fun M N => by ext p; simp; ring
      map_smul' := fun z M => by ext p; simp; ring }

@[simp] theorem colR_apply (k : Fin 3) (M : Mat) (p : Fin 3 × Fin 3) :
    colR k M p = sgn k p.2 * M p := rfl

theorem colR_colR (k : Fin 3) (M : Mat) : colR k (colR k M) = M := by
  ext p; rw [colR_apply, colR_apply, ← mul_assoc, sgn_mul_self, one_mul]

theorem colR_comm (k l : Fin 3) (M : Mat) : colR k (colR l M) = colR l (colR k M) := by
  ext p; simp only [colR_apply]; ring

theorem inner_colR (k : Fin 3) (M N : Mat) : ⟪colR k M, colR k N⟫_ℂ = ⟪M, N⟫_ℂ := by
  simp only [inner_mat, colR_apply, map_mul, conj_sgn]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
  linear_combination ((starRingEnd ℂ) (M (a, b)) * N (a, b)) * sgn_mul_self k b

/-- `grad_{flip ξ} (-v) = -(grad_ξ v) D_k`. -/
theorem grad_flip (k : Fin 3) (n : Fin 3 → ℤ) (v : Vec) :
    grad (Fourier.Torus.freq (MirrorTorus.flip k n)) (-v) =
      -colR k (grad (Fourier.Torus.freq n) v) := by
  ext ⟨a, b⟩
  simp only [grad_apply, PiLp.neg_apply, colR_apply, freq_flip]
  ring

/-- `curl_{flip ξ} (-M D_k) = (curl_ξ M) D_k`. -/
theorem curl_flip (k : Fin 3) (n : Fin 3 → ℤ) (M : Mat) :
    curl (Fourier.Torus.freq (MirrorTorus.flip k n)) (-colR k M) =
      colR k (curl (Fourier.Torus.freq n) M) := by
  ext ⟨a, b⟩
  rw [colR_apply, curl_apply, curl_apply]
  simp only [PiLp.neg_apply, colR_apply, freq_flip, Finset.mul_sum]
  refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
  linear_combination (-Complex.I * (Fourier.Torus.freq n c : ℂ) * M (a, d)) *
    leviCivita3_sgn k b c d

/-- The fibre maps of the `k`-th row-wise reflection: `σ ↦ -σ`, `E ↦ -E D_k`, `B ↦ B D_k`. -/
def fib (k : Fin 3) : ∀ i : Fin 3, W3 Vec Mat Mat i →L[ℂ] W3 Vec Mat Mat i
  | 0 => -ContinuousLinearMap.id ℂ Vec
  | 1 => -colR k
  | 2 => colR k

theorem neg_colR_neg_colR (k : Fin 3) (M : Mat) : -colR k (-colR k M) = M := by
  rw [_root_.map_neg, neg_neg, colR_colR]

theorem neg_colR_comm (k l : Fin 3) (M : Mat) : -colR k (-colR l M) = -colR l (-colR k M) := by
  rw [_root_.map_neg, _root_.map_neg, colR_comm]

theorem entryConj_colR (k : Fin 3) (M : Mat) : entryConj (colR k M) = colR k (entryConj M) := by
  ext p; simp [colR_apply, conj_sgn]

theorem fib_fib (k i : Fin 3) (v : W3 Vec Mat Mat i) : fib k i (fib k i v) = v := by
  fin_cases i
  · exact neg_neg v
  · exact neg_colR_neg_colR k v
  · exact colR_colR k v

theorem fib_comm (k l i : Fin 3) (v : W3 Vec Mat Mat i) :
    fib k i (fib l i v) = fib l i (fib k i v) := by
  fin_cases i
  · rfl
  · exact neg_colR_comm k l v
  · exact colR_comm k l v

theorem inner_fib (k i : Fin 3) (v w : W3 Vec Mat Mat i) :
    ⟪fib k i v, fib k i w⟫_ℂ = ⟪v, w⟫_ℂ := by
  fin_cases i
  · exact inner_neg_neg v w
  · exact (inner_neg_neg _ _).trans (inner_colR k v w)
  · exact inner_colR k v w

/-- Entrywise conjugation of the three fibres (real-linear for the real structure of the
inner product spaces). -/
def cjF : ∀ i : Fin 3, W3 Vec Mat Mat i →L[ℝ] W3 Vec Mat Mat i
  | 0 => entryConj
  | 1 => entryConj
  | 2 => entryConj

theorem cjF_cjF (i : Fin 3) (v : W3 Vec Mat Mat i) : cjF i (cjF i v) = v := by
  fin_cases i <;> exact entryConj_entryConj v

theorem inner_cjF (i : Fin 3) (v w : W3 Vec Mat Mat i) : ⟪cjF i v, cjF i w⟫_ℂ = ⟪w, v⟫_ℂ := by
  fin_cases i <;> exact inner_entryConj v w

theorem norm_cjF (i : Fin 3) (v : W3 Vec Mat Mat i) : ‖cjF i v‖ = ‖v‖ := by
  rw [norm_eq_sqrt_re_inner (𝕜 := ℂ), norm_eq_sqrt_re_inner (𝕜 := ℂ), inner_cjF]

/-- **The grad–curl symbols are real**: `m (-ξ) (conj v) = conj (m ξ v)`. -/
theorem m_cjF (i j : Fin 3) (ξ : Freq) (v : W3 Vec Mat Mat i) :
    gradCurl.m i j (-ξ) (cjF i v) = cjF j (gradCurl.m i j ξ v) := by
  fin_cases i <;> fin_cases j
  all_goals first
    | exact grad_neg_entryConj ξ v
    | exact curl_neg_entryConj ξ v
    | exact (map_zero (cjF _)).symm

/-- The row-wise fibre maps have real coefficients. -/
theorem cjF_fib (k i : Fin 3) (v : W3 Vec Mat Mat i) : cjF i (fib k i v) = fib k i (cjF i v) := by
  fin_cases i
  · exact _root_.map_neg entryConj v
  · exact (_root_.map_neg entryConj _).trans (congrArg Neg.neg (entryConj_colR k v))
  · exact entryConj_colR k v

/-- **The row-wise reflections of the torus grad–curl complex**, as fibre symmetries. -/
def symmetries : (Fourier.Torus.symbolComplex gradCurl).Symmetries (Fin 3) where
  R k := Reflection.count_of_involutive (MirrorTorus.flip k) (flip_flip k)
  ρ := fib
  invol := fib_fib
  inner_ρ := inner_fib
  symm k i j n v := by
    change gradCurl.m i j (Fourier.Torus.freq (MirrorTorus.flip k n)) (fib k i v) =
      fib k j (gradCurl.m i j _ v)
    fin_cases i <;> fin_cases j
    all_goals first
      | (change (0 : _ →L[ℂ] _) _ = fib k _ ((0 : _ →L[ℂ] _) v); simp)
      | exact grad_flip k n v
      | exact curl_flip k n v
  comm_σ k l n := flip_comm k l n
  comm_ρ := fib_comm

/-! ### The real unitaries -/

/-- The `k`-th row-wise reflection of `Space i`, as a real unitary. -/
def refl (k i : Fin 3) : Space i ≃ₗᵢ[ℝ] Space i where
  toLinearEquiv := (symmetries.toInvolutions.R k i).toLinearEquiv.restrictScalars ℝ
  norm_map' := (symmetries.toInvolutions.R k i).norm_map

theorem coeFn_refl (k i : Fin 3) (u : Space i) (n : Fin 3 → ℤ) :
    (refl k i u : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n = fib k i (u (MirrorTorus.flip k n)) :=
  Measure.ae_count_iff.1 (coeFn_symLp (symmetries.R k) (fib k i) u) n

/-- The conjugation `u ↦ conj (u ∘ (-·))` of `Space i` (the real fields are its fixed points). -/
def cnjL (i : Fin 3) : Space i →L[ℝ] Space i := conjLp Reflection.count_neg (cjF i)

theorem coeFn_cnjL (i : Fin 3) (u : Space i) (n : Fin 3 → ℤ) :
    (cnjL i u : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n = cjF i (u (-n)) :=
  Measure.ae_count_iff.1 (coeFn_conjLp Reflection.count_neg (cjF i) u) n

theorem cnjL_cnjL (i : Fin 3) (u : Space i) : cnjL i (cnjL i u) = u :=
  Lp.ext_count fun n => by rw [coeFn_cnjL, coeFn_cnjL, neg_neg, cjF_cjF]

theorem norm_cnjL (i : Fin 3) (u : Space i) : ‖cnjL i u‖ = ‖u‖ := by
  have h1 := hasSum_norm_sq_count (𝕜 := ℂ) (cnjL i u)
  have h2 := hasSum_norm_sq_count (𝕜 := ℂ) u
  have e : (fun n => ‖(cnjL i u : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n‖ ^ 2) =
      (fun n => ‖(u : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n‖ ^ 2) ∘ Neg.neg := by
    funext n; rw [coeFn_cnjL, norm_cjF]; rfl
  rw [e] at h1
  have h3 := (Equiv.neg (Fin 3 → ℤ)).hasSum_iff.2 h2
  have := h1.unique h3
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).1 this

/-- The conjugation as a real unitary. -/
def cnj (i : Fin 3) : Space i ≃ₗᵢ[ℝ] Space i where
  toLinearEquiv := LinearEquiv.ofInvolutive (cnjL i).toLinearMap (cnjL_cnjL i)
  norm_map' := norm_cnjL i

theorem cnj_apply (i : Fin 3) (u : Space i) : cnj i u = cnjL i u := rfl

theorem coeFn_cnj (i : Fin 3) (u : Space i) (n : Fin 3 → ℤ) :
    (cnj i u : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n = cjF i (u (-n)) := coeFn_cnjL i u n

/-- The conjugation preserves the domains of the differentials and commutes with them. -/
theorem cnj_mapsTo_comm {i j : Fin 3} (u : (Models.Torus.GradCurl.complex.d i j).domain) :
    ∃ h : cnj i u ∈ (Models.Torus.GradCurl.complex.d i j).domain,
      Models.Torus.GradCurl.complex.d i j ⟨_, h⟩ =
        cnj j (Models.Torus.GradCurl.complex.d i j u) := by
  have hpt : ∀ n, gradCurl.m i j (Fourier.Torus.freq n)
      ((cnj i u : Space i) n) = (cnj j (Models.Torus.GradCurl.complex.d i j u) :
        (Fin 3 → ℤ) → W3 Vec Mat Mat j) n := fun n => by
    rw [coeFn_cnj, coeFn_cnj]
    have e := coeFn_d_count (Fourier.Torus.symbolComplex gradCurl) u (-n)
    change ((Models.Torus.GradCurl.complex.d i j u : Space j) : (Fin 3 → ℤ) → _) (-n) =
      gradCurl.m i j (Fourier.Torus.freq (-n)) ((u : Space i) (-n)) at e
    rw [e, ← m_cjF, Fourier.Torus.freq_neg, neg_neg]
  have hm : cnj i u ∈ (Models.Torus.GradCurl.complex.d i j).domain :=
    (Lp.memLp (cnj j (Models.Torus.GradCurl.complex.d i j u))).ae_eq
      (Filter.Eventually.of_forall fun n => (hpt n).symm)
  exact ⟨hm, (Operator.mulOp_apply_eq_iff _ _).2 (Filter.Eventually.of_forall hpt)⟩

theorem flip_neg (k : Fin 3) (n : Fin 3 → ℤ) : MirrorTorus.flip k (-n) = -MirrorTorus.flip k n := by
  funext a; simp only [MirrorTorus.flip, Pi.neg_apply]; split_ifs <;> rfl

theorem refl_cnj (k i : Fin 3) (u : Space i) : refl k i (cnj i u) = cnj i (refl k i u) := by
  refine Lp.ext_count fun n => ?_
  rw [coeFn_refl, coeFn_cnj, coeFn_cnj, coeFn_refl, cjF_fib, flip_neg]

theorem refl_refl (k i : Fin 3) (u : Space i) : refl k i (refl k i u) = u :=
  symmetries.toInvolutions.invol k i u

theorem refl_comm (k l i : Fin 3) (u : Space i) : refl k i (refl l i u) = refl l i (refl k i u) :=
  symmetries.toInvolutions.comm k l i u

/-! ### Involutions and actions -/

/-- **The row-wise reflections of the real torus complex.** -/
def rowInvolutions : RealTorus.gradCurl.Involutions (Fin 3) where
  R := refl
  invol := refl_refl
  comm := refl_comm
  mapsTo k i j x := symmetries.toInvolutions.mapsTo k i j ⟨x.1, x.2⟩
  comm_d k i j x := symmetries.toInvolutions.comm_d k i j ⟨x.1, x.2⟩

/-- The real unitaries of the real row-wise parity model: the reflections (`some k`) and the
conjugation (`none`). -/
def realR : Option (Fin 3) → ∀ i : Fin 3, Space i ≃ₗᵢ[ℝ] Space i
  | none => cnj
  | some k => refl k

/-- **The row-wise reflections together with the real structure.** Its fixed fields are the real
fields with the row-wise parities. -/
def realInvolutions : RealTorus.gradCurl.Involutions (Option (Fin 3)) where
  R := realR
  invol k i u := by
    cases k
    · exact cnjL_cnjL i u
    · exact refl_refl _ i u
  comm k l i u := by
    cases k <;> cases l
    · rfl
    · exact (refl_cnj _ i u).symm
    · exact refl_cnj _ i u
    · exact refl_comm _ _ i u
  mapsTo k i j x := by
    cases k
    · exact (cnj_mapsTo_comm ⟨x.1, x.2⟩).1
    · exact symmetries.toInvolutions.mapsTo _ i j ⟨x.1, x.2⟩
  comm_d k i j x := by
    cases k
    · exact (cnj_mapsTo_comm ⟨x.1, x.2⟩).2
    · exact symmetries.toInvolutions.comm_d _ i j ⟨x.1, x.2⟩

/-- The action of `(ℤ/2)⁴` by the row-wise reflections and the conjugation. -/
abbrev realAction : RealTorus.gradCurl.Action (Multiplicative (Option (Fin 3) → ZMod 2)) :=
  realInvolutions.toAction

end Parity

/-- **The parities of the thesis' boundary conditions** (`σ = 0`, `E_a × n = 0`, no condition on
`B`): the action of `(ℤ/2)³` on the real torus complex generated by the row-wise reflections. -/
abbrev rowAction : RealTorus.gradCurl.Action ReflGroup := Parity.rowInvolutions.toAction

namespace Parity

theorem mem_fixed_iff {i : Fin 3} {u : Space i} :
    u ∈ rowAction.fixed i ↔ ∀ k, refl k i u = u :=
  rowInvolutions.mem_fixed_toAction

theorem mem_realFixed_iff {i : Fin 3} {u : Space i} :
    u ∈ realAction.fixed i ↔ cnj i u = u ∧ u ∈ rowAction.fixed i := by
  rw [realInvolutions.mem_fixed_toAction, mem_fixed_iff]
  exact ⟨fun h => ⟨h none, fun k => h (some k)⟩, fun h k => by cases k; exacts [h.1, h.2 _]⟩

/-- Fixed fields: `u (flip_k n) = ρ_k (u n)` for every reflection. -/
theorem mem_fixed_iff_coeff {i : Fin 3} {u : Space i} :
    u ∈ rowAction.fixed i ↔
      ∀ k n, (u : (Fin 3 → ℤ) → W3 Vec Mat Mat i) (MirrorTorus.flip k n) = fib k i (u n) := by
  rw [mem_fixed_iff]
  constructor
  · intro h k n
    have := congrArg
      (fun v : Space i => (v : (Fin 3 → ℤ) → W3 Vec Mat Mat i) (MirrorTorus.flip k n)) (h k)
    simp only [coeFn_refl, flip_flip k n] at this
    exact this.symm
  · intro h k
    refine Lp.ext_count fun n => ?_
    rw [coeFn_refl, h, fib_fib]

/-- **The cube complex with the thesis' boundary conditions**, `H̊¹(V) → H̊(curl; M) → L²(M)` on
`Q = (0, ½)³`, as the subcomplex of the real torus complex fixed by `rowAction` (method of
images). See [QuennevilleBelair2015], §4.10. -/
abbrev complex := rowAction.fixedComplex

end Parity

namespace Parity

/-! ### The square of the grad–curl wave symbol -/

theorem norm_sq_eq_sum (ξ : Freq) : ‖ξ‖ ^ 2 = ∑ c, (ξ c) ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq]
  exact Finset.sum_congr rfl fun c _ => by rw [Real.norm_eq_abs, sq_abs]

theorem ofReal_norm_sq_eq_sum (ξ : Freq) : (((‖ξ‖ ^ 2 : ℝ)) : ℂ) = ∑ c, (ξ c : ℂ) ^ 2 := by
  rw [norm_sq_eq_sum]; push_cast; rfl

/-- `div_ξ grad_ξ = |ξ|²`. -/
theorem div_grad (ξ : Freq) (u : Vec) : div ξ (grad ξ u) = ((‖ξ‖ ^ 2 : ℝ) : ℂ) • u := by
  ext a
  simp only [div_apply, grad_apply, PiLp.smul_apply, smul_eq_mul, ofReal_norm_sq_eq_sum,
    Fin.sum_univ_three]
  linear_combination (-(u a * ((ξ 0 : ℂ) ^ 2 + (ξ 1 : ℂ) ^ 2 + (ξ 2 : ℂ) ^ 2))) * Complex.I_sq

/-- `div_ξ curl_ξ = 0`. -/
theorem div_curl (ξ : Freq) (M : Mat) : div ξ (curl ξ M) = 0 := by
  ext a
  simp only [div_apply, curl_apply, PiLp.zero_apply, Fin.sum_univ_three, leviCivita3_apply]
  simp
  ring

/-- `grad_ξ div_ξ + curl_ξ curl_ξ = |ξ|²` on matrices (row-wise `ξ ξᵀ - ξ × ξ ×`). -/
theorem grad_div_add_curl_curl (ξ : Freq) (M : Mat) :
    grad ξ (div ξ M) + curl ξ (curl ξ M) = ((‖ξ‖ ^ 2 : ℝ) : ℂ) • M := by
  ext ⟨a, b⟩
  simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, grad_apply, div_apply, curl_apply,
    ofReal_norm_sq_eq_sum, Fin.sum_univ_three, leviCivita3_apply]
  fin_cases b <;> simp <;> ring_nf <;> simp only [Complex.I_sq] <;> ring

/-- `curl_ξ³ = |ξ|² curl_ξ`. -/
theorem curl_curl_curl (ξ : Freq) (M : Mat) :
    curl ξ (curl ξ (curl ξ M)) = ((‖ξ‖ ^ 2 : ℝ) : ℂ) • curl ξ M := by
  have h := grad_div_add_curl_curl ξ (curl ξ M)
  rwa [div_curl, _root_.map_zero, zero_add] at h

/-- The slot form of `eq_zero_of_waveSym_symAlong_sq`. -/
theorem eq_zero_of_slots {ξ : Freq} {ω : ℝ} (hω : 0 < ω) (hne : ‖ξ‖ ≠ ω) {a : Vec} {b c : Mat}
    (h0 : -div ξ (grad ξ a - curl ξ c) = ((-(ω ^ 2) : ℝ) : ℂ) • a)
    (h1 : grad ξ (-div ξ b) - curl ξ (curl ξ b) = ((-(ω ^ 2) : ℝ) : ℂ) • b)
    (h2 : curl ξ (grad ξ a - curl ξ c) = ((-(ω ^ 2) : ℝ) : ℂ) • c) :
    a = 0 ∧ b = 0 ∧ c = 0 := by
  have hc : ((‖ξ‖ ^ 2 : ℝ) : ℂ) - ((ω ^ 2 : ℝ) : ℂ) ≠ 0 := by
    rw [sub_ne_zero, Ne, Complex.ofReal_inj]
    exact fun e => hne ((sq_eq_sq₀ (norm_nonneg _) hω.le).1 e)
  have hω2 : ((ω ^ 2 : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (pow_pos hω 2).ne'
  have key : ∀ {X : Type} [AddCommGroup X] [Module ℂ X] (x : X),
      ((‖ξ‖ ^ 2 : ℝ) : ℂ) • x = ((ω ^ 2 : ℝ) : ℂ) • x → x = 0 := by
    intro X _ _ x e
    have : (((‖ξ‖ ^ 2 : ℝ) : ℂ) - ((ω ^ 2 : ℝ) : ℂ)) • x = 0 := by rw [sub_smul, e, sub_self]
    exact (smul_eq_zero.1 this).resolve_left hc
  have hneg : ((-(ω ^ 2) : ℝ) : ℂ) = -((ω ^ 2 : ℝ) : ℂ) := by push_cast; ring
  rw [hneg, neg_smul] at h0 h1 h2
  refine ⟨key a ?_, key b ?_, ?_⟩
  · rw [_root_.map_sub, div_curl, sub_zero, div_grad, neg_inj] at h0
    exact h0
  · rw [_root_.map_neg, ← neg_add', grad_div_add_curl_curl, neg_inj] at h1
    exact h1
  · rw [_root_.map_sub, curl_grad, zero_sub, neg_inj] at h2
    have hc1 : curl ξ c = 0 := by
      have e := congrArg (curl ξ) h2
      rw [curl_curl_curl, _root_.map_smul] at e
      exact key _ e
    rw [hc1, _root_.map_zero] at h2
    exact (smul_eq_zero.1 h2.symm).resolve_left hω2

/-! ### The grad–curl symbol complex along a frequency map

The spectral facts of the torus complex hold along every frequency map `ξ : ℤ³ → ℝ³`: the torus
complex is the one along `Fourier.Torus.freq`, the anisotropic torus complex of
`Feec.Models.Box` the one along `ξ_d(n) = d * 2πn`. -/

/-- **The grad–curl symbol complex along a frequency map** `ξ : ℤ³ → ℝ³`: the symbols
`gradCurl.m i j (ξ n)` on `ℓ²(ℤ³)`. Along `Fourier.Torus.freq` it is
`Fourier.Torus.symbolComplex gradCurl`. -/
abbrev symAlong (ξ : (Fin 3 → ℤ) → Freq) :
    SymbolComplex ℂ (Measure.count : Measure (Fin 3 → ℤ)) ComplexShape.fin3 (W3 Vec Mat Mat) :=
  gradCurl.toSymbolComplex _ ξ (Measurable.of_discrete).aemeasurable

section SymAlong

variable (ξ : (Fin 3 → ℤ) → Freq)

open Fourier.SymbolComplex in
theorem waveSym_symAlong_zero (n : Fin 3 → ℤ) (v : PiLp 2 (W3 Vec Mat Mat)) :
    (symAlong ξ).waveSym n v 0 = -div (ξ n) (v 1) := by
  rw [waveSym_apply, Fin.sum_univ_three, Fin.sum_univ_three]
  change (0 : Vec →L[ℂ] Vec) (v 0) + (0 : Mat →L[ℂ] Vec) (v 1) + (0 : Mat →L[ℂ] Vec) (v 2) -
    (ContinuousLinearMap.adjoint (0 : Vec →L[ℂ] Vec) (v 0) +
      ContinuousLinearMap.adjoint (grad (ξ n)) (v 1) +
      ContinuousLinearMap.adjoint (0 : Vec →L[ℂ] Mat) (v 2)) = _
  have z0 : (0 : Vec →L[ℂ] Vec) (v 0) = 0 := rfl
  have z1 : (0 : Mat →L[ℂ] Vec) (v 1) = 0 := rfl
  have z2 : (0 : Mat →L[ℂ] Vec) (v 2) = 0 := rfl
  have a0 : ContinuousLinearMap.adjoint (0 : Vec →L[ℂ] Vec) (v 0) = 0 := by
    rw [_root_.map_zero]; rfl
  have a2 : ContinuousLinearMap.adjoint (0 : Vec →L[ℂ] Mat) (v 2) = 0 := by
    rw [_root_.map_zero]; rfl
  rw [z0, z1, z2, a0, a2, adjoint_grad]
  abel

open Fourier.SymbolComplex in
theorem waveSym_symAlong_one (n : Fin 3 → ℤ) (v : PiLp 2 (W3 Vec Mat Mat)) :
    (symAlong ξ).waveSym n v 1 = grad (ξ n) (v 0) - curl (ξ n) (v 2) := by
  rw [waveSym_apply, Fin.sum_univ_three, Fin.sum_univ_three]
  change grad (ξ n) (v 0) + (0 : Mat →L[ℂ] Mat) (v 1) + (0 : Mat →L[ℂ] Mat) (v 2) -
    (ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Vec) (v 0) +
      ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) (v 1) +
      ContinuousLinearMap.adjoint (curl (ξ n)) (v 2)) = _
  have z1 : (0 : Mat →L[ℂ] Mat) (v 1) = 0 := rfl
  have z2 : (0 : Mat →L[ℂ] Mat) (v 2) = 0 := rfl
  have a0 : ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Vec) (v 0) = 0 := by
    rw [_root_.map_zero]; rfl
  have a1 : ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) (v 1) = 0 := by
    rw [_root_.map_zero]; rfl
  rw [z1, z2, a0, a1, adjoint_curl]
  abel

open Fourier.SymbolComplex in
theorem waveSym_symAlong_two (n : Fin 3 → ℤ) (v : PiLp 2 (W3 Vec Mat Mat)) :
    (symAlong ξ).waveSym n v 2 = curl (ξ n) (v 1) := by
  rw [waveSym_apply, Fin.sum_univ_three, Fin.sum_univ_three]
  change (0 : Vec →L[ℂ] Mat) (v 0) + curl (ξ n) (v 1) + (0 : Mat →L[ℂ] Mat) (v 2) -
    (ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Vec) (v 0) +
      ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) (v 1) +
      ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) (v 2)) = _
  have z0 : (0 : Vec →L[ℂ] Mat) (v 0) = 0 := rfl
  have z2 : (0 : Mat →L[ℂ] Mat) (v 2) = 0 := rfl
  have a0 : ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Vec) (v 0) = 0 := by
    rw [_root_.map_zero]; rfl
  have a1 : ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) (v 1) = 0 := by
    rw [_root_.map_zero]; rfl
  have a2 : ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) (v 2) = 0 := by
    rw [_root_.map_zero]; rfl
  rw [z0, z2, a0, a1, a2]
  abel

/-- **The eigenvalues of `-W_ξ²`**: the only nonzero one is `|ξ|²` (`W_ξ² = -|ξ|²` on the first two
slots, `-curl_ξ²` on the last, and `curl_ξ³ = |ξ|² curl_ξ`). So an eigenvector of the wave
symbol `W_ξ²` with eigenvalue `-ω²`, `ω > 0`, at the mode `n` vanishes unless `|ξ(n)| = ω`. -/
theorem eq_zero_of_waveSym_symAlong_sq {n : Fin 3 → ℤ} {ω : ℝ} (hω : 0 < ω) (hne : ‖ξ n‖ ≠ ω)
    {v : PiLp 2 (W3 Vec Mat Mat)}
    (h : (symAlong ξ).waveSym n ((symAlong ξ).waveSym n v) = (-(ω ^ 2) : ℝ) • v) : v = 0 := by
  have h0 := congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w 0) h
  have h1 := congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w 1) h
  have h2 := congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w 2) h
  simp only [waveSym_symAlong_zero, waveSym_symAlong_one, waveSym_symAlong_two,
    PiLp.smul_apply] at h0 h1 h2
  rw [RCLike.real_smul_eq_coe_smul (K := ℂ)] at h0 h1 h2
  obtain ⟨e0, e1, e2⟩ := eq_zero_of_slots (a := v 0) (b := v 1) (c := v 2) hω hne h0 h1 h2
  refine PiLp.ext fun i => ?_
  fin_cases i
  exacts [e0, e1, e2]

/-- **The real wave group along `ξ` has an eigenbasis** (the Fourier modes;
`Feec.HilbertComplex.eigenDense_restrictScalars_waveGroup_of_reducing`). -/
theorem eigenDense_symAlong :
    (symAlong ξ).toHilbertComplex.restrictScalars.waveGroup.EigenDense := by
  have := fun N i => Fourier.hasOrthogonalProjection_band (symAlong ξ)
    (Fourier.Torus.finite_bandN N).measurableSet i
  have := fun N i => Fourier.finiteDimensional_band (symAlong ξ) (Fourier.Torus.finite_bandN N) i
  exact HilbertComplex.eigenDense_restrictScalars_waveGroup_of_reducing RealTorus.real_inner_eq_re
    (fun N => (symAlong ξ).band (Fourier.Torus.bandN N))
    (fun N => Fourier.reducingSubcomplex_band (symAlong ξ)
      (Fourier.Torus.finite_bandN N).measurableSet)
    ((symAlong ξ).mem_closure_iUnion_band Fourier.Torus.finite_bandN Fourier.Torus.bandN_mono
      Fourier.Torus.exists_mem_bandN)

/-- Eigenvectors of `L²` with eigenvalue `-ω²`, `ω > 0`, along `ξ` have their Fourier modes on
the sphere `|ξ(n)| = ω`. -/
theorem fibre_eq_zero_of_isEigenSq_symAlong {ω : ℝ} (hω : 0 < ω) {v : PiLp 2 Space}
    (h : (symAlong ξ).toHilbertComplex.restrictScalars.wave.IsEigenSq ω v) {n : Fin 3 → ℤ}
    (hn : ‖ξ n‖ ≠ ω) : Fourier.SymbolComplex.fibre v n = 0 := by
  rw [HilbertComplex.wave_restrictScalars RealTorus.real_inner_eq_re] at h
  obtain ⟨h1, h2, e⟩ := h
  exact eq_zero_of_waveSym_symAlong_sq ξ hω hn ((symAlong ξ).waveSym_sq_of_isEigenSq ⟨h1, h2, e⟩ n)

/-- When the spheres `|ξ(n)| = ω` are finite, an eigenvector of `L²` with eigenvalue `-ω²`,
`ω > 0`, along `ξ` is supported on finitely many modes. -/
theorem exists_finset_of_isEigenSq_symAlong {ω : ℝ} (hfin : {n | ‖ξ n‖ = ω}.Finite) (hω : 0 < ω)
    {v : PiLp 2 Space} (h : (symAlong ξ).toHilbertComplex.restrictScalars.wave.IsEigenSq ω v) :
    ∃ S : Finset (Fin 3 → ℤ), ∀ i, ∀ n ∉ S, (v i : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n = 0 :=
  ⟨hfin.toFinset, fun i n hn => congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w i)
    (fibre_eq_zero_of_isEigenSq_symAlong ξ hω h fun e => hn (hfin.mem_toFinset.2 e))⟩

/-- Stationary data of the real complex along `ξ` are annihilated by the wave symbol, mode by
mode. -/
theorem waveSym_symAlong_fibre_eq_zero {y : PiLp 2 Space}
    (hst : y ∈ (symAlong ξ).toHilbertComplex.restrictScalars.waveGroup.stationary)
    (n : Fin 3 → ℤ) : (symAlong ξ).waveSym n (Fourier.SymbolComplex.fibre y n) = 0 := by
  have hgen : (symAlong ξ).toHilbertComplex.restrictScalars.waveGroup.generator =
      (symAlong ξ).toHilbertComplex.wave.restrictScalars :=
    (HilbertComplex.generator_waveGroup _).trans
      (HilbertComplex.wave_restrictScalars RealTorus.real_inner_eq_re)
  obtain ⟨hD, hL⟩ := C0Group.mem_domain_generator_of_mem_stationary hst
  have hD' : y ∈ (symAlong ξ).toHilbertComplex.wave.restrictScalars.domain := hgen ▸ hD
  have hL' : (symAlong ξ).toHilbertComplex.wave ⟨y, hD'⟩ = 0 := by
    have e := LinearPMap.apply_eq_of_eq hgen ⟨y, hD⟩ ⟨y, hD'⟩ rfl
    rw [hL] at e
    exact e.symm
  rw [← (symAlong ξ).wave_apply_count ⟨y, hD'⟩ n, hL']
  ext i
  exact Measure.ae_count_iff.1 (Lp.coeFn_zero _ 2 _) n

end SymAlong

/-! ### The spectrum of the torus wave group -/

/-- **The eigenvalues of `-W_ξ²`** on the torus: an eigenvector of the wave symbol `W_ξ²` with
eigenvalue `-ω²`, `ω > 0`, vanishes unless `|ξ| = ω` (`eq_zero_of_waveSym_symAlong_sq`). -/
theorem eq_zero_of_waveSym_sq {n : Fin 3 → ℤ} {ω : ℝ} (hω : 0 < ω)
    (hne : ‖Fourier.Torus.freq n‖ ≠ ω) {v : PiLp 2 (W3 Vec Mat Mat)}
    (h : (Fourier.Torus.symbolComplex gradCurl).waveSym n
      ((Fourier.Torus.symbolComplex gradCurl).waveSym n v) = (-(ω ^ 2) : ℝ) • v) : v = 0 :=
  eq_zero_of_waveSym_symAlong_sq Fourier.Torus.freq hω hne h

/-- **The real torus wave group has an eigenbasis** (the Fourier modes;
`Feec.HilbertComplex.eigenDense_restrictScalars_waveGroup_of_reducing`). -/
theorem eigenDense_torus : RealTorus.gradCurl.waveGroup.EigenDense :=
  eigenDense_symAlong Fourier.Torus.freq

/-- **The real torus wave group has pure point spectrum.** -/
theorem isPurePoint_torus : RealTorus.gradCurl.waveGroup.IsPurePoint :=
  RealTorus.gradCurl.isIsometric_waveGroup.isPurePoint_of_eigenDense eigenDense_torus

/-- **Eigenvectors of `L²` with eigenvalue `-ω²`, `ω > 0`, are trigonometric polynomials**: their
Fourier modes vanish off the sphere `|2πn| = ω`. -/
theorem fibre_eq_zero_of_isEigenSq {ω : ℝ} (hω : 0 < ω) {v : PiLp 2 Space}
    (h : RealTorus.gradCurl.wave.IsEigenSq ω v) {n : Fin 3 → ℤ}
    (hn : ‖Fourier.Torus.freq n‖ ≠ ω) : Fourier.SymbolComplex.fibre v n = 0 :=
  fibre_eq_zero_of_isEigenSq_symAlong Fourier.Torus.freq hω h hn

/-- The frequencies on a sphere `|2πn| = ω` form a finite set. -/
theorem finite_freq (ω : ℝ) : {n : Fin 3 → ℤ | ‖Fourier.Torus.freq n‖ = ω}.Finite := by
  refine (Fourier.Torus.finite_bandN (Nat.ceil ω)).subset fun n hn j => ?_
  have hn : ‖Fourier.Torus.freq n‖ = ω := hn
  have h1 : ((n j : ℝ)) ^ 2 ≤ ∑ j, ((n j : ℝ)) ^ 2 :=
    Finset.single_le_sum (f := fun j => ((n j : ℝ)) ^ 2) (fun _ _ => sq_nonneg _)
      (Finset.mem_univ j)
  have h2 := Fourier.Torus.norm_freq_sq n
  have hpi : (1 : ℝ) ≤ (2 * Real.pi) ^ 2 := by nlinarith [Real.two_le_pi]
  have h3 : ((n j : ℝ)) ^ 2 ≤ ω ^ 2 := by
    rw [← hn, h2]
    nlinarith [sq_nonneg ((n j : ℝ)), Finset.sum_nonneg fun j (_ : j ∈ Finset.univ) =>
      sq_nonneg ((n j : ℝ))]
  have h4 : |(n j : ℝ)| ≤ ω := by
    have hω : 0 ≤ ω := hn ▸ norm_nonneg _
    exact (sq_le_sq₀ (abs_nonneg _) hω).1 (by rwa [sq_abs])
  have h5 : ω ≤ (Nat.ceil ω : ℝ) := Nat.le_ceil ω
  have : |(n j : ℝ)| ≤ (Nat.ceil ω : ℝ) := h4.trans h5
  exact_mod_cast this

/-- An eigenvector of `L²` with eigenvalue `-ω²`, `ω > 0`, is supported on finitely many modes. -/
theorem exists_finset_of_isEigenSq {ω : ℝ} (hω : 0 < ω) {v : PiLp 2 Space}
    (h : RealTorus.gradCurl.wave.IsEigenSq ω v) :
    ∃ S : Finset (Fin 3 → ℤ), ∀ i, ∀ n ∉ S, (v i : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n = 0 :=
  exists_finset_of_isEigenSq_symAlong Fourier.Torus.freq (finite_freq ω) hω h

/-! ### The constraints on the cube -/

/-- The normalised Haar measure on `ℝ/ℤ`, as in `Feec.Fourier.TorusWeak`. -/
local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩

/-- Matrix fields on the Fourier side. -/
abbrev MatL : Type := Lp Mat 2 (Measure.count : Measure (Fin 3 → ℤ))

/-- **Restriction to the cube** of a matrix field given by its Fourier coefficients:
`A ↦ (F⁻¹ A)|_Q`. -/
def resM : MatL →L[ℂ] Domain.L2F ℂ (Geometry.Q (Fin 3)) (Fin 3 × Fin 3) :=
  Geometry.resQF.comp
    (ContinuousLinearEquiv.toContinuousLinearMap
      (Fourier.Torus.fieldFourier (Fin 3) (Fin 3 × Fin 3)).symm.toContinuousLinearEquiv)

theorem resM_apply (A : MatL) (p : Fin 3 × Fin 3) :
    resM A p = Geometry.resQ ((Fourier.Torus.fieldFourier (Fin 3) (Fin 3 × Fin 3)).symm A p) := rfl

/-- The Fourier coefficients of the entries of a matrix field. -/
theorem repr_fieldFourier_symm (A : MatL) (p : Fin 3 × Fin 3) (n : Fin 3 → ℤ) :
    UnitAddTorus.mFourierBasis.repr
        ((Fourier.Torus.fieldFourier (Fin 3) (Fin 3 × Fin 3)).symm A p) n =
      (A : (Fin 3 → ℤ) → Mat) n p := by
  rw [UnitAddTorus.mFourierBasis_repr, ← Fourier.Torus.fieldFourier_apply,
    LinearIsometryEquiv.apply_symm_apply]

/-- The entry `p` of the restriction to the cube, as a real-linear map. -/
def entryL (p : Fin 3 × Fin 3) : MatL →L[ℝ] Domain.L2 ℂ (Geometry.Q (Fin 3)) :=
  ((PiLp.proj 2 (fun _ : Fin 3 × Fin 3 => Domain.L2 ℂ (Geometry.Q (Fin 3))) p).comp
    resM).restrictScalars ℝ

@[simp] theorem entryL_apply (p : Fin 3 × Fin 3) (A : MatL) : entryL p A = resM A p := rfl

/-- **Symmetric on the cube**: `A_{ab} = A_{ba}` a.e. on `Q`. -/
def boxSym : Submodule ℝ MatL :=
  ⨅ a : Fin 3, ⨅ b : Fin 3, LinearMap.ker ((entryL (a, b) - entryL (b, a)).toLinearMap)

/-- **Trace-free on the cube**: `Σ_a A_{aa} = 0` a.e. on `Q`. -/
def boxTr : Submodule ℝ MatL := LinearMap.ker ((∑ a : Fin 3, entryL (a, a)).toLinearMap)

/-- **Weakly divergence-free on the cube** (row-wise): `⟪∇φ, A|_Q⟫ = 0` for every test field
`φ ∈ C_c^∞(Q; ℂ³)`. -/
def boxDiv : Submodule ℝ MatL :=
  ⨅ φ : Fin 3 → (Fin 3 → ℝ) → ℂ, ⨅ hφ : Domain.IsTestField (Geometry.Q (Fin 3)) φ,
    LinearMap.ker ((((innerSL ℂ (Domain.testField
      ((Domain.gradOp 3 3 : Domain.ConstCoeffOp (Fin 3 → ℝ) ℂ _ _).isTestField_apply hφ))).comp
        resM).restrictScalars ℝ).toLinearMap)

theorem mem_boxSym {A : MatL} : A ∈ boxSym ↔ ∀ a b, resM A (a, b) = resM A (b, a) := by
  simp [boxSym, sub_eq_zero]

theorem mem_boxTr {A : MatL} : A ∈ boxTr ↔ ∑ a, resM A (a, a) = 0 := by
  simp [boxTr]

theorem mem_boxDiv {A : MatL} : A ∈ boxDiv ↔ ∀ φ : Fin 3 → (Fin 3 → ℝ) → ℂ,
    ∀ hφ : Domain.IsTestField (Geometry.Q (Fin 3)) φ,
      ⟪Domain.testField
        ((Domain.gradOp 3 3 : Domain.ConstCoeffOp (Fin 3 → ℝ) ℂ _ _).isTestField_apply
        hφ), resM A⟫_ℂ = 0 := by
  simp [boxDiv]

theorem isClosed_boxSym : IsClosed (boxSym : Set MatL) := by
  rw [boxSym, Submodule.coe_iInf]
  refine isClosed_iInter fun a => ?_
  rw [Submodule.coe_iInf]
  exact isClosed_iInter fun b => (entryL (a, b) - entryL (b, a)).isClosed_ker

theorem isClosed_boxTr : IsClosed (boxTr : Set MatL) := (∑ a : Fin 3, entryL (a, a)).isClosed_ker

theorem isClosed_boxDiv : IsClosed (boxDiv : Set MatL) := by
  rw [boxDiv, Submodule.coe_iInf]
  refine isClosed_iInter fun φ => ?_
  rw [Submodule.coe_iInf]
  exact isClosed_iInter fun hφ => ContinuousLinearMap.isClosed_ker _

/-- **Restriction to the box detects vanishing on the box.** -/
theorem ae_eq_zero_of_resQ_eq_zero {f : Lp ℂ 2 (volume : Measure (UnitAddTorus (Fin 3)))}
    (h : Geometry.resQ f = 0) :
    (f : UnitAddTorus (Fin 3) → ℂ) =ᵐ[volume.restrict (boxSet (Fin 3))] 0 := by
  have h0 : LpToLpRestrictCLM (UnitAddTorus (Fin 3)) ℂ ℂ volume 2 (boxSet (Fin 3)) f = 0 :=
    (Lp.compMeasurePreservingₗᵢ ℂ TorusWeak.proj Geometry.measurePreserving_proj_Q).injective
      (h.trans (_root_.map_zero _).symm)
  have h1 := LpToLpRestrictCLM_coeFn ℂ (boxSet (Fin 3)) f
  rw [h0] at h1
  exact h1.symm.trans (Lp.coeFn_zero _ _ _)

/-- A scalar trigonometric polynomial whose restriction to the cube vanishes is zero. -/
theorem eq_zero_of_resQ_of_finite {f : Lp ℂ 2 (volume : Measure (UnitAddTorus (Fin 3)))}
    (S : Finset (Fin 3 → ℤ)) (hS : ∀ n ∉ S, UnitAddTorus.mFourierBasis.repr f n = 0)
    (h : Geometry.resQ f = 0) : UnitAddTorus.mFourierBasis.repr f = 0 := by
  refine eq_zero_of_zeroOnBox_of_finite S hS ?_
  change (TorusWeak.ofCoeff (UnitAddTorus.mFourierBasis.repr f) : UnitAddTorus (Fin 3) → ℂ) =ᵐ[_] 0
  rw [TorusWeak.ofCoeff, LinearIsometryEquiv.symm_apply_apply]
  exact ae_eq_zero_of_resQ_eq_zero h

/-- Symmetry on the cube propagates to the torus for trigonometric polynomials. -/
theorem symm_of_finite {A : MatL} (hs : A ∈ boxSym) (S : Finset (Fin 3 → ℤ))
    (hS : ∀ n ∉ S, (A : (Fin 3 → ℤ) → Mat) n = 0) (n : Fin 3 → ℤ) (a b : Fin 3) :
    (A : (Fin 3 → ℤ) → Mat) n (a, b) = (A : (Fin 3 → ℤ) → Mat) n (b, a) := by
  set F := (Fourier.Torus.fieldFourier (Fin 3) (Fin 3 × Fin 3)).symm A
  have h0 := eq_zero_of_resQ_of_finite (f := F (a, b) - F (b, a)) S (fun m hm => by
      rw [_root_.map_sub, lp.coeFn_sub, Pi.sub_apply, repr_fieldFourier_symm,
        repr_fieldFourier_symm, hS m hm]
      simp) (by rw [_root_.map_sub, ← resM_apply, ← resM_apply, mem_boxSym.1 hs a b, sub_self])
  have := congrArg (fun g : lp (fun _ : Fin 3 → ℤ => ℂ) 2 => g n) h0
  simp only [_root_.map_sub, lp.coeFn_sub, Pi.sub_apply, lp.coeFn_zero, Pi.zero_apply] at this
  rw [repr_fieldFourier_symm, repr_fieldFourier_symm] at this
  exact sub_eq_zero.1 this

/-- Trace-freeness on the cube propagates to the torus for trigonometric polynomials. -/
theorem trace_of_finite {A : MatL} (ht : A ∈ boxTr) (S : Finset (Fin 3 → ℤ))
    (hS : ∀ n ∉ S, (A : (Fin 3 → ℤ) → Mat) n = 0) (n : Fin 3 → ℤ) :
    ∑ a, (A : (Fin 3 → ℤ) → Mat) n (a, a) = 0 := by
  set F := (Fourier.Torus.fieldFourier (Fin 3) (Fin 3 × Fin 3)).symm A
  have hsum : ∀ m : Fin 3 → ℤ, UnitAddTorus.mFourierBasis.repr (∑ a, F (a, a)) m =
      ∑ a, (A : (Fin 3 → ℤ) → Mat) m (a, a) := fun m => by
    rw [_root_.map_sum, lp.coeFn_sum, Finset.sum_apply]
    exact Finset.sum_congr rfl fun a _ => repr_fieldFourier_symm A (a, a) m
  have h0 := eq_zero_of_resQ_of_finite (f := ∑ a, F (a, a)) S (fun m hm => by
      rw [hsum, hS m hm]; simp)
    (by rw [_root_.map_sum]; exact mem_boxTr.1 ht)
  have := congrArg (fun g : lp (fun _ : Fin 3 → ℤ => ℂ) 2 => g n) h0
  simp only [lp.coeFn_zero, Pi.zero_apply] at this
  rwa [hsum] at this

/-- **Trigonometric polynomials of a row-wise parity class that are symmetric and trace-free on
the cube vanish.** The extensions of `A_{ab}` and `A_{ba}` (`a ≠ b`) have opposite parities in
`x_a`, and the diagonal entries have pairwise different parities; once symmetry and trace hold on
all of `𝕋³` (analytic continuation from the cube, `symm_of_finite`, `trace_of_finite`), the
parities force every entry to vanish. -/
theorem eq_zero_of_finite_of_parity {ε : ℂ} (hε : ε ≠ 0) {A : MatL}
    (hpar : ∀ k n p, (A : (Fin 3 → ℤ) → Mat) (MirrorTorus.flip k n) p =
      ε * sgn k p.2 * (A : (Fin 3 → ℤ) → Mat) n p)
    (hs : A ∈ boxSym) (ht : A ∈ boxTr) (S : Finset (Fin 3 → ℤ))
    (hS : ∀ n ∉ S, (A : (Fin 3 → ℤ) → Mat) n = 0) : A = 0 := by
  have hsym := symm_of_finite hs S hS
  have htr := trace_of_finite ht S hS
  refine Lp.ext_count fun n => ?_
  rw [Measure.ae_count_iff.1 (Lp.coeFn_zero Mat 2 _) n]
  ext ⟨a, b⟩
  rw [Pi.zero_apply, PiLp.zero_apply]
  by_cases hab : a = b
  · subst hab
    have h1 := htr (MirrorTorus.flip a n)
    simp only [hpar] at h1
    have h2 : ∑ c, sgn a c * (A : (Fin 3 → ℤ) → Mat) n (c, c) = 0 := by
      have : ε * ∑ c, sgn a c * (A : (Fin 3 → ℤ) → Mat) n (c, c) = 0 := by
        rw [Finset.mul_sum, ← h1]; exact Finset.sum_congr rfl fun c _ => by ring
      exact (mul_eq_zero.1 this).resolve_left hε
    have h3 := htr n
    fin_cases a <;> simp [sgn, Fin.sum_univ_three] at h2 h3 ⊢ <;>
      linear_combination (h3 - h2) / 2
  · have h1 := hsym (MirrorTorus.flip a n) a b
    rw [hpar a n (a, b), hpar a n (b, a), hsym n b a] at h1
    have hc1 : sgn a b = 1 := by simp [sgn, Ne.symm hab]
    have hc2 : sgn a a = -1 := by simp [sgn]
    simp only [hc1, hc2] at h1
    have : (2 * ε) * (A : (Fin 3 → ℤ) → Mat) n (a, b) = 0 := by linear_combination h1
    exact (mul_eq_zero.1 this).resolve_left (mul_ne_zero two_ne_zero hε)

/-- The parities of the electric slot. -/
theorem parity_one {A : MatL} (hA : (A : Space 1) ∈ rowAction.fixed 1) (k : Fin 3)
    (n : Fin 3 → ℤ) (p : Fin 3 × Fin 3) : (A : (Fin 3 → ℤ) → Mat) (MirrorTorus.flip k n) p =
      (-1) * sgn k p.2 * (A : (Fin 3 → ℤ) → Mat) n p := by
  have h := mem_fixed_iff_coeff.1 hA k n
  change (A : (Fin 3 → ℤ) → Mat) (MirrorTorus.flip k n) = -colR k ((A : (Fin 3 → ℤ) → Mat) n) at h
  rw [h, PiLp.neg_apply, colR_apply]; ring

/-- The parities of the magnetic slot. -/
theorem parity_two {A : MatL} (hA : (A : Space 2) ∈ rowAction.fixed 2) (k : Fin 3)
    (n : Fin 3 → ℤ) (p : Fin 3 × Fin 3) : (A : (Fin 3 → ℤ) → Mat) (MirrorTorus.flip k n) p =
      1 * sgn k p.2 * (A : (Fin 3 → ℤ) → Mat) n p := by
  have h := mem_fixed_iff_coeff.1 hA k n
  change (A : (Fin 3 → ℤ) → Mat) (MirrorTorus.flip k n) = colR k ((A : (Fin 3 → ℤ) → Mat) n) at h
  rw [h, colR_apply]; ring

/-- The constant Fourier mode of an electric parity field vanishes. -/
theorem coeff_zero_of_mem_fixed_one {A : MatL} (hA : (A : Space 1) ∈ rowAction.fixed 1) :
    (A : (Fin 3 → ℤ) → Mat) 0 = 0 := by
  ext ⟨a, b⟩
  obtain ⟨k, hk⟩ : ∃ k : Fin 3, k ≠ b := ⟨b + 1, by fin_cases b <;> decide⟩
  have h := parity_one hA k 0 (a, b)
  have h0 : MirrorTorus.flip k 0 = 0 := by funext j; simp [MirrorTorus.flip]
  rw [h0, show sgn k b = 1 by simp [sgn, Ne.symm hk]] at h
  rw [PiLp.zero_apply]
  linear_combination h / 2

/-! ### The constraint `{0} × S₁ × S₂` and its invariant core -/

/-- The constraint family `{0} × S₁ × S₂` of the torus. -/
def constraint (S1 : Submodule ℝ (Space 1)) (S2 : Submodule ℝ (Space 2)) :
    ∀ i : Fin 3, Submodule ℝ (Space i)
  | 0 => ⊥
  | 1 => S1
  | 2 => S2

instance (S1 : Submodule ℝ (Space 1)) (S2 : Submodule ℝ (Space 2)) [S1.HasOrthogonalProjection]
    [S2.HasOrthogonalProjection] : ∀ i, (constraint S1 S2 i).HasOrthogonalProjection
  | 0 => inferInstanceAs (⊥ : Submodule ℝ (Space 0)).HasOrthogonalProjection
  | 1 => inferInstanceAs S1.HasOrthogonalProjection
  | 2 => inferInstanceAs S2.HasOrthogonalProjection

theorem mem_totalSub_constraint {S1 : Submodule ℝ (Space 1)} {S2 : Submodule ℝ (Space 2)}
    {y : PiLp 2 Space} : y ∈ HilbertComplex.totalSub (constraint S1 S2) ↔
      (y 0 : Space 0) = 0 ∧ (y 1 : Space 1) ∈ S1 ∧ (y 2 : Space 2) ∈ S2 := by
  constructor
  · intro h; exact ⟨(Submodule.mem_bot ℝ).1 (h 0), h 1, h 2⟩
  · rintro ⟨h0, h1, h2⟩ i
    fin_cases i
    exacts [(Submodule.mem_bot ℝ).2 h0, h1, h2]

/-- **`K*` along a frequency map with finite spheres, with the thesis' boundary conditions on the
cube**: for closed `S₁ ≤ Fix ∩ boxSym ∩ boxTr` (electric parities) and
`S₂ ≤ Fix ∩ boxSym ∩ boxTr` (magnetic parities), a datum lies in the largest invariant subspace of
`K = {0} × S₁ × S₂` for the real wave group along `ξ` iff it lies in `K` and is stationary. -/
theorem mem_invariantCore_symAlong_iff (ξ : (Fin 3 → ℤ) → Freq)
    (hfin : ∀ ω, {n | ‖ξ n‖ = ω}.Finite) {S1 : Submodule ℝ (Space 1)} {S2 : Submodule ℝ (Space 2)}
    [S1.HasOrthogonalProjection] [S2.HasOrthogonalProjection]
    (hS1 : S1 ≤ rowAction.fixed 1 ⊓ boxSym ⊓ boxTr) (hS2 : S2 ≤ rowAction.fixed 2 ⊓ boxSym ⊓ boxTr)
    (y : PiLp 2 Space) :
    y ∈ (symAlong ξ).toHilbertComplex.restrictScalars.waveGroup.invariantCore
        (HilbertComplex.totalSub (constraint S1 S2)) ↔
      y ∈ HilbertComplex.totalSub (constraint S1 S2) ∧
        y ∈ (symAlong ξ).toHilbertComplex.restrictScalars.waveGroup.stationary := by
  refine ⟨fun hy => ⟨C0Group.invariantCore_le hy, ?_⟩, fun ⟨hK, hst⟩ =>
    C0Group.mem_invariantCore.2 fun t => by rw [C0Group.mem_stationary.1 hst t]; exact hK⟩
  refine (symAlong ξ).toHilbertComplex.restrictScalars.isIsometric_waveGroup
    |>.invariantCore_le_stationary_of_eigenDense (eigenDense_symAlong ξ)
      HilbertComplex.isClosed_totalSub (fun ω hω v hv hev => ?_) hy
  rw [HilbertComplex.generator_waveGroup] at hev
  obtain ⟨S, hS⟩ := exists_finset_of_isEigenSq_symAlong ξ (hfin ω) hω hev
  obtain ⟨h0, h1, h2⟩ := mem_totalSub_constraint.1 (C0Group.invariantCore_le hv)
  obtain ⟨⟨f1, s1⟩, t1⟩ := hS1 h1
  obtain ⟨⟨f2, s2⟩, t2⟩ := hS2 h2
  have e1 : (v 1 : Space 1) = 0 :=
    eq_zero_of_finite_of_parity (ε := -1) (by norm_num) (A := (v 1 : MatL)) (parity_one f1) s1 t1 S
      (hS 1)
  have e2 : (v 2 : Space 2) = 0 :=
    eq_zero_of_finite_of_parity (ε := 1) one_ne_zero (A := (v 2 : MatL)) (parity_two f2) s2 t2 S
      (hS 2)
  refine PiLp.ext fun i => ?_
  fin_cases i
  exacts [h0, e1, e2]

/-- **`K*` on the torus side, with the thesis' boundary conditions on the cube**: for closed
`S₁ ≤ Fix ∩ boxSym ∩ boxTr` (electric parities) and `S₂ ≤ Fix ∩ boxSym ∩ boxTr` (magnetic
parities), a datum lies in the largest invariant subspace of `K = {0} × S₁ × S₂` for the torus wave
group iff it lies in `K` and is stationary. See [QuennevilleBelair2015], §4.10 (Prop 4.17,
corrected: only stationary data propagate). -/
theorem mem_invariantCore_torus_iff {S1 : Submodule ℝ (Space 1)} {S2 : Submodule ℝ (Space 2)}
    [S1.HasOrthogonalProjection] [S2.HasOrthogonalProjection]
    (hS1 : S1 ≤ rowAction.fixed 1 ⊓ boxSym ⊓ boxTr) (hS2 : S2 ≤ rowAction.fixed 2 ⊓ boxSym ⊓ boxTr)
    (y : PiLp 2 Space) :
    y ∈ RealTorus.gradCurl.waveGroup.invariantCore (HilbertComplex.totalSub (constraint S1 S2)) ↔
      y ∈ HilbertComplex.totalSub (constraint S1 S2) ∧
        y ∈ RealTorus.gradCurl.waveGroup.stationary :=
  mem_invariantCore_symAlong_iff Fourier.Torus.freq finite_freq hS1 hS2 y

/-- **`K*` on the cube with the thesis' boundary conditions**: for the cube complex and closed
`S₁`, `S₂` as in `mem_invariantCore_torus_iff`, the largest invariant subspace of
`K = {0} × S₁ × S₂` under the wave group consists of the stationary data in `K`.
See [QuennevilleBelair2015], §4.10 (Prop 4.17, corrected). -/
theorem mem_invariantCore_iff {S1 : Submodule ℝ (Space 1)} {S2 : Submodule ℝ (Space 2)}
    [S1.HasOrthogonalProjection] [S2.HasOrthogonalProjection]
    (hS1 : S1 ≤ rowAction.fixed 1 ⊓ boxSym ⊓ boxTr) (hS2 : S2 ≤ rowAction.fixed 2 ⊓ boxSym ⊓ boxTr)
    (y : PiLp 2 fun i => rowAction.fixed i) :
    y ∈ complex.waveGroup.invariantCore
        (HilbertComplex.totalSub (compSub rowAction.fixed (constraint S1 S2))) ↔
      y ∈ HilbertComplex.totalSub (compSub rowAction.fixed (constraint S1 S2)) ∧
        y ∈ complex.waveGroup.stationary := by
  rw [mem_invariantCore_compSub_iff, mem_invariantCore_torus_iff hS1 hS2,
    mem_stationary_compSub_iff]
  rfl

/-! ### The thesis' constraint -/

/-- **`L²(TSD)` on the cube in the electric parity class**: symmetric, trace-free and
divergence-free on `Q`. -/
abbrev tsdE : Submodule ℝ (Space 1) := rowAction.fixed 1 ⊓ boxSym ⊓ boxTr ⊓ boxDiv

/-- **`L²(TSD)` on the cube in the magnetic parity class.** -/
abbrev tsdB : Submodule ℝ (Space 2) := rowAction.fixed 2 ⊓ boxSym ⊓ boxTr ⊓ boxDiv

theorem isClosed_tsdE : IsClosed (tsdE : Set (Space 1)) :=
  (((rowAction.isClosed_fixed 1).inter isClosed_boxSym).inter isClosed_boxTr).inter isClosed_boxDiv

theorem isClosed_tsdB : IsClosed (tsdB : Set (Space 2)) :=
  (((rowAction.isClosed_fixed 2).inter isClosed_boxSym).inter isClosed_boxTr).inter isClosed_boxDiv

instance : tsdE.HasOrthogonalProjection := by
  have : CompleteSpace tsdE := isClosed_tsdE.completeSpace_coe
  infer_instance

instance : tsdB.HasOrthogonalProjection := by
  have : CompleteSpace tsdB := isClosed_tsdB.completeSpace_coe
  infer_instance

/-- An electric parity field with `div_{ξ(n)} Ê(n) = 0` and `curl_{ξ(n)} Ê(n) = 0` mode by mode
vanishes, along a frequency map `ξ` vanishing only at `0` (`grad div + curl curl = |ξ|²`, and the
constant mode vanishes by parity). -/
theorem eq_zero_of_div_curl_symAlong (ξ : (Fin 3 → ℤ) → Freq) (hξ : ∀ n, ξ n = 0 → n = 0)
    {E : MatL} (hE : (E : Space 1) ∈ rowAction.fixed 1)
    (hd : ∀ n, div (ξ n) ((E : (Fin 3 → ℤ) → Mat) n) = 0)
    (hc : ∀ n, curl (ξ n) ((E : (Fin 3 → ℤ) → Mat) n) = 0) : E = 0 := by
  refine Lp.ext_count fun n => ?_
  rw [Measure.ae_count_iff.1 (Lp.coeFn_zero _ 2 _) n]
  by_cases hn : n = 0
  · subst hn; exact coeff_zero_of_mem_fixed_one hE
  · have key := grad_div_add_curl_curl (ξ n) ((E : (Fin 3 → ℤ) → Mat) n)
    rw [hd n, hc n, _root_.map_zero, _root_.map_zero, add_zero, eq_comm, smul_eq_zero] at key
    refine key.resolve_left ?_
    have : ‖ξ n‖ ≠ 0 := by
      rw [norm_ne_zero_iff]; exact fun h => hn (hξ n h)
    exact_mod_cast pow_ne_zero 2 this

/-- An electric parity field with `div_ξ Ê = 0` and `curl_ξ Ê = 0` mode by mode vanishes
(`grad div + curl curl = |ξ|²`, and the constant mode vanishes by parity). -/
theorem eq_zero_of_div_curl {E : MatL} (hE : (E : Space 1) ∈ rowAction.fixed 1)
    (hd : ∀ n, div (Fourier.Torus.freq n) ((E : (Fin 3 → ℤ) → Mat) n) = 0)
    (hc : ∀ n, curl (Fourier.Torus.freq n) ((E : (Fin 3 → ℤ) → Mat) n) = 0) : E = 0 :=
  eq_zero_of_div_curl_symAlong Fourier.Torus.freq (fun _ => Fourier.Torus.freq_eq_zero_iff.1) hE hd
    hc

/-- **Stationary data with `E` of electric parity have `E = 0`** along a frequency map `ξ`
vanishing only at `0` (the electric harmonic fields vanish). -/
theorem eq_zero_of_mem_stationary_symAlong (ξ : (Fin 3 → ℤ) → Freq) (hξ : ∀ n, ξ n = 0 → n = 0)
    {y : PiLp 2 Space} (h1 : (y 1 : Space 1) ∈ rowAction.fixed 1)
    (hst : y ∈ (symAlong ξ).toHilbertComplex.restrictScalars.waveGroup.stationary) :
    (y 1 : Space 1) = 0 := by
  have hW := waveSym_symAlong_fibre_eq_zero ξ hst
  refine eq_zero_of_div_curl_symAlong ξ hξ (E := y 1) h1 (fun n => ?_) (fun n => ?_)
  · have e := congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w 0) (hW n)
    simp only [waveSym_symAlong_zero, PiLp.zero_apply] at e
    exact neg_eq_zero.1 e
  · have e := congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w 2) (hW n)
    simp only [waveSym_symAlong_two, PiLp.zero_apply] at e
    exact e

/-- **Stationary data of the torus complex in `{0} × S₁ × S₂`** (electric parities in the middle
slot): `(0, E, B)` is stationary iff `E = 0` and `curl_ξ B̂ = 0` mode by mode. -/
theorem mem_stationary_iff {y : PiLp 2 Space} (h0 : (y 0 : Space 0) = 0)
    (h1 : (y 1 : Space 1) ∈ rowAction.fixed 1) :
    y ∈ RealTorus.gradCurl.waveGroup.stationary ↔ (y 1 : Space 1) = 0 ∧
      ∀ n, curl (Fourier.Torus.freq n) ((y 2 : Space 2) n) = 0 := by
  have hy0 : ∀ n, (y 0 : Space 0) n = (0 : Vec) := fun n => by
    rw [h0]; exact Measure.ae_count_iff.1 (Lp.coeFn_zero _ 2 _) n
  have hgen : RealTorus.gradCurl.waveGroup.generator =
      Models.Torus.GradCurl.complex.wave.restrictScalars :=
    (HilbertComplex.generator_waveGroup RealTorus.gradCurl).trans RealTorus.wave_gradCurl
  constructor
  · intro hst
    refine ⟨eq_zero_of_mem_stationary_symAlong Fourier.Torus.freq
      (fun _ => Fourier.Torus.freq_eq_zero_iff.1) h1
      hst, fun n => ?_⟩
    have e := congrArg (fun w : PiLp 2 (W3 Vec Mat Mat) => w 1)
      (waveSym_symAlong_fibre_eq_zero Fourier.Torus.freq hst n)
    simp only [waveSym_symAlong_one, PiLp.zero_apply] at e
    have e' : grad (Fourier.Torus.freq n) (0 : Vec) -
        curl (Fourier.Torus.freq n) ((y 2 : MatL) n) = 0 := by
      rw [← hy0 n]; exact e
    rw [_root_.map_zero, zero_sub, neg_eq_zero] at e'
    exact e'
  · rintro ⟨e1, hc⟩
    have hy1 : ∀ n, (y 1 : Space 1) n = (0 : Mat) := fun n => by
      rw [e1]; exact Measure.ae_count_iff.1 (Lp.coeFn_zero _ 2 _) n
    have hz : ∀ i j n, (Fourier.Torus.symbolComplex gradCurl).m i j n
        ((y i : (Fin 3 → ℤ) → W3 Vec Mat Mat i) n) = 0 ∧
        ContinuousLinearMap.adjoint ((Fourier.Torus.symbolComplex gradCurl).m i j n)
          ((y j : (Fin 3 → ℤ) → W3 Vec Mat Mat j) n) = 0 := by
      intro i j n
      have a0 : ∀ k, ((Fourier.Torus.symbolComplex gradCurl).m 0 k n) ((y 0 : Space 0) n) = 0 :=
        fun k => by rw [hy0 n]; exact _root_.map_zero _
      have a1 : ∀ k, ((Fourier.Torus.symbolComplex gradCurl).m 1 k n) ((y 1 : Space 1) n) = 0 :=
        fun k => by rw [hy1 n]; exact _root_.map_zero _
      have b0 : ∀ k, ContinuousLinearMap.adjoint ((Fourier.Torus.symbolComplex gradCurl).m k 0 n)
          ((y 0 : Space 0) n) = 0 := fun k => by rw [hy0 n]; exact _root_.map_zero _
      have b1 : ∀ k, ContinuousLinearMap.adjoint ((Fourier.Torus.symbolComplex gradCurl).m k 1 n)
          ((y 1 : Space 1) n) = 0 := fun k => by rw [hy1 n]; exact _root_.map_zero _
      fin_cases i <;> fin_cases j
      · exact ⟨a0 0, b0 0⟩
      · exact ⟨a0 1, b1 0⟩
      · refine ⟨a0 2, ?_⟩
        change ContinuousLinearMap.adjoint (0 : Vec →L[ℂ] Mat) ((y 2 : MatL) n) = 0
        rw [_root_.map_zero]; rfl
      · exact ⟨a1 0, b0 1⟩
      · exact ⟨a1 1, b1 1⟩
      · refine ⟨a1 2, ?_⟩
        change ContinuousLinearMap.adjoint (curl (Fourier.Torus.freq n)) ((y 2 : MatL) n) = 0
        rw [adjoint_curl]; exact hc n
      · exact ⟨rfl, b0 2⟩
      · exact ⟨rfl, b1 2⟩
      · refine ⟨rfl, ?_⟩
        change ContinuousLinearMap.adjoint (0 : Mat →L[ℂ] Mat) ((y 2 : MatL) n) = 0
        rw [_root_.map_zero]; rfl
    obtain ⟨hx, hLx⟩ := (Fourier.Torus.symbolComplex gradCurl).exists_wave_eq_zero_of_fibre hz
    have hx' : y ∈ RealTorus.gradCurl.waveGroup.generator.domain := hgen ▸ hx
    have hgen0 : RealTorus.gradCurl.waveGroup.generator ⟨y, hx'⟩ = 0 := by
      rw [LinearPMap.apply_eq_of_eq hgen ⟨y, hx'⟩ ⟨y, hx⟩ rfl]
      exact hLx
    exact C0Group.mem_stationary.2 (C0Group.S_apply_eq_of_generator_eq_zero ⟨y, hx'⟩ hgen0)

/-- **`K*` for the thesis' constraint on the cube, explicitly** (torus side): a datum lies in the
largest invariant subspace of `K = {0} × L²(TSD) × L²(TSD)` iff it is `(0, 0, B₀)` with
`B₀ ∈ L²(TSD)` on the cube and curl-free (`curl_ξ B̂₀(n) = 0` for every mode).
See [QuennevilleBelair2015], §4.10 (Prop 4.17, corrected). -/
theorem mem_invariantCore_tsd_iff (y : PiLp 2 Space) :
    y ∈ RealTorus.gradCurl.waveGroup.invariantCore
        (HilbertComplex.totalSub (constraint tsdE tsdB)) ↔
      (y 0 : Space 0) = 0 ∧ (y 1 : Space 1) = 0 ∧ (y 2 : Space 2) ∈ tsdB ∧
        ∀ n, curl (Fourier.Torus.freq n) ((y 2 : Space 2) n) = 0 := by
  rw [mem_invariantCore_torus_iff (S1 := tsdE) (S2 := tsdB) inf_le_left inf_le_left,
    mem_totalSub_constraint]
  constructor
  · rintro ⟨⟨h0, h1, h2⟩, hst⟩
    obtain ⟨e1, hc⟩ := (mem_stationary_iff h0 h1.1.1.1).1 hst
    exact ⟨h0, e1, h2, hc⟩
  · rintro ⟨h0, h1, h2, hc⟩
    have hf : (y 1 : Space 1) ∈ rowAction.fixed 1 := h1 ▸ Submodule.zero_mem _
    exact ⟨⟨h0, h1 ▸ Submodule.zero_mem _, h2⟩, (mem_stationary_iff h0 hf).2 ⟨h1, hc⟩⟩

end Parity

end Feec.Models.Cube
