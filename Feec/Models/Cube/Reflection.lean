module

public import Feec.Models.Cube.Basic
public import Feec.Legacy.Box.Mirror

/-!
# Reflection actions of `(ℤ/2)³` on the torus complexes

The cube `Q = (0, ½)³` is a fundamental domain of the group `(ℤ/2)³` generated by the
reflections `x_i ↦ -x_i` of the torus `𝕋³ = ℝ³/ℤ³`. A field on `Q` with homogeneous boundary
conditions on the faces is a field on `𝕋³` with prescribed parities in each variable, so a
Hilbert complex on the cube is the subcomplex of a torus complex fixed by a unitary action of
`(ℤ/2)³` (the method of images, `Feec.HilbertComplex.Action.fixedComplex`). This file holds the
reflection actions shared by the row-wise models (`Feec.Models.Cube.Parity`) and the mirror models
(`Feec.Models.Cube.Mirror`); the general construction from commuting involutions is
`Feec.HilbertComplex.Involutions.toAction`.

## Main definitions

* `Feec.Models.Cube.ReflGroup`: `(ℤ/2)³`.
* `Feec.Models.Cube.reflAct`: `g ↦ R₀^{g₀} R₁^{g₁} R₂^{g₂}` for three commuting reflections.
* `Feec.Models.Cube.reflAction`: the induced unitary action on a short complex whose
  differentials commute with the reflections.
* `Feec.Models.Cube.torus`, `Feec.Models.Cube.torusSym`: the torus complexes `grad → curl` and
  `hess → curl` (Fourier side) as window complexes.

## Main results

* `mem_fixed_reflAction_zero` (and `_one`, `_two`): the fixed vectors are the vectors fixed by
  each reflection; `reflAct_mem`: subspaces invariant under the reflections are invariant under
  the action.

## References

* [QuennevilleBelair2015], §4.10 (Prop 4.17)
* [Brezis2011], §9.2 (extension by reflection)
-/

open Feec.Legacy

open scoped RealInnerProductSpace
open Set LinearPMap

@[expose] public noncomputable section

universe u

namespace Feec.Models.Cube

open Feec.Legacy.HilbertComplex2 Feec.ShortHilbertComplex Feec.Legacy.Constraints Feec.Legacy.Torus
  Feec.Legacy.Box

attribute [-instance] ShortHilbertComplex.instNormedSpaceRealW3

/-! ### The reflection group and its unitary actions -/

/-- The reflection group `(ℤ/2)³` of the cube. -/
abbrev ReflGroup : Type := Multiplicative (Fin 3 → ZMod 2)

section Refl

variable {W : Type*} [NormedAddCommGroup W] [InnerProductSpace ℝ W] (G : Refl3 W)

/-- The `k`-th reflection of `G` as a unitary. -/
def reflEquiv (k : Fin 3) : W ≃ₗᵢ[ℝ] W where
  toFun := G.R k
  invFun := G.R k
  map_add' := _root_.map_add _
  map_smul' := _root_.map_smul _
  left_inv := G.invol k
  right_inv := G.invol k
  norm_map' x := by
    rw [norm_eq_sqrt_real_inner, norm_eq_sqrt_real_inner]
    exact congrArg Real.sqrt (G.inner_map k x x)

@[simp] theorem reflEquiv_apply (k : Fin 3) (x : W) : reflEquiv G k x = G.R k x := rfl

theorem reflEquiv_mul_self (k : Fin 3) : reflEquiv G k * reflEquiv G k = 1 :=
  LinearIsometryEquiv.ext fun x => G.invol k x

theorem reflEquiv_commute (k l : Fin 3) : Commute (reflEquiv G k) (reflEquiv G l) :=
  LinearIsometryEquiv.ext fun x => G.comm k l x

theorem reflEquiv_pow_val_add (k : Fin 3) (a b : ZMod 2) :
    reflEquiv G k ^ (a + b).val = reflEquiv G k ^ a.val * reflEquiv G k ^ b.val := by
  rw [ZMod.val_add, ← pow_add, ← pow_eq_pow_mod _ (by rw [sq]; exact reflEquiv_mul_self G k)]

/-- The action of `g = (g₀, g₁, g₂) ∈ (ℤ/2)³`: `R₀^{g₀} R₁^{g₁} R₂^{g₂}`. -/
def reflAct (g : ReflGroup) : W ≃ₗᵢ[ℝ] W :=
  reflEquiv G 0 ^ (Multiplicative.toAdd g 0).val * reflEquiv G 1 ^ (Multiplicative.toAdd g 1).val *
    reflEquiv G 2 ^ (Multiplicative.toAdd g 2).val

theorem reflAct_one : reflAct G 1 = 1 := by
  simp [reflAct]

theorem reflAct_mul (g h : ReflGroup) : reflAct G (g * h) = reflAct G g * reflAct G h := by
  simp only [reflAct, toAdd_mul, Pi.add_apply, reflEquiv_pow_val_add]
  have c : ∀ k l (m n : ℕ), Commute (reflEquiv G k ^ m) (reflEquiv G l ^ n) := fun k l m n =>
    (reflEquiv_commute G k l).pow_pow m n
  simp only [mul_assoc]
  congr 1
  rw [(c 0 1 _ _).left_comm]
  congr 1
  rw [(c 1 2 _ _).left_comm, (c 0 2 _ _).left_comm]

theorem reflEquiv_pow_apply_of_fixed {k : Fin 3} {x : W} (hx : G.R k x = x) (n : ℕ) :
    (reflEquiv G k ^ n) x = x := by
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ, LinearIsometryEquiv.coe_mul, Function.comp_apply,
      reflEquiv_apply, hx, ih]

theorem reflAct_apply_of_mem_fix {x : W} (hx : x ∈ G.fix) (g : ReflGroup) : reflAct G g x = x := by
  simp only [reflAct, LinearIsometryEquiv.coe_mul, Function.comp_apply,
    reflEquiv_pow_apply_of_fixed G (hx _)]

theorem reflAct_single (k : Fin 3) (x : W) :
    reflAct G (Multiplicative.ofAdd (Pi.single k 1)) x = G.R k x := by
  fin_cases k <;> simp [reflAct, ZMod.val_one]

/-- The vectors fixed by the action are the vectors fixed by each reflection. -/
theorem forall_reflAct_eq_iff {x : W} : (∀ g, reflAct G g x = x) ↔ x ∈ G.fix :=
  ⟨fun h k => by rw [← reflAct_single]; exact h _, fun hx g => reflAct_apply_of_mem_fix G hx g⟩

end Refl

section Comm

variable {W V : Type*} [NormedAddCommGroup W] [InnerProductSpace ℝ W]
  [NormedAddCommGroup V] [InnerProductSpace ℝ V] {T : W →ₗ.[ℝ] V}

/-- `T` commutes with the pair of unitaries `(J, J')`: `J D(T) ⊆ D(T)`, `T J = J' T`. -/
def IsComm (T : W →ₗ.[ℝ] V) (J : W ≃ₗᵢ[ℝ] W) (J' : V ≃ₗᵢ[ℝ] V) : Prop :=
  ∀ x : T.domain, ∃ h : J x ∈ T.domain, T ⟨J x, h⟩ = J' (T x)

theorem isComm_one : IsComm T 1 1 := fun x => ⟨x.2, rfl⟩

theorem IsComm.mul {J₁ J₂ : W ≃ₗᵢ[ℝ] W} {J₁' J₂' : V ≃ₗᵢ[ℝ] V} (h₁ : IsComm T J₁ J₁')
    (h₂ : IsComm T J₂ J₂') : IsComm T (J₁ * J₂) (J₁' * J₂') := fun x => by
  obtain ⟨hm₂, e₂⟩ := h₂ x
  obtain ⟨hm₁, e₁⟩ := h₁ ⟨_, hm₂⟩
  refine ⟨hm₁, ?_⟩
  change T ⟨J₁ (J₂ x), hm₁⟩ = J₁' (J₂' (T x))
  rw [← e₂]
  exact e₁

theorem IsComm.pow {J : W ≃ₗᵢ[ℝ] W} {J' : V ≃ₗᵢ[ℝ] V} (h : IsComm T J J') (n : ℕ) :
    IsComm T (J ^ n) (J' ^ n) := by
  induction n with
  | zero => exact isComm_one
  | succ n ih => rw [pow_succ, pow_succ]; exact ih.mul h

/-- An operator commuting with the reflections commutes with the whole action. -/
theorem isComm_reflAct {G : Refl3 W} {G' : Refl3 V} (hT : Feec.Legacy.Box.Intertwines G G' T)
    (g : ReflGroup) : IsComm T (reflAct G g) (reflAct G' g) := by
  have h : ∀ k, IsComm T (reflEquiv G k) (reflEquiv G' k) := fun k x => hT k x
  exact (((h 0).pow _).mul ((h 1).pow _)).mul ((h 2).pow _)

theorem isComm_zero {J : W ≃ₗᵢ[ℝ] W} {J' : V ≃ₗᵢ[ℝ] V} {T : W →ₗ.[ℝ] V} (hT : T = 0) :
    IsComm T J J' := fun x => by
  subst hT
  exact ⟨Submodule.mem_top, by simp [LinearPMap.zero_apply]⟩

end Comm

section Action

variable {W0 W1 W2 : Type u}
  [NormedAddCommGroup W0] [InnerProductSpace ℝ W0] [CompleteSpace W0]
  [NormedAddCommGroup W1] [InnerProductSpace ℝ W1] [CompleteSpace W1]
  [NormedAddCommGroup W2] [InnerProductSpace ℝ W2] [CompleteSpace W2]
  (G0 : Refl3 W0) (G1 : Refl3 W1) (G2 : Refl3 W2)

/-- The reflection actions on the three spaces of a short complex, as a family on `Fin 3`. -/
def reflActFam (g : ReflGroup) : ∀ i : Fin 3, W3 W0 W1 W2 i ≃ₗᵢ[ℝ] W3 W0 W1 W2 i
  | 0 => reflAct G0 g
  | 1 => reflAct G1 g
  | 2 => reflAct G2 g

variable {G0 G1 G2} (S : ShortHilbertComplex ℝ W0 W1 W2)

theorem isComm_reflActFam (h0 : Feec.Legacy.Box.Intertwines G0 G1 S.d₀)
    (h1 : Feec.Legacy.Box.Intertwines G1 G2 S.d₁)
    (g : ReflGroup) (i j : Fin 3) :
    IsComm (S.toHilbertComplex.d i j) (reflActFam G0 G1 G2 g i) (reflActFam G0 G1 G2 g j) := by
  fin_cases i <;> fin_cases j
  · exact isComm_zero rfl
  · exact isComm_reflAct h0 g
  · exact isComm_zero rfl
  · exact isComm_zero rfl
  · exact isComm_zero rfl
  · exact isComm_reflAct h1 g
  · exact isComm_zero rfl
  · exact isComm_zero rfl
  · exact isComm_zero rfl

/-- **The reflection action of `(ℤ/2)³` on a short complex** whose differentials commute with
the reflections (`d₀ R_i = R'_i d₀`, `d₁ R'_i = R''_i d₁`). -/
def reflAction (h0 : Feec.Legacy.Box.Intertwines G0 G1 S.d₀) (h1 : Feec.Legacy.Box.Intertwines G1 G2 S.d₁) :
    S.toHilbertComplex.Action ReflGroup where
  act := reflActFam G0 G1 G2
  act_one i x := by
    fin_cases i
    · exact congrArg (fun J : W0 ≃ₗᵢ[ℝ] W0 => J x) (reflAct_one G0)
    · exact congrArg (fun J : W1 ≃ₗᵢ[ℝ] W1 => J x) (reflAct_one G1)
    · exact congrArg (fun J : W2 ≃ₗᵢ[ℝ] W2 => J x) (reflAct_one G2)
  act_mul g h i x := by
    fin_cases i
    · exact congrArg (fun J : W0 ≃ₗᵢ[ℝ] W0 => J x) (reflAct_mul G0 g h)
    · exact congrArg (fun J : W1 ≃ₗᵢ[ℝ] W1 => J x) (reflAct_mul G1 g h)
    · exact congrArg (fun J : W2 ≃ₗᵢ[ℝ] W2 => J x) (reflAct_mul G2 g h)
  mapsTo g i j x := (isComm_reflActFam S h0 h1 g i j x).fst
  comm g i j x := (isComm_reflActFam S h0 h1 g i j x).snd

variable (h0 : Feec.Legacy.Box.Intertwines G0 G1 S.d₀) (h1 : Feec.Legacy.Box.Intertwines G1 G2 S.d₁)

theorem mem_fixed_reflAction_zero {x : W0} : x ∈ (reflAction S h0 h1).fixed 0 ↔ x ∈ G0.fix :=
  forall_reflAct_eq_iff G0

theorem mem_fixed_reflAction_one {x : W1} : x ∈ (reflAction S h0 h1).fixed 1 ↔ x ∈ G1.fix :=
  forall_reflAct_eq_iff G1

theorem mem_fixed_reflAction_two {x : W2} : x ∈ (reflAction S h0 h1).fixed 2 ↔ x ∈ G2.fix :=
  forall_reflAct_eq_iff G2

end Action

/-! ### The torus complexes -/

/-- The torus complex `L²(𝕋³; ℂ³) → L²(𝕋³; ℂ³ˣ³) → L²(𝕋³; ℂ³ˣ³)`, `grad` then `curl` (row-wise),
on the Fourier side (`Feec.Legacy.Torus.periodicComplex`). -/
abbrev torus : HilbertComplex ℝ ComplexShape.fin3 (W3 L2V L2M L2M) :=
  periodicComplex.toShort.toHilbertComplex

/-- The torus complex of (4.16), `hess` then `curl` on symmetric matrices
(`Feec.Legacy.TorusSym.symComplex`). -/
abbrev torusSym :
    HilbertComplex ℝ ComplexShape.fin3 (W3 Feec.Legacy.TorusSym.L2R Feec.Legacy.TorusSym.L2S Feec.Legacy.TorusSym.L2T) :=
  Feec.Legacy.TorusSym.symComplex.toShort.toHilbertComplex

/-! ### Reflections preserving a subspace -/

theorem reflAct_mem {W : Type*} [NormedAddCommGroup W] [InnerProductSpace ℝ W] (G : Refl3 W)
    {K : Submodule ℝ W} (hK : ∀ k, ∀ x ∈ K, G.R k x ∈ K) (g : ReflGroup) {x : W} (hx : x ∈ K) :
    reflAct G g x ∈ K := by
  have hp : ∀ k n, ∀ y ∈ K, (reflEquiv G k ^ n) y ∈ K := by
    intro k n
    induction n with
    | zero => intro y hy; exact hy
    | succ n ih =>
      intro y hy
      rw [pow_succ, LinearIsometryEquiv.coe_mul, Function.comp_apply]
      exact ih _ (hK k y hy)
  simp only [reflAct, LinearIsometryEquiv.coe_mul, Function.comp_apply]
  exact hp _ _ _ (hp _ _ _ (hp _ _ _ hx))


end Feec.Models.Cube
