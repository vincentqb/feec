/-- **Shrinking the constraint space does not repair Prop 4.17 on cubes.** On every open cube,
with the thesis' boundary conditions, for all closed `S1, S2 ≤ L²(TSD)` (e.g. `S1 = TSD₀`) and
every orthogonal group generated by `-L`, the forward orbit of `x` stays in `{0} × S1 × S2` iff
`x ∈ {0} × S1 × S2` is stationary. -/
theorem openCube_forward_sub_iff (hs : 0 < s)
    {S1 S2 : Submodule ℝ (BoundedDomain.L2M (openCube b s))}
    (h1 : S1 ≤ BoundedDomain.TSD (openCube b s)) (h2 : S2 ≤ BoundedDomain.TSD (openCube b s))
    (G : UnitaryGroupGenerator (-(cxCube b s).waveOp))
    (x : Tot (BoundedDomain.L2V (openCube b s)) (BoundedDomain.L2M (openCube b s))
      (BoundedDomain.L2M (openCube b s))) :
    (∀ t, 0 ≤ t → G.S t x ∈ Kc (BoundedDomain.L2V (openCube b s)) S1 S2) ↔
      x ∈ Kc (BoundedDomain.L2V (openCube b s)) S1 S2 ∧ ∀ t, G.S t x = x := by
  constructor
  · intro h
    have hx : x ∈ Kc (BoundedDomain.L2V (openCube b s)) S1 S2 := by
      simpa [G.map_zero] using h 0 le_rfl
    refine ⟨hx, ((openCube_forward_iff hs G x).1 fun t ht => ?_).2⟩
    have := h t ht
    rw [mem_Kc] at this ⊢
    exact ⟨this.1, h1 this.2.1, h2 this.2.2⟩
  · rintro ⟨hx, hst⟩ t _
    rw [hst]; exact hx

end PlanB

/-- **Thesis Prop 4.17, corrected statement.**
1. *No boundary* (`𝕋³`, `ℝ³`): for TSD data in `D(L)` (on `ℝ³`: in `H(curl)`), (4.14) has a
   unique strong solution, which stays in `K = {0} × L²(TSD) × L²(TSD)` and whose `(E, B)` solves
   (4.15).
2. *Bounded domain, thesis' boundary conditions*: on every nonempty bounded open `Ω` some TSD datum
   in `D(L) ∩ K` has its (existing) strong solutions leave `K`; on every open cube, for every
   `S1, S2 ≤ L²(TSD)` and every group, forward invariance of `{0} × S1 × S2` forces stationarity.
3. *Box `Q = (0, ½)³`, tensorial mirror boundary conditions*: for data in
   `D(L) ∩ ({0} × TSDmE × TSDmB)` (4.14) has a unique strong solution, staying in this space and
   solving (4.15), and `(0, cos-field, 0)` is a non-stationary datum in `D(L) ∩ K*`.

Original claim: item 3 with the thesis' boundary conditions and constraint `L²(TSD)` on any
bounded contractible domain. -/
theorem prop_4_17_corrected :
    (∀ (T : ℝ) {E₀ B₀ : Feec.Torus.L2M}, E₀ ∈ Feec.Torus.L2TSD → B₀ ∈ Feec.Torus.L2TSD →
      ini Feec.Torus.L2V E₀ B₀ ∈ Feec.Torus.periodicComplex.domL →
      ∃ U : ℝ → Tot Feec.Torus.L2V Feec.Torus.L2M Feec.Torus.L2M,
        IsStrongSolution (-Feec.Torus.periodicComplex.waveOp) T
          (ini Feec.Torus.L2V E₀ B₀) 0 U ∧
        (∀ U', IsStrongSolution (-Feec.Torus.periodicComplex.waveOp) T
          (ini Feec.Torus.L2V E₀ B₀) 0 U' → EqOn U' U (Icc 0 T)) ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc Feec.Torus.L2V Feec.Torus.L2TSD Feec.Torus.L2TSD) ∧
        IsReducedSolution Feec.Torus.periodicComplex T E₀ B₀
          (fun t => (tot _ _ _ (U t)).2.1) (fun t => (tot _ _ _ (U t)).2.2)) ∧
    (∀ (T : ℝ) {E₀ B₀ : Feec.Whole.L2M}, E₀ ∈ Feec.Whole.L2TSD → B₀ ∈ Feec.Whole.L2TSD →
      E₀ ∈ Feec.Whole.Hcurl → B₀ ∈ Feec.Whole.Hcurl →
      ∃ U, IsClassicalSolution (-Feec.Whole.wholeComplex.waveOp) T
          (ini Feec.Whole.L2V E₀ B₀) 0 U ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc Feec.Whole.L2V Feec.Whole.L2TSD Feec.Whole.L2TSD) ∧
        IsReducedSolution Feec.Whole.wholeComplex T E₀ B₀
          (fun t => (tot _ _ _ (U t)).2.1) (fun t => (tot _ _ _ (U t)).2.2) ∧
        ∀ U', IsStrongSolution (-Feec.Whole.wholeComplex.waveOp) T
          (ini Feec.Whole.L2V E₀ B₀) 0 U' → EqOn U' U (Icc 0 T)) ∧
    (∀ {Ω : Set BoundedDomain.R3} (hΩ : IsOpen Ω) (hb : Bornology.IsBounded Ω), Ω.Nonempty →
      ∃ B₀ : BoundedDomain.L2M Ω, B₀ ∈ BoundedDomain.TSD Ω ∧
        ini (BoundedDomain.L2V Ω) 0 B₀ ∈ (BoundedDomain.thesisComplex hΩ hb).domL ∧
        ini (BoundedDomain.L2V Ω) 0 B₀ ∈
          Kc (BoundedDomain.L2V Ω) (BoundedDomain.TSD Ω) (BoundedDomain.TSD Ω) ∧
        ∀ T > 0, (∃ U : ℝ → Tot (BoundedDomain.L2V Ω) (BoundedDomain.L2M Ω) (BoundedDomain.L2M Ω),
            IsStrongSolution (-(BoundedDomain.thesisComplex hΩ hb).waveOp) T
              (ini (BoundedDomain.L2V Ω) 0 B₀) 0 U) ∧
          ∀ U : ℝ → Tot (BoundedDomain.L2V Ω) (BoundedDomain.L2M Ω) (BoundedDomain.L2M Ω),
            IsStrongSolution (-(BoundedDomain.thesisComplex hΩ hb).waveOp) T
              (ini (BoundedDomain.L2V Ω) 0 B₀) 0 U →
            ∃ t ∈ Icc 0 T, U t ∉
              Kc (BoundedDomain.L2V Ω) (BoundedDomain.TSD Ω) (BoundedDomain.TSD Ω)) ∧
    (∀ {b : BoundedDomain.R3} {s : ℝ}, 0 < s →
      ∀ {S1 S2 : Submodule ℝ (BoundedDomain.L2M (openCube b s))},
        S1 ≤ BoundedDomain.TSD (openCube b s) → S2 ≤ BoundedDomain.TSD (openCube b s) →
      ∀ (G : UnitaryGroupGenerator (-(cxCube b s).waveOp)) x,
        (∀ t, 0 ≤ t → G.S t x ∈ Kc (BoundedDomain.L2V (openCube b s)) S1 S2) ↔
          x ∈ Kc (BoundedDomain.L2V (openCube b s)) S1 S2 ∧ ∀ t, G.S t x = x) ∧
    (∀ (T : ℝ) {E₀ B₀ : MQ}, E₀ ∈ TSDmE → B₀ ∈ TSDmB → ini VQ E₀ B₀ ∈ mirrorCxQ.domL →
      ∃ U : ℝ → Tot VQ MQ MQ,
        IsStrongSolution (-mirrorCxQ.waveOp) T (ini VQ E₀ B₀) 0 U ∧
        (∀ U', IsStrongSolution (-mirrorCxQ.waveOp) T (ini VQ E₀ B₀) 0 U' →
          EqOn U' U (Icc 0 T)) ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc VQ TSDmE TSDmB) ∧
        IsReducedSolution mirrorCxQ T E₀ B₀ (fun t => (tot VQ MQ MQ (U t)).2.1)
          (fun t => (tot VQ MQ MQ (U t)).2.2)) ∧
    (TSDmE ≤ BoundedDomain.TSD Qr ∧ TSDmB ≤ BoundedDomain.TSD Qr) ∧
    (∀ G : UnitaryGroupGenerator (-mirrorCxQ.waveOp),
      ∃ x ∈ mirrorCxQ.domL, x ∈ Kmax G (Kc VQ TSDmE TSDmB) ∧ ∃ t, G.S t x ≠ x) :=
  ⟨fun T _ _ hE hB hD => Feec.Torus.prop_4_17_torus_exists T hE hB hD,
    fun T _ _ hE hB hEc hBc => Feec.Whole.prop_4_17_whole_exists T hE hB hEc hBc,
    fun hΩ hb hne => BoundedDomain.thesisComplex_orbit_not_propagate_unconditional hΩ hb hne,
    fun hs _ _ h1 h2 G x => openCube_forward_sub_iff hs h1 h2 G x,
    fun T _ _ hE hB hD => mirrorCxQ_prop_4_17_exists T hE hB hD,
    ⟨TSDmE_le_TSD, TSDmB_le_TSD⟩,
    fun G => ⟨cosStateQ, (mirrorCxQ_exists_nonstationary G).1,
      (mirrorCxQ_exists_nonstationary G).2⟩⟩


/-- **Thesis Prop 4.17, corrected statement on cubes (Ch. 7 setting).** On every open cube
`∏ᵢ (bᵢ, bᵢ + s)`, in particular `(0, π)³`, with tensorial mirror boundary conditions: for TSD
data (with the wall conditions) in `D(L)`, (4.14) has a unique strong solution, which stays in
`K = {0} × TSDmECube × TSDmBCube ⊆ {0} × L²(TSD) × L²(TSD)` and solves (4.15); `d1` is the weak curl;
and a non-stationary datum lies in `D(L) ∩ K*` for every group. -/
theorem prop_4_17_corrected_cube {b : BoundedDomain.R3} {s : ℝ} (hs : 0 < s) :
    (∀ (T : ℝ) {E₀ B₀ : BoundedDomain.L2M (openCube b s)}, E₀ ∈ TSDmECube b s hs →
      B₀ ∈ TSDmBCube b s hs → ini _ E₀ B₀ ∈ (mirrorCxCube b s hs).domL →
      ∃ U : ℝ → Tot (BoundedDomain.L2V (openCube b s)) (BoundedDomain.L2M (openCube b s))
          (BoundedDomain.L2M (openCube b s)),
        IsStrongSolution (-(mirrorCxCube b s hs).waveOp) T (ini _ E₀ B₀) 0 U ∧
        (∀ U', IsStrongSolution (-(mirrorCxCube b s hs).waveOp) T (ini _ E₀ B₀) 0 U' →
          EqOn U' U (Icc 0 T)) ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc _ (TSDmECube b s hs) (TSDmBCube b s hs)) ∧
        IsReducedSolution (mirrorCxCube b s hs) T E₀ B₀ (fun t => (tot _ _ _ (U t)).2.1)
          (fun t => (tot _ _ _ (U t)).2.2)) ∧
    (TSDmECube b s hs ≤ BoundedDomain.TSD (openCube b s) ∧
      TSDmBCube b s hs ≤ BoundedDomain.TSD (openCube b s)) ∧
    (∀ E : (mirrorCxCube b s hs).d1.domain,
      ∃ h : (E : BoundedDomain.L2M (openCube b s)) ∈ (cxCube b s).d1†.domain,
        (cxCube b s).d1† ⟨E, h⟩ = (mirrorCxCube b s hs).d1 E) ∧
    (∀ G : UnitaryGroupGenerator (-(mirrorCxCube b s hs).waveOp),
      ∃ x ∈ (mirrorCxCube b s hs).domL,
        x ∈ Kmax G (Kc _ (TSDmECube b s hs) (TSDmBCube b s hs)) ∧ ∃ t, G.S t x ≠ x) :=
  ⟨fun T _ _ hE hB hD => mirrorCxCube_prop_4_17_exists hs T hE hB hD,
    ⟨TSDmECube_le_TSD hs, TSDmBCube_le_TSD hs⟩, mirrorCxCube_d1_eq hs,
    fun G => ⟨_, (mirrorCxCube_exists_nonstationary hs G).1,
      (mirrorCxCube_exists_nonstationary hs G).2⟩⟩

/-- **Thesis Prop 4.19, corrected statement.**
1. On `𝕋³` and `ℝ³`: for TSD data in `H(curl, S) × H(sym curl, T)`, (4.18) has a (classical on
   `ℝ³`) strong solution staying in `K = {0} × L²(TSD) × L²(TSD)` and solving the reduced system.
2. On every nonempty bounded open `Ω` with the boundary conditions of (4.16): some TSD datum in
   `D(L) ∩ K` has its strong solutions leave `K`.
3. On the box `Q = (0, ½)³` with tensorial mirror boundary conditions (`∂_n u = 0`, `S_{nτ} = 0`;
   constraint TSD with the wall conditions): unique strong solutions staying in
   `{0} × TSDSm × TSDTm` (TSD fields on `Q`) and solving the reduced system, and a non-stationary
   datum in `D(L) ∩ K*` for every group. -/
theorem prop_4_19_corrected :
    (∀ (T : ℝ) {E₀ : TorusSym.L2S} {B₀ : TorusSym.L2T}, E₀ ∈ TorusSym.L2TSDS →
      B₀ ∈ TorusSym.L2TSDT → E₀ ∈ TorusSym.HcurlS → B₀ ∈ TorusSym.HsymCurlT →
      ∃ U : ℝ → Tot TorusSym.L2R TorusSym.L2S TorusSym.L2T,
        IsStrongSolution (-TorusSym.symComplex.waveOp) T (ini TorusSym.L2R E₀ B₀) 0 U ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc TorusSym.L2R TorusSym.L2TSDS TorusSym.L2TSDT) ∧
        IsReducedSolution TorusSym.symComplex T E₀ B₀ (fun t => (tot _ _ _ (U t)).2.1)
          (fun t => (tot _ _ _ (U t)).2.2)) ∧
    (∀ (T : ℝ) {E₀ : Feec.WholeSym.L2S} {B₀ : Feec.WholeSym.L2T}, E₀ ∈ Feec.WholeSym.L2TSDS →
      B₀ ∈ Feec.WholeSym.L2TSDT → E₀ ∈ Feec.WholeSym.HcurlS → B₀ ∈ Feec.WholeSym.HsymCurlT →
      ∃ U, IsClassicalSolution (-Feec.WholeSym.symWComplex.waveOp) T
          (ini Feec.WholeSym.L2R E₀ B₀) 0 U ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc Feec.WholeSym.L2R Feec.WholeSym.L2TSDS Feec.WholeSym.L2TSDT) ∧
        IsReducedSolution Feec.WholeSym.symWComplex T E₀ B₀ (fun t => (tot _ _ _ (U t)).2.1)
          (fun t => (tot _ _ _ (U t)).2.2) ∧
        ∀ U', IsStrongSolution (-Feec.WholeSym.symWComplex.waveOp) T
          (ini Feec.WholeSym.L2R E₀ B₀) 0 U' → EqOn U' U (Icc 0 T)) ∧
    (∀ {Ω : Set BoundedDomain.R3} (hΩ : IsOpen Ω) (hb : Bornology.IsBounded Ω), Ω.Nonempty →
      ∃ B₀ : BoundedSym.L2T Ω, B₀ ∈ BoundedSym.TSDT Ω ∧
        ini (BoundedDomain.L2 Ω) 0 B₀ ∈ (BoundedSym.symComplexB hΩ hb).domL ∧
        ini (BoundedDomain.L2 Ω) 0 B₀ ∈
          Kc (BoundedDomain.L2 Ω) (BoundedSym.TSDS Ω) (BoundedSym.TSDT Ω) ∧
        ∀ T > 0, (∃ U : ℝ → Tot (BoundedDomain.L2 Ω) (BoundedSym.L2S Ω) (BoundedSym.L2T Ω),
            IsStrongSolution (-(BoundedSym.symComplexB hΩ hb).waveOp) T
              (ini (BoundedDomain.L2 Ω) 0 B₀) 0 U) ∧
          ∀ U : ℝ → Tot (BoundedDomain.L2 Ω) (BoundedSym.L2S Ω) (BoundedSym.L2T Ω),
            IsStrongSolution (-(BoundedSym.symComplexB hΩ hb).waveOp) T
              (ini (BoundedDomain.L2 Ω) 0 B₀) 0 U →
            ∃ t ∈ Icc 0 T, U t ∉
              Kc (BoundedDomain.L2 Ω) (BoundedSym.TSDS Ω) (BoundedSym.TSDT Ω)) ∧
    (∀ (T : ℝ) {E₀ : SQ} {B₀ : TQ}, E₀ ∈ TSDSm → B₀ ∈ TSDTm → ini RQ E₀ B₀ ∈ mirrorSymCxQ.domL →
      ∃ U : ℝ → Tot RQ SQ TQ,
        IsStrongSolution (-mirrorSymCxQ.waveOp) T (ini RQ E₀ B₀) 0 U ∧
        (∀ U', IsStrongSolution (-mirrorSymCxQ.waveOp) T (ini RQ E₀ B₀) 0 U' →
          EqOn U' U (Icc 0 T)) ∧
        (∀ t ∈ Icc 0 T, U t ∈ Kc RQ TSDSm TSDTm) ∧
        IsReducedSolution mirrorSymCxQ T E₀ B₀ (fun t => (tot RQ SQ TQ (U t)).2.1)
          (fun t => (tot RQ SQ TQ (U t)).2.2)) ∧
    (∀ E ∈ TSDSm, E ∈ BoundedSym.TSDS Qr) ∧ (∀ B ∈ TSDTm, B ∈ BoundedSym.TSDT Qr) ∧
    (∀ G : UnitaryGroupGenerator (-mirrorSymCxQ.waveOp),
      ∃ x ∈ mirrorSymCxQ.domL, x ∈ Kmax G (Kc RQ TSDSm TSDTm) ∧ ∃ t, G.S t x ≠ x) :=
  ⟨fun T _ _ hE hB hEc hBc => TorusSym.prop_4_19_torus_exists T hE hB hEc hBc,
    fun T _ _ hE hB hEc hBc => Feec.WholeSym.prop_4_19_whole_exists T hE hB hEc hBc,
    fun hΩ hb hne => BoundedSym.symComplexB_not_propagate_unconditional hΩ hb hne,
    fun T _ _ hE hB hD => mirrorSymCxQ_prop_4_19_exists T hE hB hD,
    fun _ hE => TSDSm_le_TSDS hE, fun _ hB => TSDTm_le_TSDT hB,
    fun G => ⟨cosStateS, (mirrorSymCxQ_exists_nonstationary G).1,
      (mirrorSymCxQ_exists_nonstationary G).2⟩⟩

/-- **The Ch. 6 claim, corrected statement.** The Hodge wave equation of the BGG complex (5.1)
(weakly imposed symmetry) propagates TSD data, with existence and uniqueness, `σ ≡ 0`, `u` TSD,
`M ≡ 0` and `B` TSD (hence symmetric):
1. on `𝕋³` (`bggTorus_verdict`);
2. on the box `Q` with tensorial mirror boundary conditions (`bggCxQ_verdict`), with
   `d1 = (S₁, curl)`, `S₁` pointwise and `curl` the weak curl on `Q`;
and it fails on every nonempty bounded domain with the §6.3 boundary conditions
(`Feec.Ch6.Bounded.bggComplex_verdict`). The `ℝ³` case is `Feec.Ch6.Whole.bggWhole_verdict`. -/
theorem ch6_corrected :
    (∀ (T : ℝ) {E₀ B₀ : Feec.Torus.L2M}, E₀ ∈ Feec.Torus.L2TSD → B₀ ∈ Feec.Torus.L2TSD →
      E₀ ∈ Feec.Torus.Hcurl → B₀ ∈ Feec.Torus.Hcurl →
      ∃ U, IsClassicalSolution (-bggTorus.waveOp) T (ini L2RT E₀ (embBT B₀)) 0 U ∧
        (∀ U', IsStrongSolution (-bggTorus.waveOp) T (ini L2RT E₀ (embBT B₀)) 0 U' →
          EqOn U' U (Icc 0 T)) ∧
        (∀ t ∈ Icc 0 T, (tot L2RT Feec.Torus.L2M L2WT (U t)).1 = 0 ∧
          (tot L2RT Feec.Torus.L2M L2WT (U t)).2.1 ∈ Feec.Torus.L2TSD ∧
          ∃ B ∈ Feec.Torus.L2TSD, (tot L2RT Feec.Torus.L2M L2WT (U t)).2.2 = embBT B) ∧
        IsReducedSolution bggTorus T E₀ (embBT B₀) (fun t => (tot _ _ _ (U t)).2.1)
          (fun t => (tot _ _ _ (U t)).2.2)) ∧
    (∀ (T : ℝ) {E₀ B₀ : MQ}, E₀ ∈ TSDmE → B₀ ∈ TSDmB →
      ini RQ E₀ (WithLp.toLp 2 (0, B₀) : W2Q) ∈ bggCxQ.domL →
      ∃ U : ℝ → Tot RQ MQ W2Q,
        IsStrongSolution (-bggCxQ.waveOp) T (ini RQ E₀ (WithLp.toLp 2 (0, B₀) : W2Q)) 0 U ∧
        (∀ U', IsStrongSolution (-bggCxQ.waveOp) T (ini RQ E₀ (WithLp.toLp 2 (0, B₀) : W2Q)) 0 U' →
          EqOn U' U (Icc 0 T)) ∧
        (∀ t ∈ Icc 0 T, (tot RQ MQ W2Q (U t)).1 = 0 ∧ (tot RQ MQ W2Q (U t)).2.1 ∈ TSDmE ∧
          (WithLp.ofLp (tot RQ MQ W2Q (U t)).2.2).1 = 0 ∧
          (WithLp.ofLp (tot RQ MQ W2Q (U t)).2.2).2 ∈ TSDmB) ∧
        IsReducedSolution bggCxQ T E₀ (WithLp.toLp 2 (0, B₀) : W2Q)
          (fun t => (tot RQ MQ W2Q (U t)).2.1) (fun t => (tot RQ MQ W2Q (U t)).2.2)) ∧
    (∀ u ∈ TSDmE, u ∈ BoundedDomain.TSD Qr) ∧
    (∀ B ∈ TSDmB, B ∈ BoundedDomain.TSD Qr ∧ B ∈ BoundedSym.symL2 Qr) ∧
    (∀ G : UnitaryGroupGenerator (-bggCxQ.waveOp),
      ∃ x ∈ bggCxQ.domL, x ∈ Kmax G (Kc RQ TSDmE TSDBm) ∧ ∃ t, G.S t x ≠ x) :=
  ⟨fun T _ _ hE hB hEc hBc => bggTorus_verdict T hE hB hEc hBc,
    fun T _ _ hE hB hD => bggCxQ_verdict T hE hB hD,
    fun _ hu => TSDmE_le_TSD hu, fun _ hB => ⟨TSDmB_le_TSD hB, (TSDmB_le_TSD hB).1⟩,
    fun G => ⟨cosStateB, (bggCxQ_exists_nonstationary G).1, (bggCxQ_exists_nonstationary G).2⟩⟩

end Feec.Repair.C417
