/-!
# Strongly continuous groups and semigroups, and their generators

For a normed space `E` over `𝕜 = ℝ` or `ℂ`:

* `Feec.C0Group 𝕜 E`: a strongly continuous one-parameter group `S : ℝ → E →L[𝕜] E`;
  `Feec.C0Semigroup 𝕜 E`: a strongly continuous semigroup (group law and continuity for `t ≥ 0`).
  `C0Group.toC0Semigroup` forgets negative times.
* `C0Semigroup.generatorDomain`: the `x` whose orbit `t ↦ S t x` is right-differentiable at `0`;
  `C0Semigroup.generator : E →ₗ.[𝕜] E`, `x ↦ (d/dt)⁺ S t x |_{t=0}`.
  `C0Group.generator` is the generator of the underlying semigroup.
* `C0Group.IsIsometric` (`‖S t x‖ = ‖x‖`), `C0Semigroup.IsContraction` (`‖S t‖ ≤ 1`, `t ≥ 0`).
* `C0Group.ofBounded B`: the uniformly continuous group `t ↦ exp(t B)` of a bounded operator.

Time is real: derivatives in `t` are taken over `ℝ`, so `E` carries `[NormedSpace ℝ E]`
compatible with `𝕜` (`[IsScalarTower ℝ 𝕜 E]`).

## Main results

* `C0Group.exists_bound`: `‖S t‖` is bounded on compact time intervals (Banach–Steinhaus).
* `C0Group.hasDerivAt_generator`: for a group the generator is a two-sided derivative, and
  `C0Group.mem_domain_generator_iff` (`x ∈ D(A)` iff `t ↦ S t x` is differentiable at `0`).
* `C0Group.hasDerivAt_apply` (`(d/dt) S t x = S t (A x)` on `D(A)`), `C0Group.mapsTo_domain`,
  `C0Group.generator_apply_S` (`A S t = S t A` on `D(A)`).
* `C0Group.dense_domain_generator`: the generator of a group is densely defined.
* `C0Group.IsIsometric.isSkewSymmetric_generator`: the generator of an isometric group on an
  inner product space is skew-symmetric; `IsIsometric.inner_map_map`, `inner_S_left`.
* `C0Group.generator_ofBounded` (`exp(tB)` is generated by `B` with domain `E`) and
  `C0Group.isIsometric_ofBounded` (skew `B`).

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §1.1–1.2 (uniformly and strongly continuous semigroups), §1.10 (groups)
* [K.-J. Engel, R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*][EngelNagel2000],
  §II.1

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology NormedSpace LinearPMap

@[expose] public noncomputable section

namespace Feec

section Defs

variable (𝕜 E : Type*) [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- A strongly continuous one-parameter group of bounded operators. -/
structure C0Group where
  /-- the group `t ↦ S t` -/
  S : ℝ → E →L[𝕜] E
  map_zero : S 0 = 1
  map_add : ∀ s t, S (s + t) = S s * S t
  strongCont : ∀ x, Continuous fun t => S t x

/-- A strongly continuous one-parameter semigroup of bounded operators (only `t ≥ 0` matters). -/
structure C0Semigroup where
  /-- the semigroup `t ↦ S t`, `t ≥ 0` -/
  S : ℝ → E →L[𝕜] E
  map_zero : S 0 = 1
  map_add : ∀ s t, 0 ≤ s → 0 ≤ t → S (s + t) = S s * S t
  strongCont : ∀ x, ContinuousOn (fun t => S t x) (Ici 0)

end Defs

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-! ### Semigroups and their generators -/

namespace C0Semigroup

variable (G : C0Semigroup 𝕜 E)

/-- `G` is a contraction semigroup: `‖S t‖ ≤ 1` for `t ≥ 0`. -/
def IsContraction : Prop := ∀ t, 0 ≤ t → ‖G.S t‖ ≤ 1

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- The domain of the generator: orbits right-differentiable at `0`. -/
def generatorDomain : Submodule 𝕜 E where
  carrier := {x | ∃ y, HasDerivWithinAt (fun t => G.S t x) y (Ici 0) 0}
  add_mem' := by
    rintro a b ⟨ya, ha⟩ ⟨yb, hb⟩
    exact ⟨ya + yb, by convert ha.add hb using 1; funext t; simp⟩
  zero_mem' := ⟨0, by simpa using hasDerivWithinAt_const (0 : ℝ) (Ici (0 : ℝ)) (0 : E)⟩
  smul_mem' := by
    rintro c a ⟨ya, ha⟩
    refine ⟨c • ya, ?_⟩
    have e : (fun t => G.S t (c • a)) = fun t => c • G.S t a := funext fun t => map_smul _ _ _
    rw [e]; exact ha.const_smul c

theorem hasDerivWithinAt_derivWithin (x : G.generatorDomain) :
    HasDerivWithinAt (fun t => G.S t x) (derivWithin (fun t => G.S t (x : E)) (Ici 0) 0)
      (Ici 0) 0 := by
  obtain ⟨y, hy⟩ := x.2
  rw [hy.derivWithin (uniqueDiffWithinAt_Ici 0)]
  exact hy

/-- **The generator** `A x = (d/dt)⁺ S t x |_{t=0}`, on the orbits right-differentiable at `0`. -/
def generator : E →ₗ.[𝕜] E where
  domain := G.generatorDomain
  toFun :=
    { toFun := fun x => derivWithin (fun t => G.S t (x : E)) (Ici 0) 0
      map_add' := fun x y => by
        have h := (G.hasDerivWithinAt_derivWithin x).add (G.hasDerivWithinAt_derivWithin y)
        refine (HasDerivWithinAt.derivWithin ?_ (uniqueDiffWithinAt_Ici 0))
        convert h using 1
        funext t; simp
      map_smul' := fun c x => by
        have h := (G.hasDerivWithinAt_derivWithin x).const_smul c
        refine (HasDerivWithinAt.derivWithin ?_ (uniqueDiffWithinAt_Ici 0))
        have e : (fun t => G.S t ((c • x : G.generatorDomain) : E)) =
            fun t => c • G.S t (x : E) := funext fun t => map_smul _ _ _
        rw [e]; exact h }

@[simp] theorem generator_domain : G.generator.domain = G.generatorDomain := rfl

/-- On `D(A)`, the orbit has right derivative `A x` at `0`. -/
theorem hasDerivWithinAt_generator (x : G.generator.domain) :
    HasDerivWithinAt (fun t => G.S t x) (G.generator x) (Ici 0) 0 :=
  G.hasDerivWithinAt_derivWithin x

/-- The generator is the right derivative at `0`. -/
theorem generator_apply_eq {x : G.generator.domain} {y : E}
    (h : HasDerivWithinAt (fun t => G.S t x) y (Ici 0) 0) : G.generator x = y :=
  h.derivWithin (uniqueDiffWithinAt_Ici 0)

end C0Semigroup

/-! ### Groups -/

namespace C0Group

variable (G : C0Group 𝕜 E)

theorem ext {G G' : C0Group 𝕜 E} (h : G.S = G'.S) : G = G' := by
  cases G; cases G'; cases h; rfl

/-- `S (s + t) x = S s (S t x)`. -/
theorem map_add_apply (s t : ℝ) (x : E) : G.S (s + t) x = G.S s (G.S t x) := by
  rw [G.map_add]; rfl

/-- The group is commutative. -/
theorem comm (s t : ℝ) : G.S s * G.S t = G.S t * G.S s := by
  rw [← G.map_add, ← G.map_add, add_comm]

theorem comm_apply (s t : ℝ) (x : E) : G.S s (G.S t x) = G.S t (G.S s x) := by
  rw [← map_add_apply, add_comm, map_add_apply]

@[simp] theorem S_apply_S_neg (t : ℝ) (x : E) : G.S t (G.S (-t) x) = x := by
  rw [← map_add_apply, add_neg_cancel, G.map_zero]; rfl

@[simp] theorem S_zero_apply (x : E) : G.S 0 x = x := by rw [G.map_zero]; rfl

/-- The underlying semigroup (`t ≥ 0`). -/
def toC0Semigroup : C0Semigroup 𝕜 E :=
  ⟨G.S, G.map_zero, fun s t _ _ => G.map_add s t, fun x => (G.strongCont x).continuousOn⟩

@[simp] theorem toC0Semigroup_S : G.toC0Semigroup.S = G.S := rfl

/-- `G` is a group of isometries. -/
def IsIsometric : Prop := ∀ t x, ‖G.S t x‖ = ‖x‖

/-- `‖S t‖` is bounded on compact time intervals (Banach–Steinhaus). -/
theorem exists_bound [CompleteSpace E] (a b : ℝ) : ∃ C, ∀ t ∈ Icc a b, ‖G.S t‖ ≤ C := by
  have h : ∀ x, ∃ C, ∀ i : Icc a b, ‖G.S i x‖ ≤ C := fun x => by
    obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn
      (G.strongCont x).continuousOn
    exact ⟨C, fun i => hC i i.2⟩
  obtain ⟨C, hC⟩ := banach_steinhaus h
  exact ⟨C, fun t ht => hC ⟨t, ht⟩⟩

/-- If `v t → y` as `t → 0`, then `S t (v t) → y`. -/
theorem tendsto_S_apply_of_tendsto [CompleteSpace E] {l : Filter ℝ} (hl : l ≤ 𝓝 0) {v : ℝ → E}
    {y : E} (hv : Tendsto v l (𝓝 y)) : Tendsto (fun t => G.S t (v t)) l (𝓝 y) := by
  obtain ⟨C, hC⟩ := G.exists_bound (-1) 1
  have h1 : Tendsto (fun t => G.S t y) l (𝓝 y) := by
    have := ((G.strongCont y).tendsto 0).mono_left hl
    rwa [S_zero_apply] at this
  have hev : ∀ᶠ t in l, t ∈ Icc (-1 : ℝ) 1 :=
    hl (Icc_mem_nhds (by norm_num) (by norm_num))
  have h2 : Tendsto (fun t => G.S t (v t - y)) l (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    have hv' : Tendsto (fun t => C * ‖v t - y‖) l (𝓝 0) := by
      simpa using (tendsto_iff_norm_sub_tendsto_zero.1 hv).const_mul C
    refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) ?_ hv'
    filter_upwards [hev] with t ht
    exact ((G.S t).le_opNorm _).trans (mul_le_mul_of_nonneg_right (hC t ht) (norm_nonneg _))
  have := h2.add h1
  rw [zero_add] at this
  exact this.congr fun t => by rw [← _root_.map_add, sub_add_cancel]

section Generator

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- The generator of a group: the generator of its semigroup. -/
def generator : E →ₗ.[𝕜] E := G.toC0Semigroup.generator

theorem hasDerivWithinAt_generator (x : G.generator.domain) :
    HasDerivWithinAt (fun t => G.S t x) (G.generator x) (Ici 0) 0 :=
  G.toC0Semigroup.hasDerivWithinAt_generator x

/-- A continuous `𝕜`-linear map carries `ℝ`-derivatives along. -/
theorem _root_.ContinuousLinearMap.hasDerivAt_apply_of_hasDerivAt (L : E →L[𝕜] E) {f : ℝ → E}
    {f' : E} {t : ℝ} (h : HasDerivAt f f' t) : HasDerivAt (fun s => L (f s)) (L f') t :=
  (L.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt t h

/-- For a group the generator is a two-sided derivative at `0`. -/
theorem hasDerivAt_generator [CompleteSpace E] (x : G.generator.domain) :
    HasDerivAt (fun t => G.S t x) (G.generator x) 0 := by
  set f : ℝ → E := fun t => G.S t x
  have hr := G.hasDerivWithinAt_generator x
  have hl : HasDerivWithinAt f (G.generator x) (Iic 0) 0 := by
    rw [← hasDerivWithinAt_Iio_iff_Iic,
      hasDerivWithinAt_iff_tendsto_slope' (fun h => lt_irrefl _ (mem_Iio.1 h))]
    have hr' := (hasDerivWithinAt_iff_tendsto_slope' (fun h => lt_irrefl _ (mem_Ioi.1 h))).1
      (hasDerivWithinAt_Ioi_iff_Ici.2 hr)
    have hneg : Tendsto (fun t : ℝ => -t) (𝓝[<] 0) (𝓝[>] 0) := by
      refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
      · simpa using ((continuous_neg (G := ℝ)).tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
      · filter_upwards [self_mem_nhdsWithin] with t ht
        exact neg_pos.2 ht
    have hv := hr'.comp hneg
    have key : ∀ t, slope f 0 t = G.S t (slope f 0 (-t)) := by
      intro t
      simp only [slope_def_module, f, sub_zero, S_zero_apply]
      rw [ContinuousLinearMap.map_smul_of_tower, _root_.map_sub, S_apply_S_neg, inv_neg, neg_smul,
        ← smul_neg, neg_sub]
    refine (G.tendsto_S_apply_of_tendsto nhdsWithin_le_nhds hv).congr fun t => ?_
    rw [key]; rfl
  have h := hl.union hr
  rw [Iic_union_Ici, hasDerivWithinAt_univ] at h
  exact h

/-- `x ∈ D(A)` iff `t ↦ S t x` is differentiable at `0`. -/
theorem mem_domain_generator_iff [CompleteSpace E] (x : E) :
    x ∈ G.generator.domain ↔ DifferentiableAt ℝ (fun t => G.S t x) 0 :=
  ⟨fun hx => (G.hasDerivAt_generator ⟨x, hx⟩).differentiableAt,
    fun h => (show x ∈ G.toC0Semigroup.generatorDomain from
      ⟨_, h.hasDerivAt.hasDerivWithinAt⟩)⟩

/-- The generator is the derivative at `0`. -/
theorem generator_apply_eq {x : G.generator.domain} {y : E}
    (h : HasDerivAt (fun t => G.S t x) y 0) : G.generator x = y :=
  G.toC0Semigroup.generator_apply_eq h.hasDerivWithinAt

/-- `S t` maps `D(A)` into `D(A)`. -/
theorem mapsTo_domain [CompleteSpace E] (x : G.generator.domain) (t : ℝ) :
    G.S t x ∈ G.generator.domain := by
  rw [mem_domain_generator_iff]
  have h := (G.S t).hasDerivAt_apply_of_hasDerivAt (G.hasDerivAt_generator x)
  refine h.differentiableAt.congr_of_eventuallyEq (Eventually.of_forall fun s => ?_)
  exact G.comm_apply s t x

/-- `A (S t x) = S t (A x)` on `D(A)`. -/
theorem generator_apply_S [CompleteSpace E] (x : G.generator.domain) (t : ℝ) :
    G.generator ⟨G.S t x, G.mapsTo_domain x t⟩ = G.S t (G.generator x) := by
  refine G.generator_apply_eq ?_
  refine ((G.S t).hasDerivAt_apply_of_hasDerivAt (G.hasDerivAt_generator x)).congr_of_eventuallyEq
    (Eventually.of_forall fun s => ?_)
  exact G.comm_apply s t x

/-- Orbits of domain points: `(d/dt) S t x = S t (A x)`. -/
theorem hasDerivAt_apply [CompleteSpace E] (x : G.generator.domain) (t : ℝ) :
    HasDerivAt (fun s => G.S s x) (G.S t (G.generator x)) t := by
  have h0 := (G.S t).hasDerivAt_apply_of_hasDerivAt (G.hasDerivAt_generator x)
  rw [show (0 : ℝ) = t - t from (sub_self t).symm] at h0
  have h1 := HasDerivAt.comp_sub_const t t h0
  convert h1 using 1
  funext s
  simp only [← map_add_apply]
  congr 2; ring

/-- Orbits of domain points, in generator form: `(d/dt) S t x = A (S t x)`. -/
theorem hasDerivAt_apply' [CompleteSpace E] (x : G.generator.domain) (t : ℝ) :
    HasDerivAt (fun s => G.S s x) (G.generator ⟨G.S t x, G.mapsTo_domain x t⟩) t := by
  rw [generator_apply_S]; exact G.hasDerivAt_apply x t

/-- **The generator of a group is densely defined**: `h⁻¹ ∫₀ʰ S(s) x ds ∈ D(A)` tends to `x`. -/
theorem dense_domain_generator [CompleteSpace E] : Dense (G.generator.domain : Set E) := by
  intro x
  set f : ℝ → E := fun s => G.S s x
  have hf : Continuous f := G.strongCont x
  have hmem : ∀ h : ℝ, (∫ s in (0 : ℝ)..h, f s) ∈ G.generator.domain := by
    intro h
    rw [mem_domain_generator_iff]
    have e : (fun τ => G.S τ (∫ s in (0 : ℝ)..h, f s)) =
        fun τ => (∫ s in (0 : ℝ)..(τ + h), f s) - ∫ s in (0 : ℝ)..τ, f s := by
      funext τ
      rw [← (G.S τ).intervalIntegral_comp_comm (hf.intervalIntegrable _ _)]
      have : ∀ s, G.S τ (f s) = f (τ + s) := fun s => by
        simp only [f, map_add_apply]
      simp_rw [this]
      rw [intervalIntegral.integral_comp_add_left (fun u => f u) τ, add_zero,
        intervalIntegral.integral_interval_sub_left (hf.intervalIntegrable _ _)
          (hf.intervalIntegrable _ _)]
    rw [e]
    have h1 : HasDerivAt (fun τ => ∫ s in (0 : ℝ)..(τ + h), f s) (f (0 + h)) 0 := by
      have := (hf.integral_hasStrictDerivAt 0 (0 + h)).hasDerivAt
      exact HasDerivAt.comp_add_const 0 h this
    have h2 := (hf.integral_hasStrictDerivAt 0 0).hasDerivAt
    exact (h1.sub h2).differentiableAt
  have hd := (hf.integral_hasStrictDerivAt 0 0).hasDerivAt
  rw [hasDerivAt_iff_tendsto_slope] at hd
  have hx : f 0 = x := by simp [f]
  rw [hx] at hd
  refine mem_closure_of_tendsto hd (Eventually.of_forall fun h => ?_)
  rw [slope_def_module, intervalIntegral.integral_same, sub_zero, sub_zero]
  exact Submodule.smul_of_tower_mem _ _ (hmem h)


/-- **Orbits are continuous in the graph norm**: for a linear map `Φ` from `D(A)` to a normed space
`V` bounded by the graph norm, `‖Φ z‖ ≤ c (‖z‖ + ‖A z‖)`, `t ↦ Φ (S t x)` is continuous for
`x ∈ D(A)` (`A (S t x) = S t (A x)`). Cf. [Pazy1983], §1.2, Thm 2.4. -/
theorem continuous_graph [CompleteSpace E] {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (Φ : G.generator.domain →ₗ[ℝ] V) (c : ℝ)
    (hΦ : ∀ z, ‖Φ z‖ ≤ c * (‖(z : E)‖ + ‖G.generator z‖)) (x : G.generator.domain) :
    Continuous fun s => Φ ⟨G.S s x, G.mapsTo_domain x s⟩ := by
  rw [continuous_iff_continuousAt]
  intro t
  rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
  have h1 : Tendsto (fun s => c * (‖G.S s x - G.S t x‖ +
      ‖G.S s (G.generator x) - G.S t (G.generator x)‖)) (𝓝 t) (𝓝 0) := by
    have a := tendsto_iff_norm_sub_tendsto_zero.1 ((G.strongCont (x : E)).tendsto t)
    have b := tendsto_iff_norm_sub_tendsto_zero.1 ((G.strongCont (G.generator x)).tendsto t)
    simpa using (a.add b).const_mul c
  refine squeeze_zero (fun _ => norm_nonneg _) (fun s => ?_) h1
  rw [← _root_.map_sub]
  refine (hΦ _).trans (le_of_eq ?_)
  rw [LinearPMap.map_sub, G.generator_apply_S, G.generator_apply_S]
  rfl

/-- **Orbits of `D(A²)` points are differentiable in the graph norm**: for `Φ` as in
`continuous_graph` and `x ∈ D(A)` with `A x = y ∈ D(A)`, `(d/dt) Φ (S t x) = Φ (S t y)`.
Cf. [Pazy1983], §1.2, Thm 2.4 (c). -/
theorem hasDerivAt_graph [CompleteSpace E] {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (Φ : G.generator.domain →ₗ[ℝ] V) (c : ℝ)
    (hΦ : ∀ z, ‖Φ z‖ ≤ c * (‖(z : E)‖ + ‖G.generator z‖)) (x y : G.generator.domain)
    (hxy : G.generator x = y) (t : ℝ) :
    HasDerivAt (fun s => Φ ⟨G.S s x, G.mapsTo_domain x s⟩)
      (Φ ⟨G.S t y, G.mapsTo_domain y t⟩) t := by
  rw [hasDerivAt_iff_isLittleO]
  have hx := hasDerivAt_iff_isLittleO.1 (G.hasDerivAt_apply x t)
  have hy := hasDerivAt_iff_isLittleO.1 (G.hasDerivAt_apply y t)
  rw [hxy] at hx
  have hsum := (hx.norm_left.add hy.norm_left).const_mul_left c
  refine Asymptotics.IsBigO.trans_isLittleO (Asymptotics.IsBigO.of_bound 1
    (Eventually.of_forall fun s => ?_)) hsum
  rw [one_mul, Real.norm_eq_abs]
  set z : G.generator.domain := ⟨G.S s x, G.mapsTo_domain x s⟩ - ⟨G.S t x, G.mapsTo_domain x t⟩
    - (s - t) • ⟨G.S t y, G.mapsTo_domain y t⟩ with hz
  have hΦz : Φ ⟨G.S s x, G.mapsTo_domain x s⟩ - Φ ⟨G.S t x, G.mapsTo_domain x t⟩
      - (s - t) • Φ ⟨G.S t y, G.mapsTo_domain y t⟩ = Φ z := by
    rw [hz, _root_.map_sub, _root_.map_sub, _root_.map_smul]
  have hsm : ∀ (r : ℝ) (w : G.generator.domain), G.generator (r • w) = r • G.generator w :=
    fun r w => by
      rw [show r • w = (r : 𝕜) • w from Subtype.ext (RCLike.real_smul_eq_coe_smul (K := 𝕜) r
        (w : E)), LinearPMap.map_smul, ← RCLike.real_smul_eq_coe_smul]
  have hAz : G.generator z = G.S s y - G.S t y - (s - t) • G.S t (G.generator y) := by
    rw [hz, LinearPMap.map_sub, LinearPMap.map_sub, hsm,
      G.generator_apply_S, G.generator_apply_S, G.generator_apply_S, hxy]
  have hz' : (z : E) = G.S s x - G.S t x - (s - t) • G.S t y := rfl
  rw [hΦz]
  refine (hΦ z).trans (le_trans ?_ (le_abs_self _))
  rw [hAz, hz']

end Generator

/-! ### Isometric groups on inner product spaces -/

section Isometric

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] {G : C0Group 𝕜 F}

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

theorem IsIsometric.inner_map_map (hG : G.IsIsometric) (t : ℝ) (a b : F) :
    ⟪G.S t a, G.S t b⟫ = ⟪a, b⟫ :=
  (LinearMap.norm_map_iff_inner_map_map (G.S t)).mp (hG t) a b

/-- `⟪S t a, b⟫ = ⟪a, S (-t) b⟫`: `S t` is unitary with inverse `S (-t)`. -/
theorem IsIsometric.inner_S_left (hG : G.IsIsometric) (t : ℝ) (a b : F) :
    ⟪G.S t a, b⟫ = ⟪a, G.S (-t) b⟫ := by
  conv_lhs => rw [show b = G.S t (G.S (-t) b) from (G.S_apply_S_neg t b).symm]
  exact hG.inner_map_map t a _

theorem IsIsometric.norm_S_le (hG : G.IsIsometric) (t : ℝ) : ‖G.S t‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => by rw [hG t, one_mul]

variable [NormedSpace ℝ F] [IsScalarTower ℝ 𝕜 F] [CompleteSpace F]

/-- **The generator of an isometric group is skew-symmetric** (differentiate
`⟪S t x, S t y⟫ = ⟪x, y⟫` at `0`). -/
theorem IsIsometric.isSkewSymmetric_generator (hG : G.IsIsometric) :
    G.generator.IsSkewSymmetric := by
  intro x y
  have hconst : (fun t => ⟪G.S t x, G.S t y⟫) = fun _ => ⟪(x : F), (y : F)⟫ :=
    funext fun t => hG.inner_map_map t x y
  have hd := (G.hasDerivAt_generator x).inner 𝕜 (G.hasDerivAt_generator y)
  rw [hconst] at hd
  have h0 := hd.unique (hasDerivAt_const (0 : ℝ) _)
  simp only [S_zero_apply] at h0
  rw [← sub_eq_zero, sub_neg_eq_add, add_comm]
  exact h0

end Isometric

/-! ### The group of a bounded operator -/

section Bounded

/-- `ℚ`-algebra structure on operators, for `NormedSpace.exp_add_of_commute`. -/
local instance instNormedAlgebraRatCLM : NormedAlgebra ℚ (E →L[𝕜] E) :=
  NormedAlgebra.restrictScalars ℚ 𝕜 _

variable [CompleteSpace E]

theorem exp_ofReal_smul_add (B : E →L[𝕜] E) (s t : ℝ) :
    exp (((s + t : ℝ) : 𝕜) • B) = exp ((s : 𝕜) • B) * exp ((t : 𝕜) • B) := by
  rw [RCLike.ofReal_add, add_smul,
    exp_add_of_commute ((Commute.refl B).smul_left (s : 𝕜) |>.smul_right (t : 𝕜))]

theorem continuous_exp_ofReal_smul (B : E →L[𝕜] E) :
    Continuous fun t : ℝ => exp ((t : 𝕜) • B) :=
  exp_continuous.comp (Continuous.smul (f := fun t : ℝ => (t : 𝕜)) (g := fun _ => B)
    RCLike.continuous_ofReal continuous_const)

/-- The uniformly continuous group `t ↦ exp(t B)` of a bounded operator `B`. -/
def ofBounded (B : E →L[𝕜] E) : C0Group 𝕜 E where
  S t := exp ((t : 𝕜) • B)
  map_zero := by simp
  map_add := exp_ofReal_smul_add B
  strongCont x := (continuous_exp_ofReal_smul B).clm_apply continuous_const

@[simp] theorem ofBounded_S (B : E →L[𝕜] E) (t : ℝ) : (ofBounded B).S t = exp ((t : 𝕜) • B) :=
  rfl

omit [CompleteSpace E] in
theorem commute_exp_ofReal_smul (B : E →L[𝕜] E) (t : ℝ) : Commute B (exp ((t : 𝕜) • B)) :=
  ((Commute.refl B).smul_right (t : 𝕜)).exp_right

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

omit [CompleteSpace E] in
/-- An `𝕜`-derivative along the real axis is an `ℝ`-derivative. -/
theorem _root_.HasDerivAt.comp_ofReal_rclike {f : 𝕜 → E} {f' : E} {t : ℝ}
    (h : HasDerivAt f f' (t : 𝕜)) : HasDerivAt (fun s : ℝ => f s) f' t := by
  have h1 := (h.hasFDerivAt.restrictScalars ℝ).comp_hasDerivAt t
    (RCLike.ofRealCLM (K := 𝕜)).hasDerivAt
  simpa [Function.comp_def] using h1

/-- `(d/dt) exp(t B) x = B exp(t B) x`. -/
theorem hasDerivAt_exp_ofReal_smul_apply (B : E →L[𝕜] E) (x : E) (t : ℝ) :
    HasDerivAt (fun s : ℝ => exp ((s : 𝕜) • B) x) (B (exp ((t : 𝕜) • B) x)) t := by
  have h := HasDerivAt.clm_apply (hasDerivAt_exp_smul_const' (𝕂 := 𝕜) B (t : 𝕜))
    (hasDerivAt_const (t : 𝕜) x)
  simp only [_root_.map_zero, add_zero, mul_apply_eq_comp] at h
  exact h.comp_ofReal_rclike

/-- `exp(t B)` is generated by `B`, with domain all of `E`. -/
theorem generator_ofBounded (B : E →L[𝕜] E) :
    (ofBounded B).generator = (B : E →ₗ[𝕜] E).toPMap ⊤ := by
  have hd : ∀ x : E, HasDerivAt (fun t => (ofBounded B).S t x) (B x) 0 := fun x => by
    simpa using hasDerivAt_exp_ofReal_smul_apply B x 0
  have hdom : (ofBounded B).generator.domain = ⊤ :=
    Submodule.eq_top_iff'.2 fun x => ⟨_, (hd x).hasDerivWithinAt⟩
  refine LinearPMap.ext hdom fun x hx _ => ?_
  rw [(ofBounded B).generator_apply_eq (x := ⟨x, hx⟩) (hd x)]
  rfl

theorem mem_domain_generator_ofBounded (B : E →L[𝕜] E) (x : E) :
    x ∈ (ofBounded B).generator.domain := by
  rw [generator_ofBounded]; trivial

theorem generator_ofBounded_apply (B : E →L[𝕜] E) (x : (ofBounded B).generator.domain) :
    (ofBounded B).generator x = B x :=
  (ofBounded B).generator_apply_eq (by simpa using hasDerivAt_exp_ofReal_smul_apply B x 0)

end Bounded

section BoundedSkew

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace 𝕜 F] [CompleteSpace F]

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

local instance instNormedAlgebraRatCLM' : NormedAlgebra ℚ (F →L[𝕜] F) :=
  NormedAlgebra.restrictScalars ℚ 𝕜 _

/-- A skew bounded operator satisfies `B† = -B`. -/
theorem adjoint_eq_neg_of_skew {B : F →L[𝕜] F} (hB : ∀ x y, ⟪B x, y⟫ = -⟪x, B y⟫) :
    ContinuousLinearMap.adjoint B = -B := by
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro x y
  simp [hB]

/-- For skew `B`, `exp(t B)` is unitary, hence an isometry. -/
theorem norm_exp_ofReal_smul_apply {B : F →L[𝕜] F} (hB : ∀ x y, ⟪B x, y⟫ = -⟪x, B y⟫) (t : ℝ)
    (x : F) : ‖exp ((t : 𝕜) • B) x‖ = ‖x‖ := by
  have hskew : (t : 𝕜) • B ∈ skewAdjoint (F →L[𝕜] F) := by
    rw [skewAdjoint.mem_iff, star_smul, RCLike.star_def, RCLike.conj_ofReal,
      ContinuousLinearMap.star_eq_adjoint, adjoint_eq_neg_of_skew hB, smul_neg]
  exact ContinuousLinearMap.norm_map_of_mem_unitary (exp_mem_unitary_of_mem_skewAdjoint hskew) x

/-- The group of a skew bounded operator is isometric. -/
theorem isIsometric_ofBounded {B : F →L[𝕜] F} (hB : ∀ x y, ⟪B x, y⟫ = -⟪x, B y⟫) :
    (ofBounded B).IsIsometric :=
  norm_exp_ofReal_smul_apply hB

variable [NormedSpace ℝ F] [IsScalarTower ℝ 𝕜 F]

/-- For skew `B`, `‖exp(t B) x - x‖ ≤ |t| ‖B x‖` (mean value theorem). -/
theorem norm_exp_ofReal_smul_sub_le {B : F →L[𝕜] F} (hB : ∀ x y, ⟪B x, y⟫ = -⟪x, B y⟫) (t : ℝ)
    (x : F) : ‖exp ((t : 𝕜) • B) x - x‖ ≤ |t| * ‖B x‖ := by
  have hd : ∀ s ∈ (univ : Set ℝ), HasDerivWithinAt (fun s : ℝ => exp ((s : 𝕜) • B) x)
      (exp ((s : 𝕜) • B) (B x)) univ s := by
    intro s _
    have h := hasDerivAt_exp_ofReal_smul_apply B x s
    have hc : B (exp ((s : 𝕜) • B) x) = exp ((s : 𝕜) • B) (B x) :=
      congrArg (fun C : F →L[𝕜] F => C x) (commute_exp_ofReal_smul B s).eq
    rw [hc] at h
    exact h.hasDerivWithinAt
  have := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le hd
    (fun s _ => (norm_exp_ofReal_smul_apply hB s (B x)).le) convex_univ (mem_univ 0) (mem_univ t)
  simpa [Real.norm_eq_abs, mul_comm] using this

end BoundedSkew

end C0Group

