module

public import Feec.Semigroup.Rescale
public import Feec.Operator.Resolvent
public import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals
public import Mathlib.MeasureTheory.Integral.ExpDecay

/-!
# Resolvents of generators on Banach spaces: the Hille–Yosida estimates

Let `G` be a strongly continuous semigroup on a Banach space `E` over `𝕜 = ℝ` or `ℂ`, with
generator `A`. Every such semigroup is exponentially bounded, `‖S(t)‖ ≤ M e^{ωt}`
(`C0Semigroup.exists_norm_S_le_exp`), and then every `z` with `re z > ω` is in the resolvent
set of `A`, with the **Hille–Yosida estimates**

  `‖(z - A)^{-m}‖ ≤ M / (re z - ω)^m` for all `m`,

the resolvent being the Laplace transform `(z - A)^{-1} y = ∫₀^∞ e^{-zt} S(t) y dt`
([Pazy1983], §1.5; [EngelNagel2000], Ch. II, §1). These are the necessary conditions of
the Hille–Yosida theorem; nothing is assumed of `E` beyond completeness.

For an exponentially stable semigroup, `‖S(t)‖ ≤ M e^{-ct}` with `c > 0`, the integral
`∫₀^∞ S(t) y dt` is `(-A)^{-1} y` (`C0Semigroup.isResolvent_zero_of_norm_le`), and the estimate
for its powers comes from the weighted bound `‖S(s) ∫₀^∞ S(t) w dt‖ ≤ (K/c) e^{-cs}` whenever
`‖S(s) w‖ ≤ K e^{-cs}` for all `s ≥ 0` (`C0Semigroup.norm_S_apply_integral_le`), applied `m`
times: the Hille–Yosida norm `sup_{s ≥ 0} ‖e^{-ωs} S(s) w‖` is never formed. Real `z` reduce to
this case by the rescaling `e^{-zt} S(t)` (`C0Semigroup.rescale`); complex `z`, on complex
spaces, by the complex rescaling `C0Semigroup.complexRescale`.

## Main results

* `C0Semigroup.exists_norm_S_le_exp`: `‖S(t)‖ ≤ M e^{ωt}` for some `M`, `ω ≥ 0`;
* `C0Semigroup.isResolvent_zero_of_norm_le`, `C0Semigroup.norm_resolvent_zero_pow_le`:
  exponentially stable semigroups;
* `C0Semigroup.isResolvent_resolvent_ofReal`, `C0Semigroup.norm_resolvent_ofReal_pow_le`:
  **`‖(μ - A)^{-m}‖ ≤ M/(μ - ω)^m` for real `μ > ω`**, over `𝕜 = ℝ` or `ℂ`;
* `C0Semigroup.generator_complexRescale`: `e^{wt} S(t)` is generated by `A + w`, `w ∈ ℂ`;
* `C0Semigroup.isResolvent_resolvent`, `C0Semigroup.norm_resolvent_pow_le`:
  **`‖(z - A)^{-m}‖ ≤ M/(re z - ω)^m` for complex `z` with `re z > ω`**, on complex spaces.

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §1.2 (exponential bound), §1.5 (resolvent estimates)
* [K.-J. Engel, R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*][EngelNagel2000],
  Ch. I, §5; Ch. II, §1

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology MeasureTheory

@[expose] public noncomputable section

namespace Feec.C0Semigroup

open Operator

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E] (G : C0Semigroup 𝕜 E)

/-! ### The exponential bound -/

section Bound

variable [CompleteSpace E]

/-- **Every strongly continuous semigroup is exponentially bounded**: `‖S(t)‖ ≤ M e^{ωt}` for
`t ≥ 0`, with `ω ≥ 0` (`S(n + s) = S(1)ⁿ S(s)`). [Pazy1983], §1.2 -/
theorem exists_norm_S_le_exp : ∃ M ω : ℝ, 0 ≤ ω ∧ ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (ω * t) := by
  obtain ⟨C, -, hC⟩ := G.exists_bound 1
  set C' := max C 1
  have hC' : ∀ s ∈ Icc (0 : ℝ) 1, ‖G.S s‖ ≤ C' := fun s hs => (hC s hs).trans (le_max_left _ _)
  have h1 : 1 ≤ C' := le_max_right _ _
  have key : ∀ k : ℕ, ∀ s ∈ Icc (0 : ℝ) 1, ‖G.S (k + s)‖ ≤ C' ^ (k + 1) := by
    intro k
    induction k with
    | zero => intro s hs; simpa using hC' s hs
    | succ k ih =>
      intro s hs
      rw [show ((k + 1 : ℕ) : ℝ) + s = 1 + (k + s) by push_cast; ring,
        G.map_add _ _ zero_le_one (by positivity [hs.1])]
      calc ‖G.S 1 * G.S (k + s)‖ ≤ ‖G.S 1‖ * ‖G.S (k + s)‖ := norm_mul_le _ _
        _ ≤ C' * C' ^ (k + 1) :=
          mul_le_mul (hC' 1 ⟨zero_le_one, le_rfl⟩) (ih s hs) (norm_nonneg _) (by positivity)
        _ = C' ^ (k + 1 + 1) := by ring
  refine ⟨C', Real.log C', Real.log_nonneg h1, fun t ht => ?_⟩
  set n := ⌊t⌋₊
  have hs : t - n ∈ Icc (0 : ℝ) 1 :=
    ⟨sub_nonneg.2 (Nat.floor_le ht), by linarith [Nat.lt_floor_add_one t]⟩
  have h := key n (t - n) hs
  rw [show (n : ℝ) + (t - n) = t by ring] at h
  refine h.trans ?_
  rw [pow_succ, mul_comm]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  calc C' ^ n = Real.exp (n * Real.log C') := by
        rw [Real.exp_nat_mul, Real.exp_log (by positivity)]
    _ ≤ Real.exp (Real.log C' * t) := by
        rw [mul_comm]
        exact Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left (Nat.floor_le ht)
          (Real.log_nonneg h1))

end Bound

/-! ### Exponentially stable semigroups -/

section Stable

/-- The shifted orbit `t ↦ S(s + t) w` is integrable on `(0, ∞)` when `‖S(t) w‖ ≤ K e^{-ct}`,
`c > 0`. -/
theorem integrableOn_S_add_apply {w : E} {K c : ℝ} (hc : 0 < c)
    (hw : ∀ t, 0 ≤ t → ‖G.S t w‖ ≤ K * Real.exp (-c * t)) {s : ℝ} (hs : 0 ≤ s) :
    IntegrableOn (fun t => G.S (s + t) w) (Ioi 0) := by
  refine Integrable.mono' ((exp_neg_integrableOn_Ioi 0 hc).const_mul (K * Real.exp (-c * s)))
    (((G.strongCont w).comp (continuous_const_add s).continuousOn fun t (ht : t ∈ Ioi 0) =>
      mem_Ici.2 (by linarith [mem_Ioi.1 ht])).aestronglyMeasurable measurableSet_Ioi) ?_
  refine (ae_restrict_iff' measurableSet_Ioi).2 (Eventually.of_forall fun t (ht : 0 < t) => ?_)
  calc ‖G.S (s + t) w‖ ≤ K * Real.exp (-c * (s + t)) := hw _ (by linarith)
    _ = K * Real.exp (-c * s) * Real.exp (-c * t) := by rw [mul_add, Real.exp_add]; ring

theorem integral_exp_neg_mul_Ioi {c : ℝ} (hc : 0 < c) :
    ∫ t in Ioi (0 : ℝ), Real.exp (-c * t) = 1 / c := by
  rw [integral_exp_mul_Ioi (neg_lt_zero.2 hc), mul_zero, Real.exp_zero]
  field_simp

/-- `‖S(t) w‖ ≤ (M ‖w‖) e^{-ct}` from `‖S(t)‖ ≤ M e^{-ct}`. -/
theorem norm_S_apply_le_of_norm_le {M c : ℝ} (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (-c * t))
    (w : E) {t : ℝ} (ht : 0 ≤ t) : ‖G.S t w‖ ≤ M * ‖w‖ * Real.exp (-c * t) :=
  ((G.S t).le_opNorm w).trans (by
    rw [mul_right_comm]; exact mul_le_mul_of_nonneg_right (hS t ht) (norm_nonneg w))

variable [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

omit [IsScalarTower ℝ 𝕜 E] in
/-- **The weighted bound**: if `‖S(s) w‖ ≤ K e^{-cs}` for all `s ≥ 0` (`c > 0`), then
`‖S(s) ∫₀^∞ S(t) w dt‖ ≤ (K/c) e^{-cs}` for all `s ≥ 0`. -/
theorem norm_S_apply_integral_le {w : E} {K c : ℝ} (hc : 0 < c)
    (hw : ∀ t, 0 ≤ t → ‖G.S t w‖ ≤ K * Real.exp (-c * t)) {s : ℝ} (hs : 0 ≤ s) :
    ‖G.S s (∫ t in Ioi 0, G.S t w)‖ ≤ K / c * Real.exp (-c * s) := by
  have hi : IntegrableOn (fun t => G.S t w) (Ioi 0) := by
    simpa using G.integrableOn_S_add_apply hc hw le_rfl
  rw [← (G.S s).integral_comp_comm hi]
  have he : ∫ t in Ioi 0, G.S s (G.S t w) = ∫ t in Ioi 0, G.S (s + t) w :=
    setIntegral_congr_fun measurableSet_Ioi fun t (ht : 0 < t) =>
      (G.S_add_apply hs ht.le w).symm
  rw [he]
  have hg : IntegrableOn (fun t => K * Real.exp (-c * s) * Real.exp (-c * t)) (Ioi 0) :=
    (exp_neg_integrableOn_Ioi 0 hc).const_mul _
  refine (norm_integral_le_of_norm_le hg ((ae_restrict_iff' measurableSet_Ioi).2
    (Eventually.of_forall fun t (ht : 0 < t) => ?_))).trans_eq ?_
  · calc ‖G.S (s + t) w‖ ≤ K * Real.exp (-c * (s + t)) := hw _ (by linarith)
      _ = K * Real.exp (-c * s) * Real.exp (-c * t) := by rw [mul_add, Real.exp_add]; ring
  · rw [integral_const_mul, integral_exp_neg_mul_Ioi hc]
    ring

/-- **The resolvent of an exponentially stable semigroup at `0`**: for `‖S(t)‖ ≤ M e^{-ct}`,
`c > 0`, the integral `∫₀^∞ S(t) y dt` is `(-A)^{-1} y`. [Pazy1983], §1.5 -/
theorem isResolvent_zero_of_norm_le {M c : ℝ} (hc : 0 < c)
    (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (-c * t)) :
    IsResolvent G.generator 0 (resolvent G.generator 0) ∧
      ∀ y, resolvent G.generator 0 y = ∫ t in Ioi 0, G.S t y := by
  have hi : ∀ y, IntegrableOn (fun t => G.S t y) (Ioi 0) := fun y => by
    simpa using G.integrableOn_S_add_apply hc (fun t ht => G.norm_S_apply_le_of_norm_le hS y ht)
      le_rfl
  have hlim : ∀ y, Tendsto (fun u => ∫ t in (0 : ℝ)..u, G.S t y) atTop
      (𝓝 (∫ t in Ioi 0, G.S t y)) := fun y => intervalIntegral_tendsto_integral_Ioi 0 (hi y)
      tendsto_id
  have hdecay : ∀ y, Tendsto (fun u => G.S u y) atTop (𝓝 0) := fun y => by
    have he : Tendsto (fun u : ℝ => M * ‖y‖ * Real.exp (-c * u)) atTop (𝓝 0) := by
      simpa using (Real.tendsto_exp_atBot.comp
        (tendsto_id.const_mul_atTop_of_neg (neg_lt_zero.2 hc))).const_mul (M * ‖y‖)
    exact squeeze_zero_norm' ((eventually_ge_atTop 0).mono fun u hu =>
      G.norm_S_apply_le_of_norm_le hS y hu) he
  -- the operator `L y = ∫₀^∞ S(t) y dt`
  let L : E →L[𝕜] E := LinearMap.mkContinuous
    { toFun := fun y => ∫ t in Ioi 0, G.S t y
      map_add' := fun x y => by
        change ∫ t in Ioi 0, G.S t (x + y) = (∫ t in Ioi 0, G.S t x) + ∫ t in Ioi 0, G.S t y
        simp_rw [_root_.map_add]; exact integral_add (hi x) (hi y)
      map_smul' := fun a y => by
        change ∫ t in Ioi 0, G.S t (a • y) = a • ∫ t in Ioi 0, G.S t y
        simp_rw [_root_.map_smul]; exact integral_smul a _ }
    (M / c) fun y => by
      have h := G.norm_S_apply_integral_le hc (fun t ht => G.norm_S_apply_le_of_norm_le hS y ht)
        le_rfl
      simp only [S_zero_apply, mul_zero, Real.exp_zero, mul_one] at h
      change ‖∫ t in Ioi 0, G.S t y‖ ≤ M / c * ‖y‖
      rw [div_mul_eq_mul_div]; exact h
  have hL : ∀ y, L y = ∫ t in Ioi 0, G.S t y := fun y => rfl
  -- `(L y, -y) ∈ graph A`
  have hgraph : ∀ y, (L y, -y) ∈ G.generator.graph := fun y => by
    have ht : Tendsto (fun u => (∫ t in (0 : ℝ)..u, G.S t y, G.S u y - y)) atTop
        (𝓝 (L y, -y)) := by
      rw [hL, show -y = (0 : E) - y by abel]
      exact (hlim y).prodMk_nhds ((hdecay y).sub_const y)
    exact G.isClosed_generator.mem_of_tendsto ht
      ((eventually_ge_atTop 0).mono fun u hu => G.integral_mem_graph_S hu y)
  have hR : IsResolvent G.generator 0 L :=
    { mem_domain := fun y => (LinearPMap.mem_graph_iff_exists.1 (hgraph y)).1
      sub_apply := fun y => by
        have h := (LinearPMap.mem_graph_iff_exists.1 (hgraph y)).2
        rw [zero_smul, zero_sub, h, neg_neg]
      apply_sub := fun x => by
        rw [zero_smul, zero_sub, map_neg, hL, neg_eq_iff_eq_neg]
        refine tendsto_nhds_unique (hlim (G.generator x)) ?_
        have h := (hdecay x).sub_const (x : E)
        rw [zero_sub] at h
        exact h.congr' ((eventually_ge_atTop 0).mono fun u hu => G.sub_eq_integral x hu) }
  rw [hR.resolvent_eq]
  exact ⟨hR, hL⟩

/-- **The Hille–Yosida estimate at `0`**: `‖(-A)^{-m}‖ ≤ M / cᵐ` for `‖S(t)‖ ≤ M e^{-ct}`,
`c > 0`. [Pazy1983], §1.5 -/
theorem norm_resolvent_zero_pow_le {M c : ℝ} (hc : 0 < c)
    (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (-c * t)) (m : ℕ) :
    ‖resolvent G.generator 0 ^ m‖ ≤ M / c ^ m := by
  obtain ⟨-, hL⟩ := G.isResolvent_zero_of_norm_le hc hS
  have hM : 0 ≤ M := by
    have := (norm_nonneg _).trans (hS 0 le_rfl)
    simpa using this
  have key : ∀ k : ℕ, ∀ w : E, ∀ s, 0 ≤ s →
      ‖G.S s ((resolvent G.generator 0 ^ k) w)‖ ≤ M * ‖w‖ / c ^ k * Real.exp (-c * s) := by
    intro k
    induction k with
    | zero => intro w s hs; simpa using G.norm_S_apply_le_of_norm_le hS w hs
    | succ k ih =>
      intro w s hs
      rw [pow_succ', mul_apply_eq_comp, hL]
      refine (G.norm_S_apply_integral_le hc (ih w) hs).trans_eq ?_
      rw [pow_succ]; field_simp
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun w => ?_
  have := key m w 0 le_rfl
  simp only [S_zero_apply, mul_zero, Real.exp_zero, mul_one] at this
  rw [div_mul_eq_mul_div]; exact this

/-! ### Real points of the resolvent set -/

omit [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] in
/-- A resolvent of `A - z` at `0` is a resolvent of `A` at `z`. -/
private theorem isResolvent_of_vadd {A : E →ₗ.[𝕜] E} {z : 𝕜} {R : E →L[𝕜] E}
    (h : IsResolvent (((-z) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A) 0 R) : IsResolvent A z R :=
  IsResolvent.of_neg_smul_vadd (by rwa [sub_self])

omit [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] in
private theorem norm_rescale_neg_le {M ω : ℝ} (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (ω * t))
    (μ : ℝ) {t : ℝ} (ht : 0 ≤ t) :
    ‖(G.rescale (-μ)).S t‖ ≤ M * Real.exp (-(μ - ω) * t) := by
  rw [norm_rescale_S, show -(μ - ω) * t = -μ * t + ω * t by ring, Real.exp_add]
  calc Real.exp (-μ * t) * ‖G.S t‖ ≤ Real.exp (-μ * t) * (M * Real.exp (ω * t)) :=
        mul_le_mul_of_nonneg_left (hS t ht) (Real.exp_pos _).le
    _ = _ := by ring

private theorem isResolvent_rescale {M ω : ℝ}
    (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (ω * t)) {μ : ℝ} (hμ : ω < μ) :
    IsResolvent G.generator (μ : 𝕜) (resolvent (G.rescale (-μ)).generator 0) := by
  have h := ((G.rescale (-μ)).isResolvent_zero_of_norm_le (sub_pos.2 hμ)
    fun t ht => G.norm_rescale_neg_le hS μ ht).1
  have hgen : (G.rescale (-μ)).generator =
      ((-(μ : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ G.generator := by
    rw [generator_rescale, RCLike.ofReal_neg]
  exact isResolvent_of_vadd (hgen ▸ h)

/-- **Real points `μ > ω` are in the resolvent set** of the generator of a semigroup with
`‖S(t)‖ ≤ M e^{ωt}`. [Pazy1983], §1.5 -/
theorem isResolvent_resolvent_ofReal {M ω : ℝ}
    (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (ω * t)) {μ : ℝ} (hμ : ω < μ) :
    IsResolvent G.generator (μ : 𝕜) (resolvent G.generator (μ : 𝕜)) :=
  (G.isResolvent_rescale hS hμ).isResolvent_resolvent

/-- **The Hille–Yosida estimates at real points**: `‖(μ - A)^{-m}‖ ≤ M / (μ - ω)ᵐ` for
`μ > ω`, when `‖S(t)‖ ≤ M e^{ωt}`. [Pazy1983], §1.5 -/
theorem norm_resolvent_ofReal_pow_le {M ω : ℝ}
    (hS : ∀ t, 0 ≤ t → ‖G.S t‖ ≤ M * Real.exp (ω * t)) {μ : ℝ} (hμ : ω < μ) (m : ℕ) :
    ‖resolvent G.generator (μ : 𝕜) ^ m‖ ≤ M / (μ - ω) ^ m := by
  rw [(G.isResolvent_rescale hS hμ).resolvent_eq]
  exact (G.rescale (-μ)).norm_resolvent_zero_pow_le (sub_pos.2 hμ)
    (fun t ht => G.norm_rescale_neg_le hS μ ht) m

end Stable

/-! ### Complex rescaling and complex points of the resolvent set -/

section Complex

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F] (H : C0Semigroup ℂ F)

/-- **The complex rescaling** `t ↦ e^{wt} S(t)`, `w ∈ ℂ`. -/
def complexRescale (w : ℂ) : C0Semigroup ℂ F where
  S t := Complex.exp (w * t) • H.S t
  map_zero := by simp [H.map_zero]
  map_add s t hs ht := by
    rw [H.map_add s t hs ht, smul_mul_smul_comm, Complex.ofReal_add, mul_add, Complex.exp_add]
  strongCont x :=
    ((Complex.continuous_exp.comp
      (continuous_const.mul Complex.continuous_ofReal)).continuousOn.smul
        (H.strongCont x)).congr fun _ _ => rfl

theorem complexRescale_S_apply (w : ℂ) (t : ℝ) (x : F) :
    (H.complexRescale w).S t x = Complex.exp (w * t) • H.S t x := rfl

theorem norm_complexRescale_S (w : ℂ) (t : ℝ) :
    ‖(H.complexRescale w).S t‖ = Real.exp (w.re * t) * ‖H.S t‖ := by
  rw [show (H.complexRescale w).S t = Complex.exp (w * t) • H.S t from rfl, norm_smul,
    Complex.norm_exp, Complex.re_mul_ofReal]

/-- Rescaling by `w` and then by `-w` gives back `H`. -/
theorem complexRescale_complexRescale_neg (w : ℂ) :
    (H.complexRescale w).complexRescale (-w) = H := by
  obtain ⟨S, h0, hadd, hc⟩ := H
  simp only [complexRescale, mk.injEq]
  funext t
  rw [smul_smul, ← Complex.exp_add, show -w * t + w * t = 0 by ring, Complex.exp_zero, one_smul]

/-- On `D(A)`, `t ↦ e^{wt} S(t) x` has right derivative `w x + A x` at `0`. -/
theorem hasDerivWithinAt_complexRescale (w : ℂ) (x : H.generator.domain) :
    HasDerivWithinAt (fun t => (H.complexRescale w).S t x) (w • (x : F) + H.generator x)
      (Ici 0) 0 := by
  have he : HasDerivAt (fun t : ℝ => Complex.exp (w * t)) (Complex.exp (w * (0 : ℝ)) * (w * 1)) 0 :=
    ((hasDerivAt_id (0 : ℝ)).ofReal_comp.const_mul w).cexp
  have h := he.hasDerivWithinAt.smul (H.hasDerivWithinAt_generator x)
  simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, one_smul, mul_one, one_mul,
    S_zero_apply] at h
  rw [add_comm] at h
  exact h

theorem domain_le_domain_complexRescale (w : ℂ) :
    H.generator.domain ≤ (H.complexRescale w).generator.domain :=
  fun x hx => ⟨_, H.hasDerivWithinAt_complexRescale w ⟨x, hx⟩⟩

/-- **The generator of the complex rescaling** is `A + w`, on `D(A)`. -/
theorem generator_complexRescale (w : ℂ) :
    (H.complexRescale w).generator = (w • (LinearMap.id : F →ₗ[ℂ] F)) +ᵥ H.generator := by
  have hd : (H.complexRescale w).generator.domain = H.generator.domain := by
    refine le_antisymm (fun x hx => ?_) (H.domain_le_domain_complexRescale w)
    have := (H.complexRescale w).domain_le_domain_complexRescale (-w) hx
    rwa [complexRescale_complexRescale_neg] at this
  refine LinearPMap.ext (hd.trans (LinearPMap.vadd_domain _ _).symm) fun x hf hg => ?_
  rw [(H.complexRescale w).generator_apply_eq (H.hasDerivWithinAt_complexRescale w ⟨x, hd ▸ hf⟩),
    LinearPMap.vadd_apply]
  rfl

private theorem norm_complexRescale_neg_le {M ω : ℝ}
    (hS : ∀ t, 0 ≤ t → ‖H.S t‖ ≤ M * Real.exp (ω * t)) (z : ℂ) {t : ℝ} (ht : 0 ≤ t) :
    ‖(H.complexRescale (-z)).S t‖ ≤ M * Real.exp (-(z.re - ω) * t) := by
  rw [norm_complexRescale_S, Complex.neg_re, show -(z.re - ω) * t = -z.re * t + ω * t by ring,
    Real.exp_add]
  calc Real.exp (-z.re * t) * ‖H.S t‖ ≤ Real.exp (-z.re * t) * (M * Real.exp (ω * t)) :=
        mul_le_mul_of_nonneg_left (hS t ht) (Real.exp_pos _).le
    _ = _ := by ring

variable [CompleteSpace F]

private theorem isResolvent_complexRescale {M ω : ℝ}
    (hS : ∀ t, 0 ≤ t → ‖H.S t‖ ≤ M * Real.exp (ω * t)) {z : ℂ} (hz : ω < z.re) :
    IsResolvent H.generator z (resolvent (H.complexRescale (-z)).generator 0) := by
  have h := ((H.complexRescale (-z)).isResolvent_zero_of_norm_le (sub_pos.2 hz)
    fun t ht => H.norm_complexRescale_neg_le hS z ht).1
  exact isResolvent_of_vadd (H.generator_complexRescale (-z) ▸ h)

/-- **Complex points `re z > ω` are in the resolvent set** of the generator of a semigroup with
`‖S(t)‖ ≤ M e^{ωt}` on a complex Banach space. [Pazy1983], §1.5 -/
theorem isResolvent_resolvent {M ω : ℝ} (hS : ∀ t, 0 ≤ t → ‖H.S t‖ ≤ M * Real.exp (ω * t))
    {z : ℂ} (hz : ω < z.re) : IsResolvent H.generator z (resolvent H.generator z) :=
  (H.isResolvent_complexRescale hS hz).isResolvent_resolvent

/-- **The Hille–Yosida estimates at complex points**: `‖(z - A)^{-m}‖ ≤ M / (re z - ω)ᵐ` for
`re z > ω`, when `‖S(t)‖ ≤ M e^{ωt}`. [Pazy1983], §1.5 -/
theorem norm_resolvent_pow_le {M ω : ℝ} (hS : ∀ t, 0 ≤ t → ‖H.S t‖ ≤ M * Real.exp (ω * t))
    {z : ℂ} (hz : ω < z.re) (m : ℕ) : ‖resolvent H.generator z ^ m‖ ≤ M / (z.re - ω) ^ m := by
  rw [(H.isResolvent_complexRescale hS hz).resolvent_eq]
  exact (H.complexRescale (-z)).norm_resolvent_zero_pow_le (sub_pos.2 hz)
    (fun t ht => H.norm_complexRescale_neg_le hS z ht) m

end Complex

end Feec.C0Semigroup
