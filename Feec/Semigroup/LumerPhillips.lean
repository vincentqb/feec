module

public import Feec.Semigroup.Stone
public import Feec.Semigroup.Perturbation
public import Feec.ForMathlib.Analysis.Gronwall

/-!
# The Lumer–Phillips theorem

On a Hilbert space `E` over `𝕜 = ℝ` or `ℂ`, an operator `A : E →ₗ.[𝕜] E` is **m-dissipative**
(`LinearPMap.IsMDissipative`: `re ⟪A x, x⟫ ≤ 0` and `μ - A` onto for some `μ > 0`) iff it
generates a strongly continuous semigroup of contractions, and that semigroup is unique.

## Main results

Resolvents and m-dissipativity:

* `LinearPMap.IsMDissipative.surjective`, `IsMDissipative.isResolvent`,
  `IsMDissipative.norm_resolvent_le`: `μ - A` is onto for **every** `μ > 0`, with
  `‖(μ - A)⁻¹‖ ≤ 1 / μ` (Neumann series from the one `μ` of the definition).
* `IsMDissipative.isClosed`, `IsMDissipative.dense_domain`: an m-dissipative operator on a
  Hilbert space is closed and densely defined (density is not assumed).
* `IsDissipative.isMDissipative_of_orthogonal`, `IsDissipative.isMDissipative_of_adjoint`:
  criteria (closed, dissipative, `R(1 - A)ᗮ = 0`; or dissipative adjoint); hence
  `IsSelfAdjoint.isMDissipative` (self-adjoint and nonpositive) and
  `IsSkewAdjoint.isMDissipative`.

The theorem:

* `LinearPMap.IsMDissipative.semigroup`: the contraction semigroup
  `S(t) x = lim_n exp(t A_n) x` of the Yosida approximations
  `A_n = c_n A (c_n - A)⁻¹ = c_n² (c_n - A)⁻¹ - c_n`, `c_n = n + 1`
  (`Feec.LumerPhillips.yosida`), normalized by `S(t) = 1` for `t < 0`;
  `isContraction_semigroup` and **`generator_semigroup`**:
  `hA.semigroup.generator = A`, domain included.
* **`IsMDissipative.existsUnique_contraction`**: existence of a contraction semigroup generated by
  `A`, unique for `t ≥ 0` among all strongly continuous semigroups (`eqOn_semigroup`).
  `C0Semigroup.S` carries no information at negative times, so the literal `∃!` over
  `C0Semigroup` holds only after normalization: `existsUnique_normalized_contraction`.
* `C0Semigroup.IsContraction.isMDissipative_generator`: the converse; together,
  **`LinearPMap.isMDissipative_iff_exists_contraction`**.
* `LinearPMap.IsSkewAdjoint.eqOn_group_semigroup`: for skew-adjoint `A` the Lumer–Phillips
  semigroup is Stone's group `LinearPMap.IsSkewAdjoint.group` (consistency with
  `LinearPMap.isSkewAdjoint_iff_existsUnique_isometricGroup`).

Properties of the semigroup:

* `C0Semigroup.IsContraction.isDissipative_generator`,
  `C0Semigroup.eqOn_of_generator_eq_of_isDissipative` (uniqueness by the energy method, in the
  semigroup layer), `C0Semigroup.S_apply_of_mem_ker` (stationary points).
* `C0Semigroup.inner_S_left_of_isSymmetric`, `C0Semigroup.isSelfAdjoint_S_of_isSymmetric`: a
  symmetric generator gives self-adjoint `S t`;
  `C0Semigroup.starProjection_S_of_isSymmetric`: then `S t` commutes with the projection onto a
  subspace of stationary points.

## Construction

`‖(μ - A)⁻¹‖ ≤ 1/μ` makes `J_n = c_n (c_n - A)⁻¹` contractions with `J_n → 1` strongly, so the
bounded `A_n` are dissipative, commute, and `A_n x = J_n (A x) → A x` on `D(A)`. The energy method
makes `exp(t A_n)` contractions (`norm_exp_smul_apply_le`) and gives
`‖exp(t A_n) x - exp(t A_m) x‖ ≤ t ‖A_n x - A_m x‖` (`norm_exp_smul_sub_exp_smul_le`), so the
`exp(t A_n) x` converge for every `x` (density of `D(A)`), locally uniformly in `t` on `D(A)`.
The orbit identity `S(t) x - x = ∫₀ᵗ S(s) A x ds` on `D(A)` gives `A ⊆ B` for the generator `B`;
`B` is dissipative and `1 - A` is onto, so `B = A`. The literature proof goes through the
Hille–Yosida theorem; here only its contraction case is needed and is proved directly.

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §1.3 (Thm 3.1 Hille–Yosida, the Yosida approximation), §1.4 (Thm 4.3 Lumer–Phillips, Thm 4.6
  density in reflexive spaces)
* [K.-J. Engel, R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*][EngelNagel2000],
  §II.3 (Generation theorems)

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology NormedSpace LinearPMap Feec.Operator

@[expose] public noncomputable section

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

namespace LinearPMap

variable {A : E →ₗ.[𝕜] E}

/-! ### Dissipative operators: the lower bound and resolvents -/

/-- `μ ‖x‖ ≤ ‖μ x - A x‖` for a dissipative `A`. -/
theorem IsDissipative.mul_norm_le_norm_smul_sub (hA : A.IsDissipative) (μ : ℝ) (x : A.domain) :
    μ * ‖(x : E)‖ ≤ ‖(μ : 𝕜) • (x : E) - A x‖ := by
  simpa using hA.re_mul_norm_le_norm_shiftOp (μ : 𝕜) x

/-- `μ - A` is injective on `D(A)` for a dissipative `A` and `μ > 0`. -/
theorem IsDissipative.eq_zero_of_smul_sub_eq_zero (hA : A.IsDissipative) {μ : ℝ} (hμ : 0 < μ)
    {x : A.domain} (h : (μ : 𝕜) • (x : E) - A x = 0) : x = 0 := by
  have h1 := hA.mul_norm_le_norm_smul_sub μ x
  rw [h, norm_zero] at h1
  have h2 : ‖(x : E)‖ = 0 :=
    le_antisymm (by nlinarith [norm_nonneg (x : E)]) (norm_nonneg _)
  exact Subtype.ext (norm_eq_zero.1 h2)

theorem IsDissipative.injective_shiftOp (hA : A.IsDissipative) {μ : ℝ} (hμ : 0 < μ) :
    Function.Injective (shiftOp A (μ : 𝕜)) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  exact fun x hx => hA.eq_zero_of_smul_sub_eq_zero hμ hx

/-- For a dissipative `A`, `μ > 0`, and `μ - A` onto, `(μ - A)⁻¹` is a resolvent. -/
theorem IsDissipative.isResolvent_of_surjective (hA : A.IsDissipative) {μ : ℝ} (hμ : 0 < μ)
    (hs : ∀ y, ∃ x : A.domain, (μ : 𝕜) • (x : E) - A x = y) :
    IsResolvent A (μ : 𝕜) (resolvent A (μ : 𝕜)) := by
  let e : A.domain ≃ₗ[𝕜] E := LinearEquiv.ofBijective (shiftOp A (μ : 𝕜))
    ⟨hA.injective_shiftOp hμ, fun y => hs y⟩
  have hb : ∀ y, ‖(A.domain.subtype ∘ₗ e.symm.toLinearMap) y‖ ≤ μ⁻¹ * ‖y‖ := by
    intro y
    have h := hA.mul_norm_le_norm_smul_sub μ (e.symm y)
    have he : (μ : 𝕜) • ((e.symm y : A.domain) : E) - A (e.symm y) = y := e.apply_symm_apply y
    rw [he] at h
    rw [le_inv_mul_iff₀ hμ]
    exact h
  let R : E →L[𝕜] E := LinearMap.mkContinuous (A.domain.subtype ∘ₗ e.symm.toLinearMap) μ⁻¹ hb
  have hR : IsResolvent A (μ : 𝕜) R :=
    { mem_domain := fun y => (e.symm y).2
      sub_apply := fun y => e.apply_symm_apply y
      apply_sub := fun x => congrArg Subtype.val (e.symm_apply_apply x) }
  exact hR.isResolvent_resolvent

/-- **Perturbation of the resolvent set**: if `A` is dissipative and `μ₀ - A` has a resolvent,
`μ₀ > 0`, then `μ - A` is onto for `0 < μ < 2 μ₀` (Neumann series for
`1 - (μ₀ - μ) R(μ₀)`). -/
theorem IsDissipative.surjective_of_isResolvent (hA : A.IsDissipative) {μ₀ : ℝ} (hμ₀ : 0 < μ₀)
    {R : E →L[𝕜] E} (hR : IsResolvent A (μ₀ : 𝕜) R) {μ : ℝ} (hμ : 0 < μ) (hμ' : μ < 2 * μ₀)
    [CompleteSpace E] (y : E) : ∃ x : A.domain, (μ : 𝕜) • (x : E) - A x = y := by
  have hRn : ‖R‖ ≤ μ₀⁻¹ := by
    simpa using hR.norm_le_of_isDissipative hA (by simpa using hμ₀)
  set T : E →L[𝕜] E := ((μ₀ - μ : ℝ) : 𝕜) • R
  have hT : ‖T‖ < 1 := by
    have h1 : ‖T‖ ≤ |μ₀ - μ| * μ₀⁻¹ := by
      rw [norm_smul, RCLike.norm_ofReal]; gcongr
    have h2 : |μ₀ - μ| < μ₀ := abs_sub_lt_iff.2 ⟨by linarith, by linarith⟩
    calc ‖T‖ ≤ |μ₀ - μ| * μ₀⁻¹ := h1
      _ < μ₀ * μ₀⁻¹ := by gcongr
      _ = 1 := mul_inv_cancel₀ hμ₀.ne'
  set u := Units.oneSub T hT
  set z : E := (↑u⁻¹ : E →L[𝕜] E) y
  have hz : z - T z = y := by
    have h := congrArg (fun C : E →L[𝕜] E => C y) u.mul_inv
    simpa [u, z, Units.val_oneSub] using h
  refine ⟨hR.toDomain z, ?_⟩
  rw [hR.apply_resolvent, IsResolvent.coe_toDomain]
  rw [← hz]
  simp only [T, _root_.smul_apply, RCLike.ofReal_sub]
  module


/-- **An m-dissipative operator has resolvents on `(0, ∞)`**: `μ - A` is onto for every `μ > 0`
(not only for the one `μ` of the definition). -/
theorem IsMDissipative.surjective [CompleteSpace E] (hA : A.IsMDissipative) {μ : ℝ} (hμ : 0 < μ)
    (y : E) : ∃ x : A.domain, (μ : 𝕜) • (x : E) - A x = y := by
  obtain ⟨μ₀, hμ₀, hs₀⟩ := hA.surj
  have hstep : ∀ n : ℕ, ∀ y : E, ∃ x : A.domain,
      (((3 / 2 : ℝ) ^ n * μ₀ : ℝ) : 𝕜) • (x : E) - A x = y := by
    intro n
    induction n with
    | zero => simpa using hs₀
    | succ n ih =>
      have hpos : 0 < (3 / 2 : ℝ) ^ n * μ₀ := by positivity
      refine hA.dissipative.surjective_of_isResolvent hpos
        (hA.dissipative.isResolvent_of_surjective hpos ih) (by positivity) ?_
      rw [pow_succ]; nlinarith
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (μ / μ₀) (by norm_num : (1 : ℝ) < 3 / 2)
  have hpos : 0 < (3 / 2 : ℝ) ^ n * μ₀ := by positivity
  refine hA.dissipative.surjective_of_isResolvent hpos
    (hA.dissipative.isResolvent_of_surjective hpos (hstep n)) hμ ?_ y
  rw [div_lt_iff₀ hμ₀] at hn
  nlinarith

/-- `(μ - A)⁻¹` is a resolvent of an m-dissipative `A` for every `μ > 0`. -/
theorem IsMDissipative.isResolvent [CompleteSpace E] (hA : A.IsMDissipative) {μ : ℝ}
    (hμ : 0 < μ) : IsResolvent A (μ : 𝕜) (resolvent A (μ : 𝕜)) :=
  hA.dissipative.isResolvent_of_surjective hμ (hA.surjective hμ)

theorem IsMDissipative.isResolvent_one [CompleteSpace E] (hA : A.IsMDissipative) :
    IsResolvent A 1 (resolvent A 1) := by
  simpa using hA.isResolvent one_pos

/-- **The Hille–Yosida bound** `‖(μ - A)⁻¹‖ ≤ 1 / μ` for an m-dissipative `A`. -/
theorem IsMDissipative.norm_resolvent_le [CompleteSpace E] (hA : A.IsMDissipative) {μ : ℝ}
    (hμ : 0 < μ) : ‖resolvent A (μ : 𝕜)‖ ≤ μ⁻¹ := by
  simpa using (hA.isResolvent hμ).norm_le_of_isDissipative hA.dissipative (by simpa using hμ)

theorem IsMDissipative.norm_resolvent_apply_le [CompleteSpace E] (hA : A.IsMDissipative)
    {μ : ℝ} (hμ : 0 < μ) (y : E) : ‖resolvent A (μ : 𝕜) y‖ ≤ μ⁻¹ * ‖y‖ :=
  ((resolvent A (μ : 𝕜)).le_opNorm y).trans
    (mul_le_mul_of_nonneg_right (hA.norm_resolvent_le hμ) (norm_nonneg y))

/-- **An m-dissipative operator is closed**: its graph is `{(x, y) | x = R(1) (x - y)}`. -/
theorem IsMDissipative.isClosed [CompleteSpace E] (hA : A.IsMDissipative) : A.IsClosed := by
  have hR := hA.isResolvent one_pos
  set R := resolvent A ((1 : ℝ) : 𝕜)
  have e : (A.graph : Set (E × E)) = {p | p.1 = R (p.1 - p.2)} := by
    ext ⟨x, y⟩
    simp only [SetLike.mem_coe, mem_graph_iff, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨x', rfl, rfl⟩
      have h := hR.apply_sub x'
      rw [RCLike.ofReal_one, one_smul] at h
      exact h.symm
    · intro h
      refine ⟨hR.toDomain (x - y), h.symm, ?_⟩
      rw [hR.apply_resolvent, RCLike.ofReal_one, one_smul, ← h]
      abel
  rw [LinearPMap.IsClosed, e]
  exact isClosed_eq continuous_fst (R.continuous.comp (continuous_fst.sub continuous_snd))

/-- **In a Hilbert space an m-dissipative operator is densely defined**: if `y ⊥ D(A)` and
`x = R(1) y`, then `0 = re ⟪x - A x, x⟫ ≥ ‖x‖²`. Cf. [Pazy1983], Thm 1.4.6. -/
theorem IsMDissipative.dense_domain [CompleteSpace E] (hA : A.IsMDissipative) :
    Dense (A.domain : Set E) := by
  rw [Submodule.dense_iff_topologicalClosure_eq_top, Submodule.topologicalClosure_eq_top_iff,
    Submodule.eq_bot_iff]
  intro y hy
  have hR := hA.isResolvent_one
  set x := hR.toDomain y
  have hx : (x : E) - A x = y := by
    have := hR.sub_apply_toDomain y
    rwa [one_smul] at this
  have h0 : ⟪y, (x : E)⟫ = 0 := Submodule.inner_left_of_mem_orthogonal x.2 hy
  have h1 : RCLike.re ⟪(x : E) - A x, (x : E)⟫ = ‖(x : E)‖ ^ 2 - RCLike.re ⟪A x, (x : E)⟫ := by
    rw [inner_sub_left, _root_.map_sub, inner_self_eq_norm_sq]
  rw [hx, h0, _root_.map_zero] at h1
  have h2 := hA.dissipative x
  have hx0 : (x : E) = 0 := by
    rw [← norm_eq_zero]; nlinarith [norm_nonneg (x : E)]
  have hAx : A x = 0 := by
    rw [show x = 0 from Subtype.ext hx0, A.map_zero]
  rw [← hx, hx0, hAx, sub_zero]

/-! ### Criteria for m-dissipativity in a Hilbert space -/

/-- The range of `1 - A` is closed for a closed dissipative `A`. -/
theorem IsDissipative.isClosed_range_one_sub [CompleteSpace E] (hA : A.IsDissipative)
    (hc : A.IsClosed) : _root_.IsClosed (LinearMap.range (shiftOp A 1) : Set E) := by
  refine IsSeqClosed.isClosed fun {u y} hu huy => ?_
  choose x hx using hu
  have hb : ∀ w : A.domain, ‖(w : E)‖ ≤ ‖shiftOp A 1 w‖ := fun w => by
    simpa using hA.mul_norm_le_norm_smul_sub 1 w
  have hcs : CauchySeq fun n => (x n : E) := by
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 huy.cauchySeq ε hε
    refine ⟨N, fun m hm n hn => ?_⟩
    have h1 := hb (x m - x n)
    rw [_root_.map_sub, hx, hx] at h1
    rw [dist_eq_norm, ← Submodule.coe_sub]
    exact h1.trans_lt (by rw [← dist_eq_norm]; exact hN m hm n hn)
  obtain ⟨x₀, hx₀⟩ := cauchySeq_tendsto_of_complete hcs
  have hAx : Tendsto (fun n => A (x n)) atTop (𝓝 (x₀ - y)) := by
    refine (hx₀.sub huy).congr fun n => ?_
    rw [← hx n, shiftOp_apply, one_smul]; abel
  have hg : (x₀, x₀ - y) ∈ A.graph := by
    refine hc.mem_of_tendsto (hx₀.prodMk_nhds hAx) (Eventually.of_forall fun n => ?_)
    exact A.mem_graph (x n)
  obtain ⟨x', hx'1, hx'2⟩ := (mem_graph_iff A).1 hg
  refine ⟨x', ?_⟩
  rw [shiftOp_apply, one_smul, hx'2, hx'1]; exact sub_sub_cancel _ _

/-- **A criterion for m-dissipativity**: a closed dissipative `A` such that no nonzero vector is
orthogonal to the range of `1 - A` is m-dissipative. -/
theorem IsDissipative.isMDissipative_of_orthogonal [CompleteSpace E] (hA : A.IsDissipative)
    (hc : A.IsClosed) (horth : ∀ y : E, (∀ x : A.domain, ⟪(x : E) - A x, y⟫ = 0) → y = 0) :
    A.IsMDissipative := by
  refine ⟨hA, 1, one_pos, fun y => ?_⟩
  have htop : LinearMap.range (shiftOp A 1) = ⊤ := by
    rw [← (hA.isClosed_range_one_sub hc).submodule_topologicalClosure_eq,
      Submodule.topologicalClosure_eq_top_iff, Submodule.eq_bot_iff]
    intro z hz
    refine horth z fun x => ?_
    have := Submodule.inner_right_of_mem_orthogonal (LinearMap.mem_range_self (shiftOp A 1) x) hz
    simpa using this
  obtain ⟨x, hx⟩ := (LinearMap.range_eq_top.1 htop) y
  exact ⟨x, by simpa using hx⟩

/-- **A closed, densely defined, dissipative `A` with dissipative adjoint is m-dissipative.** -/
theorem IsDissipative.isMDissipative_of_adjoint [CompleteSpace E] (hA : A.IsDissipative)
    (hD : Dense (A.domain : Set E)) (hc : A.IsClosed) (hA' : A†.IsDissipative) :
    A.IsMDissipative := by
  refine hA.isMDissipative_of_orthogonal hc fun y hy => ?_
  have h : ∀ x : A.domain, ⟪y, A x⟫ = ⟪y, (x : E)⟫ := fun x => by
    have := hy x
    rw [inner_sub_left, sub_eq_zero] at this
    rw [← inner_conj_symm, ← this, inner_conj_symm]
  have hya : y ∈ A†.domain := mem_adjoint_domain_of_exists y ⟨y, fun x => (h x).symm⟩
  have hval : A† ⟨y, hya⟩ = y := adjoint_apply_eq hD ⟨y, hya⟩ fun x => (h x).symm
  have h1 := hA' ⟨y, hya⟩
  rw [hval, inner_self_eq_norm_sq] at h1
  exact norm_eq_zero.1 (by nlinarith [norm_nonneg y])

/-- **A self-adjoint, nonpositive operator is m-dissipative.** -/
theorem _root_.IsSelfAdjoint.isMDissipative [CompleteSpace E] (hA : IsSelfAdjoint A)
    (hn : A.IsDissipative) : A.IsMDissipative := by
  have hD := hA.dense_domain
  have hc : A.IsClosed := by
    have h : A† = A := hA
    rw [← h]; exact adjoint_isClosed hD
  refine hn.isMDissipative_of_adjoint hD hc ?_
  have h : A† = A := hA
  rw [h]; exact hn

/-- **A skew-adjoint operator is m-dissipative** (and so is its negative): consistency of
Lumer–Phillips with Stone's theorem. -/
theorem IsSkewAdjoint.isMDissipative [CompleteSpace E] (hA : A.IsSkewAdjoint) :
    A.IsMDissipative := by
  refine hA.isDissipative.isMDissipative_of_adjoint hA.dense_domain hA.isClosed ?_
  have h : A† = -A := hA
  rw [h]; exact hA.neg.isDissipative

end LinearPMap

namespace Feec

namespace LumerPhillips

-- the `ℚ`-algebra structure on operators, for `NormedSpace.exp_add_of_commute`
attribute [local instance] Stone.instNormedAlgebraRatStone

variable [CompleteSpace E]

section Exp

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-! ### Exponentials of bounded dissipative operators -/

/-- **`exp(t B)` is a contraction** for a bounded dissipative `B` and `t ≥ 0` (energy method). -/
theorem norm_exp_smul_apply_le {B : E →L[𝕜] E} (hB : ∀ x, RCLike.re ⟪B x, x⟫ ≤ 0) {t : ℝ}
    (ht : 0 ≤ t) (x : E) : ‖exp ((t : 𝕜) • B) x‖ ≤ ‖x‖ := by
  have hd : ∀ s : ℝ, HasDerivAt (fun s : ℝ => exp ((s : 𝕜) • B) x)
      (B (exp ((s : 𝕜) • B) x)) s := C0Group.hasDerivAt_exp_ofReal_smul_apply B x
  have h := _root_.norm_le_add_integral_of_re_inner_deriv_le (𝕜 := 𝕜) (g := fun _ => 0)
    (a := 0) (b := t) (e := fun s : ℝ => exp ((s : 𝕜) • B) x)
    (e' := fun s => B (exp ((s : 𝕜) • B) x))
    (fun s _ => (hd s).continuousAt.continuousWithinAt)
    (fun s _ => (hd s).hasDerivWithinAt) continuousOn_const (fun _ _ => le_rfl)
    (fun s _ => by simpa using hB _) t ⟨ht, le_rfl⟩
  simpa using h

/-- **Comparison of exponentials**: for commuting bounded dissipative `B`, `C` and `t ≥ 0`,
`‖exp(t B) x - exp(t C) x‖ ≤ t ‖B x - C x‖`. The derivative of
`s ↦ exp(t C) exp(s (B - C)) x = exp((t - s) C) exp(s B) x` is
`exp((t - s) C) exp(s B) (B - C) x`. -/
theorem norm_exp_smul_sub_exp_smul_le {B C : E →L[𝕜] E} (hB : ∀ x, RCLike.re ⟪B x, x⟫ ≤ 0)
    (hC : ∀ x, RCLike.re ⟪C x, x⟫ ≤ 0) (hBC : Commute B C) {t : ℝ} (ht : 0 ≤ t) (x : E) :
    ‖exp ((t : 𝕜) • B) x - exp ((t : 𝕜) • C) x‖ ≤ t * ‖B x - C x‖ := by
  set D := B - C
  have hCD : Commute C D := hBC.symm.sub_right (Commute.refl C)
  have hsplit : ∀ s : ℝ, exp ((s : 𝕜) • C) * exp ((s : 𝕜) • D) = exp ((s : 𝕜) • B) := fun s => by
    rw [← exp_add_of_commute ((hCD.smul_left _).smul_right _), ← smul_add]
    congr 2
    simp [D]
  set f : ℝ → E := fun s => exp ((t : 𝕜) • C) (exp ((s : 𝕜) • D) x)
  set f' : ℝ → E := fun s => exp ((t : 𝕜) • C) (D (exp ((s : 𝕜) • D) x))
  have hf : ∀ s, HasDerivAt f (f' s) s := fun s =>
    (exp ((t : 𝕜) • C)).hasDerivAt_apply_of_hasDerivAt
      (C0Group.hasDerivAt_exp_ofReal_smul_apply D x s)
  have hf' : ∀ s ∈ Ico (0 : ℝ) t, ‖f' s‖ ≤ ‖D x‖ := by
    intro s hs
    have e1 : exp ((t : 𝕜) • C) = exp (((t - s : ℝ) : 𝕜) • C) * exp ((s : 𝕜) • C) := by
      rw [← C0Group.exp_ofReal_smul_add, sub_add_cancel]
    have e2 : D (exp ((s : 𝕜) • D) x) = exp ((s : 𝕜) • D) (D x) :=
      congrArg (fun T : E →L[𝕜] E => T x) (C0Group.commute_exp_ofReal_smul D s).eq
    have e3 : f' s = exp (((t - s : ℝ) : 𝕜) • C) (exp ((s : 𝕜) • B) (D x)) := by
      change exp ((t : 𝕜) • C) (D (exp ((s : 𝕜) • D) x)) = _
      rw [e2, e1, ← hsplit s]
      rfl
    rw [e3]
    exact (norm_exp_smul_apply_le hC (sub_nonneg.2 hs.2.le) _).trans
      (norm_exp_smul_apply_le hB hs.1 _)
  have hmvt := norm_image_sub_le_of_norm_deriv_le_segment' (f := f) (a := 0) (b := t)
    (fun s _ => (hf s).hasDerivWithinAt) hf' t ⟨ht, le_rfl⟩
  have hft : f t = exp ((t : 𝕜) • B) x := by
    change exp ((t : 𝕜) • C) (exp ((t : 𝕜) • D) x) = _
    rw [← hsplit t]
    rfl
  have hf0 : f 0 = exp ((t : 𝕜) • C) x := by simp [f]
  rw [hft, hf0, sub_zero] at hmvt
  rw [mul_comm]
  simpa [D] using hmvt

end Exp

/-! ### The Yosida approximation -/

variable {A : E →ₗ.[𝕜] E}

/-- The resolvent `R_n = (c_n - A)⁻¹` at `c_n = n + 1`. -/
def res (A : E →ₗ.[𝕜] E) (n : ℕ) : E →L[𝕜] E := resolvent A ((Stone.scale n : ℝ) : 𝕜)

/-- `J_n = c_n R_n`, a contraction converging strongly to `1`. -/
def approxJ (A : E →ₗ.[𝕜] E) (n : ℕ) : E →L[𝕜] E := ((Stone.scale n : ℝ) : 𝕜) • res A n

/-- The **Yosida approximation** `A_n = c_n A (c_n - A)⁻¹ = c_n² R_n - c_n`, bounded and
dissipative, with `A_n x = J_n (A x)` on `D(A)`. -/
def yosida (A : E →ₗ.[𝕜] E) (n : ℕ) : E →L[𝕜] E :=
  ((Stone.scale n : ℝ) : 𝕜) • approxJ A n - ((Stone.scale n : ℝ) : 𝕜) • 1

theorem isResolvent_res (hA : A.IsMDissipative) (n : ℕ) :
    IsResolvent A ((Stone.scale n : ℝ) : 𝕜) (res A n) :=
  hA.isResolvent (Stone.scale_pos n)

theorem norm_approxJ_apply_le (hA : A.IsMDissipative) (n : ℕ) (y : E) :
    ‖approxJ A n y‖ ≤ ‖y‖ := by
  have hc := Stone.scale_pos n
  rw [approxJ, _root_.smul_apply, norm_smul, RCLike.norm_ofReal, abs_of_pos hc]
  calc Stone.scale n * ‖res A n y‖ ≤ Stone.scale n * ((Stone.scale n)⁻¹ * ‖y‖) := by
        gcongr; exact hA.norm_resolvent_apply_le hc y
    _ = ‖y‖ := by field_simp

/-- `J_n x - x = R_n (A x)` on `D(A)`. -/
theorem approxJ_apply_domain_sub (hA : A.IsMDissipative) (n : ℕ) (x : A.domain) :
    approxJ A n x - x = res A n (A x) := by
  rw [approxJ, _root_.smul_apply, (isResolvent_res hA n).apply_domain x]

theorem yosida_apply_domain (hA : A.IsMDissipative) (n : ℕ) (x : A.domain) :
    yosida A n x = approxJ A n (A x) := by
  have h := approxJ_apply_domain_sub hA n x
  have h' : approxJ A n (A x) = ((Stone.scale n : ℝ) : 𝕜) • res A n (A x) := by
    rw [approxJ, _root_.smul_apply]
  rw [h', ← h]
  simp only [yosida, _root_.sub_apply, _root_.smul_apply, one_apply_eq_self,
    smul_sub]

theorem norm_yosida_apply_domain_le (hA : A.IsMDissipative) (n : ℕ) (x : A.domain) :
    ‖yosida A n x‖ ≤ ‖A x‖ := by
  rw [yosida_apply_domain hA]; exact norm_approxJ_apply_le hA n _

/-- The Yosida approximation is dissipative: `re ⟪A_n y, y⟫ = c_n (re ⟪J_n y, y⟫ - ‖y‖²) ≤ 0`. -/
theorem re_inner_yosida_le (hA : A.IsMDissipative) (n : ℕ) (y : E) :
    RCLike.re ⟪yosida A n y, y⟫ ≤ 0 := by
  have hc := Stone.scale_pos n
  have e : yosida A n y = ((Stone.scale n : ℝ) : 𝕜) • (approxJ A n y - y) := by
    simp only [yosida, _root_.sub_apply, _root_.smul_apply, one_apply_eq_self,
      smul_sub]
  have h1 : RCLike.re ⟪approxJ A n y, y⟫ ≤ ‖y‖ ^ 2 :=
    (RCLike.re_le_norm _).trans ((norm_inner_le_norm _ _).trans (by
      nlinarith [norm_approxJ_apply_le hA n y, norm_nonneg y]))
  rw [e, inner_smul_left, RCLike.conj_ofReal, RCLike.re_ofReal_mul, inner_sub_left,
    _root_.map_sub, inner_self_eq_norm_sq]
  exact mul_nonpos_of_nonneg_of_nonpos hc.le (by linarith)

/-- `J_n y → y` for every `y`. -/
theorem tendsto_approxJ (hA : A.IsMDissipative) (y : E) :
    Tendsto (fun n => approxJ A n y) atTop (𝓝 y) := by
  refine Stone.tendsto_apply_of_dense (norm_approxJ_apply_le hA) hA.dense_domain ?_ y
  intro x hx
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_)
    ((tendsto_const_nhds (x := ‖A ⟨x, hx⟩‖)).div_atTop Stone.tendsto_scale_atTop)
  have h := approxJ_apply_domain_sub hA n ⟨x, hx⟩
  simp only at h
  rw [h]
  calc ‖res A n (A ⟨x, hx⟩)‖ ≤ (Stone.scale n)⁻¹ * ‖A ⟨x, hx⟩‖ :=
        hA.norm_resolvent_apply_le (Stone.scale_pos n) _
    _ = ‖A ⟨x, hx⟩‖ / Stone.scale n := by rw [inv_mul_eq_div]

/-- `A_n x → A x` on `D(A)`. -/
theorem tendsto_yosida (hA : A.IsMDissipative) (x : A.domain) :
    Tendsto (fun n => yosida A n x) atTop (𝓝 (A x)) := by
  simp_rw [yosida_apply_domain hA]; exact tendsto_approxJ hA _

theorem yosida_commute (hA : A.IsMDissipative) (n m : ℕ) :
    Commute (yosida A n) (yosida A m) := by
  have h : Commute (res A n) (res A m) := (isResolvent_res hA n).commute (isResolvent_res hA m)
  have h' : Commute (approxJ A n) (approxJ A m) := (h.smul_left _).smul_right _
  unfold yosida
  refine Commute.sub_left (Commute.sub_right ?_ ?_) (Commute.sub_right ?_ ?_)
  · exact (h'.smul_left _).smul_right _
  · exact ((Commute.one_right _).smul_left _).smul_right _
  · exact ((Commute.one_left _).smul_left _).smul_right _
  · exact ((Commute.one_left _).smul_left _).smul_right _

/-! ### The approximating semigroups and their strong limit -/

section Limit

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- The approximating contraction semigroups `S_n(t) = exp(t A_n)`. -/
def approxS (A : E →ₗ.[𝕜] E) (n : ℕ) (t : ℝ) : E →L[𝕜] E := exp ((t : 𝕜) • yosida A n)

omit [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] in
theorem approxS_add (n : ℕ) (s t : ℝ) : approxS A n (s + t) = approxS A n s * approxS A n t :=
  C0Group.exp_ofReal_smul_add _ s t

theorem norm_approxS_apply_le (hA : A.IsMDissipative) (n : ℕ) {t : ℝ} (ht : 0 ≤ t) (x : E) :
    ‖approxS A n t x‖ ≤ ‖x‖ :=
  norm_exp_smul_apply_le (re_inner_yosida_le hA n) ht x

/-- `‖S_n(t) x - S_m(t) x‖ ≤ t ‖A_n x - A_m x‖`. -/
theorem norm_approxS_sub_le (hA : A.IsMDissipative) (n m : ℕ) {t : ℝ} (ht : 0 ≤ t) (x : E) :
    ‖approxS A n t x - approxS A m t x‖ ≤ t * ‖yosida A n x - yosida A m x‖ :=
  norm_exp_smul_sub_exp_smul_le (re_inner_yosida_le hA n) (re_inner_yosida_le hA m)
    (yosida_commute hA n m) ht x

/-- `‖S_n(t) x - x‖ ≤ t ‖A x‖` on `D(A)`. -/
theorem norm_approxS_sub_self_le (hA : A.IsMDissipative) (n : ℕ) {t : ℝ} (ht : 0 ≤ t)
    (x : A.domain) : ‖approxS A n t x - x‖ ≤ t * ‖A x‖ := by
  have h := norm_exp_smul_sub_exp_smul_le (re_inner_yosida_le hA n) (C := 0) (fun _ => by simp)
    (Commute.zero_right _) ht (x : E)
  simp only [smul_zero, exp_zero, one_apply_eq_self, _root_.zero_apply,
    sub_zero] at h
  exact h.trans (mul_le_mul_of_nonneg_left (norm_yosida_apply_domain_le hA n x) ht)

theorem cauchySeq_approxS (hA : A.IsMDissipative) {t : ℝ} (ht : 0 ≤ t) (x : E) :
    CauchySeq fun n => approxS A n t x := by
  refine Stone.cauchySeq_apply_of_dense (fun n x => norm_approxS_apply_le hA n ht x)
    hA.dense_domain ?_ x
  intro y hy
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 (tendsto_yosida hA ⟨y, hy⟩).cauchySeq
    (ε / (t + 1)) (by positivity)
  refine ⟨N, fun m hm n hn => ?_⟩
  have h1 := norm_approxS_sub_le hA m n ht y
  have h2 := hN m hm n hn
  rw [dist_eq_norm] at h2 ⊢
  have h3 : t * ‖yosida A m y - yosida A n y‖ ≤ t * (ε / (t + 1)) :=
    mul_le_mul_of_nonneg_left h2.le ht
  have h4 : t * (ε / (t + 1)) < ε := by
    rw [mul_div_assoc', div_lt_iff₀ (by positivity)]; nlinarith
  linarith

/-- The **Lumer–Phillips semigroup** `S(t) x = lim_n exp(t A_n) x` for `t ≥ 0`, normalized by
`S(t) = 1` for `t < 0` (a continuous linear map by Banach–Steinhaus). -/
def lpS (hA : A.IsMDissipative) (t : ℝ) : E →L[𝕜] E :=
  continuousLinearMapOfTendsto (fun n => approxS A n (max t 0))
    (tendsto_pi_nhds.2 fun x => (cauchySeq_approxS hA (le_max_right t 0) x).tendsto_limUnder)

theorem tendsto_approxS_max (hA : A.IsMDissipative) (t : ℝ) (x : E) :
    Tendsto (fun n => approxS A n (max t 0) x) atTop (𝓝 (lpS hA t x)) :=
  (cauchySeq_approxS hA (le_max_right t 0) x).tendsto_limUnder

theorem tendsto_approxS (hA : A.IsMDissipative) {t : ℝ} (ht : 0 ≤ t) (x : E) :
    Tendsto (fun n => approxS A n t x) atTop (𝓝 (lpS hA t x)) := by
  simpa only [max_eq_left ht] using tendsto_approxS_max hA t x

theorem tendsto_approxS_of_tendsto (hA : A.IsMDissipative) {t : ℝ} (ht : 0 ≤ t) {y : ℕ → E}
    {y₀ : E} (hy : Tendsto y atTop (𝓝 y₀)) :
    Tendsto (fun n => approxS A n t (y n)) atTop (𝓝 (lpS hA t y₀)) := by
  have h0 : Tendsto (fun n => approxS A n t (y n - y₀)) atTop (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) (fun n => norm_approxS_apply_le hA n ht _) ?_
    exact tendsto_zero_iff_norm_tendsto_zero.1 (by simpa using hy.sub_const y₀)
  have := h0.add (tendsto_approxS hA ht y₀)
  rw [zero_add] at this
  exact this.congr fun n => by rw [← _root_.map_add, sub_add_cancel]

theorem norm_lpS_apply_le (hA : A.IsMDissipative) (t : ℝ) (x : E) : ‖lpS hA t x‖ ≤ ‖x‖ :=
  le_of_tendsto' (tendsto_approxS_max hA t x).norm fun n =>
    norm_approxS_apply_le hA n (le_max_right t 0) x

theorem lpS_max (hA : A.IsMDissipative) (t : ℝ) : lpS hA (max t 0) = lpS hA t := by
  ext x
  exact tendsto_nhds_unique (tendsto_approxS hA (le_max_right t 0) x) (tendsto_approxS_max hA t x)

theorem lpS_zero (hA : A.IsMDissipative) : lpS hA 0 = 1 := by
  ext x
  refine tendsto_nhds_unique (tendsto_approxS hA le_rfl x) ?_
  simp [approxS]

theorem lpS_of_nonpos (hA : A.IsMDissipative) {t : ℝ} (ht : t ≤ 0) : lpS hA t = 1 := by
  rw [← lpS_max, max_eq_right ht, lpS_zero]

theorem lpS_add (hA : A.IsMDissipative) {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    lpS hA (s + t) = lpS hA s * lpS hA t := by
  ext x
  refine tendsto_nhds_unique (tendsto_approxS hA (add_nonneg hs ht) x) ?_
  simp_rw [approxS_add]
  exact tendsto_approxS_of_tendsto hA hs (tendsto_approxS hA ht x)

/-- `‖S(t) x - S(s) x‖ ≤ (t - s) ‖A x‖` on `D(A)` for `0 ≤ s ≤ t`. -/
theorem norm_lpS_sub_le_of_le (hA : A.IsMDissipative) (x : A.domain) {s t : ℝ} (hs : 0 ≤ s)
    (hst : s ≤ t) : ‖lpS hA t x - lpS hA s x‖ ≤ (t - s) * ‖A x‖ := by
  refine le_of_tendsto' ((tendsto_approxS hA (hs.trans hst) x).sub
    (tendsto_approxS hA hs x)).norm fun n => ?_
  have e : approxS A n t = approxS A n s * approxS A n (t - s) := by
    rw [← approxS_add, add_sub_cancel]
  rw [e, mul_apply_eq_comp, ← _root_.map_sub]
  exact (norm_approxS_apply_le hA n hs _).trans
    (norm_approxS_sub_self_le hA n (sub_nonneg.2 hst) x)

/-- `‖S(t) x - S(s) x‖ ≤ |t - s| ‖A x‖` on `D(A)`. -/
theorem norm_lpS_sub_le (hA : A.IsMDissipative) (x : A.domain) (t s : ℝ) :
    ‖lpS hA t x - lpS hA s x‖ ≤ |t - s| * ‖A x‖ := by
  rw [← lpS_max hA t, ← lpS_max hA s]
  have hab := abs_max_sub_max_le_abs t s 0
  rcases le_total (max s 0) (max t 0) with h | h
  · refine (norm_lpS_sub_le_of_le hA x (le_max_right s 0) h).trans ?_
    gcongr
    exact (le_abs_self _).trans hab
  · rw [norm_sub_rev]
    refine (norm_lpS_sub_le_of_le hA x (le_max_right t 0) h).trans ?_
    gcongr
    rw [abs_sub_comm (max t 0)] at hab
    exact (le_abs_self _).trans hab

theorem continuous_lpS_apply (hA : A.IsMDissipative) (x : E) :
    Continuous fun t => lpS hA t x := by
  refine continuous_of_uniform_approx_of_continuous fun u hu => ?_
  obtain ⟨ε, hε, hεu⟩ := Metric.mem_uniformity_dist.1 hu
  obtain ⟨d, hd, hdD⟩ := Metric.dense_iff.1 hA.dense_domain x ε hε
  rw [Metric.mem_ball] at hd
  refine ⟨fun t => lpS hA t d, ?_, fun t => hεu ?_⟩
  · refine (LipschitzWith.of_dist_le_mul (K := ‖A ⟨d, hdD⟩‖₊) fun t s => ?_).continuous
    rw [dist_eq_norm, dist_eq_norm, Real.norm_eq_abs, coe_nnnorm, mul_comm]
    exact norm_lpS_sub_le hA ⟨d, hdD⟩ t s
  · rw [dist_eq_norm, ← _root_.map_sub]
    exact (norm_lpS_apply_le hA t _).trans_lt (by rw [← dist_eq_norm, dist_comm]; exact hd)

/-- `S(t) x - x = ∫₀ᵗ S(s) (A x) ds` on `D(A)`, `t ≥ 0`. -/
theorem lpS_sub_eq_integral (hA : A.IsMDissipative) (x : A.domain) {t : ℝ} (ht : 0 ≤ t) :
    lpS hA t x - x = ∫ s in (0 : ℝ)..t, lpS hA s (A x) := by
  have hcont : ∀ n, Continuous fun s => approxS A n s (yosida A n x) := fun n =>
    (C0Group.continuous_exp_ofReal_smul _).clm_apply continuous_const
  have hftc : ∀ n, approxS A n t x - x = ∫ s in (0 : ℝ)..t, approxS A n s (yosida A n x) := by
    intro n
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun s => approxS A n s x) (a := 0) (b := t)
      (f' := fun s => approxS A n s (yosida A n x)) (fun s _ => ?_)
      ((hcont n).intervalIntegrable _ _)
    · rw [h]; simp [approxS]
    · have h := C0Group.hasDerivAt_exp_ofReal_smul_apply (yosida A n) (x : E) s
      have hc : yosida A n (exp ((s : 𝕜) • yosida A n) x) =
          exp ((s : 𝕜) • yosida A n) (yosida A n x) :=
        congrArg (fun C : E →L[𝕜] E => C x) (C0Group.commute_exp_ofReal_smul (yosida A n) s).eq
      rw [hc] at h
      exact h
  have hlim : Tendsto (fun n => ∫ s in (0 : ℝ)..t, approxS A n s (yosida A n x)) atTop
      (𝓝 (∫ s in (0 : ℝ)..t, lpS hA s (A x))) := by
    refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence (fun _ => ‖A x‖)
      (Eventually.of_forall fun n => (hcont n).aestronglyMeasurable) ?_
      intervalIntegrable_const ?_
    · refine Eventually.of_forall fun n => Eventually.of_forall fun s hs => ?_
      rw [uIoc_of_le ht] at hs
      exact (norm_approxS_apply_le hA n hs.1.le _).trans (norm_yosida_apply_domain_le hA n x)
    · refine Eventually.of_forall fun s hs => ?_
      rw [uIoc_of_le ht] at hs
      exact tendsto_approxS_of_tendsto hA hs.1.le (tendsto_yosida hA x)
  refine tendsto_nhds_unique ((tendsto_approxS hA ht x).sub_const (x : E)) ?_
  simp_rw [hftc]; exact hlim

/-- On `D(A)`, `t ↦ S(t) x` has right derivative `A x` at `0`. -/
theorem hasDerivWithinAt_lpS (hA : A.IsMDissipative) (x : A.domain) :
    HasDerivWithinAt (fun t => lpS hA t x) (A x) (Ici 0) 0 := by
  have hc : Continuous fun s => lpS hA s (A x) := continuous_lpS_apply hA _
  have h := (hc.integral_hasStrictDerivAt 0 0).hasDerivAt.const_add (x : E)
  rw [lpS_zero, one_apply_eq_self] at h
  refine h.hasDerivWithinAt.congr_of_mem (fun t (ht : 0 ≤ t) => ?_) self_mem_Ici
  rw [← lpS_sub_eq_integral hA x ht, add_sub_cancel]

end Limit

end LumerPhillips

end Feec

namespace Feec.C0Semigroup

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

omit [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] in
private theorem apply_eq_of_eq {T T' : E →ₗ.[𝕜] E} (e : T = T') {y : E} (hy : y ∈ T.domain)
    (hy' : y ∈ T'.domain) : T ⟨y, hy⟩ = T' ⟨y, hy'⟩ := by
  subst e; rfl

/-- **The generator of a contraction semigroup on an inner product space is dissipative**:
`re ⟪S t x, x⟫ ≤ ‖x‖²` for `t ≥ 0`, so the right derivative `re ⟪A x, x⟫` at `0` is `≤ 0`. -/
theorem IsContraction.isDissipative_generator {G : C0Semigroup 𝕜 E} (hG : G.IsContraction) :
    G.generator.IsDissipative := by
  intro x
  have h := G.hasDerivWithinAt_generator x
  have hi : HasDerivWithinAt (fun t => ⟪G.S t x, (x : E)⟫) ⟪G.generator x, (x : E)⟫ (Ici 0) 0 := by
    simpa using h.inner 𝕜 (hasDerivWithinAt_const (0 : ℝ) (Ici 0) (x : E))
  have hsub : Ioi (0 : ℝ) ⊆ Ici 0 \ {0} := fun t (ht : 0 < t) => ⟨ht.le, ne_of_gt ht⟩
  have hs := (hasDerivWithinAt_iff_tendsto_slope.1 hi).mono_left (nhdsWithin_mono _ hsub)
  have hr := (RCLike.continuous_re.tendsto _).comp hs
  refine le_of_tendsto hr (eventually_nhdsWithin_of_forall fun t (ht : 0 < t) => ?_)
  simp only [Function.comp_apply, slope_def_module, sub_zero, RCLike.smul_re]
  refine mul_nonpos_of_nonneg_of_nonpos (inv_nonneg.2 ht.le) ?_
  have h1 : ‖G.S t x‖ ≤ ‖(x : E)‖ := by
    simpa using (G.S t).le_opNorm (x : E) |>.trans
      (mul_le_mul_of_nonneg_right (hG t ht.le) (norm_nonneg _))
  have h2 : RCLike.re ⟪G.S t x, (x : E)⟫ ≤ ‖(x : E)‖ ^ 2 :=
    (RCLike.re_le_norm _).trans ((norm_inner_le_norm _ _).trans (by nlinarith [norm_nonneg (x : E)]))
  rw [_root_.map_sub, S_zero_apply, inner_self_eq_norm_sq, sub_nonpos]
  exact h2

/-- **Uniqueness for a dissipative generator** (energy method): two strongly continuous
semigroups with the same dissipative generator agree for `t ≥ 0`. -/
theorem eqOn_of_generator_eq_of_isDissipative [CompleteSpace E] {G G' : C0Semigroup 𝕜 E}
    (hA : G.generator.IsDissipative) (h : G'.generator = G.generator) :
    EqOn G'.S G.S (Ici 0) := by
  set A := G.generator
  have hmem' : ∀ y, y ∈ A.domain → y ∈ G'.generator.domain := fun y hy => h ▸ hy
  have hmem : ∀ y, y ∈ G'.generator.domain → y ∈ A.domain := fun y hy => h ▸ hy
  have hD : ∀ x : A.domain, ∀ T, 0 ≤ T → G'.S T x = G.S T x := by
    intro x T hT
    set x' : G'.generator.domain := ⟨x, hmem' x x.2⟩
    have hAx : G'.generator x' = A x := apply_eq_of_eq h _ _
    set e : ℝ → E := fun s => G'.S s x - G.S s x
    have hm : ∀ s, 0 ≤ s → e s ∈ A.domain := fun s hs =>
      A.domain.sub_mem (hmem _ (G'.mapsTo_domain x' hs)) (G.mapsTo_domain x hs)
    have hAe : ∀ s (hs : 0 ≤ s), A ⟨e s, hm s hs⟩ = G'.S s (A x) - G.S s (A x) := by
      intro s hs
      have e1 : (⟨e s, hm s hs⟩ : A.domain) =
          ⟨G'.S s x, hmem _ (G'.mapsTo_domain x' hs)⟩ - ⟨G.S s x, G.mapsTo_domain x hs⟩ := rfl
      rw [e1, LinearPMap.map_sub, G.generator_apply_S x hs, ← hAx,
        ← G'.generator_apply_S x' hs]
      congr 1
      exact (apply_eq_of_eq h _ _).symm
    have hec : ContinuousOn e (Icc 0 T) :=
      ((G'.strongCont x).sub (G.strongCont x)).mono Icc_subset_Ici_self
    have he : ∀ s ∈ Ico 0 T, HasDerivWithinAt e (G'.S s (A x) - G.S s (A x)) (Ici s) s := by
      intro s hs
      have h1 := G'.hasDerivWithinAt_Ici_apply x' hs.1
      rw [hAx] at h1
      exact h1.sub (G.hasDerivWithinAt_Ici_apply x hs.1)
    have hle := _root_.norm_le_add_integral_of_re_inner_deriv_le (𝕜 := 𝕜) (g := fun _ => 0)
      hec he continuousOn_const (fun _ _ => le_rfl) (fun s hs => by
        rw [← hAe s hs.1, zero_mul]; exact hA _) T ⟨hT, le_rfl⟩
    simp only [e, S_zero_apply, sub_self, norm_zero, intervalIntegral.integral_zero,
      add_zero] at hle
    exact sub_eq_zero.1 (norm_le_zero_iff.1 hle)
  intro t (ht : 0 ≤ t)
  exact DFunLike.coe_injective (Continuous.ext_on G.dense_domain_generator (G'.S t).continuous
    (G.S t).continuous fun x hx => hD ⟨x, hx⟩ t ht)

/-- **Converse of Lumer–Phillips**: the generator of a contraction semigroup on a Hilbert space
is m-dissipative. If `y ⊥ R(1 - A)`, then `f(t) = ⟪S t x, y⟫` solves `f' = f` for `x ∈ D(A)`, so
`⟪x, y⟫ = e^{-t} f(t) → 0`; `D(A)` is dense. -/
theorem IsContraction.isMDissipative_generator [CompleteSpace E] {G : C0Semigroup 𝕜 E}
    (hG : G.IsContraction) : G.generator.IsMDissipative := by
  set A := G.generator
  have hdis := hG.isDissipative_generator
  refine hdis.isMDissipative_of_orthogonal G.isClosed_generator fun y hy => ?_
  have hS : ∀ t, 0 ≤ t → ∀ z : E, ‖G.S t z‖ ≤ ‖z‖ := fun t ht z => by
    simpa using (G.S t).le_opNorm z |>.trans
      (mul_le_mul_of_nonneg_right (hG t ht) (norm_nonneg _))
  have hAy : ∀ z : A.domain, ⟪A z, y⟫ = ⟪(z : E), y⟫ := fun z => by
    have := hy z
    rw [inner_sub_left, sub_eq_zero] at this
    exact this.symm
  have horth : ∀ x : A.domain, ⟪(x : E), y⟫ = 0 := by
    intro x
    set f : ℝ → 𝕜 := fun t => ⟪G.S t x, y⟫
    set g : ℝ → 𝕜 := fun t => Real.exp (-t) • f t
    have hf : ∀ t, 0 ≤ t → HasDerivWithinAt f (f t) (Ici t) t := by
      intro t ht
      have h1 := (G.hasDerivWithinAt_Ici_apply x ht).inner 𝕜 (hasDerivWithinAt_const t (Ici t) y)
      simp only [inner_zero_right, zero_add] at h1
      rw [← G.generator_apply_S x ht, hAy] at h1
      exact h1
    have hexp : ∀ t, HasDerivAt (fun t : ℝ => Real.exp (-t)) (-Real.exp (-t)) t := by
      intro t
      simpa using (hasDerivAt_neg t).exp
    have hg : ∀ T, 0 ≤ T → g T = g 0 := by
      intro T hT
      refine constant_of_has_deriv_right_zero (a := 0) (b := T) ?_ (fun t ht => ?_) T ⟨hT, le_rfl⟩
      · exact (Real.continuous_exp.comp continuous_neg).continuousOn.smul
          (((G.strongCont x).mono Icc_subset_Ici_self).inner continuousOn_const)
      · have := ((hexp t).hasDerivWithinAt (s := Ici t)).smul (hf t ht.1)
        convert this using 1
        rw [neg_smul, add_neg_cancel]
    have hb : ∀ T, 0 ≤ T → ‖⟪(x : E), y⟫‖ ≤ Real.exp (-T) * (‖(x : E)‖ * ‖y‖) := by
      intro T hT
      have e := hg T hT
      simp only [g, f, neg_zero, Real.exp_zero, one_smul, S_zero_apply] at e
      rw [← e, norm_smul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      gcongr
      exact (norm_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right (hS T hT _) (norm_nonneg _))
    have hlim : Tendsto (fun T => Real.exp (-T) * (‖(x : E)‖ * ‖y‖)) atTop (𝓝 0) := by
      simpa using Real.tendsto_exp_neg_atTop_nhds_zero.mul_const (‖(x : E)‖ * ‖y‖)
    have h0 : ‖⟪(x : E), y⟫‖ ≤ 0 :=
      ge_of_tendsto hlim (eventually_atTop.2 ⟨0, fun T hT => hb T hT⟩)
    exact norm_le_zero_iff.1 h0
  have hall : ∀ z, ⟪z, y⟫ = 0 := by
    have hcl : _root_.IsClosed {z : E | ⟪z, y⟫ = 0} :=
      isClosed_eq (continuous_id.inner continuous_const) continuous_const
    intro z
    have := closure_minimal (show (A.domain : Set E) ⊆ {z : E | ⟪z, y⟫ = 0} from
      fun z hz => horth ⟨z, hz⟩) hcl
    rw [G.dense_domain_generator.closure_eq] at this
    exact this (mem_univ z)
  exact inner_self_eq_zero.1 (hall y)

/-- **Stationary points**: an element of the kernel of the generator is fixed by the
semigroup, `S t x = x` for `t ≥ 0`. -/
theorem S_apply_of_mem_ker [CompleteSpace E] {G : C0Semigroup 𝕜 E} {x : E}
    (hx : x ∈ G.generator.ker) {t : ℝ} (ht : 0 ≤ t) : G.S t x = x := by
  obtain ⟨x', rfl, hx'⟩ := LinearPMap.mem_ker_iff.1 hx
  have h := constant_of_has_deriv_right_zero (f := fun s => G.S s x') (a := 0) (b := t)
    ((G.strongCont x').mono Icc_subset_Ici_self) (fun s hs => by
      simpa [hx'] using G.hasDerivWithinAt_Ici_apply x' hs.1) t ⟨ht, le_rfl⟩
  simpa using h

/-- **A symmetric generator gives self-adjoint `S t`**: `⟪S t x, y⟫ = ⟪x, S t y⟫` for `t ≥ 0`.
For `x, y ∈ D(A)`, `s ↦ ⟪S s x, S (t - s) y⟫` has right derivative
`⟪S s (A x), S (t - s) y⟫ - ⟪S s x, S (t - s) (A y)⟫ = 0`; then density. -/
theorem inner_S_left_of_isSymmetric [CompleteSpace E] {G : C0Semigroup 𝕜 E}
    (hA : G.generator.IsSymmetric) {t : ℝ} (ht : 0 ≤ t) (x y : E) :
    ⟪G.S t x, y⟫ = ⟪x, G.S t y⟫ := by
  set A := G.generator
  have hD : ∀ x y : A.domain, ⟪G.S t x, (y : E)⟫ = ⟪(x : E), G.S t y⟫ := by
    intro x y
    set φ : ℝ → 𝕜 := fun s => ⟪G.S s x, G.extS (t - s) y⟫
    have hφc : ContinuousOn φ (Icc 0 t) :=
      ((G.strongCont x).mono Icc_subset_Ici_self).inner
        ((G.continuous_extS_apply y).comp (continuous_const.sub continuous_id)).continuousOn
    have hφd : ∀ s ∈ Ico 0 t, HasDerivWithinAt φ 0 (Ici s) s := by
      intro s hs
      have h1 := G.hasDerivWithinAt_Ici_apply x hs.1
      have h2' := (G.hasDerivAt_extS_apply y (sub_pos.2 hs.2)).scomp s
        ((hasDerivAt_id s).const_sub t)
      have h2 : HasDerivAt (fun s => G.extS (t - s) y) (-(G.S (t - s) (A y))) s := by
        convert h2' using 1 <;> first | rfl | (simp only [neg_smul, one_smul]; rfl)
      have h3 := h1.inner 𝕜 h2.hasDerivWithinAt
      convert h3 using 1
      have hts : 0 ≤ t - s := (sub_pos.2 hs.2).le
      have hsym : ⟪A ⟨G.S s x, G.mapsTo_domain x hs.1⟩, G.S (t - s) y⟫ =
          ⟪G.S s x, A ⟨G.S (t - s) y, G.mapsTo_domain y hts⟩⟫ :=
        hA ⟨G.S s x, G.mapsTo_domain x hs.1⟩ ⟨G.S (t - s) y, G.mapsTo_domain y hts⟩
      rw [G.extS_of_nonneg hts, inner_neg_right, ← G.generator_apply_S x hs.1,
        ← G.generator_apply_S y hts, hsym]
      ring
    have h := constant_of_has_deriv_right_zero hφc hφd t ⟨ht, le_rfl⟩
    simp only [φ, sub_self, sub_zero, G.extS_of_nonneg le_rfl, G.extS_of_nonneg ht,
      S_zero_apply] at h
    exact h
  have hd := G.dense_domain_generator
  have h1 : ∀ x : A.domain, ∀ y : E, ⟪G.S t x, y⟫ = ⟪(x : E), G.S t y⟫ := by
    intro x y
    have := Continuous.ext_on hd (f := fun y => ⟪G.S t x, y⟫) (g := fun y => ⟪(x : E), G.S t y⟫)
      (continuous_const.inner continuous_id) (continuous_const.inner (G.S t).continuous)
      fun y hy => hD x ⟨y, hy⟩
    exact congrFun this y
  have := Continuous.ext_on hd (f := fun x => ⟪G.S t x, y⟫) (g := fun x => ⟪x, G.S t y⟫)
    ((G.S t).continuous.inner continuous_const) (continuous_id.inner continuous_const)
    fun x hx => h1 ⟨x, hx⟩ y
  exact congrFun this x

/-- For a symmetric generator, `S t` is a self-adjoint operator (`t ≥ 0`). -/
theorem isSelfAdjoint_S_of_isSymmetric [CompleteSpace E] {G : C0Semigroup 𝕜 E}
    (hA : G.generator.IsSymmetric) {t : ℝ} (ht : 0 ≤ t) : IsSelfAdjoint (G.S t) :=
  (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric).2 fun x y =>
    inner_S_left_of_isSymmetric hA ht x y

/-- **A self-adjoint semigroup commutes with the projection onto the stationary points**: if
`S t` is self-adjoint and fixes the closed subspace `K`, then `P_K (S t x) = P_K x` and
`S t (P_K x) = P_K x`. -/
theorem starProjection_S_of_isSymmetric [CompleteSpace E] {G : C0Semigroup 𝕜 E}
    (hA : G.generator.IsSymmetric) {K : Submodule 𝕜 E} [K.HasOrthogonalProjection]
    {t : ℝ} (ht : 0 ≤ t) (hK : ∀ k ∈ K, G.S t k = k) (x : E) :
    K.starProjection (G.S t x) = K.starProjection x := by
  refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero (K.starProjection_apply_mem x)
    fun w hw => ?_
  rw [inner_sub_left, inner_S_left_of_isSymmetric hA ht, hK w hw, ← inner_sub_left]
  exact Submodule.inner_left_of_mem_orthogonal hw (K.sub_starProjection_mem_orthogonal x)

end Feec.C0Semigroup

namespace Feec.LumerPhillips

variable [CompleteSpace E]

-- the `ℚ`-algebra structure on operators, for `NormedSpace.exp_mem`
attribute [local instance] Stone.instNormedAlgebraRatStone

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A T : E →ₗ.[𝕜] E}

end Feec.LumerPhillips

namespace LinearPMap.IsMDissipative

open Feec Feec.LumerPhillips

variable [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A : E →ₗ.[𝕜] E}

/-- **The contraction semigroup generated by an m-dissipative operator** (Lumer–Phillips):
`S(t) x = lim_n exp(t A_n) x` for `t ≥ 0`, with the Yosida approximations
`A_n = c_n A (c_n - A)⁻¹`, `c_n = n + 1`; normalized by `S(t) = 1` for `t < 0`. -/
def semigroup (hA : A.IsMDissipative) : C0Semigroup 𝕜 E where
  S := lpS hA
  map_zero := lpS_zero hA
  map_add _ _ hs ht := lpS_add hA hs ht
  strongCont x := (continuous_lpS_apply hA x).continuousOn

theorem semigroup_S_of_nonpos (hA : A.IsMDissipative) {t : ℝ} (ht : t ≤ 0) :
    hA.semigroup.S t = 1 :=
  lpS_of_nonpos hA ht

/-- The Lumer–Phillips semigroup is a contraction semigroup. -/
theorem isContraction_semigroup (hA : A.IsMDissipative) : hA.semigroup.IsContraction :=
  fun t _ => ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => by
    rw [one_mul]; exact norm_lpS_apply_le hA t x

/-- **The generator of the Lumer–Phillips semigroup is `A`**, domain included: `A ⊆ B` for the
generator `B` (the orbit identity), `B` is dissipative, and `1 - A` is onto. -/
theorem generator_semigroup (hA : A.IsMDissipative) : hA.semigroup.generator = A := by
  set G := hA.semigroup
  have hle : A ≤ G.generator := by
    refine ⟨fun x hx => ⟨A ⟨x, hx⟩, hasDerivWithinAt_lpS hA ⟨x, hx⟩⟩, fun x y hxy => ?_⟩
    have hy : HasDerivWithinAt (fun t => G.S t y) (A x) (Ici 0) 0 := by
      rw [← hxy]; exact hasDerivWithinAt_lpS hA x
    exact (G.generator_apply_eq hy).symm
  refine (LinearPMap.eq_of_le_of_domain_eq hle (le_antisymm hle.1 fun x hx => ?_)).symm
  set B := G.generator
  have hB := hA.isContraction_semigroup.isDissipative_generator
  obtain ⟨y, hy⟩ := hA.surjective one_pos ((x : E) - B ⟨x, hx⟩)
  set y' : B.domain := ⟨y, hle.1 y.2⟩
  have hBy : B y' = A y := (hle.2 rfl).symm
  have h0 : ((1 : ℝ) : 𝕜) • ((y' - ⟨x, hx⟩ : B.domain) : E) - B (y' - ⟨x, hx⟩) = 0 := by
    calc _ = (((1 : ℝ) : 𝕜) • (y : E) - A y) - ((x : E) - B ⟨x, hx⟩) := by
          rw [LinearPMap.map_sub, hBy, Submodule.coe_sub, RCLike.ofReal_one, one_smul, one_smul]
          abel
      _ = 0 := by rw [hy, sub_self]
  have h1 := congrArg Subtype.val (hB.eq_zero_of_smul_sub_eq_zero one_pos h0)
  have hxy : (y : E) = x := by simpa [sub_eq_zero, y'] using h1
  rw [← hxy]; exact y.2

/-- **Lumer–Phillips, uniqueness**: every strongly continuous semigroup generated by an
m-dissipative `A` (contractive or not) agrees with `hA.semigroup` for `t ≥ 0`. -/
theorem eqOn_semigroup (hA : A.IsMDissipative) {G : C0Semigroup 𝕜 E} (hG : G.generator = A) :
    EqOn G.S hA.semigroup.S (Ici 0) :=
  C0Semigroup.eqOn_of_generator_eq_of_isDissipative
    (by rw [hA.generator_semigroup]; exact hA.dissipative)
    (hG.trans hA.generator_semigroup.symm)

/-- **The Lumer–Phillips theorem** (existence and uniqueness): an m-dissipative operator on a
Hilbert space generates a strongly continuous contraction semigroup, unique for `t ≥ 0` among all
strongly continuous semigroups. Cf. [Pazy1983], §1.4, Thm 4.3. -/
theorem existsUnique_contraction (hA : A.IsMDissipative) :
    ∃ G : C0Semigroup 𝕜 E, G.IsContraction ∧ G.generator = A ∧
      ∀ G' : C0Semigroup 𝕜 E, G'.generator = A → EqOn G'.S G.S (Ici 0) :=
  ⟨hA.semigroup, hA.isContraction_semigroup, hA.generator_semigroup,
    fun _ hG' => hA.eqOn_semigroup hG'⟩

/-- **The Lumer–Phillips theorem, `∃!` form**: `C0Semigroup.S` carries no information at negative
times, so uniqueness as structures holds after the normalization `S t = 1` for `t < 0`. -/
theorem existsUnique_normalized_contraction (hA : A.IsMDissipative) :
    ∃! G : C0Semigroup 𝕜 E, (∀ t < 0, G.S t = 1) ∧ G.IsContraction ∧ G.generator = A := by
  refine ⟨hA.semigroup, ⟨fun t ht => hA.semigroup_S_of_nonpos ht.le,
    hA.isContraction_semigroup, hA.generator_semigroup⟩, ?_⟩
  rintro G ⟨h0, -, hG⟩
  have hS : G.S = hA.semigroup.S := funext fun t => by
    rcases lt_or_ge t 0 with ht | ht
    · rw [h0 t ht, hA.semigroup_S_of_nonpos ht.le]
    · exact hA.eqOn_semigroup hG ht
  obtain ⟨S, _, _, _⟩ := G
  subst hS
  rfl

end LinearPMap.IsMDissipative

namespace LinearPMap

variable [CompleteSpace E] {A : E →ₗ.[𝕜] E}

end LinearPMap

namespace LinearPMap

variable [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A : E →ₗ.[𝕜] E}

open Feec

/-- **The Lumer–Phillips theorem, characterization**: on a Hilbert space, `A` is m-dissipative iff
it generates a strongly continuous contraction semigroup. Cf. [Pazy1983], §1.4, Thm 4.3. -/
theorem isMDissipative_iff_exists_contraction :
    A.IsMDissipative ↔ ∃ G : C0Semigroup 𝕜 E, G.IsContraction ∧ G.generator = A :=
  ⟨fun hA => ⟨hA.semigroup, hA.isContraction_semigroup, hA.generator_semigroup⟩,
    fun ⟨_, hG, h⟩ => h ▸ hG.isMDissipative_generator⟩

/-- **Consistency with Stone's theorem**: for a skew-adjoint `A`, the Lumer–Phillips semigroup
of `A` is Stone's isometric group for `t ≥ 0`. -/
theorem IsSkewAdjoint.eqOn_group_semigroup (hA : A.IsSkewAdjoint) :
    EqOn hA.group.S hA.isMDissipative.semigroup.S (Ici 0) :=
  hA.isMDissipative.eqOn_semigroup (G := hA.group.toC0Semigroup) hA.generator_group

end LinearPMap
