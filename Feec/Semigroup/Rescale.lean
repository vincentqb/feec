module

public import Feec.Semigroup.Orbit
public import Feec.Semigroup.LumerPhillips

/-!
# Rescaled semigroups

The rescaled semigroup `e^{wt} S(t)`, with generator `A + w`, and the quasi-contractive semigroups
`‖S(t)‖ ≤ e^{ωt}` generated by `A` with `A - ω` m-dissipative.

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §1.5
* [K.-J. Engel, R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*][EngelNagel2000],
  §II.2.2

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology NormedSpace

@[expose] public noncomputable section

namespace Feec.C0Semigroup

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E] (G : C0Semigroup 𝕜 E)

/-- **The rescaled semigroup** `t ↦ e^{wt} S(t)`, `w ∈ 𝕜`. -/
def rescale (w : 𝕜) : C0Semigroup 𝕜 E where
  S t := exp (t • w) • G.S t
  map_zero := by simp [G.map_zero]
  map_add s t hs ht := by rw [G.map_add s t hs ht, smul_mul_smul_comm, add_smul, exp_add]
  strongCont x :=
    ((exp_continuous.comp (continuous_id.smul continuous_const)).continuousOn.smul
      (G.strongCont x)).congr fun _ _ => rfl

theorem rescale_S_apply (w : 𝕜) (t : ℝ) (x : E) :
    (G.rescale w).S t x = exp (t • w) • G.S t x := rfl

theorem norm_rescale_S (w : 𝕜) (t : ℝ) :
    ‖(G.rescale w).S t‖ = Real.exp (RCLike.re w * t) * ‖G.S t‖ := by
  rw [show (G.rescale w).S t = exp (t • w) • G.S t from rfl, norm_smul, RCLike.norm_exp,
    RCLike.smul_re, mul_comm t]

theorem rescale_rescale_neg (w : 𝕜) : (G.rescale w).rescale (-w) = G := by
  obtain ⟨S, h0, hadd, hc⟩ := G
  simp only [rescale, mk.injEq]
  funext t
  rw [smul_smul, ← exp_add, smul_neg, neg_add_cancel, exp_zero, one_smul]

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

theorem hasDerivWithinAt_rescale (w : 𝕜) (x : G.generator.domain) :
    HasDerivWithinAt (fun t => (G.rescale w).S t x) (w • (x : E) + G.generator x) (Ici 0) 0 := by
  have he : HasDerivAt (fun t : ℝ => exp (t • w)) w 0 := by
    simpa using hasDerivAt_exp_smul_const (𝕂 := ℝ) w (0 : ℝ)
  have h := he.hasDerivWithinAt.smul (G.hasDerivWithinAt_generator x)
  simp only [zero_smul, exp_zero, one_smul, S_zero_apply] at h
  rw [add_comm] at h
  exact h

theorem domain_le_domain_rescale (w : 𝕜) :
    G.generator.domain ≤ (G.rescale w).generator.domain :=
  fun x hx => ⟨_, G.hasDerivWithinAt_rescale w ⟨x, hx⟩⟩

/-- **The generator of the rescaled semigroup** is `A + w`, on `D(A)`. [EngelNagel2000],
§II.2.2 -/
theorem generator_rescale (w : 𝕜) :
    (G.rescale w).generator = (w • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ G.generator := by
  have hd : (G.rescale w).generator.domain = G.generator.domain := by
    refine le_antisymm (fun x hx => ?_) (G.domain_le_domain_rescale w)
    have := (G.rescale w).domain_le_domain_rescale (-w) hx
    rwa [rescale_rescale_neg] at this
  refine LinearPMap.ext (hd.trans (LinearPMap.vadd_domain _ _).symm) fun x hf hg => ?_
  rw [(G.rescale w).generator_apply_eq (G.hasDerivWithinAt_rescale w ⟨x, hd ▸ hf⟩),
    LinearPMap.vadd_apply]
  rfl

end Feec.C0Semigroup

/-! ### Quasi-contractive semigroups on Hilbert spaces -/

namespace LinearPMap.IsMDissipative

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A : E →ₗ.[𝕜] E} {ω : ℝ}

/-- **`A` generates `e^{ωt} S_{A-ω}(t)`** when `A - ω` is m-dissipative. [Pazy1983], §1.5 -/
theorem generator_rescale_semigroup
    (hA : (((-(ω : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A).IsMDissipative) :
    (hA.semigroup.rescale ω).generator = A := by
  rw [Feec.C0Semigroup.generator_rescale, hA.generator_semigroup, vadd_vadd, ← add_smul,
    add_neg_cancel, zero_smul, zero_vadd]

theorem norm_rescale_semigroup_le
    (hA : (((-(ω : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A).IsMDissipative) {t : ℝ}
    (ht : 0 ≤ t) : ‖(hA.semigroup.rescale ω).S t‖ ≤ Real.exp (ω * t) := by
  rw [Feec.C0Semigroup.norm_rescale_S, RCLike.ofReal_re]
  exact mul_le_of_le_one_right (Real.exp_pos _).le (hA.isContraction_semigroup t ht)

/-- **Every semigroup generated by `A` is bounded by `e^{ωt}`** when `A - ω` is m-dissipative. -/
theorem norm_S_le_of_generator_eq
    (hA : (((-(ω : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A).IsMDissipative)
    {G : Feec.C0Semigroup 𝕜 E} (hG : G.generator = A) {t : ℝ} (ht : 0 ≤ t) :
    ‖G.S t‖ ≤ Real.exp (ω * t) := by
  have hgen : (G.rescale (-ω)).generator =
      ((-(ω : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A := by
    rw [Feec.C0Semigroup.generator_rescale, hG]
  have h := hA.eqOn_semigroup hgen ht
  have hG' : G = (G.rescale (-ω)).rescale ω := by
    simpa using (G.rescale_rescale_neg (-ω)).symm
  rw [hG', Feec.C0Semigroup.norm_rescale_S, RCLike.ofReal_re, h]
  exact mul_le_of_le_one_right (Real.exp_pos _).le (hA.isContraction_semigroup t ht)

end LinearPMap.IsMDissipative
