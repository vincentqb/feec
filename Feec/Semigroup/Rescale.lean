module

public import Feec.Semigroup.Orbit
public import Feec.Semigroup.LumerPhillips

/-!
# Rescaled semigroups

For a strongly continuous semigroup `G` on a normed space over `𝕜 = ℝ` or `ℂ` and `ω : ℝ`,
`C0Semigroup.rescale G ω` is the semigroup `t ↦ e^{ωt} S(t)`. Its generator is `A + ω`
(`C0Semigroup.generator_rescale`, domain `D(A)`), and `‖e^{ωt} S(t)‖ = e^{ωt} ‖S(t)‖`. This is
the shift between quasi-contractive semigroups, `‖S(t)‖ ≤ e^{ωt}`, generated by `A` with `A - ω`
m-dissipative, and contraction semigroups ([Pazy1983], §1.5;
[EngelNagel2000], §II.2.2): on a Hilbert space, if `A - ω` is m-dissipative, then
`e^{ωt} S_{A-ω}(t)` is generated by `A` and bounded by `e^{ωt}`
(`LinearPMap.IsMDissipative.generator_rescale_semigroup`,
`LinearPMap.IsMDissipative.norm_rescale_semigroup_le`).

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §1.5 (quasi-contractive semigroups `e^{ωt} S(t)`)
* [K.-J. Engel, R. Nagel, *One-Parameter Semigroups for Linear Evolution Equations*][EngelNagel2000],
  §II.2.2 (rescaled semigroups)

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology

@[expose] public noncomputable section

namespace Feec.C0Semigroup

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E] (G : C0Semigroup 𝕜 E)

/-- **The rescaled semigroup** `t ↦ e^{ωt} S(t)`. -/
def rescale (ω : ℝ) : C0Semigroup 𝕜 E where
  S t := ((Real.exp (ω * t) : ℝ) : 𝕜) • G.S t
  map_zero := by simp [G.map_zero]
  map_add s t hs ht := by
    rw [G.map_add s t hs ht, smul_mul_smul_comm, mul_add, Real.exp_add, RCLike.ofReal_mul]
  strongCont x :=
    ((RCLike.continuous_ofReal.comp (Real.continuous_exp.comp
      (continuous_const.mul continuous_id))).continuousOn.smul (G.strongCont x)).congr
      fun _ _ => rfl

theorem rescale_S_apply (ω t : ℝ) (x : E) :
    (G.rescale ω).S t x = ((Real.exp (ω * t) : ℝ) : 𝕜) • G.S t x := rfl

theorem norm_rescale_S (ω t : ℝ) : ‖(G.rescale ω).S t‖ = Real.exp (ω * t) * ‖G.S t‖ := by
  rw [show (G.rescale ω).S t = ((Real.exp (ω * t) : ℝ) : 𝕜) • G.S t from rfl, norm_smul,
    RCLike.norm_ofReal, abs_of_pos (Real.exp_pos _)]

/-- Rescaling by `ω` and then by `-ω` gives back `G`. -/
theorem rescale_rescale_neg (ω : ℝ) : (G.rescale ω).rescale (-ω) = G := by
  obtain ⟨S, h0, hadd, hc⟩ := G
  simp only [rescale, mk.injEq]
  funext t
  rw [smul_smul, ← RCLike.ofReal_mul, ← Real.exp_add, show -ω * t + ω * t = 0 by ring,
    Real.exp_zero, RCLike.ofReal_one, one_smul]

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- On `D(A)`, `t ↦ e^{ωt} S(t) x` has right derivative `ω x + A x` at `0`. -/
theorem hasDerivWithinAt_rescale (ω : ℝ) (x : G.generator.domain) :
    HasDerivWithinAt (fun t => (G.rescale ω).S t x) ((ω : 𝕜) • (x : E) + G.generator x)
      (Ici 0) 0 := by
  have he : HasDerivWithinAt (fun t : ℝ => Real.exp (ω * t)) (Real.exp (ω * 0) * ω) (Ici 0) 0 :=
    (((hasDerivAt_id 0).const_mul ω).exp.congr_deriv (by simp)).hasDerivWithinAt
  have h := he.smul (G.hasDerivWithinAt_generator x)
  simp only [mul_zero, Real.exp_zero, one_smul, one_mul, S_zero_apply] at h
  rw [add_comm, RCLike.real_smul_eq_coe_smul (K := 𝕜)] at h
  refine h.congr (fun t _ => ?_) ?_
  · change _ = Real.exp (ω * t) • G.S t x
    rw [rescale_S_apply, RCLike.real_smul_eq_coe_smul (K := 𝕜)]
  · change _ = Real.exp (ω * 0) • G.S 0 x
    rw [rescale_S_apply, RCLike.real_smul_eq_coe_smul (K := 𝕜)]

theorem domain_le_domain_rescale (ω : ℝ) :
    G.generator.domain ≤ (G.rescale ω).generator.domain :=
  fun x hx => ⟨_, G.hasDerivWithinAt_rescale ω ⟨x, hx⟩⟩

/-- **The generator of the rescaled semigroup** is `A + ω`, on `D(A)`. [EngelNagel2000],
§II.2.2 -/
theorem generator_rescale (ω : ℝ) :
    (G.rescale ω).generator = ((ω : 𝕜) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ G.generator := by
  have hd : (G.rescale ω).generator.domain = G.generator.domain := by
    refine le_antisymm (fun x hx => ?_) (G.domain_le_domain_rescale ω)
    have := (G.rescale ω).domain_le_domain_rescale (-ω) hx
    rwa [rescale_rescale_neg] at this
  refine LinearPMap.ext (hd.trans (LinearPMap.vadd_domain _ _).symm) fun x hf hg => ?_
  rw [(G.rescale ω).generator_apply_eq (G.hasDerivWithinAt_rescale ω ⟨x, hd ▸ hf⟩),
    LinearPMap.vadd_apply]
  rfl

end Feec.C0Semigroup

/-! ### Quasi-contractive semigroups on Hilbert spaces -/

namespace LinearPMap.IsMDissipative

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [CompleteSpace E] [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A : E →ₗ.[𝕜] E} {ω : ℝ}

/-- **`A` generates `e^{ωt} S_{A-ω}(t)`** when `A - ω` is m-dissipative. [Pazy1983], §1.5 -/
theorem generator_rescale_semigroup
    (hA : (((-(ω : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A).IsMDissipative) :
    (hA.semigroup.rescale ω).generator = A := by
  rw [Feec.C0Semigroup.generator_rescale, hA.generator_semigroup, vadd_vadd, ← add_smul,
    add_neg_cancel, zero_smul, zero_vadd]

/-- `‖e^{ωt} S_{A-ω}(t)‖ ≤ e^{ωt}` for `t ≥ 0`. -/
theorem norm_rescale_semigroup_le
    (hA : (((-(ω : 𝕜)) • (LinearMap.id : E →ₗ[𝕜] E)) +ᵥ A).IsMDissipative) {t : ℝ}
    (ht : 0 ≤ t) : ‖(hA.semigroup.rescale ω).S t‖ ≤ Real.exp (ω * t) := by
  rw [Feec.C0Semigroup.norm_rescale_S]
  exact mul_le_of_le_one_right (Real.exp_pos _).le (hA.isContraction_semigroup t ht)

end LinearPMap.IsMDissipative
