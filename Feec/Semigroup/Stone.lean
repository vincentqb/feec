/-!
# Stone's theorem

On a Hilbert space over `𝕜 = ℝ` or `ℂ`, an operator `A` is skew-adjoint (`A† = -A`) iff it
generates a strongly continuous group of isometries, and that group is unique:

* **`LinearPMap.isSkewAdjoint_iff_existsUnique_isometricGroup`**:
  `A.IsSkewAdjoint ↔ ∃! G : C0Group 𝕜 E, G.IsIsometric ∧ G.generator = A`.
* `LinearPMap.IsSkewAdjoint.group hA : C0Group 𝕜 E`, with `isIsometric_group`,
  `generator_group : hA.group.generator = A`, and `eq_group` (every strongly continuous group
  generated by `A`, isometric or not, is `hA.group`).
* `C0Group.IsIsometric.isSkewAdjoint_generator`: the converse half;
  `C0Group.IsIsometric.ext_of_generator_eq`: a group with the generator of an isometric group is
  that group.

## Construction

For `c = n + 1`, the resolvents `R(±c) = (±c - A)⁻¹` (`Feec.Operator.resolvent`) give the bounded
skew approximants `B_n = (c²/2) (R(c) + R(-c)) = c² A (c² - A²)⁻¹` (`Feec.Stone.approxB`), with
`B_n x = J_n (A x) → A x` on `D(A)`, `J_n = (c/2) (R(c) - R(-c)) → 1` strongly. The isometric
groups `exp(t B_n)` (`C0Group.ofBounded`) converge strongly (they commute, and
`‖e^{tB_n} x - e^{tB_m} x‖ ≤ |t| ‖B_n x - B_m x‖`); the limit is the Stone group. Unlike the
Yosida approximant `c A (c - A)⁻¹`, which is only dissipative, `B_n` is skew, so every
approximating group is isometric.

## References

* [A. Pazy, *Semigroups of Linear Operators and Applications to Partial Differential Equations*][Pazy1983],
  §1.10 (Stone's theorem)
* [H. Brezis, *Functional Analysis, Sobolev Spaces and Partial Differential Equations*][Brezis2011],
  Ch. 7 (Hille–Yosida; the skew-adjoint case)
* [V. Quenneville-Bélair, *A New Approach to Finite Element Simulations of General Relativity*][QuennevilleBelair2015],
  Thm 4.3 (the existence input, cited there from [CazenaveHaraux1998])
* [T. Cazenave, A. Haraux, *An Introduction to Semilinear Evolution Equations*][CazenaveHaraux1998],
  Cor. 2.4.9 (skew-adjoint generators of isometry groups) and Prop. 4.1.6

Bibliography: [references.bib](../../docs/references.bib)
-/

open Set Filter Topology NormedSpace LinearPMap Feec.Operator

@[expose] public noncomputable section

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]
  [CompleteSpace E]

local notation "⟪" x ", " y "⟫" => inner 𝕜 x y

/-- Membership in `D(A†)` with `A† y = w` transfers to `D(A)` with `A y = -w` for skew-adjoint
`A`. -/
theorem LinearPMap.IsSkewAdjoint.exists_mem_domain_of_inner_eq {A : E →ₗ.[𝕜] E}
    (hA : A.IsSkewAdjoint) {y w : E} (h : ∀ x : A.domain, ⟪w, (x : E)⟫ = ⟪y, A x⟫) :
    ∃ hy : y ∈ A.domain, A ⟨y, hy⟩ = -w := by
  have hya : y ∈ A†.domain := mem_adjoint_domain_of_exists y ⟨w, h⟩
  have hval : A† ⟨y, hya⟩ = w := adjoint_apply_eq hA.dense_domain ⟨y, hya⟩ h
  have hle : A† ≤ -A := hA ▸ le_rfl
  have hy : y ∈ A.domain := hle.1 hya
  refine ⟨hy, ?_⟩
  have h2 : A† ⟨y, hya⟩ = (-A) ⟨y, hy⟩ := hle.2 rfl
  rw [hval, LinearPMap.neg_apply] at h2
  rw [h2, neg_neg]

namespace Feec

namespace Stone

variable {A : E →ₗ.[𝕜] E}

/-! ### Real resolvents of a skew-adjoint operator -/

/-- `R(z) = (z - A)⁻¹` at a real point `z`. -/
def res (A : E →ₗ.[𝕜] E) (z : ℝ) : E →L[𝕜] E := resolvent A (z : 𝕜)

theorem isResolvent_res (hA : A.IsSkewAdjoint) {z : ℝ} (hz : z ≠ 0) :
    IsResolvent A (z : 𝕜) (res A z) :=
  isResolvent_resolvent hA (by rwa [RCLike.ofReal_re])

/-- `R(z) (A x) = z R(z) x - x` on `D(A)`. -/
theorem res_apply_domain (hA : A.IsSkewAdjoint) {z : ℝ} (hz : z ≠ 0) (x : A.domain) :
    res A z (A x) = (z : 𝕜) • res A z x - x :=
  (isResolvent_res hA hz).apply_domain x

/-- `‖R(z) y‖ ≤ |z|⁻¹ ‖y‖`. -/
theorem norm_res_apply_le (hA : A.IsSkewAdjoint) {z : ℝ} (hz : z ≠ 0) (y : E) :
    ‖res A z y‖ ≤ |z|⁻¹ * ‖y‖ := by
  have h := norm_resolvent_apply_le hA (z := (z : 𝕜)) (by rwa [RCLike.ofReal_re]) y
  rwa [RCLike.ofReal_re] at h

/-- `⟪R(z) x, y⟫ = -⟪x, R(-z) y⟫`. -/
theorem inner_res_left (hA : A.IsSkewAdjoint) {z : ℝ} (hz : z ≠ 0) (x y : E) :
    ⟪res A z x, y⟫ = -⟪x, res A (-z) y⟫ := by
  have h := inner_resolvent_left hA (z := (z : 𝕜)) (by rwa [RCLike.ofReal_re]) x y
  rwa [RCLike.conj_ofReal, ← RCLike.ofReal_neg] at h

theorem res_commute (hA : A.IsSkewAdjoint) {z w : ℝ} (hz : z ≠ 0) (hw : w ≠ 0) :
    Commute (res A z) (res A w) :=
  (isResolvent_res hA hz).commute (isResolvent_res hA hw)

/-! ### Bounded skew approximants -/

/-- The scale `c_n = n + 1`. -/
def scale (n : ℕ) : ℝ := (n : ℝ) + 1

theorem scale_pos (n : ℕ) : 0 < scale n := by unfold scale; positivity

theorem scale_ne_zero (n : ℕ) : scale n ≠ 0 := (scale_pos n).ne'

theorem neg_scale_ne_zero (n : ℕ) : -scale n ≠ 0 := neg_ne_zero.2 (scale_ne_zero n)

theorem tendsto_scale_atTop : Tendsto scale atTop atTop :=
  tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop

/-- `J_n = (c/2) (R(c) - R(-c)) = c² (c² - A²)⁻¹`, a contraction converging strongly to `1`. -/
def approxJ (A : E →ₗ.[𝕜] E) (n : ℕ) : E →L[𝕜] E :=
  ((scale n / 2 : ℝ) : 𝕜) • (res A (scale n) - res A (-scale n))

/-- `B_n = (c²/2) (R(c) + R(-c)) = c² A (c² - A²)⁻¹`: bounded, skew, `B_n x = J_n (A x)`. -/
def approxB (A : E →ₗ.[𝕜] E) (n : ℕ) : E →L[𝕜] E :=
  ((scale n ^ 2 / 2 : ℝ) : 𝕜) • (res A (scale n) + res A (-scale n))

/-- `B_n` is skew: `⟪B_n x, y⟫ = -⟪x, B_n y⟫`. -/
theorem approxB_skew (hA : A.IsSkewAdjoint) (n : ℕ) (x y : E) :
    ⟪approxB A n x, y⟫ = -⟪x, approxB A n y⟫ := by
  simp only [approxB, _root_.smul_apply, _root_.add_apply,
    inner_smul_left, inner_smul_right, inner_add_left, inner_add_right, RCLike.conj_ofReal,
    inner_res_left hA (scale_ne_zero n), inner_res_left hA (neg_scale_ne_zero n), neg_neg]
  ring

/-- `B_n x = J_n (A x)` on `D(A)`. -/
theorem approxB_apply_domain (hA : A.IsSkewAdjoint) (n : ℕ) (x : A.domain) :
    approxB A n x = approxJ A n (A x) := by
  simp only [approxB, approxJ, _root_.smul_apply, _root_.add_apply,
    _root_.sub_apply, res_apply_domain hA (scale_ne_zero n),
    res_apply_domain hA (neg_scale_ne_zero n)]
  push_cast
  module

/-- `‖J_n y‖ ≤ ‖y‖`. -/
theorem norm_approxJ_apply_le (hA : A.IsSkewAdjoint) (n : ℕ) (y : E) :
    ‖approxJ A n y‖ ≤ ‖y‖ := by
  have h1 := norm_res_apply_le hA (scale_ne_zero n) y
  have h2 := norm_res_apply_le hA (neg_scale_ne_zero n) y
  have hc := scale_pos n
  rw [abs_neg, abs_of_pos hc] at h2
  rw [abs_of_pos hc] at h1
  simp only [approxJ, _root_.smul_apply, _root_.sub_apply, norm_smul,
    RCLike.norm_ofReal, abs_of_pos (half_pos hc)]
  calc scale n / 2 * ‖res A (scale n) y - res A (-scale n) y‖
      ≤ scale n / 2 * (‖res A (scale n) y‖ + ‖res A (-scale n) y‖) := by
        gcongr; exact norm_sub_le _ _
    _ ≤ scale n / 2 * ((scale n)⁻¹ * ‖y‖ + (scale n)⁻¹ * ‖y‖) := by gcongr
    _ = ‖y‖ := by field_simp; ring

/-- `‖B_n x‖ ≤ ‖A x‖` on `D(A)`. -/
theorem norm_approxB_apply_domain_le (hA : A.IsSkewAdjoint) (n : ℕ) (x : A.domain) :
    ‖approxB A n x‖ ≤ ‖A x‖ := by
  rw [approxB_apply_domain hA]; exact norm_approxJ_apply_le hA n _

/-- `‖J_n y - y‖ ≤ ‖A y‖ / c_n` on `D(A)`. -/
theorem norm_approxJ_sub_le (hA : A.IsSkewAdjoint) (n : ℕ) (y : A.domain) :
    ‖approxJ A n y - y‖ ≤ ‖A y‖ / scale n := by
  have hc := scale_pos n
  have e1 := res_apply_domain hA (scale_ne_zero n) y
  have e2 := res_apply_domain hA (neg_scale_ne_zero n) y
  have h : approxJ A n y - y =
      ((1 / 2 : ℝ) : 𝕜) • (res A (scale n) (A y) + res A (-scale n) (A y)) := by
    rw [e1, e2]
    simp only [approxJ, _root_.smul_apply, _root_.sub_apply]
    push_cast
    module
  have h1 := norm_res_apply_le hA (scale_ne_zero n) (A y)
  have h2 := norm_res_apply_le hA (neg_scale_ne_zero n) (A y)
  rw [abs_neg, abs_of_pos hc] at h2
  rw [abs_of_pos hc] at h1
  rw [h, norm_smul, RCLike.norm_ofReal, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
  calc 1 / 2 * ‖res A (scale n) (A y) + res A (-scale n) (A y)‖
      ≤ 1 / 2 * (‖res A (scale n) (A y)‖ + ‖res A (-scale n) (A y)‖) := by
        gcongr; exact norm_add_le _ _
    _ ≤ 1 / 2 * ((scale n)⁻¹ * ‖A y‖ + (scale n)⁻¹ * ‖A y‖) := by gcongr
    _ = ‖A y‖ / scale n := by field_simp; ring

omit [InnerProductSpace 𝕜 E] [CompleteSpace E] in
/-- Strong convergence on a dense set plus `‖T n x‖ ≤ ‖x‖` gives strong convergence. -/
theorem tendsto_apply_of_dense [NormedSpace 𝕜 E] {T : ℕ → E →L[𝕜] E} (hT : ∀ n x, ‖T n x‖ ≤ ‖x‖)
    {D : Set E} (hD : Dense D) (h : ∀ x ∈ D, Tendsto (fun n => T n x) atTop (𝓝 x)) (x : E) :
    Tendsto (fun n => T n x) atTop (𝓝 x) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨d, hd, hdD⟩ := Metric.dense_iff.1 hD x (ε / 3) (by positivity)
  rw [Metric.mem_ball] at hd
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 (h d hdD) (ε / 3) (by positivity)
  refine ⟨N, fun n hn => ?_⟩
  have h1 : dist (T n x) (T n d) ≤ dist x d := by
    rw [dist_eq_norm, dist_eq_norm, ← _root_.map_sub]; exact hT n _
  have := hN n hn
  calc dist (T n x) x ≤ dist (T n x) (T n d) + dist (T n d) d + dist d x :=
        dist_triangle4 _ _ _ _
    _ < ε / 3 + ε / 3 + ε / 3 := by
        have hd' : dist x d < ε / 3 := by rwa [dist_comm]
        linarith
    _ = ε := by ring

omit [InnerProductSpace 𝕜 E] [CompleteSpace E] in
/-- Strong Cauchy-ness on a dense set plus `‖T n x‖ ≤ ‖x‖` gives strong Cauchy-ness. -/
theorem cauchySeq_apply_of_dense [NormedSpace 𝕜 E] {T : ℕ → E →L[𝕜] E}
    (hT : ∀ n x, ‖T n x‖ ≤ ‖x‖) {D : Set E} (hD : Dense D)
    (h : ∀ x ∈ D, CauchySeq fun n => T n x) (x : E) : CauchySeq fun n => T n x := by
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨d, hd, hdD⟩ := Metric.dense_iff.1 hD x (ε / 3) (by positivity)
  rw [Metric.mem_ball, dist_comm] at hd
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 (h d hdD) (ε / 3) (by positivity)
  refine ⟨N, fun m hm n hn => ?_⟩
  have h1 : ∀ k, dist (T k x) (T k d) ≤ dist x d := fun k => by
    rw [dist_eq_norm, dist_eq_norm, ← _root_.map_sub]; exact hT k _
  have := hN m hm n hn
  have h2 := h1 n
  rw [dist_comm] at h2
  calc dist (T m x) (T n x) ≤ dist (T m x) (T m d) + dist (T m d) (T n d) + dist (T n d) (T n x) :=
        dist_triangle4 _ _ _ _
    _ < ε / 3 + ε / 3 + ε / 3 := by linarith [h1 m]
    _ = ε := by ring

/-- `J_n y → y` for every `y`. -/
theorem tendsto_approxJ (hA : A.IsSkewAdjoint) (y : E) :
    Tendsto (fun n => approxJ A n y) atTop (𝓝 y) := by
  refine tendsto_apply_of_dense (norm_approxJ_apply_le hA) hA.dense_domain ?_ y
  rintro x hx
  rw [tendsto_iff_norm_sub_tendsto_zero]
  refine squeeze_zero (fun _ => norm_nonneg _) (fun n => norm_approxJ_sub_le hA n ⟨x, hx⟩) ?_
  exact tendsto_const_nhds.div_atTop tendsto_scale_atTop

/-- `B_n x → A x` on `D(A)`. -/
theorem tendsto_approxB (hA : A.IsSkewAdjoint) (x : A.domain) :
    Tendsto (fun n => approxB A n x) atTop (𝓝 (A x)) := by
  simp_rw [approxB_apply_domain hA]; exact tendsto_approxJ hA _

/-- The approximants commute. -/
theorem approxB_commute (hA : A.IsSkewAdjoint) (n m : ℕ) :
    Commute (approxB A n) (approxB A m) := by
  have h : ∀ z w : ℝ, z ≠ 0 → w ≠ 0 → Commute (res A z) (res A w) :=
    fun z w hz hw => res_commute hA hz hw
  have hn := scale_ne_zero n; have hm := scale_ne_zero m
  have hn' := neg_scale_ne_zero n; have hm' := neg_scale_ne_zero m
  unfold approxB
  refine ((Commute.add_left ?_ ?_).smul_left _).smul_right _ <;> refine Commute.add_right ?_ ?_
  all_goals apply h <;> assumption

/-! ### The approximating groups and their strong limit -/

/-- `ℚ`-algebra structure on operators, for `NormedSpace.exp_add_of_commute`. -/
local instance instNormedAlgebraRatStone : NormedAlgebra ℚ (E →L[𝕜] E) :=
  NormedAlgebra.restrictScalars ℚ 𝕜 _

/-- The approximating isometric groups `U_n(t) = exp(t B_n)`. -/
def approxU (A : E →ₗ.[𝕜] E) (n : ℕ) (t : ℝ) : E →L[𝕜] E := exp ((t : 𝕜) • approxB A n)

theorem norm_approxU_apply (hA : A.IsSkewAdjoint) (n : ℕ) (t : ℝ) (x : E) :
    ‖approxU A n t x‖ = ‖x‖ :=
  C0Group.norm_exp_ofReal_smul_apply (approxB_skew hA n) t x

theorem approxU_add (n : ℕ) (s t : ℝ) :
    approxU A n (s + t) = approxU A n s * approxU A n t :=
  C0Group.exp_ofReal_smul_add _ s t

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- `‖e^{tB_n} x - e^{tB_m} x‖ ≤ |t| ‖B_n x - B_m x‖`. -/
theorem norm_approxU_sub_le (hA : A.IsSkewAdjoint) (n m : ℕ) (t : ℝ) (x : E) :
    ‖approxU A n t x - approxU A m t x‖ ≤ |t| * ‖approxB A n x - approxB A m x‖ := by
  set D := approxB A n - approxB A m
  have hD : ∀ x y, ⟪D x, y⟫ = -⟪x, D y⟫ := fun x y => by
    simp only [D, _root_.sub_apply, inner_sub_left, inner_sub_right,
      approxB_skew hA]; ring
  have hcomm : Commute ((t : 𝕜) • approxB A m) ((t : 𝕜) • D) :=
    (((approxB_commute hA m n).sub_right (Commute.refl _)).smul_left _).smul_right _
  have he : approxU A n t = approxU A m t * exp ((t : 𝕜) • D) := by
    unfold approxU
    rw [← exp_add_of_commute hcomm, ← smul_add]
    congr 2
    simp only [D]; abel
  rw [he, mul_apply_eq_comp, ← _root_.map_sub, norm_approxU_apply hA]
  exact C0Group.norm_exp_ofReal_smul_sub_le hD t x

/-- `(exp(t B_n) x)_n` is Cauchy. -/
theorem cauchySeq_approxU (hA : A.IsSkewAdjoint) (t : ℝ) (x : E) :
    CauchySeq fun n => approxU A n t x := by
  refine cauchySeq_apply_of_dense (fun n x => (norm_approxU_apply hA n t x).le)
    hA.dense_domain ?_ x
  intro y hy
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 (tendsto_approxB hA ⟨y, hy⟩).cauchySeq
    (ε / (|t| + 1)) (by positivity)
  refine ⟨N, fun m hm n hn => ?_⟩
  have h1 := norm_approxU_sub_le hA m n t y
  have h2 := hN m hm n hn
  rw [dist_eq_norm] at h2 ⊢
  have h3 : |t| * ‖approxB A m y - approxB A n y‖ ≤ |t| * (ε / (|t| + 1)) :=
    mul_le_mul_of_nonneg_left h2.le (abs_nonneg t)
  have h4 : |t| * (ε / (|t| + 1)) < ε := by
    rw [mul_div_assoc', div_lt_iff₀ (by positivity)]; nlinarith [abs_nonneg t]
  linarith

/-- The Stone group `S(t) x = lim_n exp(t B_n) x` (a continuous linear map by
Banach–Steinhaus). -/
def stoneS (hA : A.IsSkewAdjoint) (t : ℝ) : E →L[𝕜] E :=
  continuousLinearMapOfTendsto (fun n => approxU A n t)
    (tendsto_pi_nhds.2 fun x => (cauchySeq_approxU hA t x).tendsto_limUnder)

theorem tendsto_approxU (hA : A.IsSkewAdjoint) (t : ℝ) (x : E) :
    Tendsto (fun n => approxU A n t x) atTop (𝓝 (stoneS hA t x)) :=
  (cauchySeq_approxU hA t x).tendsto_limUnder

theorem tendsto_approxU_of_tendsto (hA : A.IsSkewAdjoint) (t : ℝ) {y : ℕ → E} {y₀ : E}
    (hy : Tendsto y atTop (𝓝 y₀)) :
    Tendsto (fun n => approxU A n t (y n)) atTop (𝓝 (stoneS hA t y₀)) := by
  have h0 : Tendsto (fun n => approxU A n t (y n - y₀)) atTop (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    simp_rw [norm_approxU_apply hA]
    exact tendsto_zero_iff_norm_tendsto_zero.1 (by simpa using hy.sub_const y₀)
  have := h0.add (tendsto_approxU hA t y₀)
  rw [zero_add] at this
  exact this.congr fun n => by rw [← _root_.map_add, sub_add_cancel]

theorem norm_stoneS_apply (hA : A.IsSkewAdjoint) (t : ℝ) (x : E) : ‖stoneS hA t x‖ = ‖x‖ :=
  tendsto_nhds_unique (tendsto_approxU hA t x).norm
    (by simp_rw [norm_approxU_apply hA]; exact tendsto_const_nhds)

theorem stoneS_zero (hA : A.IsSkewAdjoint) : stoneS hA 0 = 1 := by
  ext x
  refine tendsto_nhds_unique (tendsto_approxU hA 0 x) ?_
  simp [approxU]

theorem stoneS_add (hA : A.IsSkewAdjoint) (s t : ℝ) :
    stoneS hA (s + t) = stoneS hA s * stoneS hA t := by
  ext x
  refine tendsto_nhds_unique (tendsto_approxU hA (s + t) x) ?_
  simp_rw [approxU_add, mul_apply_eq_comp]
  exact tendsto_approxU_of_tendsto hA s (tendsto_approxU hA t x)

/-- `‖S(t) x - S(s) x‖ ≤ |t - s| ‖A x‖` on `D(A)`. -/
theorem norm_stoneS_sub_le (hA : A.IsSkewAdjoint) (x : A.domain) (t s : ℝ) :
    ‖stoneS hA t x - stoneS hA s x‖ ≤ |t - s| * ‖A x‖ := by
  refine le_of_tendsto' ((tendsto_approxU hA t x).sub (tendsto_approxU hA s x)).norm fun n => ?_
  have e : approxU A n t = approxU A n s * approxU A n (t - s) := by
    rw [← approxU_add, add_sub_cancel]
  rw [e, mul_apply_eq_comp, ← _root_.map_sub, norm_approxU_apply hA]
  calc ‖approxU A n (t - s) x - x‖ ≤ |t - s| * ‖approxB A n x‖ :=
        C0Group.norm_exp_ofReal_smul_sub_le (approxB_skew hA n) _ _
    _ ≤ |t - s| * ‖A x‖ := by gcongr; exact norm_approxB_apply_domain_le hA n x

theorem continuous_stoneS_apply (hA : A.IsSkewAdjoint) (x : E) :
    Continuous fun t => stoneS hA t x := by
  refine continuous_of_uniform_approx_of_continuous fun u hu => ?_
  obtain ⟨ε, hε, hεu⟩ := Metric.mem_uniformity_dist.1 hu
  obtain ⟨d, hd, hdD⟩ := Metric.dense_iff.1 hA.dense_domain x ε hε
  rw [Metric.mem_ball] at hd
  refine ⟨fun t => stoneS hA t d, ?_, fun t => hεu ?_⟩
  · refine (LipschitzWith.of_dist_le_mul (K := ‖A ⟨d, hdD⟩‖₊) fun t s => ?_).continuous
    rw [dist_eq_norm, dist_eq_norm, Real.norm_eq_abs, coe_nnnorm, mul_comm]
    exact norm_stoneS_sub_le hA ⟨d, hdD⟩ t s
  · rw [dist_eq_norm, ← _root_.map_sub, norm_stoneS_apply, ← dist_eq_norm, dist_comm]
    exact hd

/-- `S(t) x - x = ∫₀ᵗ S(s) (A x) ds` on `D(A)`. -/
theorem stoneS_sub_eq_integral (hA : A.IsSkewAdjoint) (x : A.domain) (t : ℝ) :
    stoneS hA t x - x = ∫ s in (0 : ℝ)..t, stoneS hA s (A x) := by
  have hcont : ∀ n, Continuous fun s => approxU A n s (approxB A n x) := fun n =>
    (C0Group.continuous_exp_ofReal_smul _).clm_apply continuous_const
  have hftc : ∀ n, approxU A n t x - x = ∫ s in (0 : ℝ)..t, approxU A n s (approxB A n x) := by
    intro n
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun s => approxU A n s x) (a := 0) (b := t)
      (f' := fun s => approxU A n s (approxB A n x)) (fun s _ => ?_)
      ((hcont n).intervalIntegrable _ _)
    · rw [h]; simp [approxU]
    · have h := C0Group.hasDerivAt_exp_ofReal_smul_apply (approxB A n) (x : E) s
      have hc : approxB A n (exp ((s : 𝕜) • approxB A n) x) =
          exp ((s : 𝕜) • approxB A n) (approxB A n x) :=
        congrArg (fun C : E →L[𝕜] E => C x) (C0Group.commute_exp_ofReal_smul (approxB A n) s).eq
      rw [hc] at h
      exact h
  have hlim : Tendsto (fun n => ∫ s in (0 : ℝ)..t, approxU A n s (approxB A n x)) atTop
      (𝓝 (∫ s in (0 : ℝ)..t, stoneS hA s (A x))) := by
    refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence (fun _ => ‖A x‖)
      (Eventually.of_forall fun n => (hcont n).aestronglyMeasurable) ?_
      intervalIntegrable_const ?_
    · refine Eventually.of_forall fun n => Eventually.of_forall fun s _ => ?_
      rw [norm_approxU_apply hA]; exact norm_approxB_apply_domain_le hA n x
    · exact Eventually.of_forall fun s _ =>
        tendsto_approxU_of_tendsto hA s (tendsto_approxB hA x)
  refine tendsto_nhds_unique ((tendsto_approxU hA t x).sub_const (x : E)) ?_
  simp_rw [hftc]; exact hlim

/-- `(d/dt) S(t) x |_{t=0} = A x` on `D(A)`. -/
theorem hasDerivAt_stoneS_zero (hA : A.IsSkewAdjoint) (x : A.domain) :
    HasDerivAt (fun t => stoneS hA t x) (A x) 0 := by
  have hc : Continuous fun s => stoneS hA s (A x) := continuous_stoneS_apply hA _
  have h := (hc.integral_hasStrictDerivAt 0 0).hasDerivAt.const_add (x : E)
  rw [stoneS_zero, one_apply_eq_self] at h
  refine h.congr_of_eventuallyEq (Eventually.of_forall fun t => ?_)
  simp only
  rw [← stoneS_sub_eq_integral]; abel

end Stone

open Stone

namespace C0Group

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- **Stone's theorem, converse half**: the generator of an isometric group is skew-adjoint. -/
theorem IsIsometric.isSkewAdjoint_generator {G : C0Group 𝕜 E} (hG : G.IsIsometric) :
    G.generator.IsSkewAdjoint := by
  set L := G.generator
  have hD : Dense (L.domain : Set E) := G.dense_domain_generator
  have hS : L.IsSkewSymmetric := hG.isSkewSymmetric_generator
  have hle : -L ≤ L† := (isSkewSymmetric_iff_neg_le_adjoint hD).1 hS
  refine (LinearPMap.eq_of_le_of_domain_eq hle (le_antisymm hle.1 fun y hy => ?_)).symm
  set w := L† ⟨y, hy⟩
  have hw : ∀ x : L.domain, ⟪w, (x : E)⟫ = ⟪y, L x⟫ := fun x =>
    adjoint_isFormalAdjoint hD ⟨y, hy⟩ x
  have hcw : Continuous fun u => G.S u w := G.strongCont w
  have key : ∀ τ, G.S τ y = y - ∫ u in (0 : ℝ)..τ, G.S u w := by
    intro τ
    rw [← sub_eq_zero]
    set v := G.S τ y - (y - ∫ u in (0 : ℝ)..τ, G.S u w)
    have horth : ∀ z ∈ (L.domain : Set E), ⟪z, v⟫ = 0 := by
      intro z hz
      have hder : ∀ t, HasDerivAt (fun τ => ⟪z, G.S τ y⟫) (-⟪z, G.S t w⟫) t := by
        intro t
        have h0 : HasDerivAt (fun τ => G.S τ z) (G.S (-t) (L ⟨z, hz⟩)) (-t) :=
          G.hasDerivAt_apply ⟨z, hz⟩ (-t)
        have h1 := h0.scomp t (hasDerivAt_neg t)
        have h2 := h1.inner 𝕜 (hasDerivAt_const t y)
        have e : (fun τ => ⟪z, G.S τ y⟫) = fun τ => ⟪G.S (-τ) z, y⟫ := by
          funext τ
          rw [hG.inner_S_left, neg_neg]
        rw [e]
        refine h2.congr_deriv ?_
        rw [inner_zero_right, zero_add, neg_one_smul, inner_neg_left,
          ← G.generator_apply_S ⟨z, hz⟩ (-t), ← inner_conj_symm, ← hw, inner_conj_symm,
          hG.inner_S_left, neg_neg]
      have hcont : Continuous fun t => -⟪z, G.S t w⟫ :=
        (continuous_const.inner hcw).neg
      have hftc : (∫ t in (0 : ℝ)..τ, -⟪z, G.S t w⟫) = ⟪z, G.S τ y⟫ - ⟪z, y⟫ := by
        have := intervalIntegral.integral_eq_sub_of_hasDerivAt
          (f := fun τ => ⟪z, G.S τ y⟫) (a := 0) (b := τ)
          (fun t _ => hder t) (hcont.intervalIntegrable _ _)
        rw [this, G.S_zero_apply]
      have hcomm : (∫ u in (0 : ℝ)..τ, ⟪z, G.S u w⟫) = ⟪z, ∫ u in (0 : ℝ)..τ, G.S u w⟫ :=
        (innerSL 𝕜 z).intervalIntegral_comp_comm (hcw.intervalIntegrable _ _)
      rw [intervalIntegral.integral_neg, hcomm] at hftc
      simp only [v, inner_sub_right]
      linear_combination -hftc
    have hall : ∀ z, ⟪z, v⟫ = 0 := by
      have hcl : IsClosed {z : E | ⟪z, v⟫ = 0} :=
        isClosed_eq (continuous_id.inner continuous_const) continuous_const
      intro z
      have := closure_minimal
        (show (L.domain : Set E) ⊆ {z : E | ⟪z, v⟫ = 0} from fun z hz => horth z hz) hcl
      rw [hD.closure_eq] at this
      exact this (mem_univ z)
    exact inner_self_eq_zero.1 (hall v)
  show y ∈ L.domain
  rw [G.mem_domain_generator_iff]
  have hd := ((hcw.integral_hasStrictDerivAt 0 0).hasDerivAt.const_sub y)
  exact (hd.congr_of_eventuallyEq (Eventually.of_forall key)).differentiableAt

/-- **Uniqueness**: a strongly continuous group with the same generator as an isometric group is
that group (energy argument; `G'` need not be isometric). -/
theorem IsIsometric.ext_of_generator_eq {G G' : C0Group 𝕜 E} (hG : G.IsIsometric)
    (h : G.generator = G'.generator) : G = G' := by
  set L := G.generator
  have hS : L.IsSkewSymmetric := hG.isSkewSymmetric_generator
  have hmem' : ∀ x : L.domain, (x : E) ∈ G'.generator.domain := fun x => h ▸ x.2
  have happ' : ∀ (x : L.domain), G'.generator ⟨x, hmem' x⟩ = L x := fun x => by
    have : ∀ (T T' : E →ₗ.[𝕜] E) (e : T = T') (x : T.domain), T' ⟨x, e ▸ x.2⟩ = T x := by
      rintro T T' rfl x; rfl
    exact this _ _ h x
  refine C0Group.ext (funext fun t => ?_)
  have hD : ∀ x : L.domain, G.S t x = G'.S t x := by
    intro x
    set e : ℝ → E := fun s => G.S s x - G'.S s x
    have hm1 : ∀ s, G.S s x ∈ L.domain := fun s => G.mapsTo_domain x s
    have hdom : G'.generator.domain = L.domain := congrArg LinearPMap.domain h.symm
    have hm2 : ∀ s, G'.S s x ∈ L.domain := fun s =>
      (SetLike.ext_iff.1 hdom _).1 (G'.mapsTo_domain ⟨x, hmem' x⟩ s)
    have hmem : ∀ s, e s ∈ L.domain := fun s => L.domain.sub_mem (hm1 s) (hm2 s)
    have hde : ∀ s, HasDerivAt e (L ⟨e s, hmem s⟩) s := by
      intro s
      have h1 := G.hasDerivAt_apply' x s
      have h2 := G'.hasDerivAt_apply' ⟨x, hmem' x⟩ s
      have e2 : G'.generator ⟨G'.S s x, G'.mapsTo_domain ⟨x, hmem' x⟩ s⟩ =
          L ⟨G'.S s x, hm2 s⟩ := happ' ⟨_, hm2 s⟩
      rw [e2] at h2
      convert h1.sub h2 using 1
      have e1 : (⟨e s, hmem s⟩ : L.domain) = ⟨G.S s x, hm1 s⟩ - ⟨G'.S s x, hm2 s⟩ := rfl
      rw [e1, LinearPMap.map_sub]
    have hn : ∀ s, HasDerivAt (fun s => ⟪e s, e s⟫) 0 s := by
      intro s
      have := (hde s).inner 𝕜 (hde s)
      rwa [hS ⟨e s, hmem s⟩ ⟨e s, hmem s⟩, add_neg_cancel] at this
    have hc := is_const_of_deriv_eq_zero (fun s => (hn s).differentiableAt)
      (fun s => (hn s).deriv) t 0
    simp only [e, S_zero_apply, sub_self, inner_zero_left] at hc
    exact sub_eq_zero.1 (inner_self_eq_zero.1 hc)
  exact DFunLike.coe_injective (Continuous.ext_on G.dense_domain_generator (G.S t).continuous
    (G'.S t).continuous fun x hx => hD ⟨x, hx⟩)

end C0Group

namespace Stone

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A : E →ₗ.[𝕜] E}

/-- The Stone group of a skew-adjoint operator, as a `C0Group`. -/
def group (hA : A.IsSkewAdjoint) : C0Group 𝕜 E where
  S := stoneS hA
  map_zero := stoneS_zero hA
  map_add := stoneS_add hA
  strongCont := continuous_stoneS_apply hA

theorem isIsometric_group (hA : A.IsSkewAdjoint) : (group hA).IsIsometric :=
  norm_stoneS_apply hA

/-- The generator of the Stone group is `A`, domain included. -/
theorem generator_group (hA : A.IsSkewAdjoint) : (group hA).generator = A := by
  set G := group hA
  have hle : A ≤ G.generator := by
    refine ⟨fun x hx => (G.mem_domain_generator_iff x).2
      (hasDerivAt_stoneS_zero hA ⟨x, hx⟩).differentiableAt, fun x y hxy => ?_⟩
    have hy : HasDerivAt (fun t => G.S t y) (A x) 0 := by
      rw [← hxy]; exact hasDerivAt_stoneS_zero hA x
    exact (G.generator_apply_eq hy).symm
  refine (LinearPMap.eq_of_le_of_domain_eq hle (le_antisymm hle.1 fun x hx => ?_)).symm
  obtain ⟨y, hy⟩ : ∃ y, HasDerivAt (fun t => G.S t x) y 0 :=
    ⟨_, G.hasDerivAt_generator ⟨x, hx⟩⟩
  have key : ∀ z : A.domain, ⟪-y, (z : E)⟫ = ⟪x, A z⟫ := by
    intro z
    have d1 := hy.inner 𝕜 (hasDerivAt_const (0 : ℝ) (z : E))
    have hz' : HasDerivAt (fun h : ℝ => G.S (-h) z) (-(A z)) 0 := by
      have h0 : HasDerivAt (fun t => G.S t z) (A z) (-0) := by
        rw [neg_zero]; exact hasDerivAt_stoneS_zero hA z
      have := h0.scomp (0 : ℝ) (hasDerivAt_neg (0 : ℝ))
      simpa [Function.comp_def] using this
    have d2 := (hasDerivAt_const (0 : ℝ) x).inner 𝕜 hz'
    have e : (fun t => ⟪G.S t x, (z : E)⟫) = fun t => ⟪x, G.S (-t) z⟫ :=
      funext fun t => (isIsometric_group hA).inner_S_left t x z
    rw [e] at d1
    have := d1.unique d2
    simp only [inner_zero_right, inner_zero_left, zero_add, add_zero, inner_neg_right] at this
    rw [inner_neg_left, this, neg_neg]
  exact (hA.exists_mem_domain_of_inner_eq key).1

end Stone

namespace C0Group

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E]

/-- The isometric group generated by a skew-adjoint operator (Stone); cf.
[CazenaveHaraux1998], Cor. 2.4.9. -/
def _root_.LinearPMap.IsSkewAdjoint.group {A : E →ₗ.[𝕜] E} (hA : A.IsSkewAdjoint) :
    C0Group 𝕜 E :=
  Stone.group hA

theorem _root_.LinearPMap.IsSkewAdjoint.isIsometric_group {A : E →ₗ.[𝕜] E}
    (hA : A.IsSkewAdjoint) : hA.group.IsIsometric :=
  Stone.isIsometric_group hA

theorem _root_.LinearPMap.IsSkewAdjoint.generator_group {A : E →ₗ.[𝕜] E}
    (hA : A.IsSkewAdjoint) : hA.group.generator = A :=
  Stone.generator_group hA

/-- Every strongly continuous group generated by a skew-adjoint `A` is the Stone group. -/
theorem _root_.LinearPMap.IsSkewAdjoint.eq_group {A : E →ₗ.[𝕜] E} (hA : A.IsSkewAdjoint)
    {G : C0Group 𝕜 E} (hgen : G.generator = A) : G = hA.group :=
  (hA.isIsometric_group.ext_of_generator_eq (hA.generator_group.trans hgen.symm)).symm

end C0Group

end Feec

namespace LinearPMap

variable [NormedSpace ℝ E] [IsScalarTower ℝ 𝕜 E] {A : E →ₗ.[𝕜] E}

open Feec

/-- **Stone's theorem**: `A` is skew-adjoint iff it generates a strongly continuous group of
isometries, and that group is unique. This is the group-generation input of
[QuennevilleBelair2015], Thm 4.3, which the thesis obtains as a corollary of the Hille–Yosida
theorem; see [CazenaveHaraux1998], Cor. 2.4.9 (skew-adjoint operators generate isometry groups)
and Prop. 4.1.6. Here it is proved directly, by bounded skew approximants, without passing
through Hille–Yosida. -/
theorem isSkewAdjoint_iff_existsUnique_isometricGroup :
    A.IsSkewAdjoint ↔ ∃! G : C0Group 𝕜 E, G.IsIsometric ∧ G.generator = A := by
  constructor
  · intro hA
    exact ⟨hA.group, ⟨hA.isIsometric_group, hA.generator_group⟩,
      fun G hG => hA.eq_group hG.2⟩
  · rintro ⟨G, ⟨hG, rfl⟩, -⟩
    exact hG.isSkewAdjoint_generator

end LinearPMap
