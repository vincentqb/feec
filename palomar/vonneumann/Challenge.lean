          (∀ j < m + 1, HasDerivWithinAt (fun t => S t (u j)) (u (j + 1)) (Set.Ici 0) 0) →
          ‖((P * Ring.inverse Q) ^ n) (u 0) - S (n * τ) (u 0)‖ ≤
            K * M ^ 3 * (1 + C * √n) * (n * τ) * τ ^ m * ‖u (m + 1)‖ := by
  sorry

end VonNeumann
