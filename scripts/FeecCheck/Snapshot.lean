import FeecCheck.Util
import FeecCheck.Env

/-!
# Declaration snapshot

`lake exe feec-snapshot OUT` writes one line per user-facing declaration defined in a `Feec.*`
module (theorems, definitions, opaques, axioms, inductives/structures; any namespace, so global
names such as `E0` are included) as

  `name <TAB> type <TAB> main <TAB> kind`

(types pretty-printed on one line; `kind` is theorem / def / opaque / axiom / inductive).
Compiler/elaborator auxiliaries (constructors, recursors, `noConfusion`, matchers, equation lemmas,
`injEq`, `sizeOf_spec`, `_proof_i`, …) are skipped. `main` is the literal `main` for the "main"
set and empty otherwise:
* thesis-numbered names: a last component containing `thm_N` / `prop_N` / `cor_N` / `lemma_N`
  (underscore optional, e.g. `prop417_density_gap`) / `chN_` (e.g. `prop_4_17`, `thm_4_6_strong`,
  `mirror_prop_4_17_exists`, `ch6_corrected`), or of the form `Sol61` / `Hyp54` / `Sys56` / `C55`;
* names appearing in `docs/OVERVIEW.md` inside backticks (full name, name without the `Feec.`
  root, or a component-aligned suffix of at least 3 characters).

This produced `docs/migration/old_theorems.tsv` once, at the pre-migration HEAD; that file is
frozen, so `OUT` is required (there is no default that would overwrite it).
-/

namespace FeecCheck.Snapshot

open Lean Meta Re

/-- Auxiliary declarations generated by the elaborator or compiler. -/
def isAuxDecl (env : Environment) (nm : Name) : Bool :=
  nm.isInternal || isAuxRecursor env nm || isNoConfusion env nm ||
    Lean.Meta.isMatcherCore env nm ||
    (match nm with
      | .str _ s =>
        s == "injEq" || s == "inj" || s == "sizeOf_spec" || s == "eq_def" || s == "congr_simp" ||
          (s.startsWith "eq_" && (s.drop 3).all Char.isDigit) ||
          (s.startsWith "match_" && (s.drop 6).all Char.isDigit) ||
          (s.startsWith "proof_" && (s.drop 6).all Char.isDigit)
      | _ => false)

def kindOf : ConstantInfo → Option String
  | .thmInfo _ => some "theorem"
  | .defnInfo _ => some "def"
  | .opaqueInfo _ => some "opaque"
  | .axiomInfo _ => some "axiom"
  | .inductInfo _ => some "inductive"
  | _ => none

/-- Collapse a pretty-printed term onto one TSV-safe line. -/
def oneLine (s : String) : String :=
  let s := s.map fun c => if c == '\n' || c == '\t' || c == '\r' then ' ' else c
  " ".intercalate ((s.splitOn " ").filter (· ≠ ""))

/-- `(^|_)(thm|prop|cor|lemma)_?\d|(^|_)ch\d+_|^(Sol|Hyp|Sys|C)\d{2,3}$`. -/
def numbered : Re :=
  alts [seqs [.alt .bos (chr '_'), lits ["thm", "prop", "cor", "lemma"], opt (chr '_'), digit],
    seqs [.alt .bos (chr '_'), lit "ch", plus digit, chr '_'],
    seqs [.bos, lits ["Sol", "Hyp", "Sys", "C"], digit, digit, opt digit,
      .alt .eos (.seq (chr '\n') .eos)]]

/-- The identifier tokens of the backticked spans of `docs/OVERVIEW.md`. -/
def overviewTokens (text : String) : Std.HashSet String := Id.run do
  let span := seqs [chr '`', .group 1 (plus (noneOf ['`', '\n'])), chr '`']
  -- `[A-Za-z_][A-Za-z0-9_'.!?₀-₉ᵢ]*`
  let ident := Re.seq (.alt alphaAZ (chr '_'))
    (.star (.cls fun c => ('A' ≤ c && c ≤ 'Z') || ('a' ≤ c && c ≤ 'z') ||
      ('0' ≤ c && c ≤ '9') || "_'.!?ᵢ".contains c || ('₀' ≤ c && c ≤ '₉')))
  let mut toks := {}
  for s in span.findAllGroup (chars text) do
    for m in ident.findAll (chars s) do
      let mut t := String.ofList (((m.group 0).toList.dropWhile (· == '.')).reverse.dropWhile (· == '.')).reverse
      if t.startsWith "Feec." then t := (t.drop 5).toString
      if t.length ≥ 3 && t.any (fun c => ('A' ≤ c && c ≤ 'Z') || ('a' ≤ c && c ≤ 'z')) then
        toks := toks.insert t
  return toks

def isMain (toks : Std.HashSet String) (name : String) : Bool := Id.run do
  let comps := (name.splitOn ".").toArray
  if (numbered.search (chars comps.back!)).isSome then return true
  for k in [1:comps.size + 1] do
    if toks.contains (".".intercalate (comps.extract (comps.size - k) comps.size).toList) then
      return true
  return false

def run (env : Environment) (out : String) : IO Report := do
  -- the snapshot of `docs/migration/old_theorems.tsv` was printed under
  -- `open Lean Meta Elab Command` (hence `_root_.Module`); keep that for reproducibility
  let opens := [`Lean, `Lean.Meta, `Lean.Elab, `Lean.Elab.Command].map (OpenDecl.simple · [])
  let raw ← (runCore (openDecls := opens) env) do
    let mut rows : Array String := #[]
    for (nm, _, ci) in feecConstants env do
      if isAuxDecl env nm then continue
      let some kind := kindOf ci | continue
      let ty ← MetaM.run' <| withOptions (fun o => o.set `format.width (100000 : Nat)) do
        return toString (← ppExpr ci.type)
      rows := rows.push s!"{nm}\t{oneLine ty}\t{kind}"
    return rows.qsort (· < ·)
  let toks := overviewTokens (← readText "docs/OVERVIEW.md")
  let mut lines := #[]
  let mut m := 0
  for line in raw do
    let [name, ty, kind] := line.splitOn "\t" | continue
    let main := if isMain toks name then "main" else ""
    if !main.isEmpty then m := m + 1
    lines := lines.push s!"{name}\t{ty}\t{main}\t{kind}\n"
  IO.FS.writeFile out (String.join lines.toList)
  return ({ name := "Snapshot" } : Report).addInfo s!"{out}: {lines.size} declarations, {m} main"

end FeecCheck.Snapshot
