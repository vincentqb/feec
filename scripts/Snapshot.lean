import Feec
open Lean Meta Elab Command

/-!
# Declaration snapshot

`#dump_feec_decls` writes one line per user-facing declaration defined in a `Feec.*` module
(theorems, definitions, opaques, axioms, inductives/structures; any namespace, so global
names such as `E0` are included) as

  `name \t type \t kind`

to the file named by the environment variable `FEEC_SNAPSHOT_OUT`
(default `docs/migration/old_theorems.raw.tsv`). Types are pretty-printed on one line.
Compiler/elaborator auxiliaries (constructors, recursors, `noConfusion`, matchers,
equation lemmas, `injEq`, `sizeOf_spec`, `_proof_i`, …) are skipped.

Run through `scripts/Snapshot.sh`, which adds the `main` column and writes
`docs/migration/old_theorems.tsv`.
-/

/-- Auxiliary declarations generated by the elaborator or compiler. -/
def isAuxDecl (env : Environment) (nm : Name) : Bool :=
  nm.isInternal || isAuxRecursor env nm || isNoConfusion env nm ||
    Lean.Meta.isMatcherCore env nm ||
    (match nm with
      | .str _ s =>
        s == "injEq" || s == "inj" || s == "sizeOf_spec" || s == "eq_def" || s == "congr_simp" ||
          (s.startsWith "eq_" && (s.drop 3).all Char.isDigit) ||
          (s.startsWith "match_" && (s.drop 6).all Char.isDigit) ||
          (s.startsWith "proof_" && (s.drop 6).all Char.isDigit)
      | _ => false)

def kindOf : ConstantInfo → Option String
  | .thmInfo _ => some "theorem"
  | .defnInfo _ => some "def"
  | .opaqueInfo _ => some "opaque"
  | .axiomInfo _ => some "axiom"
  | .inductInfo _ => some "inductive"
  | _ => none

/-- Collapse a pretty-printed term onto one TSV-safe line. -/
def oneLine (s : String) : String :=
  let s := s.map fun c => if c == '\n' || c == '\t' || c == '\r' then ' ' else c
  " ".intercalate ((s.splitOn " ").filter (· ≠ ""))

elab "#dump_feec_decls" : command => do
  let env ← getEnv
  let out := (← IO.getEnv "FEEC_SNAPSHOT_OUT").getD "docs/migration/old_theorems.raw.tsv"
  let mut rows : Array String := #[]
  for (nm, ci) in env.constants.toList do
    let some idx := env.getModuleIdxFor? nm | continue
    let some mod := env.header.moduleNames[idx.toNat]? | continue
    unless (`Feec).isPrefixOf mod do continue
    if isAuxDecl env nm then continue
    let some kind := kindOf ci | continue
    let ty ← liftTermElabM <| withOptions (fun o => o.set `format.width (100000 : Nat)) do
      return toString (← ppExpr ci.type)
    rows := rows.push s!"{nm}\t{oneLine ty}\t{kind}"
  let sorted := rows.qsort (· < ·)
  IO.FS.writeFile out ("\n".intercalate sorted.toList ++ "\n")
  logInfo m!"wrote {sorted.size} declarations to {out}"

#dump_feec_decls
